    {
      "STORY_ID": "ST_0012",
      "NEXT_ID": "ST_0013",
      "CHAPTER": 1,
      "STAGE": 1,
      "NUMBER": "12",
      "CATEGORY": "NONE",
      "BACKGROUND": "",
      "BGM": "",
      "SFX": "",
      "PORTRAIT": "",
      "NAME": "스파인",
      "TEXT_ID": "스파인이야. 회복을 맡고 있어. 아프면 바로 말해줘."

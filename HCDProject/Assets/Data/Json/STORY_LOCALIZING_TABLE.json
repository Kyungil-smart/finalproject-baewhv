      "NEXT_ID": "ST_0011",
      "CHAPTER": 1,
      "STAGE": 1,
      "NUMBER": "10",
      "CATEGORY": "NONE",
      "BACKGROUND": "",
      "BGM": "",
      "SFX": "",
      "PORTRAIT": "",
      "NAME": "지휘관",
      "TEXT_ID": "그리고 이쪽이 엘리스, 스파인이야."

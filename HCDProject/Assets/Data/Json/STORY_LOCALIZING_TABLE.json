    {
      "STORY_ID": "ST_0007",
      "NEXT_ID": "ST_0008",
      "CHAPTER": 1,
      "STAGE": 1,
      "NUMBER": "7",
      "CATEGORY": "NONE",
      "BACKGROUND": "",
      "BGM": "",
      "SFX": "",
      "PORTRAIT": "",
      "NAME": "지휘관",
      "TEXT_ID": "이쪽이 세라, 그리고 이쪽이 노아야."

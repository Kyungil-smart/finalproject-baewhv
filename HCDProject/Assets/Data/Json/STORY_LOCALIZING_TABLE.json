    {
      "STORY_ID": "ST_0008",
      "NEXT_ID": "ST_0009",
      "CHAPTER": 1,
      "STAGE": 1,
      "NUMBER": "8",
      "CATEGORY": "NONE",
      "BACKGROUND": "",
      "BGM": "",
      "SFX": "",
      "PORTRAIT": "",
      "NAME": "세라",
      "TEXT_ID": "반가워. 전열을 맡고 있는 세라야. 관문 쪽 확인은 내가 먼저 볼게."
    },
    {
      "STORY_ID": "ST_0009",
      "NEXT_ID": "ST_0010",
      "CHAPTER": 1,
      "STAGE": 1,
      "NUMBER": "9",
      "CATEGORY": "NONE",
      "BACKGROUND": "",
      "BGM": "",
      "SFX": "",
      "PORTRAIT": "",
      "NAME": "노아",
      "TEXT_ID": "노아야. 멀리서 보이는 움직임은 내가 먼저 확인해 둘게."

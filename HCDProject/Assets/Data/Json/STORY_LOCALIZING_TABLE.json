      "STAGE": 1,
      "NUMBER": "5",
      "CATEGORY": "NONE",
      "BACKGROUND": "",
      "BGM": "",
      "SFX": "",
      "PORTRAIT": "",
      "NAME": "요새 병사",
      "TEXT_ID": "시에스 방어 요새에 오신 것을 환영합니다."

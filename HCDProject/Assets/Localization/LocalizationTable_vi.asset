  - m_Id: 2554901966446604
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446605
    m_Localized: "Tr\u01B0\u1EDBc c\u1ED5ng ph\xE1o \u0111\xE0i ph\xF2ng th\u1EE7
      Cies"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446606
    m_Localized: "L\u1EA7n b\u1EA3o tr\xEC chung \u0111\u1EA7u ti\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446607
    m_Localized: "\u0110\u01B0\u1EDDng r\u1EEBng tr\u01B0\u1EDBc c\u1ED5ng Cies"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446608
    m_Localized: "L\u1ED1i v\xE0o ph\xEDa nam ph\xE1o \u0111\xE0i ph\xF2ng th\u1EE7
      Cies"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446609
    m_Localized: "Tr\u01B0\u1EDBc t\u01B0\u1EDDng c\u1ED5ng ph\xE1o \u0111\xE0i ph\xF2ng
      th\u1EE7 Cies"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446610
    m_Localized: "B\u1EA3o tr\xEC t\u01B0\u1EDDng c\u1ED5ng tr\u01B0\u1EDBc tr\u1EADn
      Boss"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640896
    m_Localized: "Tuy\u1EBFn ph\xF2ng th\u1EE7 trung t\xE2m ph\xE1o \u0111\xE0i ph\xF2ng
      th\u1EE7 Cies"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160528
    m_Localized: "Wave 1 \u0111\xE3 s\u1EB5n s\xE0ng. H\xE3y \u0111\u1EB7t \u0111\xE1
      t\xEDn hi\u1EC7u \u0111\u1EC3 c\u01B0\u1EDDng h\xF3a anh h\xF9ng tr\u01B0\u1EDBc
      tr\u1EADn chi\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640897
    m_Localized: "K\xE9o \u0111\xE1 t\xEDn hi\u1EC7u t\u1EA5n c\xF4ng v\xE0o \xF4
      c\u1EE7a Serah."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640898
    m_Localized: "COMBO +1. T\u1EA5n c\xF4ng c\u1EE7a Serah t\u0103ng X1."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640899
    m_Localized: "S\u1ED1 l\u01B0\u1EE3t Sort c\xF2n l\u1EA1i gi\u1EA3m t\u1EEB 6
      xu\u1ED1ng 5."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640900
    m_Localized: "\u0110\xE3 chu\u1EA9n b\u1ECB xong. Nh\u1EA5n BATTLE START \u0111\u1EC3
      b\u1EAFt \u0111\u1EA7u chi\u1EBFn \u0111\u1EA5u."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640901
    m_Localized: "Level Up! H\xE3y ch\u1ECDn ph\u1EA7n th\u01B0\u1EDFng b\u1EA1n
      mu\u1ED1n."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640902
    m_Localized: "Ch\u1EA1m v\xE0o th\u1EBB th\u01B0\u1EDFng m\u1ED9t l\u1EA7n \u0111\u1EC3
      ch\u1ECDn."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640903
    m_Localized: "Ch\u1EA1m th\xEAm m\u1ED9t l\u1EA7n v\xE0o th\u1EBB \u0111\xE3
      ch\u1ECDn \u0111\u1EC3 x\xE1c nh\u1EADn."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640904
    m_Localized: "\u0110\xE3 nh\u1EADn [Gi\xE1c Quan S\u1EAFc B\xE9n] T\u1EA5n c\xF4ng
      +8!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640905
    m_Localized: "Noah gia nh\u1EADp. H\u1ED7 tr\u1EE3 t\u1EA7m xa \u0111\xE3 s\u1EB5n
      s\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640906
    m_Localized: "Spayne gia nh\u1EADp. T\u1EA5t c\u1EA3 anh h\xF9ng \u0111\xE3 s\u1EB5n
      s\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640907
    m_Localized: "Noah v\xE0 Spayne gia nh\u1EADp!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640908
    m_Localized: "Qu\xE1i v\u1EADt l\u1EDBn xu\u1EA5t hi\u1EC7n. H\xE3y chu\u1EA9n
      b\u1ECB t\xEDn hi\u1EC7u k\u1EF9 n\u0103ng c\u1EE7a Serah."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640909
    m_Localized: "Ch\u1EA1m v\xE0o ch\xE2n dung \u0111\u1EC3 d\xF9ng tuy\u1EC7t k\u1EF9.<br>Serah:
      \u0111\xE1nh v\xF9ng ph\xEDa tr\u01B0\u1EDBc / Noah: t\u0103ng t\u1ED1c \u0111\xE1nh
      / Alice: ph\xE9p di\u1EC7n r\u1ED9ng / Spayne: h\u1ED3i m\xE1u to\xE0n \u0111\u1ED9i"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640910
    m_Localized: "Ch\u1EA1m v\xE0o ch\xE2n dung Serah \u0111\u1EC3 d\xF9ng tuy\u1EC7t
      k\u1EF9."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640911
    m_Localized: "Tuy\u1EC7t k\u1EF9 k\xEDch ho\u1EA1t!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640912
    m_Localized: "Ch\u1EA1m v\xE0o m\xE0n h\xECnh trong l\xFAc ph\xE1t c\u1EAFt c\u1EA3nh
      \u0111\u1EC3 hi\u1EC7n n\xFAt B\u1ECF qua."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640913
    m_Localized: "Stage Clear! H\xE3y ki\u1EC3m tra ph\u1EA7n th\u01B0\u1EDFng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640914
    m_Localized: "Hi\u1EC7u \u1EE9ng di v\u1EADt s\u1EBD duy tr\xEC sang m\xE0n ti\u1EBFp
      theo. H\xE3y ch\u1ECDn 1 trong 3."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640915
    m_Localized: "Ch\u1EA1m th\xEAm m\u1ED9t l\u1EA7n v\xE0o di v\u1EADt \u0111\xE3
      ch\u1ECDn \u0111\u1EC3 x\xE1c nh\u1EADn."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640916
    m_Localized: "\u0110\xE3 nh\u1EADn \xC1o Gi\xE1p C\u1ED5 \u0110\u1EA1i. Di v\u1EADt
      \u0111\xE3 ch\u1ECDn \u0111\u01B0\u1EE3c \u0111\u0103ng k\xFD v\xE0o danh s\xE1ch
      s\u1EDF h\u1EEFu. Hi\u1EC7u \u1EE9ng s\u1EBD duy tr\xEC \u1EDF c\xE1c m\xE0n
      sau."
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160384
    m_Localized: "Th\u1EA7n T\u1ED1c"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160385
    m_Localized: "Th\u1ECB Gi\xE1c S\u1EAFc B\xE9n"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160386
    m_Localized: "\u0110\xF2n \u0110\xE1nh S\u1EAFc B\xE9n"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160387
    m_Localized: "Sinh L\u1EF1c Tr\xE0n Tr\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160388
    m_Localized: "Sinh L\u1EF1c Tu\xF4n Ch\u1EA3y"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160389
    m_Localized: "C\u01B0\u1EDDng H\xF3a C\u01A1 Th\u1EC3"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160390
    m_Localized: "Th\xE2n Nh\u1EB9"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160391
    m_Localized: "S\u1EE9c M\u1EA1nh C\xF4 \u0110\u1ECDng"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160392
    m_Localized: "Qu\xE1 T\u1EA3i"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160393
    m_Localized: "H\u01A1i Th\u1EDF C\u1EE7a Gi\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160394
    m_Localized: "H\xF3a Th\xFA"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160395
    m_Localized: "Kh\xED Th\u1EBF T\u01B0\u1EDDng S\u1EAFt"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160396
    m_Localized: "T\xEAn qu\xE1i v\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160464
    m_Localized: "Th\xF4ng tin k\u1EF9 n\u0103ng qu\xE1i v\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160513
    m_Localized: "T\u1EA5n c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160514
    m_Localized: "Ph\xF2ng th\u1EE7"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160515
    m_Localized: "T\u1ED1c \u0111\u1ED9 t\u1EA5n c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160516
    m_Localized: HP
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160517
    m_Localized: "K\u1EF9 n\u0103ng ch\u1EE7 \u0111\u1ED9ng"
    m_Metadata:
      m_Items: []

  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: LocalizationTable_vi
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 4ccbdbf1878cce04a8441eeb10934d6b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 51780677632
    m_Localized: "Gi\xE1c Quan S\u1EAFc B\xE9n"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160463
    m_Localized: "C\u1EDD c\u1EE7a Ch\u1EC9 Huy"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160462
    m_Localized: "C\u01B0\u1EDDng H\xF3a T\u01B0\u1EDDng Th\xE0nh"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160461
    m_Localized: "S\u1EEDa T\u01B0\u1EDDng Th\xE0nh"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160460
    m_Localized: "S\u1ED5 Tay Chi\u1EBFn Thu\u1EADt (Tr\u1ECB Li\u1EC7u S\u01B0)"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160459
    m_Localized: "Ma Thu\u1EADt L\xE1 Ch\u1EAFn"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160458
    m_Localized: "B\u1ED9 Khu\u1EBFch \u0110\u1EA1i H\u1ED3i Ph\u1EE5c"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160457
    m_Localized: "S\u1ED5 Tay Chi\u1EBFn Thu\u1EADt (Ph\xE1p S\u01B0)"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160456
    m_Localized: "Ma Thu\u1EADt \u0110\u1ED9ng \u0110\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160455
    m_Localized: "Ma Thu\u1EADt M\u1EDF R\u1ED9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160454
    m_Localized: "S\u1ED5 Tay Chi\u1EBFn Thu\u1EADt (Cung Th\u1EE7)"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160453
    m_Localized: "M\u01B0a T\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160452
    m_Localized: "Cung Ma Thu\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160451
    m_Localized: "S\u1ED5 Tay Chi\u1EBFn Thu\u1EADt (Chi\u1EBFn Binh)"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160450
    m_Localized: "Y\u1EBFu T\u1ED1 H\u1ED3i Ph\u1EE5c"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160449
    m_Localized: "\xC1o Gi\xE1p C\u1ED5 \u0110\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160445
    m_Localized: Serah
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160446
    m_Localized: Noah
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160447
    m_Localized: Alice
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160448
    m_Localized: Spayne
    m_Metadata:
      m_Items: []
  - m_Id: 863262176796672
    m_Localized: "L\u1EDDi d\u1EABn"
    m_Metadata:
      m_Items: []
  - m_Id: 863262227128320
    m_Localized: "L\xEDnh g\xE1c ph\xE1o \u0111\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 863262227128321
    m_Localized: Demian
    m_Metadata:
      m_Items: []
  - m_Id: 863262227128322
    m_Localized: "Ch\u1EC9 huy"
    m_Metadata:
      m_Items: []
  - m_Id: 863262227128323
    m_Localized: "H\u1EC7 th\u1ED1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322624
    m_Localized: "Tr\u01B0\u1EDBc c\u1ED5ng ph\xE1o \u0111\xE0i ph\xF2ng th\u1EE7
      Cies."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322625
    m_Localized: "\u0110\xE2y l\xE0 ph\xE1o \u0111\xE0i ph\xF2ng th\u1EE7 Cies sao?
      Nghe n\xF3i h\u1EA7u nh\u01B0 kh\xF4ng c\xF3 qu\xE1i v\u1EADt xu\u1EA5t hi\u1EC7n
      \u1EDF \u0111\xE2y, qu\u1EA3 th\u1EADt y\xEAn t\u0129nh."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322626
    m_Localized: "Ng\xE0i Ch\u1EC9 huy v\xE0 c\xE1c H\u1ED9 V\u1EC7 ph\u1EA3i kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322627
    m_Localized: "Ch\xE0o m\u1EEBng \u0111\u1EBFn v\u1EDBi ph\xE1o \u0111\xE0i ph\xF2ng
      th\u1EE7 Cies."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322628
    m_Localized: "C\u1EA3m \u01A1n v\xEC \u0111\xE3 ch\xE0o \u0111\xF3n. Xin l\u1ED7i
      v\xEC v\u1EEBa \u0111\u1EBFn \u0111\xE3 h\u1ECFi c\xF4ng vi\u1EC7c, nh\u01B0ng
      c\xF3 th\u1EC3 d\u1EABn \u0111\u01B0\u1EDDng cho ch\xFAng t\xF4i kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322629
    m_Localized: "\u0110\xE2y l\xE0 Serah, c\xF2n \u0111\xE2y l\xE0 Noah."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322630
    m_Localized: "R\u1EA5t vui \u0111\u01B0\u1EE3c g\u1EB7p! T\xF4i l\xE0 Serah,
      ph\u1EE5 tr\xE1ch ti\u1EC1n tuy\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322631
    m_Localized: "T\xF4i l\xE0 Noah. T\xF4i s\u1EBD quan s\xE1t chuy\u1EC3n \u0111\u1ED9ng
      t\u1EEB xa."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322632
    m_Localized: "C\xF2n \u0111\xE2y l\xE0 Alice v\xE0 Spayne."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322633
    m_Localized: "T\xF4i l\xE0 Alice. T\xF4i ph\u1EE5 tr\xE1ch ki\u1EC3m tra \u0111\xE1
      t\xEDn hi\u1EC7u v\xE0 h\u1ED7 tr\u1EE3 ph\xE9p thu\u1EADt."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322634
    m_Localized: "T\xF4i l\xE0 Spayne. T\xF4i ph\u1EE5 tr\xE1ch h\u1ED3i ph\u1EE5c.
      B\u1ECB th\u01B0\u01A1ng th\xEC b\xE1o ngay nh\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322635
    m_Localized: "T\xF4i l\xE0 Demian, \u0111\u1ED9i tr\u01B0\u1EDFng \u0111\u1ED9i
      l\xEDnh b\u1EA3o v\u1EC7 ph\xE1o \u0111\xE0i Cies."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322636
    m_Localized: "R\u1EA5t mong \u0111\u01B0\u1EE3c h\u1EE3p t\xE1c, Demian. Tr\u01B0\u1EDBc
      khi \u0111\u1EBFn, ch\xFAng t\xF4i \u0111\xE3 nh\u1EADn \u0111\u01B0\u1EE3c
      th\xF4ng tin v\u1EC1 nh\u1EEFng n\u01A1i c\u1EA7n ki\u1EC3m tra."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322637
    m_Localized: "Serah, ki\u1EC3m tra ch\u1ED1t ki\u1EC3m so\xE1t c\u1ED5ng. Noah,
      quan s\xE1t \u0111\u01B0\u1EDDng r\u1EEBng t\u1EEB th\xE1p canh."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322638
    m_Localized: "Alice ki\u1EC3m tra c\xE1c \u0111\xE1 t\xEDn hi\u1EC7u, c\xF2n
      Spayne, c\u1EADu ki\u1EC3m tra kho v\u1EADt t\u01B0 nh\xE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322639
    m_Localized: "Demian, c\u1EADu c\xF3 th\u1EC3 b\u1ED1 tr\xED ng\u01B0\u1EDDi
      d\u1EABn \u0111\u01B0\u1EDDng cho c\u1EA3 b\u1ED1n ng\u01B0\u1EDDi h\u1ECD
      kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322640
    m_Localized: "\u0110\xE3 r\xF5. T\xF4i s\u1EBD l\u1EADp t\u1EE9c b\u1ED1 tr\xED
      ng\u01B0\u1EDDi h\u1ED9 t\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322641
    m_Localized: "\u0110\u01B0\u1EE3c! T\xF4i s\u1EBD ki\u1EC3m tra khu v\u1EF1c
      c\u1ED5ng tr\u01B0\u1EDBc. C\xF3 chuy\u1EC7n g\xEC t\xF4i s\u1EBD b\xE1o ngay!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322642
    m_Localized: "\u0110i tr\u01B0\u1EDBc th\xEC \u0111\u01B0\u1EE3c, nh\u01B0ng
      \u0111\u1EEBng t\u1EF1 \xFD \u0111i qu\xE1 xa nh\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322643
    m_Localized: "T\xF4i s\u1EBD ki\u1EC3m tra \u0111\xE1 t\xEDn hi\u1EC7u tr\u01B0\u1EDBc.
      Xong vi\u1EC7c t\xF4i s\u1EBD sang ki\u1EC3m tra khu v\u1EF1c c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322644
    m_Localized: "Kho v\u1EADt t\u01B0 b\xEAn trong c\u1ED5ng sao... Kh\xF4ng ph\u1EA3i
      l\xE0 n\u01A1i xa nh\u1EA5t t\u1EEB \u0111\xE2y \xE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322645
    m_Localized: "Serah, hay l\xE0 \u0111\u1ED5i v\u1ECB tr\xED v\u1EDBi t\xF4i...?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322646
    m_Localized: "Xin l\u1ED7i. T\xF4i s\u1EBD lo khu v\u1EF1c c\u1ED5ng. Ch\u1EB7n
      \u1EDF ph\xEDa tr\u01B0\u1EDBc l\xE0 vi\u1EC7c c\u1EE7a t\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322647
    m_Localized: "T\xF4i mu\u1ED1n ph\u1EA3n b\xE1c l\u1EAFm... nh\u01B0ng c\u1EADu
      n\xF3i \u0111\xFAng n\xEAn l\u1EA1i c\xE0ng kh\xF4ng mu\u1ED1n \u0111i..."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322648
    m_Localized: "B\xE1o c\xE1o! M\u1ED9t nh\xF3m l\u1EDBn qu\xE1i v\u1EADt \u0111ang
      ti\u1EBFn v\u1EC1 ph\xEDa c\u1ED5ng t\u1EEB h\u01B0\u1EDBng r\u1EEBng!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322649
    m_Localized: "Serah... c\u1EADu n\xF3i l\xE0 n\u01A1i n\xE0y y\xEAn t\u0129nh
      m\xE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322650
    m_Localized: "\u0110\xFAng v\u1EADy! V\u1EADy th\xEC c\u1EE9 l\xE0m cho n\xF3
      y\xEAn t\u0129nh tr\u1EDF l\u1EA1i l\xE0 \u0111\u01B0\u1EE3c!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322651
    m_Localized: "C\xF4 \u1EA5y n\xF3i kh\xF4ng sai, nh\u01B0ng sao nghe \u0111\xE1ng
      lo th\u1EBF nh\u1EC9?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322652
    m_Localized: "Noah, ti\u1EBFp t\u1EE5c quan s\xE1t \u0111\u01B0\u1EDDng r\u1EEBng
      t\u1EEB th\xE1p canh nh\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322653
    m_Localized: "Spayne, l\u1EA5y v\u1EADt d\u1EE5ng s\u01A1 c\u1EE9u t\u1EEB kho
      v\u1EADt t\u01B0 nh\xE9. C\u1EA3 hai h\xE3y nh\u1EADp \u0111\u1ED9i \u1EDF
      c\u1ED5ng ngay khi chu\u1EA9n b\u1ECB xong."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322654
    m_Localized: "\u1EEA, t\xF4i ki\u1EC3m tra xong s\u1EBD \u0111\u1EBFn ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322655
    m_Localized: "H\u1EEB... \u0110i m\xE3i m\u1EDBi \u0111\u1EBFn \u0111\u01B0\u1EE3c
      n\u01A1i xa nh\u1EA5t, v\u1EADy m\xE0 gi\u1EDD l\u1EA1i ph\u1EA3i quay v\u1EC1
      ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322656
    m_Localized: "Serah v\xE0 Alice, ch\u1EB7n qu\xE1i v\u1EADt tr\u01B0\u1EDBc \u1EDF
      ch\u1ED1t ki\u1EC3m so\xE1t c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322657
    m_Localized: "\u0110\u01B0\u1EE3c! T\xF4i s\u1EBD lo ph\xEDa tr\u01B0\u1EDBc
      c\u1ED5ng. Nh\u1EA5t \u0111\u1ECBnh kh\xF4ng \u0111\u1EC3 ch\xFAng v\u01B0\u1EE3t
      qua!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322658
    m_Localized: "C\xF3 c\u1EADu th\xEC y\xEAn t\xE2m th\u1EADt, nh\u01B0ng h\xE3y
      ch\u1EDD t\xEDn hi\u1EC7u r\u1ED3i di chuy\u1EC3n. T\xF4i s\u1EBD x\u1EED l\xFD
      ph\xEDa ch\xFAng d\u1ED3n v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322659
    m_Localized: "R\xF5 r\u1ED3i. C\xF3 t\xEDn hi\u1EC7u l\xE0 t\xF4i s\u1EBD ra
      ngay!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322660
    m_Localized: "Nh\xF3m qu\xE1i v\u1EADt \u0111\xE3 ti\u1EBFn \u0111\u1EBFn tr\u01B0\u1EDBc
      c\u1ED5ng! Ch\u1EC9 huy, xin h\xE3y chu\u1EA9n b\u1ECB c\xE1c \u0111\xE1 t\xEDn
      hi\u1EC7u!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322661
    m_Localized: "T\xF4i s\u1EBD g\u1EEDi t\xEDn hi\u1EC7u cho Serah v\xE0 Alice
      tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322662
    m_Localized: "\u0110\xE3 x\xE1c nh\u1EADn k\u1EBFt n\u1ED1i t\xEDn hi\u1EC7u.
      Serah, s\u1EB5n s\xE0ng ch\u01B0a?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322663
    m_Localized: "\u0110\u01B0\u1EE3c, t\xF4i l\xEAn \u0111\xE2y!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322664
    m_Localized: "Ch\xFAng b\u1EAFt \u0111\u1EA7u tr\xE0n t\u1EDBi r\u1ED3i! T\xF4i
      s\u1EBD ch\u1EB7n ph\xEDa tr\u01B0\u1EDBc!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322665
    m_Localized: "R\xF5 r\u1ED3i. T\xF4i s\u1EBD x\u1EED l\xFD ph\xEDa ch\xFAng \u0111ang
      d\u1ED3n v\xE0o tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322666
    m_Localized: "T\xF4i th\u1EA5y \u0111\u1EE3t th\u1EE9 hai. Gi\u1EDD t\xF4i s\u1EBD
      nh\u1EADp \u0111\u1ED9i. T\xF4i s\u1EBD quan s\xE1t chuy\u1EC3n \u0111\u1ED9ng
      \u1EDF ph\xEDa xa h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322667
    m_Localized: "\u0110\u01B0\u1EE3c! Noah lo k\u1EBB \u0111\u1ECBch \u1EDF xa,
      c\xF2n t\xF4i s\u1EBD ch\u1EB7n ph\xEDa tr\u01B0\u1EDBc!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322668
    m_Localized: "T\xF4i \u0111\xE3 ki\u1EC3m tra kh\xF3a kho v\u1EADt t\u01B0. C\u0169ng
      mang theo b\u0103ng g\u1EA1c r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322669
    m_Localized: "Gi\u1EDD ai b\u1ECB th\u01B0\u01A1ng t\xF4i c\u0169ng c\xF3 th\u1EC3
      ch\u1EEFa tr\u1ECB ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322670
    m_Localized: "T\xF4i th\u1EA5y m\u1ED9t con l\u1EDBn. Nh\xF3m n\xE0y \u0111ang
      di chuy\u1EC3n xoay quanh n\xF3!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322671
    m_Localized: "V\u1EADy th\xEC ch\u1EB7n con l\u1EDBn \u0111\xF3 tr\u01B0\u1EDBc.
      T\xF4i s\u1EBD \u0111\u1ED1i ph\xF3 v\u1EDBi n\xF3!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322672
    m_Localized: "Serah, khoan \u0111\xE3! N\u1EBFu k\xE9o d\xE0i, s\u1EBD c\xF3
      th\xEAm qu\xE1i v\u1EADt t\u1EADp trung l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322673
    m_Localized: "Ch\u1EC9 huy, h\xE3y g\u1EEDi t\xEDn hi\u1EC7u k\u1EF9 n\u0103ng
      cho Serah!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322674
    m_Localized: "\u0110\xE2y l\xE0 t\xEDn hi\u1EC7u tuy\u1EC7t k\u1EF9! N\xF3 s\u1EBD
      d\xF9ng to\xE0n b\u1ED9 thanh n\u0103ng l\u01B0\u1EE3ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322675
    m_Localized: "\u0110\xE3 nh\u1EADn t\xEDn hi\u1EC7u! T\xF4i s\u1EBD tung m\u1ED9t
      \u0111\xF2n th\u1EADt m\u1EA1nh!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322676
    m_Localized: "C\xF3 ai b\u1ECB th\u01B0\u01A1ng kh\xF4ng? \u0110\u1EEBng c\u1ED1
      qu\xE1, h\xE3y b\xE1o ngay nh\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322677
    m_Localized: "T\xF4i kh\xF4ng b\u1ECB th\u01B0\u01A1ng! T\u01B0\u1EDDng ph\xF2ng
      th\u1EE7 c\u1ED5ng h\u01A1i b\u1ECB tr\u1EA7y, nh\u01B0ng... ch\u1EAFc kh\xF4ng
      sao \u0111\xE2u nh\u1EC9?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322678
    m_Localized: "Kh\xF4ng th\u1EC3 ch\u1EC9 k\u1EBFt th\xFAc b\u1EB1ng c\xE2u \"ch\u1EAFc
      kh\xF4ng sao \u0111\xE2u\"."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322679
    m_Localized: "Nh\u01B0ng d\xF9 v\u1EADy, c\u1EADu \u0111\xE3 l\xE0m r\u1EA5t
      t\u1ED1t khi ch\u1EB7n ch\xFAng tr\u01B0\u1EDBc c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322680
    m_Localized: "Ki\u1EC3m tra t\u01B0\u1EDDng ph\xF2ng th\u1EE7 ngay b\xE2y gi\u1EDD
      lu\xF4n. \u0110\u1EC3 sau s\u1EEDa s\u1EBD phi\u1EC1n h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322681
    m_Localized: "Nh\u01B0ng h\u01A1i l\u1EA1. C\u1EA3 nh\xF3m qu\xE1i v\u1EADt l\xFAc
      n\xE3y \u0111\u1EC1u \u0111i xu\u1ED1ng t\u1EEB \u0111\u01B0\u1EDDng r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322682
    m_Localized: "T\xF4i c\u0169ng th\u1EA5y t\u1EEB th\xE1p canh, chuy\u1EC3n \u0111\u1ED9ng
      s\xE2u trong \u0111\u01B0\u1EDDng r\u1EEBng d\u01B0\u1EDDng nh\u01B0 v\u1EABn
      ch\u01B0a k\u1EBFt th\xFAc."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322683
    m_Localized: "V\u1EADy ph\u1EA3i ki\u1EC3m tra l\u1EA1i ph\xEDa \u0111\u01B0\u1EDDng
      r\u1EEBng r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322684
    m_Localized: "Cies v\u1ED1n kh\xF4ng ph\u1EA3i n\u01A1i qu\xE1i v\u1EADt th\u01B0\u1EDDng
      d\u1ED3n \u0111\u1EBFn nh\u01B0 th\u1EBF n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322685
    m_Localized: "Nghe n\xF3i \u0111\xE2y l\xE0 n\u01A1i l\xE0m vi\u1EC7c y\xEAn
      t\u0129nh, l\u1EDDi \u0111\u1ED3n ho\xE0n to\xE0n sai r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322686
    m_Localized: "Serah l\xE0 ng\u01B0\u1EDDi \u0111\u1EA7u ti\xEAn n\xF3i v\u1EDBi
      ch\xFAng t\xF4i tin \u0111\u1ED3n \u0111\xF3 m\xE0."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322687
    m_Localized: "V\u1EADy t\xF4i s\u1EBD t\u1EF1 m\xECnh ki\u1EC3m tra v\xE0 \u0111\xEDnh
      ch\xEDnh l\u1EA1i!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322688
    m_Localized: "Khoan \u0111\xE3, t\xF4i th\u1EA5y g\xEC \u0111\xF3 tr\u01B0\u1EDBc
      c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322689
    m_Localized: "C\xF3 th\u1EE9 g\xEC \u0111\xF3 ph\xE1t s\xE1ng \u1EDF n\u01A1i
      qu\xE1i v\u1EADt \u0111\xE3 \u0111i qua."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322690
    m_Localized: "\u0110\xFAng th\u1EADt. Tr\xF4ng kh\xF4ng gi\u1ED1ng m\u1ED9t t\u1EA3ng
      \u0111\xE1 b\xECnh th\u01B0\u1EDDng nh\u1EC9?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322691
    m_Localized: "N\u1EBFu t\xF9y ti\u1EC7n ch\u1EA1m v\xE0o, m\u1ECDi chuy\u1EC7n
      c\xF3 th\u1EC3 ph\u1EE9c t\u1EA1p h\u01A1n. H\xE3y ki\u1EC3m tra tr\u01B0\u1EDBc
      \u0111\xE3..."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322692
    m_Localized: "Alice, c\u1EADu xem gi\xFAp \u0111\u01B0\u1EE3c kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322693
    m_Localized: "\u1EEA. C\xF3 v\u1EBB kh\xF4ng c\xF3 ph\u1EA3n \u1EE9ng nguy hi\u1EC3m."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322694
    m_Localized: "Ph\u1EA3n \u1EE9ng gi\u1ED1ng \u0111\xE1 t\xEDn hi\u1EC7u, nh\u01B0ng
      h\u01A1i kh\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711232
    m_Localized: "\u0110\xE2y l\xE0 di v\u1EADt."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711233
    m_Localized: "V\u1EADy ph\u1EA3i l\u1EF1a ch\u1ECDn c\u1EA9n th\u1EADn r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711234
    m_Localized: "V\u1EADy h\xE3y ch\u1ECDn th\u1EE9 gi\xFAp Serah tr\u1EE5 \u1EDF
      ph\xEDa tr\u01B0\u1EDBc l\xE2u h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711235
    m_Localized: "\u0110\u01B0\u1EDDng r\u1EEBng c\xF3 t\u1EA7m nh\xECn h\u1EA1n
      ch\u1EBF. N\u1EBFu Serah tr\u1EE5 \u1EDF ph\xEDa tr\u01B0\u1EDBc, m\u1ECDi
      ng\u01B0\u1EDDi s\u1EBD d\u1EC5 di chuy\u1EC3n h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711236
    m_Localized: "\u0110\xE3 ch\u1ECDn. Hi\u1EC7u \u1EE9ng n\xE0y s\u1EBD ti\u1EBFp
      t\u1EE5c c\xF3 hi\u1EC7u l\u1EF1c v\u1EC1 sau."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711237
    m_Localized: "Tr\u01B0\u1EDBc h\u1EBFt h\xE3y ki\u1EC3m tra \u0111\u01B0\u1EDDng
      r\u1EEBng. Noah, xem d\u1EA5u v\u1EBFt d\u1EABn v\u1EC1 h\u01B0\u1EDBng n\xE0o
      nh\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711238
    m_Localized: "\u1EEA. D\u1EA5u v\u1EBFt v\u1EABn c\xF2n. T\xF4i s\u1EBD xem ch\xFAng
      d\u1EABn \u0111\u1EBFn \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711239
    m_Localized: "T\xF4i s\u1EBD ki\u1EC3m tra l\u1EA1i t\xECnh tr\u1EA1ng \u0111\xE1
      t\xEDn hi\u1EC7u. Ph\u1EA3i \u0111i\u1EC1u ch\u1EC9nh xong tr\u01B0\u1EDBc
      khi nh\xF3m ti\u1EBFp theo \u0111\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711240
    m_Localized: "\u0110\u01B0\u1EE3c! H\xE3y t\xECm nguy\xEAn nh\xE2n v\xE0 l\xE0m
      cho Cies y\xEAn t\u0129nh tr\u1EDF l\u1EA1i!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711241
    m_Localized: "V\u1EADy... ch\xFAng ta ph\u1EA3i \u0111i ngay sao? Kh\xF4ng c\u1EA7n
      \u0111i qu\xE1 xa \u0111\xE2u nh\u1EC9...?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711242
    m_Localized: "H\xE3y n\xF3i r\u1EB1ng ch\xFAng ta kh\xF4ng c\u1EA7n \u0111i..."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711243
    m_Localized: "Tr\u01B0\u1EDBc c\u1ED5ng ph\xE1o \u0111\xE0i ph\xF2ng th\u1EE7
      Cies."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711244
    m_Localized: "Ch\u1EC9 huy, c\xE1c H\u1ED9 V\u1EC7."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711245
    m_Localized: "T\xF4i s\u1EBD t\u1ED5ng h\u1EE3p h\u1ED3 s\u01A1 ph\xF2ng th\u1EE7
      tr\u01B0\u1EDBc c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711246
    m_Localized: "C\u1EA3m \u01A1n, Demian."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711247
    m_Localized: "H\xE3y ki\u1EC3m tra t\xECnh tr\u1EA1ng tr\u01B0\u1EDBc khi ra
      \u0111\u01B0\u1EDDng r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711248
    m_Localized: "\u1EEA. C\xF3 v\u1EBB kh\xF4ng ai b\u1ECB th\u01B0\u01A1ng n\u1EB7ng."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711249
    m_Localized: "Kh\xF4ng c\xF3 ai b\u1ECB th\u01B0\u01A1ng n\u1EB7ng l\xE0 \u0111i\u1EC1u
      t\u1ED1t."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711250
    m_Localized: "N\u1EBFu th\u1EDDi gian ch\u1EEFa tr\u1ECB k\xE9o d\xE0i th\xEC
      m\u1ECDi ng\u01B0\u1EDDi s\u1EBD c\xF9ng m\u1EC7t..."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711251
    m_Localized: "N\u1EBFu vi\u1EC7c ch\u1EEFa tr\u1ECB k\xE9o d\xE0i, Spayne s\u1EBD
      l\xE0 ng\u01B0\u1EDDi v\u1EA5t v\u1EA3 nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711252
    m_Localized: "D\xF9 v\u1EADy, m\u1ECDi ng\u01B0\u1EDDi v\u1EABn an to\xE0n l\xE0
      \u0111\u01B0\u1EE3c r\u1ED3i!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711253
    m_Localized: "Ch\u1EC9 c\u1EA7n ch\u1EB7n \u0111\u1EE3t ti\u1EBFp theo v\u1EDBi
      kh\xED th\u1EBF n\xE0y l\xE0 \u0111\u01B0\u1EE3c!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711254
    m_Localized: "Tr\u01B0\u1EDBc khi ch\u1EC9 d\u1EF1a v\xE0o kh\xED th\u1EBF, h\xE3y
      ki\u1EC3m tra \u0111\xE1 t\xEDn hi\u1EC7u tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711255
    m_Localized: "T\xF4i \u0111\xE3 xem h\u1ED3 s\u01A1 tr\u1EADn chi\u1EBFn \u0111\u1EA7u
      ti\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711256
    m_Localized: "T\xEDn hi\u1EC7u do Ch\u1EC9 huy g\u1EEDi v\u1EABn \u1ED5n \u0111\u1ECBnh."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711257
    m_Localized: "Ch\xFAng ta c\xF3 th\u1EC3 duy tr\xEC hi\u1EC7u \u1EE9ng \u0111\xF3
      v\u1EC1 sau kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711258
    m_Localized: "C\xF3 th\u1EC3."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299390316544
    m_Localized: "C\xF3 th\u1EC3 t\u0103ng c\u01B0\u1EDDng t\xEDn hi\u1EC7u c\u1EE7a
      m\u1ED9t ng\u01B0\u1EDDi \u0111\u1EC3 tr\u1EADn chi\u1EBFn \u1ED5n \u0111\u1ECBnh
      h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065280
    m_Localized: "S\u1EBD t\u1ED1t h\u01A1n n\u1EBFu c\xF3 th\u1EC3 chu\u1EA9n b\u1ECB
      tr\u01B0\u1EDBc khi ra \u0111\u01B0\u1EDDng r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065281
    m_Localized: "T\u1EEB gi\u1EDD ch\u1EC9 c\u1EA7n ch\u1ECDn th\u1EE9 m\xECnh c\u1EA7n
      th\xF4i nh\u1EC9!"
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065282
    m_Localized: "T\xF4i c\u0169ng t\xE1n th\xE0nh n\u1EBFu n\xF3 gi\xFAp m\u1ECDi
      chuy\u1EC7n sau n\xE0y b\u1EDBt r\u1EAFc r\u1ED1i..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065283
    m_Localized: "Ch\u1EC9 huy, h\xE3y ch\u1ECDn h\u01B0\u1EDBng \u0111i\u1EC1u ch\u1EC9nh."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065284
    m_Localized: "\u0110\xE3 \u0111i\u1EC1u ch\u1EC9nh xong."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065285
    m_Localized: "Hi\u1EC7u \u1EE9ng c\u01B0\u1EDDng h\xF3a n\xE0y s\u1EBD ti\u1EBFp
      t\u1EE5c c\xF3 hi\u1EC7u l\u1EF1c t\u1EEB gi\u1EDD."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065286
    m_Localized: "Tuy\u1EC7t! Ch\u1ECDn ai c\u0169ng s\u1EBD c\xF3 \xEDch v\u1EC1
      sau!"
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065287
    m_Localized: "T\xF4i s\u1EBD ki\u1EC3m tra xem t\xEDn hi\u1EC7u \u0111\xE3 ch\u1ECDn
      c\xF3 truy\u1EC1n \u1ED5n \u0111\u1ECBnh kh\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065288
    m_Localized: "V\u1EADy l\xE0 chu\u1EA9n b\u1ECB xong r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065289
    m_Localized: "C\xF3 l\u1EBD n\xEAn \u0111i tr\u01B0\u1EDBc khi qu\xE1 mu\u1ED9n..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065290
    m_Localized: "V\u1EABn c\xF2n chuy\u1EC3n \u0111\u1ED9ng \u1EDF ph\xEDa \u0111\u01B0\u1EDDng
      r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065291
    m_Localized: "Xin h\xE3y c\u1EA9n th\u1EADn n\u1EBFu \u0111i qu\xE1 xa c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065292
    m_Localized: "\u0110\xE3 r\xF5. Ch\xFAng t\xF4i s\u1EBD kh\xF4ng \u0111i qu\xE1
      xa c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065293
    m_Localized: "M\u1ECDi ng\u01B0\u1EDDi s\u1EB5n s\xE0ng ch\u01B0a?"
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065294
    m_Localized: "\u1EEA! T\xF4i c\xF3 th\u1EC3 xu\u1EA5t ph\xE1t b\u1EA5t c\u1EE9
      l\xFAc n\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065295
    m_Localized: "\u1EEA. V\u1EEBa \u0111i v\u1EEBa ki\u1EC3m tra l\u1EA1i d\u1EA5u
      v\u1EBFt v\xE0 \xE2m thanh nh\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065296
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y l\u1EA7n l\u01B0\u1EE3t ki\u1EC3m tra
      t\u1EEB khu v\u1EF1c g\u1EA7n c\u1ED5ng nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065297
    m_Localized: "Ch\u1EC9 mong \u0111\xF3 kh\xF4ng ph\u1EA3i con \u0111\u01B0\u1EDDng
      m\u1EA5t c\u1EA3 \u0111\u1EDDi m\u1EDBi quay v\u1EC1 \u0111\u01B0\u1EE3c..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065298
    m_Localized: "L\u1ED1i v\xE0o \u0111\u01B0\u1EDDng r\u1EEBng tr\u01B0\u1EDBc
      c\u1ED5ng Cies."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065299
    m_Localized: "B\u1EAFt \u0111\u1EA7u ki\u1EC3m tra t\u1EEB \u0111\xE2y. Ch\xFAng
      ta s\u1EBD kh\xF4ng \u0111i qu\xE1 xa c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065300
    m_Localized: "\u1EEA. D\u1EA5u v\u1EBFt ch\xFAng ta th\u1EA5y tr\u01B0\u1EDBc
      c\u1ED5ng k\xE9o d\xE0i \u0111\u1EBFn t\u1EADn \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065301
    m_Localized: "Theo d\xF5i th\xEAm m\u1ED9t ch\xFAt, c\xF3 l\u1EBD s\u1EBD bi\u1EBFt
      ch\xFAng \u0111i xu\u1ED1ng t\u1EEB \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065302
    m_Localized: "\u0110\u01B0\u1EE3c. N\u1EBFu c\xF3 th\u1EE9 nguy hi\u1EC3m xu\u1EA5t
      hi\u1EC7n, t\xF4i s\u1EBD ch\u1EB7n ph\xEDa tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065303
    m_Localized: "\u0110\u01B0\u1EE3c. Tr\u01B0\u1EDBc h\u1EBFt h\xE3y xem d\u1EA5u
      v\u1EBFt."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065304
    m_Localized: "Tr\u01B0\u1EDBc ti\xEAn h\xE3y x\xE1c \u0111\u1ECBnh ch\xFAng \u0111i
      xu\u1ED1ng ph\xEDa c\u1ED5ng t\u1EEB \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065305
    m_Localized: "V\u1EADy t\xF4i s\u1EBD b\u1EAFt \u0111\u1EA7u \u0111\u1EC3 l\u1EA1i
      d\u1EA5u hi\u1EC7u t\u1EEB \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065306
    m_Localized: "N\u1EBFu l\u1EA1c \u0111\u01B0\u1EDDng \u1EDF \u0111\xE2y th\xEC
      c\u1EA3 th\u1EDDi gian ngh\u1EC9 c\u0169ng bi\u1EBFn m\u1EA5t..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065307
    m_Localized: "Chuy\u1EC7n \u0111\xF3 \u0111\xFAng l\xE0 th\u1EA3m h\u1ECDa!"
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065308
    m_Localized: "M\u1EA5t \u0111\u01B0\u1EDDng v\u1EC1 c\xF2n l\xE0 th\u1EA3m h\u1ECDa
      l\u1EDBn h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065309
    m_Localized: "C\u1EA3 hai \u0111\u1EC1u quan tr\u1ECDng m\xE0..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065310
    m_Localized: "C\xF3 l\u1EBD v\xEC l\xE0 \u0111\u01B0\u1EDDng r\u1EEBng n\xEAn
      kh\xF4ng kh\xED \u1EA9m nh\u1EC9."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065311
    m_Localized: "\u0110\u01B0\u1EDDng \u0111\u1EA5t m\u1EC1m, \xE1nh n\u1EAFng c\u0169ng
      \u0111\u01B0\u1EE3c che t\u1ED1t..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065312
    m_Localized: "N\u1EBFu c\u1EADu \u0111\u1ECBnh n\xF3i l\xE0 d\u1EC5 bu\u1ED3n
      ng\u1EE7 th\xEC c\u1ED1 ch\u1ECBu th\xEAm m\u1ED9t ch\xFAt nh\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065313
    m_Localized: "T\xF4i c\xF2n ch\u01B0a n\xF3i m\xE0..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065314
    m_Localized: "\u0110\xFAng. Nh\u01B0ng c\u1EADu v\u1EEBa n\xF3i \"ch\u01B0a\"
      m\xE0."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065315
    m_Localized: "Khoan \u0111\xE3. B\u1EE5i c\u1ECF b\xEAn \u0111\u01B0\u1EDDng
      b\u1ECB \xE9p theo m\u1ED9t h\u01B0\u1EDBng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065316
    m_Localized: "N\xF3 d\u1EABn v\u1EC1 h\u01B0\u1EDBng n\xE0o?"
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065317
    m_Localized: "D\u1EA5u ch\xE2n k\xE9o d\xE0i t\u1EEB s\xE2u trong r\u1EEBng v\u1EC1
      ph\xEDa c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065318
    m_Localized: "C\xF3 v\u1EBB s\u1ED1 l\u01B0\u1EE3ng kh\xE1 \u0111\xF4ng. D\u1EA5u
      ch\xE2n ch\u1ED3ng l\xEAn nhau kh\u1EAFp n\u01A1i."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065319
    m_Localized: "\u01AF..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065320
    m_Localized: Noah?
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065321
    m_Localized: "Xin l\u1ED7i. T\xF4i ch\u1EC9 h\u01A1i gi\u1EADt m\xECnh."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065322
    m_Localized: "\xC2m thanh v\u1EEBa r\u1ED3i c\u0169ng ph\xE1t ra t\u1EEB h\u01B0\u1EDBng
      \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065323
    m_Localized: "\u0110\u01B0\u1EE3c. N\u1EBFu c\xF3 g\xEC chuy\u1EC3n \u0111\u1ED9ng
      trong b\u1EE5i c\u1ECF, t\xF4i s\u1EBD ch\u1EB7n l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065324
    m_Localized: "Serah, \u0111\u1EEBng \u0111i qu\xE1 xa ph\xEDa tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065325
    m_Localized: "H\xE3y \u1EDF trong kho\u1EA3ng c\xE1ch Noah c\xF3 th\u1EC3 quan
      s\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065326
    m_Localized: "\u0110\u01B0\u1EE3c. T\xF4i s\u1EBD kh\xF4ng \u0111i qu\xE1 xa."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065327
    m_Localized: "\u1EEA... \u0110\xFAng nh\u01B0 t\xF4i ngh\u0129, \u0111\xE2y kh\xF4ng
      gi\u1ED1ng d\u1EA5u v\u1EBFt c\u1EE7a th\u1EE9 ch\u1EE7 \u0111\u1ED9ng nh\u1EAFm
      \u0111\u1EBFn c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065328
    m_Localized: "C\xF3 r\u1EA5t nhi\u1EC1u v\u1EBFt tr\u01B0\u1EE3t. H\u1EA7u nh\u01B0
      kh\xF4ng c\xF3 d\u1EA5u hi\u1EC7u d\u1EEBng l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065329
    m_Localized: "C\xF3 v\u1EBB qu\xE1i v\u1EADt \u0111\xE3 ch\u1EA1y xu\u1ED1ng
      t\u1EEB s\xE2u trong r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065330
    m_Localized: "V\u1EADy ngh\u0129a l\xE0 c\xF3 th\u1EE9 g\xEC \u0111\xF3 \u0111ang
      \u0111u\u1ED5i ch\xFAng t\u1EEB s\xE2u trong r\u1EEBng sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065331
    m_Localized: "Ch\u01B0a bi\u1EBFt. Nh\u01B0ng c\xF3 v\u1EBB ch\xFAng kh\xF4ng
      t\u1EF1 nguy\u1EC7n \u0111i v\u1EC1 h\u01B0\u1EDBng n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065332
    m_Localized: "Ch\xFAng kh\xF4ng di chuy\u1EC3n v\u1EDBi c\u1ED5ng l\xE0 m\u1EE5c
      ti\xEAu."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065333
    m_Localized: "C\xF3 l\u1EBD ch\xFAng \u0111\xE3 ch\u1EA1y xu\u1ED1ng \u0111\u1EC3
      tr\xE1nh th\u1EE9 g\xEC \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065334
    m_Localized: "Ch\u1EC9 huy, ti\u1EBFng b\u01B0\u1EDBc ch\xE2n qu\xE1i v\u1EADt
      \u0111ang \u0111\u1EBFn g\u1EA7n t\u1EEB s\xE2u trong r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065335
    m_Localized: "Ch\xFAng \u0111ang \u0111i xu\u1ED1ng theo \u0111\xFAng h\u01B0\u1EDBng
      d\u1EA5u v\u1EBFt k\xE9o d\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299428065336
    m_Localized: "N\u1EBFu l\xF9i l\u1EA1i l\xFAc n\xE0y, ch\xFAng c\xF3 th\u1EC3
      xu\u1ED1ng t\u1EADn tr\u01B0\u1EDBc c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453888
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n ch\xFAng \u1EDF \u0111\xE2y
      tr\u01B0\u1EDBc khi ch\xFAng \u0111\u1EBFn c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453889
    m_Localized: "R\xF5 r\u1ED3i! T\xF4i s\u1EBD ch\u1EB7n tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453890
    m_Localized: "\u0110\u01B0\u1EE3c. T\xF4i s\u1EBD x\u1EED l\xFD ph\xEDa ch\xFAng
      d\u1ED3n v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453891
    m_Localized: "\u01AF... T\xF4i kh\xF4ng th\xEDch chi\u1EBFn \u0111\u1EA5u tr\xEAn
      nh\u1EEFng con \u0111\u01B0\u1EDDng nh\u01B0 th\u1EBF n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453892
    m_Localized: "D\xF9 v\u1EADy, ch\u1EB7n \u1EDF \u0111\xE2y v\u1EABn t\u1ED1t
      h\u01A1n l\xF9i \u0111\u1EBFn t\u1EADn c\u1ED5ng..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453893
    m_Localized: "M\u1ECDi ng\u01B0\u1EDDi \u1ED5n ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453894
    m_Localized: "N\u1EBFu th\u1EA5y \u0111au \u1EDF \u0111\xE2u th\xEC b\xE1o ngay
      nh\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453895
    m_Localized: "C\u1EE9 im l\u1EB7ng ch\u1ECBu \u0111\u1EF1ng th\xEC s\u1EBD c\xE0ng
      \u0111au h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453896
    m_Localized: "V\u1EDBi c\u1EA3 t\xF4i s\u1EBD c\xF3 th\xEAm vi\u1EC7c..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453897
    m_Localized: "T\xF4i \u1ED5n! Kh\xF4ng b\u1ECB th\u01B0\u01A1ng \u1EDF \u0111\xE2u
      c\u1EA3!"
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453898
    m_Localized: "Ch\u1EB7n theo h\u01B0\u1EDBng Noah b\xE1o \u0111\xFAng l\xE0 d\u1EC5
      h\u01A1n h\u1EB3n."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453899
    m_Localized: "L\u1EA7n sau c\u0169ng nh\u1EDD c\u1EADu nh\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453900
    m_Localized: "\u1EEA. T\xF4i c\u0169ng s\u1EBD kh\xF4ng b\u1ECF s\xF3t \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453901
    m_Localized: "T\xF4i c\u0169ng \u1ED5n. Spayne th\xEC sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453902
    m_Localized: "\u1EEA, t\xF4i c\u0169ng v\u1EADy. Ch\u1EC9 l\xE0 \u0111\u01B0\u1EDDng
      r\u1EEBng h\u01A1i kh\xF3 ch\u1ECBu th\xF4i..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453903
    m_Localized: "May qu\xE1. V\u1EC1 c\u1ED5ng r\u1ED3i h\xE3y n\xF3i k\u1EF9 h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453904
    m_Localized: "B\xE2y gi\u1EDD \u01B0u ti\xEAn l\xE0 r\u1EDDi kh\u1ECFi \u0111\xE2y
      an to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453905
    m_Localized: "May l\xE0 m\u1ECDi ng\u01B0\u1EDDi \u0111\u1EC1u \u1ED5n."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453906
    m_Localized: "Sau n\xE0y h\xE3y ki\u1EC3m tra s\xE2u h\u01A1n, gi\u1EDD quay
      v\u1EC1 ph\xEDa c\u1ED5ng tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453907
    m_Localized: "\u1EEA. L\xE0m v\u1EADy \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453908
    m_Localized: "Spayne, nh\u1EEFng d\u1EA5u hi\u1EC7u l\xFAc n\xE3y c\xF2n nh\xECn
      th\u1EA5y kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453909
    m_Localized: "\u1EEA. T\xF4i v\u1EABn th\u1EA5y m\u1EA3nh v\u1EA3i \u0111\xE3
      \u0111\xE1nh d\u1EA5u, v\xE0 d\u1EA5u ch\xE2n ch\xFAng ta \u0111i qua v\u1EABn
      c\xF2n."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453910
    m_Localized: "Ch\u1EC9 huy, t\xF4i c\xF3 b\xE1o c\xE1o b\u1ED5 sung."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453911
    m_Localized: "Trinh s\xE1t \u0111\u01B0\u1EE3c c\u1EED \u0111i ki\u1EC3m tra
      l\u1ED1i v\xE0o ph\xEDa nam \u0111\xE3 tr\u1EDF v\u1EC1."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453912
    m_Localized: "H\u1ECD b\xE1o r\u1EB1ng c\u0169ng ph\xE1t hi\u1EC7n d\u1EA5u ch\xE2n
      t\u01B0\u01A1ng t\u1EF1 \u1EDF l\u1ED1i v\xE0o ph\xEDa nam."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453913
    m_Localized: "Ch\u1EC9 d\u1EF1a v\xE0o d\u1EA5u ch\xE2n th\xEC ch\u01B0a th\u1EC3
      k\u1EBFt lu\u1EADn, nh\u01B0ng n\u01A1i \u0111\xF3 c\xF3 v\u1EBB c\u1EA7n \u0111\u01B0\u1EE3c
      ki\u1EC3m tra."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453914
    m_Localized: "V\u1EADy \u0111\xE2y kh\xF4ng ch\u1EC9 l\xE0 v\u1EA5n \u0111\u1EC1
      c\u1EE7a \u0111\u01B0\u1EDDng r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453915
    m_Localized: "\u1EEA. C\xF3 th\u1EC3 \u0111\xF3 l\xE0 d\u1EA5u v\u1EBFt n\u1ED1i
      ti\u1EBFp d\u1EA5u ch\xE2n ch\xFAng ta \u0111\xE3 th\u1EA5y."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453916
    m_Localized: "\u0110\xE3 r\xF5. H\xE3y \u0111\u01B0a c\u1EA3 n\u1ED9i dung \u0111\xF3
      v\xE0o b\xE1o c\xE1o."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453917
    m_Localized: "Chu\u1EA9n b\u1ECB xong th\xEC \u0111i ki\u1EC3m tra l\u1ED1i v\xE0o
      ph\xEDa nam."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453918
    m_Localized: "L\u1ED1i v\xE0o ph\xEDa nam c\u1EE7a ph\xE1o \u0111\xE0i ph\xF2ng
      th\u1EE7 Cies."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453919
    m_Localized: "\u0110\xE2y l\xE0 l\u1ED1i v\xE0o ph\xEDa nam m\xE0 trinh s\xE1t
      n\xF3i sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453920
    m_Localized: "\u0110\xFAng v\u1ECB tr\xED r\u1ED3i. Con \u0111\u01B0\u1EDDng
      n\u1EB1m ngay b\xEAn d\u01B0\u1EDBi ph\xEDa nam c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453921
    m_Localized: "T\xF4i c\u0169ng th\u1EA5y d\u1EA5u ch\xE2n m\xE0 trinh s\xE1t
      nh\u1EAFc \u0111\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453922
    m_Localized: "\u0110\u1ED9 s\xE2u v\xE0 kho\u1EA3ng c\xE1ch gi\u1ED1ng v\u1EDBi
      d\u1EA5u v\u1EBFt ch\xFAng ta th\u1EA5y \u1EDF \u0111\u01B0\u1EDDng r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453923
    m_Localized: "V\u1EADy nh\xF3m \u0111i xu\u1ED1ng t\u1EEB \u0111\u01B0\u1EDDng
      r\u1EEBng c\u0169ng t\xE1ch sang ph\xEDa l\u1ED1i v\xE0o ph\xEDa nam."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453924
    m_Localized: "Con \u0111\u01B0\u1EDDng n\xE0y c\xF3 v\u1EBB kh\xF4ng th\xEDch
      h\u1EE3p \u0111\u1EC3 chuy\u1EC3n ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453925
    m_Localized: "N\u1EBFu \u0111i s\xE2u h\u01A1n, vi\u1EC7c \u1EE9ng ph\xF3 c\u0169ng
      s\u1EBD kh\xF3 kh\u0103n h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453926
    m_Localized: "\u0110\u1EEBng \u0111i qu\xE1 s\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453927
    m_Localized: "H\xE3y ki\u1EC3m tra l\u1ED1i v\xE0o, n\u1EBFu nguy hi\u1EC3m th\xEC
      ch\u1EB7n ch\xFAng ngay t\u1EA1i \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453928
    m_Localized: "R\xF5 r\u1ED3i. T\xF4i s\u1EBD quan s\xE1t ph\xEDa s\xE2u h\u01A1n
      c\u1EE7a l\u1ED1i v\xE0o ph\xEDa nam."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453929
    m_Localized: "D\u1EA5u ch\xE2n s\xE2u h\u01A1n t\u1EEB ch\u1ED7 n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453930
    m_Localized: "Ch\xFAng b\u1ECB \xE9p s\xE2u h\u01A1n nhi\u1EC1u so v\u1EDBi d\u1EA5u
      v\u1EBFt \u1EDF \u0111\u01B0\u1EDDng r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453931
    m_Localized: "C\xF3 v\u1EBB ch\xFAng \u0111\xE3 v\u1ED9i v\xE3 \u0111i xu\u1ED1ng
      m\xE0 kh\xF4ng c\xF3 th\u1EDDi gian quan s\xE1t xung quanh."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453932
    m_Localized: "V\u1EADy ph\u1EA3i ch\u1EB7n ch\xFAng tr\u01B0\u1EDBc khi \u0111\u1EBFn
      c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453933
    m_Localized: "\u1EEA. C\xF3 r\u1EA5t nhi\u1EC1u ch\u1ED7 d\u1EA5u ch\xE2n ch\u1ED3ng
      l\xEAn nhau."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299436453934
    m_Localized: "Ch\xFAng kh\xF4ng n\u1ED1i th\xE0nh m\u1ED9t h\xE0ng, c\xF2n c\xF3
      d\u1EA5u b\u1ECB l\u1EC7ch sang b\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648192
    m_Localized: "V\u1EADy qu\xE1i v\u1EADt kh\xF4ng ch\u1EC9 l\u01B0\u1EDBt qua
      l\u1ED1i v\xE0o ph\xEDa nam."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648193
    m_Localized: "N\u1EBFu b\u1ECB \u0111\u1EA9y l\xF9i tr\xEAn con \u0111\u01B0\u1EDDng
      nh\u01B0 th\u1EBF n\xE0y, vi\u1EC7c di chuy\u1EC3n ng\u01B0\u1EDDi b\u1ECB
      th\u01B0\u01A1ng s\u1EBD r\u1EA5t kh\xF3..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648194
    m_Localized: "V\u1EADy c\u1EE9 ch\u1EB7n ch\xFAng \u1EDF \u0111\xE2y tr\u01B0\u1EDBc
      khi b\u1ECB \u0111\u1EA9y l\xF9i l\xE0 \u0111\u01B0\u1EE3c, \u0111\xFAng kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648195
    m_Localized: "N\xF3i th\xEC d\u1EC5..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648196
    m_Localized: "Khoan \u0111\xE3. C\xF3 chuy\u1EC3n \u0111\u1ED9ng trong b\u1EE5i
      c\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648197
    m_Localized: "Ch\xFAng \u0111\u1EBFn t\u1EEB h\u01B0\u1EDBng n\xE0o?"
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648198
    m_Localized: "T\u1EEB s\xE2u trong l\u1ED1i v\xE0o ph\xEDa nam."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648199
    m_Localized: "Gi\u1ED1ng nh\u01B0 tr\xEAn \u0111\u01B0\u1EDDng r\u1EEBng, ch\xFAng
      \u0111ang b\u1ECB \u0111\u1EA9y xu\u1ED1ng t\u1EEB ph\xEDa s\xE2u h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648200
    m_Localized: "N\u1EBFu \u0111\u1EC3 l\u1ECDt \u1EDF \u0111\xE2y, s\u1ED1 ng\u01B0\u1EDDi
      b\u1ECB th\u01B0\u01A1ng \u1EDF ph\xEDa c\u1ED5ng s\u1EBD t\u0103ng th\xEAm..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648201
    m_Localized: "N\u1EBFu b\u1ECB \u0111\u1EA9y l\xF9i \u1EDF \u0111\xE2y, ch\xFAng
      s\u1EBD \u0111i th\u1EB3ng v\u1EC1 ph\xEDa c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648202
    m_Localized: "V\u1EADy t\xF4i s\u1EBD lo ph\xEDa tr\u01B0\u1EDBc l\u1ED1i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648203
    m_Localized: "Ch\u1EC9 huy, nh\xF3m qu\xE1i v\u1EADt s\u1EAFp xu\u1EA5t hi\u1EC7n
      r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648204
    m_Localized: "Ch\xFAng \u0111ang \u0111i xu\u1ED1ng theo \u0111\u01B0\u1EDDng
      n\xE0y. Ch\u1EC9 c\u1EA7n ch\u1EB7n ph\xEDa tr\u01B0\u1EDBc l\u1ED1i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648205
    m_Localized: "\u0110\u01B0\u1EE3c. Ch\u1EB7n \u1EDF \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648206
    m_Localized: "N\u1EBFu Serah gi\u1EEF ph\xEDa tr\u01B0\u1EDBc, t\xF4i s\u1EBD
      x\u1EED l\xFD ph\xEDa ch\xFAng d\u1ED3n v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648207
    m_Localized: "Ph\xEDa sau nh\u1EDD c\u1EADu nh\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648208
    m_Localized: "H\xE3y c\u1ED1 gi\u1EA3m thi\u1EC3u th\u01B0\u01A1ng t\xEDch..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648209
    m_Localized: "T\xF4i s\u1EBD ti\u1EBFp t\u1EE5c quan s\xE1t. N\u1EBFu c\u1EADu
      \u0111i qu\xE1 xa t\xF4i s\u1EBD b\xE1o ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648210
    m_Localized: "M\u1ECDi ng\u01B0\u1EDDi \u1ED5n ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648211
    m_Localized: "C\xF3 ai b\u1ECB th\u01B0\u01A1ng kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648212
    m_Localized: "T\xF4i \u1ED5n! Kh\xF4ng b\u1ECB th\u01B0\u01A1ng \u1EDF \u0111\xE2u
      c\u1EA3!"
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648213
    m_Localized: "Ch\u1EB7n ch\xFAng tr\xEAn con \u0111\u01B0\u1EDDng h\u1EB9p c\u0169ng
      kh\xF4ng t\u1EC7 nh\u01B0 t\xF4i ngh\u0129."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648214
    m_Localized: "T\xF4i c\u0169ng \u1ED5n."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648215
    m_Localized: "C\u1EADu bi\u1EBFt v\u1EEBa r\u1ED3i nguy hi\u1EC3m l\u1EAFm ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648216
    m_Localized: "Nh\u01B0ng ch\xFAng ta \u0111\xE3 ch\u1EB7n kh\xF4ng cho ch\xFAng
      \u0111\u1EBFn c\u1ED5ng r\u1ED3i m\xE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648217
    m_Localized: "\u0110\xFAng l\xE0 v\u1EADy... nh\u01B0ng l\u1EA7n sau c\u1EA9n
      th\u1EADn h\u01A1n m\u1ED9t ch\xFAt nh\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648218
    m_Localized: "\u1EEA, t\xF4i c\u0169ng v\u1EADy... May l\xE0 kh\xF4ng ai b\u1ECB
      th\u01B0\u01A1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648219
    m_Localized: "T\xF4i kh\xF4ng mu\u1ED1n \u1EDF \u0111\xE2y l\xE2u \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648220
    m_Localized: "Khoan \u0111\xE3. D\u1EA5u ch\xE2n v\u1EABn ch\u01B0a d\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648221
    m_Localized: "D\u1EA5u ch\xE2n \u1EDF l\u1ED1i v\xE0o ph\xEDa nam c\u0169ng k\xE9o
      d\xE0i v\u1EC1 ph\xEDa t\u01B0\u1EDDng ph\xF2ng th\u1EE7 c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648222
    m_Localized: "V\u1EADy d\u1EA5u v\u1EBFt t\u1EEB hai con \u0111\u01B0\u1EDDng
      h\u1ED9i t\u1EE5 tr\u01B0\u1EDBc t\u01B0\u1EDDng ph\xF2ng th\u1EE7 c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648223
    m_Localized: "\u1EEA. Ch\xFAng ta c\u0169ng ph\u1EA3i ki\u1EC3m tra ph\xEDa tr\u01B0\u1EDBc
      t\u01B0\u1EDDng ph\xF2ng th\u1EE7 c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648224
    m_Localized: "\u0110\u01B0\u1EE3c. L\u1EA7n sau h\xE3y \u0111i theo h\u01B0\u1EDBng
      Noah \u0111\xE3 ki\u1EC3m tra tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648225
    m_Localized: "\u1EEA. T\xF4i s\u1EBD ti\u1EBFp t\u1EE5c theo d\xF5i n\u01A1i
      d\u1EA5u ch\xE2n d\u1EABn \u0111\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648226
    m_Localized: "Ch\xFAng ta ph\u1ED1i h\u1EE3p t\u1ED1t h\u01A1n l\xE0 \u0111i\u1EC1u
      \u0111\xE1ng m\u1EEBng, nh\u01B0ng..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648227
    m_Localized: "Sao c\xE0ng nh\u01B0 v\u1EADy th\xEC th\u1EDDi gian ngh\u1EC9 c\xE0ng
      xa th\u1EBF..."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648228
    m_Localized: "\u0110\u1EBFn \u0111\xE2y l\xE0 \u0111\u1EE7 cho vi\u1EC7c ki\u1EC3m
      tra l\u1ED1i v\xE0o ph\xEDa nam."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648229
    m_Localized: "H\xE3y quay l\u1EA1i tr\u01B0\u1EDBc t\u01B0\u1EDDng ph\xF2ng th\u1EE7
      c\u1ED5ng v\xE0 ki\u1EC3m tra t\xECnh tr\u1EA1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1035299440648230
    m_Localized: "Tr\u01B0\u1EDBc t\u01B0\u1EDDng ph\xF2ng th\u1EE7 c\u1ED5ng c\u1EE7a
      ph\xE1o \u0111\xE0i ph\xF2ng th\u1EE7 Cies."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901911920640
    m_Localized: "C\xE1c H\u1ED9 V\u1EC7, m\u1ECDi ng\u01B0\u1EDDi v\u1EABn an to\xE0n
      ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669376
    m_Localized: "\u1EEA. Ch\xFAng t\xF4i c\u0169ng \u0111\xE3 ki\u1EC3m tra l\u1ED1i
      v\xE0o ph\xEDa nam."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669377
    m_Localized: "D\u1EA5u v\u1EBFt t\u1EEB l\u1ED1i v\xE0o ph\xEDa nam g\u1EB7p
      d\u1EA5u v\u1EBFt t\u1EEB \u0111\u01B0\u1EDDng r\u1EEBng \u1EDF \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669378
    m_Localized: "\u0110\xFAng v\u1EADy. D\u1EA5u v\u1EBFt t\u1EADp trung tr\u01B0\u1EDBc
      b\u1EE9c t\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669379
    m_Localized: "C\xF3 d\u1EA5u hi\u1EC7u qu\xE1i v\u1EADt \u0111\xE3 d\u1EEBng
      l\u1EA1i kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669380
    m_Localized: "\u1EEA. V\u1EBFt tr\u01B0\u1EE3t nhi\u1EC1u h\u01A1n d\u1EA5u hi\u1EC7u
      d\u1EEBng l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669381
    m_Localized: "V\u1EADy d\u1EA5u v\u1EBFt c\u1EE7a ch\xFAng b\u1ECB \u0111\u1EA9y
      xu\u1ED1ng \u0111\xE2y \u0111\xE3 d\u1ED3n l\u1EA1i t\u1EADn tr\u01B0\u1EDBc
      t\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669382
    m_Localized: "V\u1EADy n\u1EBFu b\u1ECB \u0111\u1EA9y l\xF9i \u1EDF \u0111\xE2y,
      ch\xFAng ta s\u1EBD b\u1ECB d\u1ED3n th\u1EB3ng v\u1EC1 c\u1ED5ng..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669383
    m_Localized: "V\u1EADy ph\xEDa tr\u01B0\u1EDBc \u0111\u1EC3 t\xF4i lo."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669384
    m_Localized: "L\u1EA7n n\xE0y c\u1ED5ng \u1EDF ngay sau l\u01B0ng. \u0110\u1EEBng
      \u0111i qu\xE1 xa."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669385
    m_Localized: "\u0110\xE3 r\xF5. T\xF4i s\u1EBD ch\u1EB7n trong t\u1EA7m m\u1EAFt
      c\u1EE7a m\u1ECDi ng\u01B0\u1EDDi."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669386
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng t\u1EEB ph\xEDa r\u1EEBng \u0111ang
      \u0111\u1EBFn g\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669387
    m_Localized: "Ch\xFAng \u0111ang \u0111i xu\u1ED1ng \u0111\u1ED3ng th\u1EDDi
      t\u1EEB \u0111\u01B0\u1EDDng r\u1EEBng tr\u01B0\u1EDBc c\u1ED5ng v\xE0 l\u1ED1i
      v\xE0o ph\xEDa nam."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669388
    m_Localized: "T\xF4i s\u1EBD \u0111\u01B0a binh l\xEDnh ra sau t\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669389
    m_Localized: "Trong khi m\u1ECDi ng\u01B0\u1EDDi ch\u1EB7n ch\xFAng, ch\xFAng
      t\xF4i s\u1EBD ki\u1EC3m tra t\xECnh tr\u1EA1ng t\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669390
    m_Localized: "\u0110\u01B0\u1EE3c. B\u1EA3o v\u1EC7 c\u1ED5ng \u1EDF \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669391
    m_Localized: "\u0110\xE3 r\xF5. T\xF4i s\u1EBD kh\xF4ng \u0111\u1EC3 qu\xE1i
      v\u1EADt v\u01B0\u1EE3t qua ph\xEDa tr\u01B0\u1EDBc c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669392
    m_Localized: "N\u1EBFu b\u1ECB th\u01B0\u01A1ng h\xE3y b\xE1o ngay. Gi\u1EA5u
      \u0111i ch\u1EC9 khi\u1EBFn m\u1ECDi chuy\u1EC7n kh\xF3 h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669393
    m_Localized: "C\xF3 ai b\u1ECB th\u01B0\u01A1ng kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669394
    m_Localized: "T\xF4i \u1ED5n! Ch\xFAng ta \u0111\xE3 ch\u1EB7n \u0111\u01B0\u1EE3c
      c\u1EA3 ph\xEDa tr\u01B0\u1EDBc c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669395
    m_Localized: "D\xF9 v\u1EADy v\u1EABn ph\u1EA3i ki\u1EC3m tra t\xECnh tr\u1EA1ng
      t\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669396
    m_Localized: "D\xF9 b\xEAn ngo\xE0i tr\xF4ng c\xF2n nguy\xEAn, b\xEAn trong c\xF3
      th\u1EC3 \u0111\xE3 kh\xE1c..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669397
    m_Localized: "Demian, t\xECnh tr\u1EA1ng t\u01B0\u1EDDng th\u1EBF n\xE0o?"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669398
    m_Localized: "V\u1EABn \u0111ang tr\u1EE5 \u0111\u01B0\u1EE3c, nh\u01B0ng \u0111\xE3
      ch\u1ECBu kh\xE1 nhi\u1EC1u va ch\u1EA1m."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669399
    m_Localized: "V\u1EDBi t\xECnh tr\u1EA1ng n\xE0y s\u1EBD kh\xF3 ch\u1EB7n \u0111\u1EE3t
      ti\u1EBFp theo ngay l\u1EADp t\u1EE9c."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669400
    m_Localized: "V\u1EADy c\u1EA7n gia c\u1ED1 r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669401
    m_Localized: "V\xE2ng. S\u1EEDa ch\u1EEFa d\xF9 ch\u1EC9 m\u1ED9t ch\xFAt c\u0169ng
      s\u1EBD an to\xE0n h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669402
    m_Localized: "V\u1EABn c\xF2n chuy\u1EC3n \u0111\u1ED9ng trong r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669403
    m_Localized: "T\xF4i nghe th\u1EA5y c\u1EA3 nh\u1EEFng ti\u1EBFng b\u01B0\u1EDBc
      ch\xE2n n\u1EB7ng h\u01A1n l\xFAc n\xE3y."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669404
    m_Localized: "V\u1EADy h\xE3y s\u1EEDa t\u01B0\u1EDDng tr\u01B0\u1EDBc, r\u1ED3i
      ki\u1EC3m tra l\u1EA1i chuy\u1EC3n \u0111\u1ED9ng n\u1EB7ng n\u1EC1 t\u1EEB
      ph\xEDa r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669405
    m_Localized: "N\u1EBFu c\xF3 th\u1EDDi gian s\u1EEDa ch\u1EEFa, c\xF3 l\u1EBD
      t\xF4i c\xF3 th\u1EC3 nh\u1EAFm m\u1EAFt m\u1ED9t l\xE1t..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669406
    m_Localized: "Ng\u1EE7 kh\xF4ng \u0111\u01B0\u1EE3c t\xEDnh l\xE0 th\u1EDDi gian
      s\u1EEDa ch\u1EEFa."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669407
    m_Localized: "T\xF4i c\xF2n ch\u01B0a n\xF3i h\u1EBFt m\xE0..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901949669408
    m_Localized: "...Kh\xF4ng, c\u0169ng g\u1EA7n \u0111\xFAng r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958057984
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y s\u1EEDa t\u01B0\u1EDDng ph\xF2ng th\u1EE7
      c\u1ED5ng tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958057985
    m_Localized: "Noah v\xE0 Alice, ti\u1EBFp t\u1EE5c theo d\xF5i chuy\u1EC3n \u0111\u1ED9ng
      trong r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958057986
    m_Localized: "Serah v\xE0 Spayne, h\xE3y c\xF9ng binh l\xEDnh ki\u1EC3m tra nh\u1EEFng
      ch\u1ED7 c\u1EA7n s\u1EEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958057987
    m_Localized: "\u1EEA. T\xF4i s\u1EBD ti\u1EBFp t\u1EE5c quan s\xE1t ph\xEDa r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958057988
    m_Localized: "\u0110\u01B0\u1EE3c. T\xF4i s\u1EBD chu\u1EA9n b\u1ECB m\u1ECDi
      th\u1EE9 tr\u01B0\u1EDBc khi ch\xFAng ta di chuy\u1EC3n \u0111\u1EBFn tuy\u1EBFn
      ph\xF2ng th\u1EE7 trung t\xE2m!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958057989
    m_Localized: "\u0110\u01B0\u1EE3c. L\u1EA7n n\xE0y h\xE3y c\u1ED1 \u0111\u1EC3
      c\u1EA3 ng\u01B0\u1EDDi l\u1EABn t\u01B0\u1EDDng \u0111\u1EC1u \xEDt b\u1ECB
      th\u01B0\u01A1ng h\u01A1n nh\xE9..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958057990
    m_Localized: "Tr\u01B0\u1EDBc t\u01B0\u1EDDng ph\xF2ng th\u1EE7 c\u1ED5ng c\u1EE7a
      ph\xE1o \u0111\xE0i ph\xF2ng th\u1EE7 Cies."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958057991
    m_Localized: "Demian, t\xF4i ngh\u0129 ch\u1ED7 n\xE0y n\u1EE9t kh\xE1 nhi\u1EC1u."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958057992
    m_Localized: "V\xE2ng. T\xF4i s\u1EBD gia c\u1ED1 ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958057993
    m_Localized: "S\u1EEDa ngay b\xE2y gi\u1EDD v\u1EABn t\u1ED1t h\u01A1n... N\u1EBFu
      v\u1EBFt n\u1EE9t r\u1ED9ng th\xEAm, ch\xFAng ta s\u1EBD ph\u1EA3i lo c\u1EA3
      ng\u01B0\u1EDDi l\u1EABn t\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958057994
    m_Localized: "Kh\xF4ng th\u1EC3 s\u1EEDa ho\xE0n to\xE0n, nh\u01B0ng v\u1EABn
      \u0111\u1EE7 s\u1EE9c ch\u1EB7n th\xEAm m\u1ED9t \u0111\u1EE3t \u0111ang tr\xE0n
      t\u1EDBi."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958057995
    m_Localized: "Nh\u01B0 v\u1EADy l\xE0 \u0111\u1EE7. \u01AFu ti\xEAn l\xE0 gia
      c\u1ED1 \u0111\u1EC3 n\xF3 kh\xF4ng s\u1EADp trong khi ch\xFAng ta ch\u1EB7n
      \u0111\u1EE3t \u0111ang t\u1EDBi."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958057996
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y gia c\u1ED1 nh\u1EEFng ch\u1ED7 y\u1EBFu
      tr\u01B0\u1EDBc!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958057997
    m_Localized: "\u1EEA. H\xE3y c\u1ED1 gi\u1EA3m s\u1ED1 vi\u1EC7c ph\u1EA3i s\u1EEDa
      v\u1EC1 sau..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958057998
    m_Localized: "\u0110\xE3 gia c\u1ED1 xong t\u01B0\u1EDDng ph\xF2ng th\u1EE7."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958057999
    m_Localized: "\u0110\xE1 t\xEDn hi\u1EC7u v\u1EABn c\xF3 th\u1EC3 \u0111i\u1EC1u
      ch\u1EC9nh th\xEAm m\u1ED9t l\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058000
    m_Localized: "M\u1ED9t khi ch\u1ECDn, c\u01B0\u1EDDng h\xF3a n\xE0y s\u1EBD ti\u1EBFp
      t\u1EE5c c\xF3 hi\u1EC7u l\u1EF1c. H\xE3y l\u1EF1a ch\u1ECDn c\u1EA9n th\u1EADn."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058001
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y \u0111i\u1EC1u ch\u1EC9nh l\u1EA7n
      cu\u1ED1i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058002
    m_Localized: "Kh\xF4ng \u0111\u01B0\u1EE3c m\u1EA5t nhi\u1EC1u th\u1EDDi gian.
      Chuy\u1EC3n \u0111\u1ED9ng t\u1EEB ph\xEDa r\u1EEBng \u0111ang \u0111\u1EBFn
      g\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058003
    m_Localized: "V\u1EADy c\xE0ng ph\u1EA3i ch\u1ECDn th\u1EE9 m\xE0 sau n\xE0y
      ch\xFAng ta kh\xF4ng h\u1ED1i h\u1EADn..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058004
    m_Localized: "\u0110\xE3 \u0111i\u1EC1u ch\u1EC9nh xong."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058005
    m_Localized: "Gi\u1EDD h\xE3y ki\u1EC3m tra t\xECnh h\xECnh tr\u01B0\u1EDBc c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058006
    m_Localized: "Ch\u1EC9 huy, chuy\u1EC3n \u0111\u1ED9ng s\xE2u trong r\u1EEBng
      r\u1EA5t k\u1EF3 l\u1EA1."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058007
    m_Localized: "C\xF3 m\u1ED9t ti\u1EBFng b\u01B0\u1EDBc ch\xE2n n\u1EB7ng h\u01A1n
      h\u1EB3n nh\u1EEFng ti\u1EBFng c\xF2n l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058008
    m_Localized: "C\xE1c qu\xE1i v\u1EADt xung quanh c\u0169ng b\u1ECB cu\u1ED1n
      theo chuy\u1EC3n \u0111\u1ED9ng \u0111\xF3 v\xE0 b\u1ECB \u0111\u1EA9y xu\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058009
    m_Localized: "V\u1EABn ch\u01B0a bi\u1EBFt n\xF3 \u0111ang d\u1EABn c\u1EA3 \u0111\xE0n
      hay c\u0169ng b\u1ECB \u0111\u1EA9y \u0111\u1EBFn \u0111\xE2y nh\u01B0 nh\u1EEFng
      con kh\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058010
    m_Localized: "\u0110i\u1EC1u ch\u1EAFc ch\u1EAFn l\xE0 con qu\xE1i v\u1EADt l\u1EDBn
      \u0111\xF3 nguy hi\u1EC3m nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058011
    m_Localized: "H\xE3y ch\u1EB7n \u1EDF tuy\u1EBFn ph\xF2ng th\u1EE7 trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058012
    m_Localized: "Ch\xFAng ta ph\u1EA3i ng\u0103n n\xF3 trong l\xFAc t\u01B0\u1EDDng
      \u0111\u01B0\u1EE3c gia c\u1ED1 v\u1EABn c\xF2n tr\u1EE5."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058013
    m_Localized: "R\xF5 r\u1ED3i. K\u1EBFt th\xFAc tr\u01B0\u1EDBc t\u01B0\u1EDDng!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058014
    m_Localized: "N\u1EBFu s\u1ED1 ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng l\u1EA1i
      t\u0103ng, t\xF4i s\u1EBD b\u1EADn t\u1ED1i m\u1EAFt m\u1EA5t..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058015
    m_Localized: "Chu\u1EA9n b\u1ECB xong th\xEC di chuy\u1EC3n ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058016
    m_Localized: "V\u1EADy l\xE0 th\u1EADt s\u1EF1 kh\xF4ng \u0111\u01B0\u1EE3c ngh\u1EC9
      cho \u0111\u1EBFn ph\xFAt cu\u1ED1i..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058017
    m_Localized: "Ch\u1EDD \u0111\u1EE3i ch\u1EC9 khi\u1EBFn m\u1ECDi chuy\u1EC7n
      kh\xF3 h\u01A1n th\xF4i!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058018
    m_Localized: "Serah l\u1EA5y m\u1EA5t l\xFD l\u1EBD c\u1EE7a t\xF4i r\u1ED3i..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058019
    m_Localized: "Tuy\u1EBFn ph\xF2ng th\u1EE7 trung t\xE2m c\u1EE7a ph\xE1o \u0111\xE0i
      ph\xF2ng th\u1EE7 Cies, ph\xEDa tr\u01B0\u1EDBc t\u01B0\u1EDDng ph\xF2ng th\u1EE7
      c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058020
    m_Localized: "Ch\u1EC9 huy, \u0111\xF3 l\xE0 ti\u1EBFng b\u01B0\u1EDBc ch\xE2n
      n\u1EB7ng l\xFAc n\xE3y."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058021
    m_Localized: "V\u1EABn ch\u01B0a th\u1EA5y, nh\u01B0ng chuy\u1EC3n \u0111\u1ED9ng
      \u0111ang \u0111\u1EBFn g\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058022
    m_Localized: "Qu\xE1i v\u1EADt xung quanh \u0111ang b\u1ECB \u0111\u1EA9y xu\u1ED1ng
      tr\u01B0\u1EDBc n\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058023
    m_Localized: "Kh\xF4ng c\xF2n th\u1EDDi gian ki\u1EC3m tra th\xEAm. Ph\u1EA3i
      ch\u1EB7n ch\xFAng \u1EDF \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058024
    m_Localized: "\u0110\u01B0\u1EE3c. K\u1EBFt th\xFAc tr\u01B0\u1EDBc khi ch\xFAng
      \u0111\u1EBFn t\u01B0\u1EDDng!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058025
    m_Localized: "V\u1EADy h\xE3y c\u1ED1 gi\u1EA3m s\u1ED1 ng\u01B0\u1EDDi b\u1ECB
      th\u01B0\u01A1ng nh\xE9..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058026
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn v\u1EABn c\xF2n s\xE2u trong
      r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058027
    m_Localized: "Ph\u1EA3i ch\u1EB7n nh\xF3m \u0111i xu\u1ED1ng tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058028
    m_Localized: "T\u01B0\u1EDDng ph\xF2ng th\u1EE7 \u0111\u01B0\u1EE3c gia c\u1ED1
      c\xF3 th\u1EC3 tr\u1EE5 \u0111\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058029
    m_Localized: "Nh\u01B0ng t\u01B0\u1EDDng s\u1EBD kh\xF4ng tr\u1EE5 \u0111\u01B0\u1EE3c
      l\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058030
    m_Localized: "T\xF4i s\u1EBD cho binh l\xEDnh ch\u1EDD ph\xEDa sau t\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058031
    m_Localized: "Vi\u1EC7c \u0111i\u1EC1u ch\u1EC9nh \u0111\xE1 t\xEDn hi\u1EC7u
      c\u0169ng \u0111ang \u1ED5n \u0111\u1ECBnh. Ch\u1EC9 c\u1EA7n \u0111\u1EEBng
      \u0111\u1EC3 k\xE9o d\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058032
    m_Localized: "\u0110\u01B0\u1EE3c. Ch\u1EB7n \u1EDF tuy\u1EBFn ph\xF2ng th\u1EE7
      trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058033
    m_Localized: "\u1EEA. H\xE3y b\u1EA3o v\u1EC7 Cies ngay t\u1EA1i \u0111\xE2y!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058034
    m_Localized: "B\u1ECB th\u01B0\u01A1ng th\xEC b\xE1o ngay. Gi\u1EA5u \u0111i
      ch\u1EC9 khi\u1EBFn m\u1ECDi chuy\u1EC7n kh\xF3 h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058035
    m_Localized: "Nh\xF3m \u0111i xu\u1ED1ng tr\u01B0\u1EDBc \u0111ang \u0111\u1EBFn
      g\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058036
    m_Localized: "C\xF3 v\u1EBB ch\xFAng s\u1EAFp \u0111\u1EBFn tuy\u1EBFn ph\xF2ng
      th\u1EE7 trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058037
    m_Localized: "Qu\xE1i v\u1EADt xung quanh \u0111ang t\u1EA3n ra."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058038
    m_Localized: "C\xF3 v\u1EBB s\u1ED1 l\u01B0\u1EE3ng b\u1ECB \u0111\u1EA9y \u0111\u1EBFn
      \u0111\xE2y \u0111\xE3 gi\u1EA3m."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058039
    m_Localized: "Ph\xF9... L\u1EA7n n\xE0y \u0111\xFAng l\xE0 s\xE1t n\xFAt."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058040
    m_Localized: "T\u1ED1t... Ch\xFAng ta \u0111\xE3 ch\u1EB7n \u0111\u01B0\u1EE3c
      r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058041
    m_Localized: "Ch\xFAng ta \u0111\xE3 b\u1EA3o v\u1EC7 \u0111\u01B0\u1EE3c ph\xE1o
      \u0111\xE0i ph\xF2ng th\u1EE7 Cies!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058042
    m_Localized: "H\xE3y ki\u1EC3m tra ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng tr\u01B0\u1EDBc...
      \u0102n m\u1EEBng sau c\u0169ng ch\u01B0a mu\u1ED9n."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058043
    m_Localized: "Binh l\xEDnh \u0111\u1EC1u an to\xE0n. Kh\xF4ng c\xF3 ai b\u1ECB
      th\u01B0\u01A1ng n\u1EB7ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058044
    m_Localized: "T\u01B0\u1EDDng ph\xF2ng th\u1EE7 c\u1ED5ng c\u0169ng \u0111\xE3
      tr\u1EE5 \u0111\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058045
    m_Localized: "N\u1EBFu kh\xF4ng c\xF3 c\xE1c H\u1ED9 V\u1EC7, ch\xFAng t\xF4i
      \u0111\xE3 kh\xF3 m\xE0 tr\u1EE5 tr\u01B0\u1EDBc b\u1EE9c t\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058046
    m_Localized: "V\u1EABn ch\u01B0a gi\u1EA3i quy\u1EBFt ho\xE0n to\xE0n, nh\u01B0ng
      ch\xFAng ta \u0111\xE3 ch\u1EB7n \u0111\u01B0\u1EE3c nh\xF3m h\xF4m nay."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058047
    m_Localized: "\u1EEA. V\u1EADy l\xE0 \u0111\u1EE7 cho l\xFAc n\xE0y!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058048
    m_Localized: "M\u1ECDi ng\u01B0\u1EDDi v\u1EA5t v\u1EA3 r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058049
    m_Localized: "Ch\u1EC9 huy, ch\xFAng t\xF4i nh\u1EADn \u0111\u01B0\u1EE3c b\xE1o
      c\xE1o t\u1EEB ph\xEDa Zeppel trong l\xFAc chi\u1EBFn \u0111\u1EA5u."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058050
    m_Localized: "H\u1ECD n\xF3i qu\xE1i v\u1EADt \u1EDF Zeppel c\u0169ng \u0111ang
      d\u1ED3n v\u1EC1 m\u1ED9t h\u01B0\u1EDBng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058051
    m_Localized: "N\u1ED9i dung t\u01B0\u01A1ng t\u1EF1 c\u0169ng \u0111\xE3 \u0111\u01B0\u1EE3c
      b\xE1o l\xEAn c\u1EA5p tr\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058052
    m_Localized: "T\xF4i s\u1EBD b\xE0n giao vi\u1EC7c ph\xF2ng th\u1EE7 Cies ngay
      khi qu\xE2n ti\u1EBFp vi\u1EC7n \u0111\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058053
    m_Localized: "V\u1EADy hi\u1EC7n t\u01B0\u1EE3ng t\u01B0\u01A1ng t\u1EF1 c\u0169ng
      x\u1EA3y ra \u1EDF Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058054
    m_Localized: "C\xF3 th\u1EC3 chuy\u1EC7n n\xE0y kh\xF4ng li\xEAn quan \u0111\u1EBFn
      vi\u1EC7c chuy\u1EC3n \u0111\u1ED9ng qu\xE1i v\u1EADt \u1EDF Cies \u0111\xE3
      gi\u1EA3m."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058055
    m_Localized: "Nguy\xEAn nh\xE2n v\u1EABn c\xF2n \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058056
    m_Localized: "D\xF9 v\u1EADy, b\u1EA3o v\u1EC7 \u0111\u01B0\u1EE3c Cies v\u1EABn
      l\xE0 m\u1ED9t th\xE0nh qu\u1EA3 r\xF5 r\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058057
    m_Localized: "\u1EEA. H\xE3y ki\u1EC3m tra Zeppel tr\u01B0\u1EDBc khi qu\xE1
      mu\u1ED9n."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058058
    m_Localized: "H\xECnh nh\u01B0 th\u1EDDi gian ngh\u1EC9 v\u1EEBa xa h\u01A1n
      n\u1EEFa r\u1ED3i..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058059
    m_Localized: "Tr\u01B0\u1EDBc h\u1EBFt ph\u1EA3i chu\u1EA9n b\u1ECB di chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058060
    m_Localized: "\u0110\u01B0\u1EE3c r\u1ED3i... T\xF4i s\u1EBD tin r\u1EB1ng th\u1EDDi
      gian ngh\u1EC9 c\u0169ng \u0111ang di chuy\u1EC3n c\xF9ng ch\xFAng ta..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901958058061
    m_Localized: "\u0110\u01B0\u1EE3c. T\u1ED5ng h\u1EE3p t\xECnh h\xECnh \u1EDF
      Cies r\u1ED3i l\u1EADp t\u1EE9c \u0111\u1EBFn Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252288
    m_Localized: "Tr\u01B0\u1EDBc c\u1ED5ng ngo\xE0i Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252289
    m_Localized: "C\xE1c H\u1ED9 V\u1EC7 t\u1EEB Cies ph\u1EA3i kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252290
    m_Localized: "\u0110\xFAng v\u1EADy. Ch\xFAng t\xF4i \u0111\u1EBFn \u0111\u1EC3
      ki\u1EC3m tra t\xECnh h\xECnh \u1EDF Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252291
    m_Localized: "V\xE2ng. C\xE1c nh\xF3m qu\xE1i v\u1EADt li\xEAn t\u1EE5c \u0111i
      xu\u1ED1ng t\u1EEB con \u0111\u01B0\u1EDDng ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252292
    m_Localized: "Ch\xFAng t\xF4i \u0111ang s\u01A1 t\xE1n c\u01B0 d\xE2n v\xE0o
      trong c\u1ED5ng, nh\u01B0ng v\u1EABn c\xF2n v\xE0i xe v\u1EADt t\u01B0 \u1EDF
      b\xEAn ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252293
    m_Localized: "D\u1EA5u ch\xE2n ch\u1EC9 k\xE9o d\xE0i v\u1EC1 m\u1ED9t h\u01B0\u1EDBng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252294
    m_Localized: "Gi\u1ED1ng nh\u01B0 \u1EDF Cies, nh\xF3m n\xE0y b\u1ECB \u0111\u1EA9y
      v\u1EC1 m\u1ED9t ph\xEDa ch\u1EE9 kh\xF4ng t\u1EF1 ch\u1ECDn h\u01B0\u1EDBng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252295
    m_Localized: "\u0110\u01B0\u1EE3c. Ch\u1EB7n \u1EDF \u0111\xE2y. Ph\u1EA3i b\u1EA3o
      v\u1EC7 \u0111\u1EC3 ng\u01B0\u1EDDi b\xEAn trong c\xF3 th\u1EC3 s\u01A1 t\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252296
    m_Localized: "\u0110\xFAng. \u0110\u01B0\u1EDDng r\u1ED9ng n\xEAn vi\u1EC7c ch\u1EB7n
      c\xF3 th\u1EC3 d\u1EC5 h\u01A1n m\u1ED9t ch\xFAt."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252297
    m_Localized: "Nh\u01B0ng ch\u1EC9 c\u1EA7n b\u1ECB \u0111\u1EA9y l\xF9i m\u1ED9t
      l\u1EA7n, s\u1EBD l\u1EADp t\u1EE9c c\xF3 ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252298
    m_Localized: "B\u1ECB th\u01B0\u01A1ng \u1EDF n\u01A1i \u0111\xF4ng ng\u01B0\u1EDDi
      th\xEC ngay c\u1EA3 vi\u1EC7c t\xECm ng\u01B0\u1EDDi c\u0169ng \u0111\xE3 l\xE0
      m\u1ED9t vi\u1EC7c r\u1ED3i..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252299
    m_Localized: "V\xEC v\u1EADy n\u1EBFu c\xF3 th\u1EC3, h\xE3y \u0111\u1EEBng t\u1EA1o
      th\xEAm vi\u1EC7c cho t\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252300
    m_Localized: "Khi xe \u0111i qua, ch\xFAng t\xF4i c\xF3 th\u1EC3 nhanh ch\xF3ng
      d\u1ECDn tr\u1ED1ng khu v\u1EF1c tr\u01B0\u1EDBc c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252301
    m_Localized: "Xin h\xE3y gi\u1EEF tuy\u1EBFn ph\xF2ng th\u1EE7 \u0111\u1EBFn
      l\xFAc \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252302
    m_Localized: "\u0110\xE3 r\xF5. H\xE3y d\u1ECDn khu v\u1EF1c tr\u01B0\u1EDBc
      c\u1ED5ng tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252303
    m_Localized: "M\u1EDF \u0111\u01B0\u1EDDng cho xe \u0111i qua v\xE0 gi\u1EEF
      nguy\xEAn tuy\u1EBFn ph\xF2ng th\u1EE7."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252304
    m_Localized: "\u0110\xE3 r\xF5. T\xF4i s\u1EBD ti\u1EBFn h\xE0nh ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252305
    m_Localized: "Ch\u1EC9 huy, c\xF3 r\u1EA5t nhi\u1EC1u d\u1EA5u ch\xE2n tr\xEAn
      con \u0111\u01B0\u1EDDng b\xEAn ngo\xE0i c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252306
    m_Localized: "N\u1EBFu qu\xE1i v\u1EADt l\u1ECDt sang \u0111\u01B0\u1EDDng b\xEAn,
      ch\xFAng s\u1EBD giao v\u1EDBi \u0111\u01B0\u1EDDng xe \u0111i ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252307
    m_Localized: "V\u1EADy kh\xF4ng \u0111\u01B0\u1EE3c \u0111\u1EA9y qu\xE1 xa v\u1EC1
      ph\xEDa tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252308
    m_Localized: "H\xE3y gi\u1EEF tuy\u1EBFn n\xE0y cho \u0111\u1EBFn khi xe \u0111i
      qua."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252309
    m_Localized: "\u0110\u01B0\u1EE3c. T\xF4i s\u1EBD lo ph\xEDa ch\xFAng va v\xE0o
      tr\u01B0\u1EDBc!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252310
    m_Localized: "T\xF4i s\u1EBD kh\xF4ng \u0111\u1EC3 qu\xE1i v\u1EADt ti\u1EBFn
      d\xF9 ch\u1EC9 m\u1ED9t b\u01B0\u1EDBc v\u1EC1 ph\xEDa xe."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252311
    m_Localized: "\u1EEA. T\xF4i s\u1EBD quan s\xE1t chuy\u1EC3n \u0111\u1ED9ng t\xE1ch
      sang b\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252312
    m_Localized: "Serah, \u0111\u1EEBng \u0111i qu\xE1 xa ph\xEDa tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252313
    m_Localized: "\u0110\xE3 r\xF5. T\xF4i s\u1EBD ch\u1EB7n ch\xFAng trong tuy\u1EBFn
      n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252314
    m_Localized: "N\u1EBFu c\u1EADu \u1EDF b\xEAn trong tuy\u1EBFn ph\xF2ng th\u1EE7
      th\xEC t\xF4i c\u0169ng y\xEAn t\xE2m h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252315
    m_Localized: "N\u1EBFu c\u1EADu \u0111i qu\xE1 xa, t\xF4i s\u1EBD ph\u1EA3i \u0111i
      t\xECm..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252316
    m_Localized: "Nh\xF3m b\xEAn ngo\xE0i c\u1ED5ng \u0111ang \u0111\u1EBFn g\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252317
    m_Localized: "Ch\xFAng \u0111ang \u0111i th\u1EB3ng v\xE0o theo con \u0111\u01B0\u1EDDng
      ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252318
    m_Localized: "Qu\xE1i v\u1EADt \u0111ang \u0111\u1EBFn! Ch\xFAng \u1EDF ngay
      ph\xEDa tr\u01B0\u1EDBc c\u1ED5ng ngo\xE0i!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252319
    m_Localized: "\u0110\u01B0\u1EE3c. Gi\u1EEF \u0111\u01B0\u1EDDng cho xe \u0111i
      qua v\xE0 ch\u1EB7n nh\xF3m \u0111ang ti\u1EBFn v\xE0o \u1EDF c\u1ED5ng ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252320
    m_Localized: "\u1EEA. T\xF4i s\u1EBD lo ph\xEDa tr\u01B0\u1EDBc c\u1ED5ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252321
    m_Localized: "T\xF4i s\u1EBD ti\u1EBFp t\u1EE5c quan s\xE1t b\xEAn ngo\xE0i.
      N\u1EBFu c\xF3 con n\xE0o l\u1ECDt sang \u0111\u01B0\u1EDDng b\xEAn, t\xF4i
      s\u1EBD b\xE1o ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252322
    m_Localized: "N\u1EBFu ch\xFAng d\u1ED3n v\u1EC1 m\u1ED9t ph\xEDa, t\xF4i s\u1EBD
      x\u1EED l\xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252323
    m_Localized: "B\u1ECB th\u01B0\u01A1ng th\xEC b\xE1o ngay nh\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252324
    m_Localized: "N\u1EBFu c\u1EE9 ch\u1ECBu \u0111\u1EF1ng th\xEC c\u1EA3 c\u1EADu
      v\xE0 t\xF4i \u0111\u1EC1u s\u1EBD m\u1EC7t h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252325
    m_Localized: "M\u1ECDi ng\u01B0\u1EDDi \u1ED5n ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252326
    m_Localized: "C\xF3 v\u1EBB c\u01B0 d\xE2n c\u0169ng kh\xF4ng ai b\u1ECB th\u01B0\u01A1ng
      n\u1EB7ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252327
    m_Localized: "Tuy\u1EC7t! Xe c\u0169ng \u0111\xE3 v\xE0o trong an to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252328
    m_Localized: "Ch\xFAng ta \u0111\xE3 b\u1EA3o v\u1EC7 \u0111\u01B0\u1EE3c ng\u01B0\u1EDDi
      b\xEAn trong Zeppel!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252329
    m_Localized: "\u1EEA. Nh\u01B0ng qu\xE1i v\u1EADt v\u1EABn \u0111ang \u0111i
      xu\u1ED1ng theo c\xF9ng m\u1ED9t con \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252330
    m_Localized: "Ch\xFAng ta ch\u1EC9 ch\u1EB7n \u0111\u01B0\u1EE3c \u1EDF c\u1ED5ng,
      chuy\u1EC3n \u0111\u1ED9ng v\u1EABn ch\u01B0a d\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252331
    m_Localized: "N\u1EBFu ch\xFAng v\u1EABn ti\u1EBFp t\u1EE5c \u0111i xu\u1ED1ng..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252332
    m_Localized: "C\xF3 ngh\u0129a l\xE0 h\xF4m nay ch\xFAng ta c\u0169ng kh\xF4ng
      \u0111\u01B0\u1EE3c ngh\u1EC9 s\u1EDBm sao...?"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252333
    m_Localized: "M\u1ED9t ph\u1EA7n d\u1EA5u v\u1EBFt tr\u01B0\u1EDBc c\u1ED5ng
      \u0111\xE3 t\xE1ch sang b\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252334
    m_Localized: "T\xF4i c\u0169ng th\u1EA5y d\u1EA5u ch\xE2n d\u1EABn v\u1EC1 khu
      n\xF4ng tr\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252335
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ki\u1EC3m tra d\u1EA5u v\u1EBFt t\xE1ch
      ra tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252336
    m_Localized: "\u1EEA. Ch\xFAng ta ch\u1EC9 ch\u1EB7n \u0111\u01B0\u1EE3c m\u1ED9t
      ph\u1EA7n \u1EDF c\u1ED5ng ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252337
    m_Localized: "Ph\u1EA3i xem ph\u1EA7n c\xF2n l\u1EA1i d\u1EABn \u0111i \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252338
    m_Localized: "Ch\u1EC9 huy, ch\xFAng t\xF4i c\u0169ng nh\u1EADn \u0111\u01B0\u1EE3c
      b\xE1o c\xE1o t\u1EEB khu n\xF4ng tr\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901962252339
    m_Localized: "Ng\u01B0\u1EDDi ta n\xF3i qu\xE1i v\u1EADt \u0111ang h\xFAc \u0111\u1ED5
      h\xE0ng r\xE0o \u0111\u1EC3 \u0111i qua."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446592
    m_Localized: "\u0110\u1EBFn t\u1EADn n\xF4ng tr\u1EA1i sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446593
    m_Localized: "V\u1EADy l\xE0 ch\xFAng \u0111\xE3 ti\u1EBFn s\xE2u h\u01A1n v\xE0o
      n\u01A1i c\xF3 ng\u01B0\u1EDDi \u1EDF r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446594
    m_Localized: "\u1EEA. D\u1EA5u v\u1EBFt t\xE1ch ra tr\u01B0\u1EDBc c\u1ED5ng
      d\u1EABn v\u1EC1 ph\xEDa khu n\xF4ng tr\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446595
    m_Localized: "Nh\xECn b\xE1o c\xE1o n\xE0y th\xEC ch\xFAng \u0111\xE3 v\xE0o
      t\u1EADn b\xEAn trong n\xF4ng tr\u1EA1i r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446596
    m_Localized: "\u0110\u01B0\u1EDDng ru\u1ED9ng ch\u1EAFc c\u0169ng c\xF3 b\xF9n..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446597
    m_Localized: "N\u1EBFu ng\xE3 th\xEC ch\u1EAFc th\u1EDDi gian r\u1EEDa ng\u01B0\u1EDDi
      c\xF2n l\xE2u h\u01A1n th\u1EDDi gian ngh\u1EC9 m\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446598
    m_Localized: "Gi\u1EDD kh\xF4ng ph\u1EA3i l\xFAc t\xEDnh th\u1EDDi gian ngh\u1EC9
      \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446599
    m_Localized: "\u0110\u1EEBng xem nh\u1EB9 vi\u1EC7c ngh\u1EC9 ng\u01A1i..."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446600
    m_Localized: "Tr\u01B0\u1EDBc h\u1EBFt h\xE3y \u0111\u1EBFn s\u1EDF ch\u1EC9
      huy t\u1EA1m th\u1EDDi."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446601
    m_Localized: "Tr\u01B0\u1EDBc khi \u0111\u1EBFn n\xF4ng tr\u1EA1i, h\xE3y s\u1EAFp
      x\u1EBFp l\u1EA1i ghi ch\xE9p tr\u01B0\u1EDBc c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446602
    m_Localized: "\u1EEA. T\xF4i s\u1EBD ki\u1EC3m tra c\u1EA3 ph\u1EA3n \u1EE9ng
      c\u1EE7a \u0111\xE1 t\xEDn hi\u1EC7u."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446603
    m_Localized: "H\xE3y xem ch\xFAng \u0111\xE3 t\xE1ch ra theo con \u0111\u01B0\u1EDDng
      n\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446604
    m_Localized: "\u0110\u01B0\u1EE3c. Xong vi\u1EC7c th\xEC \u0111i th\u1EB3ng \u0111\u1EBFn
      n\xF4ng tr\u1EA1i!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446605
    m_Localized: "Tr\u01B0\u1EDBc c\u1ED5ng ph\xE1o \u0111\xE0i ph\xF2ng th\u1EE7
      Cies"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446606
    m_Localized: "L\u1EA7n b\u1EA3o tr\xEC chung \u0111\u1EA7u ti\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446607
    m_Localized: "\u0110\u01B0\u1EDDng r\u1EEBng tr\u01B0\u1EDBc c\u1ED5ng Cies"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446608
    m_Localized: "L\u1ED1i v\xE0o ph\xEDa nam ph\xE1o \u0111\xE0i ph\xF2ng th\u1EE7
      Cies"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446609
    m_Localized: "Tr\u01B0\u1EDBc t\u01B0\u1EDDng c\u1ED5ng ph\xE1o \u0111\xE0i ph\xF2ng
      th\u1EE7 Cies"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901966446610
    m_Localized: "B\u1EA3o tr\xEC t\u01B0\u1EDDng c\u1ED5ng tr\u01B0\u1EDBc tr\u1EADn
      Boss"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640896
    m_Localized: "Tuy\u1EBFn ph\xF2ng th\u1EE7 trung t\xE2m ph\xE1o \u0111\xE0i ph\xF2ng
      th\u1EE7 Cies"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160528
    m_Localized: "Wave 1 \u0111\xE3 s\u1EB5n s\xE0ng. H\xE3y \u0111\u1EB7t \u0111\xE1
      t\xEDn hi\u1EC7u \u0111\u1EC3 c\u01B0\u1EDDng h\xF3a anh h\xF9ng tr\u01B0\u1EDBc
      tr\u1EADn chi\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640897
    m_Localized: "K\xE9o \u0111\xE1 t\xEDn hi\u1EC7u t\u1EA5n c\xF4ng v\xE0o \xF4
      c\u1EE7a Serah."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640898
    m_Localized: COMBO +1.
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640899
    m_Localized: "Combo \u0111\xE3 k\xE9o d\xE0i th\u1EDDi gian Sort c\xF2n l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640900
    m_Localized: "\u0110\xE3 chu\u1EA9n b\u1ECB xong. Nh\u1EA5n BATTLE START \u0111\u1EC3
      b\u1EAFt \u0111\u1EA7u chi\u1EBFn \u0111\u1EA5u."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640901
    m_Localized: "Level Up! H\xE3y ch\u1ECDn ph\u1EA7n th\u01B0\u1EDFng b\u1EA1n
      mu\u1ED1n."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640902
    m_Localized: "Ch\u1EA1m v\xE0o th\u1EBB th\u01B0\u1EDFng m\u1ED9t l\u1EA7n \u0111\u1EC3
      ch\u1ECDn."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640903
    m_Localized: "Ch\u1EA1m th\xEAm m\u1ED9t l\u1EA7n v\xE0o th\u1EBB \u0111\xE3
      ch\u1ECDn \u0111\u1EC3 x\xE1c nh\u1EADn."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640904
    m_Localized: "\u0110\xE3 nh\u1EADn [Gi\xE1c Quan S\u1EAFc B\xE9n] T\u1EA5n c\xF4ng
      +8!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640905
    m_Localized: "Noah gia nh\u1EADp. H\u1ED7 tr\u1EE3 t\u1EA7m xa \u0111\xE3 s\u1EB5n
      s\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640906
    m_Localized: "Spayne gia nh\u1EADp. T\u1EA5t c\u1EA3 anh h\xF9ng \u0111\xE3 s\u1EB5n
      s\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640907
    m_Localized: "Noah v\xE0 Spayne gia nh\u1EADp!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640908
    m_Localized: "Qu\xE1i v\u1EADt l\u1EDBn xu\u1EA5t hi\u1EC7n. H\xE3y chu\u1EA9n
      b\u1ECB t\xEDn hi\u1EC7u k\u1EF9 n\u0103ng c\u1EE7a Serah."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640909
    m_Localized: "Ch\u1EA1m v\xE0o ch\xE2n dung \u0111\u1EC3 d\xF9ng tuy\u1EC7t k\u1EF9.<br>Serah:
      \u0111\xE1nh v\xF9ng ph\xEDa tr\u01B0\u1EDBc / Noah: t\u0103ng t\u1ED1c \u0111\xE1nh
      / Alice: ph\xE9p di\u1EC7n r\u1ED9ng / Spayne: h\u1ED3i m\xE1u to\xE0n \u0111\u1ED9i"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640910
    m_Localized: "Ch\u1EA1m v\xE0o ch\xE2n dung Serah \u0111\u1EC3 d\xF9ng tuy\u1EC7t
      k\u1EF9."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640911
    m_Localized: "Tuy\u1EC7t k\u1EF9 k\xEDch ho\u1EA1t!"
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640912
    m_Localized: "Ch\u1EA1m v\xE0o m\xE0n h\xECnh trong l\xFAc ph\xE1t c\u1EAFt c\u1EA3nh
      \u0111\u1EC3 hi\u1EC7n n\xFAt B\u1ECF qua."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640913
    m_Localized: "Stage Clear! H\xE3y ki\u1EC3m tra ph\u1EA7n th\u01B0\u1EDFng."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640914
    m_Localized: "Hi\u1EC7u \u1EE9ng di v\u1EADt s\u1EBD duy tr\xEC sang m\xE0n ti\u1EBFp
      theo. H\xE3y ch\u1ECDn 1 trong 3."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640915
    m_Localized: "Ch\u1EA1m th\xEAm m\u1ED9t l\u1EA7n v\xE0o di v\u1EADt \u0111\xE3
      ch\u1ECDn \u0111\u1EC3 x\xE1c nh\u1EADn."
    m_Metadata:
      m_Items: []
  - m_Id: 2554901970640916
    m_Localized: "\u0110\xE3 nh\u1EADn \xC1o Gi\xE1p C\u1ED5 \u0110\u1EA1i. Di v\u1EADt
      \u0111\xE3 ch\u1ECDn \u0111\u01B0\u1EE3c \u0111\u0103ng k\xFD v\xE0o danh s\xE1ch
      s\u1EDF h\u1EEFu. Hi\u1EC7u \u1EE9ng s\u1EBD duy tr\xEC \u1EDF c\xE1c m\xE0n
      sau."
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160384
    m_Localized: "Th\u1EA7n T\u1ED1c"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160385
    m_Localized: "Th\u1ECB Gi\xE1c S\u1EAFc B\xE9n"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160386
    m_Localized: "\u0110\xF2n \u0110\xE1nh S\u1EAFc B\xE9n"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160387
    m_Localized: "Sinh L\u1EF1c Tr\xE0n Tr\u1EC1"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160388
    m_Localized: "Sinh L\u1EF1c Tu\xF4n Ch\u1EA3y"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160389
    m_Localized: "C\u01B0\u1EDDng H\xF3a C\u01A1 Th\u1EC3"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160390
    m_Localized: "Th\xE2n Nh\u1EB9"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160391
    m_Localized: "S\u1EE9c M\u1EA1nh C\xF4 \u0110\u1ECDng"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160392
    m_Localized: "Qu\xE1 T\u1EA3i"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160393
    m_Localized: "H\u01A1i Th\u1EDF C\u1EE7a Gi\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160394
    m_Localized: "H\xF3a Th\xFA"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160395
    m_Localized: "Kh\xED Th\u1EBF T\u01B0\u1EDDng S\u1EAFt"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160396
    m_Localized: "T\xEAn qu\xE1i v\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160464
    m_Localized: "Th\xF4ng tin k\u1EF9 n\u0103ng qu\xE1i v\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160513
    m_Localized: "T\u1EA5n c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160514
    m_Localized: "Ph\xF2ng th\u1EE7"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160515
    m_Localized: "T\u1ED1c \u0111\u1ED9 t\u1EA5n c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160516
    m_Localized: HP
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160517
    m_Localized: "K\u1EF9 n\u0103ng ch\u1EE7 \u0111\u1ED9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233806413824
    m_Localized: "T\xF4i s\u1EBD ti\u1EBFp t\u1EE5c theo d\xF5i d\u1EA5u v\u1EBFt."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356864
    m_Localized: "V\u1EADy th\xEC mau s\u1EAFp x\u1EBFp xong tr\u01B0\u1EDBc \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356865
    m_Localized: "C\xE0ng m\u1EA5t th\u1EDDi gian th\xEC gi\u1EDD ngh\u1EC9 c\xE0ng
      xa..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356866
    m_Localized: "S\u1EDF ch\u1EC9 huy t\u1EA1m th\u1EDDi t\u1EA1i c\u1ED5ng ngo\xE0i
      Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356867
    m_Localized: "H\u1EA7u h\u1EBFt c\u01B0 d\xE2n b\xEAn trong c\u1ED5ng \u0111\xE3
      \u0111\u01B0\u1EE3c s\u01A1 t\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356868
    m_Localized: "\xCDt ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng, nh\u01B0ng m\u1ED9t
      s\u1ED1 xe ch\u1EDF h\xE0ng \u0111\xE3 h\u1ECFng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356869
    m_Localized: "\xCDt ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng l\xE0 may r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356870
    m_Localized: "N\u1EBFu c\xF2n b\u1EAFt t\xF4i ch\u1EEFa cho c\u1EA3 xe ch\u1EDF
      h\xE0ng th\xEC t\xF4i c\u0169ng kh\xF3 x\u1EED \u0111\u1EA5y..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356871
    m_Localized: "Thi\u1EC7t h\u1EA1i ch\u01B0a lan r\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356872
    m_Localized: "Gi\u1EDD v\u1EA5n \u0111\u1EC1 l\xE0 d\u1EA5u v\u1EBFt c\u1EE7a
      nh\xF3m n\xE0y d\u1EABn theo con \u0111\u01B0\u1EDDng n\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356873
    m_Localized: "D\u1EA5u ch\xE2n v\u1EABn ti\u1EBFp t\u1EE5c t\u1EEB b\xEAn ngo\xE0i
      c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356874
    m_Localized: "H\u1EA7u nh\u01B0 kh\xF4ng c\xF3 d\u1EA5u hi\u1EC7u ch\xFAng d\u1EEBng
      l\u1EA1i hay \u0111i v\xF2ng quanh."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356875
    m_Localized: "V\u1EADy th\xEC c\u0169ng nh\u01B0 \u1EDF Cies, ch\xFAng ta \u0111\xE3
      ch\u1EB7n nh\xF3m b\u1ECB d\u1ED3n v\u1EC1 \u0111\xE2y r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356876
    m_Localized: "\u1EEA. Nh\u01B0ng Zeppel c\xF3 nhi\u1EC1u \u0111\u01B0\u1EDDng
      h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356877
    m_Localized: "D\xF9 ch\u1EB7n \u1EDF c\u1ED5ng, ch\xFAng v\u1EABn c\xF3 th\u1EC3
      t\xE1ch sang \u0111\u01B0\u1EDDng kh\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356878
    m_Localized: "H\xE3y s\u1EAFp x\u1EBFp l\u1EA1i ghi ch\xE9p ph\xF2ng th\u1EE7
      \u1EDF c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356879
    m_Localized: "H\xE3y \u0111\u1ED1i chi\u1EBFu c\xF9ng ghi ch\xE9p \u1EDF Cies."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356880
    m_Localized: "\u0110\u1ED1i chi\u1EBFu ch\xFAng s\u1EBD gi\xFAp t\xECm ra \u0111i\u1EC3m
      t\xE1ch."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356881
    m_Localized: "Ch\u1EC9 huy, c\xF3 th\xEAm b\xE1o c\xE1o t\u1EEB khu n\xF4ng tr\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356882
    m_Localized: "Nhi\u1EC1u h\xE0ng r\xE0o \u0111\xE3 b\u1ECB \u0111\u1EA9y \u0111\u1ED5,
      v\xE0 qu\xE1i v\u1EADt \u0111ang \u0111i qua gi\u1EEFa c\xE1c c\xE1nh \u0111\u1ED3ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356883
    m_Localized: "Gi\u1EEFa c\xE1c c\xE1nh \u0111\u1ED3ng? C\xF2n ng\u01B0\u1EDDi
      d\xE2n th\xEC sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356884
    m_Localized: "Ng\u01B0\u1EDDi qu\u1EA3n l\xFD \u0111ang s\u01A1 t\xE1n h\u1ECD,
      nh\u01B0ng \u0111\u01B0\u1EDDng trong n\xF4ng tr\u1EA1i r\u1ED9ng n\xEAn kh\xF3
      ch\u1EB7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356885
    m_Localized: "D\u1EA5u v\u1EBFt \u0111\xE3 t\xE1ch ra ngay r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356886
    m_Localized: "Tr\u01B0\u1EDBc h\u1EBFt h\xE3y ki\u1EC3m tra khu n\xF4ng tr\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356887
    m_Localized: "N\u1EBFu l\xE0 \u0111\u01B0\u1EDDng ru\u1ED9ng th\xEC ch\xE2n c\u0169ng
      s\u1EBD l\xFAn m\u1EA5t..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356888
    m_Localized: "H\xF4m nay \u0111\xE0nh b\u1ECF \u0111\xF4i gi\xE0y n\xE0y v\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356889
    m_Localized: "S\u1EAFp x\u1EBFp xong ghi ch\xE9p ph\xF2ng th\u1EE7 r\u1ED3i l\u1EADp
      t\u1EE9c di chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233848356890
    m_Localized: "Khu n\xF4ng tr\u1EA1i Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745472
    m_Localized: "C\xF3 ph\u1EA3i c\xE1c v\u1ECB l\xE0 H\u1ED9 V\u1EC7 kh\xF4ng?
      L\u1ED1i n\xE0y!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745473
    m_Localized: "Qu\xE1i v\u1EADt \u0111\xE3 ph\xE1 h\xE0ng r\xE0o v\xE0 \u0111i
      qua gi\u1EEFa c\xE1c c\xE1nh \u0111\u1ED3ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745474
    m_Localized: "M\u1ECDi ng\u01B0\u1EDDi \u0111\xE3 s\u01A1 t\xE1n h\u1EBFt ch\u01B0a?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745475
    m_Localized: "Ch\xFAng t\xF4i \u0111\xE3 s\u01A1 t\xE1n nh\u1EEFng ng\u01B0\u1EDDi
      \u1EDF g\u1EA7n \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745476
    m_Localized: "Nh\u01B0ng vi\u1EC7c s\u01A1 t\xE1n tr\xEAn \u0111\u01B0\u1EDDng
      ph\xEDa kho l\xE0m vi\u1EC7c v\u1EABn ch\u01B0a xong."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745477
    m_Localized: "H\u1EA7u nh\u01B0 kh\xF4ng c\xF3 d\u1EA5u hi\u1EC7u ch\xFAng \u0111\xE3
      \u0103n c\xE2y tr\u1ED3ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745478
    m_Localized: "Kh\xF4ng gi\u1ED1ng nh\u01B0 ch\xFAng c\u1ED1 t\xECnh ph\xE1 h\xE0ng
      r\xE0o. C\xF3 v\u1EBB ch\xFAng ch\u1EC9 \u0111\u1EA9y n\xF3 sang m\u1ED9t b\xEAn
      khi \u0111i qua."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745479
    m_Localized: "\u0110\u01B0\u1EDDng trong n\xF4ng tr\u1EA1i r\u1ED9ng l\u1EA1i
      th\xE0nh v\u1EA5n \u0111\u1EC1."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745480
    m_Localized: "C\xE0ng c\xF3 nhi\u1EC1u \u0111\u01B0\u1EDDng c\u1EA7n ch\u1EB7n
      th\xEC qu\xE1i v\u1EADt c\xE0ng c\xF3 nhi\u1EC1u \u0111\u01B0\u1EDDng \u0111\u1EC3
      tho\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745481
    m_Localized: "Ch\xE2n d\u1EC5 l\xFAn v\xE0o \u0111\u01B0\u1EDDng ru\u1ED9ng h\u01A1n
      v\u1EBB ngo\xE0i \u0111\u1EA5y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745482
    m_Localized: "N\u1EBFu ng\xE3 th\xEC qu\u1EA7n \xE1o c\xF3 khi c\xF2n t\u1EC7
      h\u01A1n c\u1EA3 v\u1EBFt th\u01B0\u01A1ng..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745483
    m_Localized: "\u0110\u01B0\u1EE3c. V\u1EADy h\xE3y ch\u1EB7n ch\xFAng tr\u01B0\u1EDBc
      kho l\xE0m vi\u1EC7c!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745484
    m_Localized: "T\xF4i s\u1EBD kh\xF4ng \u0111\u1EC3 ch\xFAng \u0111\u1EBFn g\u1EA7n
      kho l\xE0m vi\u1EC7c!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745485
    m_Localized: "Qu\u1EA3n l\xFD, h\xE3y s\u01A1 t\xE1n m\u1ECDi ng\u01B0\u1EDDi
      sang ph\xEDa \u0111\u1ED1i di\u1EC7n kho l\xE0m vi\u1EC7c."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745486
    m_Localized: "Ch\xFAng ta s\u1EBD ch\u1EB7n nh\xF3m \u0111ang \u0111i v\xE0o
      gi\u1EEFa c\xE1c c\xE1nh \u0111\u1ED3ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745487
    m_Localized: "\u0110\xE3 r\xF5. T\xF4i s\u1EBD d\u1EABn h\u1ECD theo con \u0111\u01B0\u1EDDng
      ph\xEDa \u0111\u1ED1i di\u1EC7n kho l\xE0m vi\u1EC7c."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745488
    m_Localized: "D\u1EA5u ch\xE2n chia th\xE0nh hai h\u01B0\u1EDBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745489
    m_Localized: "D\u1EA5u v\u1EBFt c\u1EE7a nh\xF3m l\u1EDBn d\u1EABn qua gi\u1EEFa
      c\xE1nh \u0111\u1ED3ng, c\xF2n nh\xF3m nh\u1ECF \u0111i d\u1ECDc h\xE0ng r\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745490
    m_Localized: "N\u1EBFu kh\xF4ng ch\u1EB7n nh\xF3m \u0111i s\xE1t h\xE0ng r\xE0o
      tr\u01B0\u1EDBc, ch\xFAng s\u1EBD c\u1EAFt qua \u0111\u01B0\u1EDDng s\u01A1
      t\xE1n c\u1EE7a c\u01B0 d\xE2n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745491
    m_Localized: "Serah, h\xE3y gi\u1EEF ph\xEDa trong h\xE0ng r\xE0o tr\u01B0\u1EDBc
      kho l\xE0m vi\u1EC7c."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745492
    m_Localized: "C\u1EE9 giao cho t\xF4i! T\xF4i s\u1EBD kh\xF4ng \u0111\u1EC3 ch\xFAng
      v\u01B0\u1EE3t qua v\u1EC1 ph\xEDa kho l\xE0m vi\u1EC7c!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745493
    m_Localized: "\u0110\u1EEBng \u0111i qu\xE1 xa."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745494
    m_Localized: "K\xE9o ng\u01B0\u1EDDi b\u1ECB l\xFAn trong b\xF9n ra c\xF2n kh\xF3
      h\u01A1n ch\u1EEFa tr\u1ECB..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745495
    m_Localized: "Nh\xF3m \u1EDF gi\u1EEFa c\xE1nh \u0111\u1ED3ng \u0111ang \u0111\u1EBFn
      g\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745496
    m_Localized: "Ch\xFAng \u0111ang \u0111i th\u1EB3ng v\xE0o gi\u1EEFa c\xE1nh
      \u0111\u1ED3ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745497
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n ch\xFAng \u1EDF con \u0111\u01B0\u1EDDng
      gi\u1EEFa c\xE1c c\xE1nh \u0111\u1ED3ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745498
    m_Localized: "H\xE3y ch\u1EB7n nh\xF3m qu\xE1i v\u1EADt tr\u01B0\u1EDBc khi ch\xFAng
      v\xE0o \u0111\u01B0\u1EDDng s\u01A1 t\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745499
    m_Localized: "\u0110\xE3 ng\u0103n \u0111\u01B0\u1EE3c thi\u1EC7t h\u1EA1i \u1EDF
      ph\xEDa kho l\xE0m vi\u1EC7c."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745500
    m_Localized: "Ng\u01B0\u1EDDi d\xE2n c\u0169ng kh\xF4ng ai b\u1ECB th\u01B0\u01A1ng
      n\u1EB7ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745501
    m_Localized: "May qu\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745502
    m_Localized: "N\u1EBFu h\xE0ng r\xE0o b\u1ECB \u0111\u1EA9y \u0111\u1EBFn m\u1EE9c
      \u0111\xF3, c\xF3 ng\u01B0\u1EDDi \u1EDF g\u1EA7n th\xEC s\u1EBD r\u1EA5t nguy
      hi\u1EC3m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745503
    m_Localized: "\u1EEA. H\u1EA7u nh\u01B0 kh\xF4ng c\xF3 d\u1EA5u hi\u1EC7u qu\xE1i
      v\u1EADt d\u1EEBng l\u1EA1i \u0111\u1EC3 chi\u1EBFn \u0111\u1EA5u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745504
    m_Localized: "Ch\xFAng b\u1ECB d\u1ED3n qua c\xE1nh \u0111\u1ED3ng nh\u01B0 th\u1EC3
      \u0111\xE3 l\u1EA1c \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745505
    m_Localized: "\u0110\u1ECBa h\xECnh n\xF4ng tr\u1EA1i khi\u1EBFn d\u1EA5u ch\xE2n
      t\xE1ch ra."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745506
    m_Localized: "Ch\xFAng ta \u0111\xE3 ch\u1EB7n m\u1ED9t ph\xEDa, nh\u01B0ng d\u1EA5u
      v\u1EBFt c\xF2n l\u1EA1i v\u1EABn d\u1EABn v\u1EC1 ph\xEDa khu ch\u1EE3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745507
    m_Localized: "N\u1EBFu l\xE0 ch\u1EE3 th\xEC ch\u1EAFc s\u1EBD c\xF3 nhi\u1EC1u
      ng\u01B0\u1EDDi h\u01A1n nh\u1EC9...?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745508
    m_Localized: "\u0110i l\u1EA1i s\u1EBD d\u1EC5 h\u01A1n tr\xEAn ru\u1ED9ng, nh\u01B0ng
      ng\u01B0\u1EDDi v\xE0 h\xE0nh l\xFD c\u0169ng s\u1EBD nhi\u1EC1u h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745509
    m_Localized: "C\xF3 l\u1EBD v\u1EABn c\xF2n th\u01B0\u01A1ng nh\xE2n ch\u01B0a
      k\u1ECBp s\u01A1 t\xE1n \u1EDF ph\xEDa ch\u1EE3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745510
    m_Localized: "C\u0169ng c\xF3 nhi\u1EC1u ng\u01B0\u1EDDi kh\xF3 b\u1ECF h\xE0ng
      h\xF3a \u0111\u1EC3 l\u1EADp t\u1EE9c di chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745511
    m_Localized: "V\u1EADy ph\u1EA3i \u0111i nhanh th\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745512
    m_Localized: "S\u1EBD c\xE0ng nguy hi\u1EC3m n\u1EBFu ch\xFAng ti\u1EBFn v\xE0o
      n\u01A1i \u0111\xF4ng ng\u01B0\u1EDDi."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745513
    m_Localized: "D\u1EA5u ch\xE2n d\u1EABn \u0111\u1EBFn con \u0111\u01B0\u1EDDng
      l\u1EDBn trong ch\u1EE3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745514
    m_Localized: "M\u1ED9t ph\u1EA7n \u0111\xE3 \u0111i theo con \u0111\u01B0\u1EDDng
      d\xE0nh cho xe ch\u1EDF h\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745515
    m_Localized: "Qu\xE1i v\u1EADt kh\xF4ng nh\u1EAFm v\xE0o ng\u01B0\u1EDDi. Ch\xFAng
      ch\u1EC9 b\u1ECB d\u1ED3n l\xEAn con \u0111\u01B0\u1EDDng ng\u01B0\u1EDDi d\xE2n
      s\u1EED d\u1EE5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745516
    m_Localized: "V\xEC v\u1EADy ph\xEDa ch\u1EB7n ch\xFAng c\u0169ng kh\xF3 x\u1EED
      l\xFD h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745517
    m_Localized: "H\xE3y giao khu n\xF4ng tr\u1EA1i cho ng\u01B0\u1EDDi qu\u1EA3n
      l\xFD, c\xF2n ch\xFAng ta di chuy\u1EC3n \u0111\u1EBFn khu ch\u1EE3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745518
    m_Localized: "N\u1EBFu \u1EDF ch\u1EE3 th\xEC t\xECm ng\u01B0\u1EDDi b\u1ECB
      th\u01B0\u01A1ng c\u0169ng \u0111\u1EE7 th\xE0nh m\u1ED9t vi\u1EC7c r\u1ED3i
      nh\u1EC9."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745519
    m_Localized: "\u0110\u1EEBng ngh\u0129 vi\u1EC7c t\xECm ng\u01B0\u1EDDi l\xE0
      m\u1ED9t c\xF4ng vi\u1EC7c."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745520
    m_Localized: "\u01AF... N\u1EBFu m\u1EA5t qu\xE1 nhi\u1EC1u th\u1EDDi gian ch\u1EC9
      \u0111\u1EC3 t\xECm h\u1ECD th\xEC vi\u1EC7c ch\u1EEFa tr\u1ECB c\u0169ng s\u1EBD
      b\u1ECB ch\u1EADm."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745521
    m_Localized: "Khu ch\u1EE3 Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745522
    m_Localized: "L\u1ED1i n\xE0y! Xe ch\u1EDF h\xE0ng \u0111ang ch\u1EB7n \u0111\u01B0\u1EDDng!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745523
    m_Localized: "C\u01B0 d\xE2n \u0111ang di chuy\u1EC3n v\xE0o c\xE1c ng\xF5 b\xEAn
      trong."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745524
    m_Localized: "Nh\u01B0ng con \u0111\u01B0\u1EDDng l\u1EDBn trong ch\u1EE3 v\u1EABn
      ch\u01B0a \u0111\u01B0\u1EE3c d\u1ECDn xong."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745525
    m_Localized: "Con ng\u01B0\u1EDDi l\xE0 tr\xEAn h\u1EBFt."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745526
    m_Localized: "N\u1EBFu c\u1EA7n th\xEC ch\xEDnh ch\xFAng ta s\u1EBD \u0111\u1EA9y
      xe ch\u1EDF h\xE0ng ra!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745527
    m_Localized: "N\u1EBFu v\u1ED9i \u0111\u1EA9y chi\u1EBFc xe n\u1EB7ng nh\u01B0
      v\u1EADy th\xEC l\u01B0ng s\u1EBD ch\u1ECBu tr\u1EADn tr\u01B0\u1EDBc m\u1EA5t..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745528
    m_Localized: "D\xF9 sao v\u1EABn c\xF2n h\u01A1n b\u1ECB qu\xE1i v\u1EADt \u0111\u1EA9y
      l\xF9i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745529
    m_Localized: "D\u1EA5u ch\xE2n t\u1EEB ph\xEDa n\xF4ng tr\u1EA1i d\u1EABn \u0111\u1EBFn
      \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745530
    m_Localized: "Kh\xF4ng ph\u1EA3i ch\xFAng tr\xE1nh c\xE1c s\u1EA1p h\xE0ng, m\xE0
      c\xF3 v\u1EBB ch\xFAng \u0111\xE3 \u0111i theo nh\u1EEFng kho\u1EA3ng tr\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745531
    m_Localized: "Con \u0111\u01B0\u1EDDng l\u1EDBn trong ch\u1EE3 v\u1EEBa l\xE0
      n\u01A1i th\u01B0\u01A1ng nh\xE2n bu\xF4n b\xE1n, v\u1EEBa l\xE0 \u0111\u01B0\u1EDDng
      s\u01A1 t\xE1n c\u1EE7a c\u01B0 d\xE2n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745532
    m_Localized: "N\u1EBFu qu\xE1i v\u1EADt chen v\xE0o con \u0111\u01B0\u1EDDng
      l\u1EDBn trong ch\u1EE3, ng\u01B0\u1EDDi d\xE2n s\u1EBD b\u1ECB th\u01B0\u01A1ng
      d\xF9 ch\xFAng kh\xF4ng nh\u1EAFm v\xE0o h\u1ECD."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745533
    m_Localized: "H\xE3y \u0111\u1EC3 \u0111\u01B0\u1EDDng s\u01A1 t\xE1n th\xF4ng
      tho\xE1ng v\xE0 ch\u1EB7n nh\xF3m \u0111ang ti\u1EBFn v\xE0o \u1EDF l\u1ED1i
      v\xE0o ch\u1EE3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745534
    m_Localized: "Hi\u1EC3u r\u1ED3i. T\xF4i s\u1EBD ch\u1EEBa m\u1ED9t l\u1ED1i
      cho m\u1ECDi ng\u01B0\u1EDDi \u0111i qua!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745535
    m_Localized: "N\u1EBFu Serah gi\u1EEF ph\xEDa tr\u01B0\u1EDBc, t\xF4i s\u1EBD
      \u0111\u1EC3 \xFD nh\xF3m l\u1EBBn ra gi\u1EEFa c\xE1c s\u1EA1p h\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745536
    m_Localized: "T\xF4i c\u0169ng s\u1EBD ki\u1EC3m tra chuy\u1EC3n \u0111\u1ED9ng
      tr\xEAn m\xE1i nh\xE0."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745537
    m_Localized: "\u1EDE ch\u1EE3 c\xF3 nhi\u1EC1u ch\u1ED7 che khu\u1EA5t t\u1EA7m
      nh\xECn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233856745538
    m_Localized: "H\xE3y \u0111\u01B0a ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng v\xE0o
      ph\xEDa trong tuy\u1EBFn ph\xF2ng th\u1EE7."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939776
    m_Localized: "N\u1EBFu h\u1ECD c\u1ED1 th\u1EE7 b\xEAn c\u1EA1nh s\u1EA1p h\xE0ng
      th\xEC t\xF4i s\u1EBD kh\xF3 t\xECm th\u1EA5y h\u1ECD..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939777
    m_Localized: "\u0110\u01B0\u1EDDng \u0111\xE3 \u0111\u01B0\u1EE3c d\u1ECDn r\u1ED3i!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939778
    m_Localized: "Nh\u01B0ng c\xF3 ti\u1EBFng \u0111\u1ED9ng \u1EDF l\u1ED1i v\xE0o
      ph\xEDa n\xF4ng tr\u1EA1i!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939779
    m_Localized: "Ch\xFAng \u0111ang ti\u1EBFn v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939780
    m_Localized: "Ph\u1EA3i ch\u1EB7n ch\xFAng tr\u01B0\u1EDBc khi ch\xFAng t\u1EA3n
      ra gi\u1EEFa c\xE1c s\u1EA1p h\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939781
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n ch\xFAng \u1EDF l\u1ED1i
      v\xE0o ch\u1EE3 tr\u01B0\u1EDBc khi ch\xFAng t\u1EA3n ra."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939782
    m_Localized: "C\u01B0 d\xE2n b\xEAn trong khu ch\u1EE3 \u0111\xE3 \u0111\u01B0\u1EE3c
      s\u01A1 t\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939783
    m_Localized: "\u0110\xE3 ng\u0103n \u0111\u01B0\u1EE3c thi\u1EC7t h\u1EA1i l\u1EDBn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939784
    m_Localized: "T\u1ED1t. Ch\xFAng ta \u0111\xE3 b\u1EA3o v\u1EC7 \u0111\u01B0\u1EE3c
      m\u1ECDi ng\u01B0\u1EDDi."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939785
    m_Localized: "V\u1EA5n \u0111\u1EC1 l\xE0 qu\xE1i v\u1EADt \u0111\xE3 ti\u1EBFn
      v\xE0o t\u1EADn \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939786
    m_Localized: "Kh\xF4ng c\xF3 d\u1EA5u hi\u1EC7u ch\xFAng \u0111u\u1ED5i theo
      ng\u01B0\u1EDDi d\xE2n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939787
    m_Localized: "Thay v\xE0o \u0111\xF3, ch\xFAng \u0111\xE3 \u0111i theo con \u0111\u01B0\u1EDDng
      m\u1EDF ra khi c\u01B0 d\xE2n s\u01A1 t\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939788
    m_Localized: "V\xEC v\u1EADy ch\xFAng m\u1EDBi nguy hi\u1EC3m h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939789
    m_Localized: "Zeppel c\xF3 nhi\u1EC1u con \u0111\u01B0\u1EDDng, n\xEAn ng\u01B0\u1EDDi
      d\xE2n c\xF3 nhi\u1EC1u ch\u1ED7 \u0111\u1EC3 tr\xE1nh \u0111i, nh\u01B0ng
      qu\xE1i v\u1EADt c\u0169ng c\xF3 th\u1EC3 t\u1EA3n ra theo nh\u1EEFng con \u0111\u01B0\u1EDDng
      tr\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939790
    m_Localized: "Khi m\u1ECDi ng\u01B0\u1EDDi b\u1ECB ph\xE2n t\xE1n th\xEC vi\u1EC7c
      ch\u1EEFa tr\u1ECB c\u0169ng kh\xF3 h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939791
    m_Localized: "Ch\u1EC9 t\xECm xem ai b\u1ECB th\u01B0\u01A1ng th\xF4i c\u0169ng
      \u0111\xE3 m\u1EA5t th\u1EDDi gian r\u1ED3i..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939792
    m_Localized: "Nghe n\xF3i kho h\xE0ng b\xEAn k\xEAnh n\u01B0\u1EDBc c\u0169ng
      x\u1EA3y ra n\xE1o lo\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939793
    m_Localized: "Nghe n\xF3i d\xF2ng n\u01B0\u1EDBc b\u1ECB ch\u1EB7n khi\u1EBFn
      con \u0111\u01B0\u1EDDng gi\u1EEFa c\xE1c kho h\xE0ng h\u1EB9p l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939794
    m_Localized: "D\u1EA5u ch\xE2n c\u0169ng d\u1EABn v\u1EC1 ph\xEDa k\xEAnh n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939795
    m_Localized: "Ch\xFAng \u0111i theo con \u0111\u01B0\u1EDDng l\u1EDBn trong ch\u1EE3
      r\u1ED3i r\u1EBD v\u1EC1 ph\xEDa k\xEAnh n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939796
    m_Localized: "N\u1EBFu k\xEAnh n\u01B0\u1EDBc b\u1ECB ch\u1EB7n, qu\xE1i v\u1EADt
      c\xF3 th\u1EC3 b\u1ECB d\u1ED3n v\xE0o con \u0111\u01B0\u1EDDng gi\u1EEFa c\xE1c
      kho h\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939797
    m_Localized: "\u0110i\u1EC1u \u0111\xF3 s\u1EBD \u1EA3nh h\u01B0\u1EDFng \u0111\u1EBFn
      c\u1EA3 vi\u1EC7c s\u01A1 t\xE1n ng\u01B0\u1EDDi d\xE2n, ch\u1EE9 kh\xF4ng
      ch\u1EC9 qu\xE1i v\u1EADt."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939798
    m_Localized: "V\u1EADy th\xEC ph\u1EA3i ch\u1EB7n c\u1EA3 nh\xF3m \u0111ang ti\u1EBFn
      v\xE0o ph\xEDa k\xEAnh n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939799
    m_Localized: "Ch\xFAng ta \u0111\xE3 b\u1EA3o v\u1EC7 \u0111\u01B0\u1EE3c khu
      ch\u1EE3, v\u1EADy ch\u1EC9 c\u1EA7n b\u1EA3o v\u1EC7 c\u1EA3 con \u0111\u01B0\u1EDDng
      ti\u1EBFp theo n\u1EEFa th\xF4i!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939800
    m_Localized: "G\u1EA7n m\xE9p n\u01B0\u1EDBc ch\u1EAFc tr\u01A1n l\u1EAFm..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939801
    m_Localized: "L\u1EA7n n\xE0y t\xF4i s\u1EBD nh\u1EAFc m\u1ECDi ng\u01B0\u1EDDi
      c\u1EA9n th\u1EADn tr\u01B0\u1EDBc khi c\xF3 ai b\u1ECB ng\xE3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939802
    m_Localized: "H\xE3y di chuy\u1EC3n \u0111\u1EBFn khu k\xEAnh n\u01B0\u1EDBc
      v\xE0 kho h\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939803
    m_Localized: "H\xE3y ki\u1EC3m tra xem d\xF2ng n\u01B0\u1EDBc c\xF3 \u1EA3nh
      h\u01B0\u1EDFng \u0111\u1EBFn chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a qu\xE1i v\u1EADt
      kh\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939804
    m_Localized: "K\xEAnh n\u01B0\u1EDBc v\xE0 khu kho h\xE0ng Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939805
    m_Localized: "C\xE1c v\u1ECB \u0111\u1EBFn t\u1EEB ph\xEDa khu ch\u1EE3 ph\u1EA3i
      kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939806
    m_Localized: "D\xF2ng n\u01B0\u1EDBc b\u1ECB ch\u1EB7n khi\u1EBFn con \u0111\u01B0\u1EDDng
      gi\u1EEFa c\xE1c kho h\xE0ng h\u1EB9p l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939807
    m_Localized: "Qu\xE1i v\u1EADt \u0111ang k\xE9o v\xE0o con \u0111\u01B0\u1EDDng
      gi\u1EEFa c\xE1c kho h\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939808
    m_Localized: "D\u1EA5u ch\xE2n r\u1EBD \u1EDF m\xE9p n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233860939809
    m_Localized: "V\u1EABn ch\u01B0a bi\u1EBFt ch\xFAng tr\xE1nh n\u01B0\u1EDBc hay
      b\u1ECB d\u1ED3n n\xEAn ph\u1EA3i v\xF2ng qua."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134080
    m_Localized: "Nh\u01B0ng c\xF3 th\u1EC3 th\u1EA5y qu\xE1i v\u1EADt \u0111\xE3
      b\u1ECB d\u1ED3n v\xE0o gi\u1EEFa c\xE1c kho h\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134081
    m_Localized: "K\xEAnh n\u01B0\u1EDBc b\u1ECB ch\u1EB7n c\u0169ng l\xE0m h\u1EB9p
      c\u1EA3 con \u0111\u01B0\u1EDDng ng\u01B0\u1EDDi d\xE2n \u0111i l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134082
    m_Localized: "\u0110\u01B0\u1EDDng \xEDt \u0111i th\xEC ch\u1EB3ng ph\u1EA3i
      s\u1EBD d\u1EC5 ch\u1EB7n h\u01A1n sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134083
    m_Localized: "\u0110\xFAng l\xE0 c\xF3 th\u1EC3 nh\u01B0 v\u1EADy trong th\u1EDDi
      gian ng\u1EAFn. Nh\u01B0ng n\u1EBFu ch\xFAng d\u1ED3n v\xE0o m\u1ED9t ch\u1ED7
      th\xEC tuy\u1EBFn ph\xF2ng th\u1EE7 c\u0169ng ph\u1EA3i ch\u1ECBu c\xFA va
      ch\u1EA1m l\u1EDBn h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134084
    m_Localized: "N\u1EBFu b\u1ECB \u0111\u1EA9y l\xF9i \u1EDF m\xE9p n\u01B0\u1EDBc
      th\xEC vi\u1EC7c x\u1EED l\xFD v\u1EBFt th\u01B0\u01A1ng c\u0169ng ph\u1EE9c
      t\u1EA1p h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134085
    m_Localized: "Tr\u01A1n tr\u01B0\u1EE3t, va \u0111\u1EADp, r\u1ED3i c\xF2n b\u1ECB
      \u01B0\u1EDBt n\u1EEFa... \u0110\xFAng l\xE0 m\u1ED9t s\u1EF1 k\u1EBFt h\u1EE3p
      ch\u1EB3ng hay ho g\xEC."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134086
    m_Localized: "C\xF2n ai \u1EDF g\u1EA7n m\xE9p n\u01B0\u1EDBc kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134087
    m_Localized: "Ch\xFAng t\xF4i \u0111\xE3 s\u01A1 t\xE1n c\xE1c nh\xE2n vi\xEAn
      kho h\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134088
    m_Localized: "Nh\u01B0ng v\u1EADt t\u01B0 trong kho \u0111ang ch\u1EAFn \u0111\u01B0\u1EDDng
      n\xEAn vi\u1EC7c s\u1EEDa ch\u1EEFa k\xEAnh n\u01B0\u1EDBc b\u1ECB ch\u1EADm
      l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134089
    m_Localized: "D\u1EA5u v\u1EBFt c\u1EE7a nh\xF3m l\u1EDBn d\u1EABn v\xE0o gi\u1EEFa
      c\xE1c kho h\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134090
    m_Localized: "V\u1EBFt l\xFAn s\xE2u h\u01A1n nh\u1EEFng g\xEC ch\xFAng ta th\u1EA5y
      \u1EDF khu ch\u1EE3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134091
    m_Localized: "C\xF3 ngh\u0129a l\xE0 c\xF3 th\u1EE9 g\xEC \u0111\xF3 l\u1EDBn
      h\u01A1n sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134092
    m_Localized: "C\u0169ng c\xF3 kh\u1EA3 n\u0103ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134093
    m_Localized: "Nh\u01B0ng m\u1ED1i \u0111e d\u1ECDa tr\u01B0\u1EDBc m\u1EAFt l\xE0
      nh\xF3m \u0111ang ti\u1EBFn v\xE0o gi\u1EEFa c\xE1c kho h\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134094
    m_Localized: "Mu\u1ED1n ki\u1EC3m tra chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn h\u01A1n
      th\xEC tr\u01B0\u1EDBc h\u1EBFt ph\u1EA3i m\u1EDF con \u0111\u01B0\u1EDDng
      b\xEAn k\xEAnh n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134095
    m_Localized: "N\u1EBFu kh\xF4ng s\u1EEDa k\xEAnh n\u01B0\u1EDBc th\xEC tuy\u1EBFn
      ph\xF2ng th\u1EE7 ti\u1EBFp theo c\u0169ng s\u1EBD kh\xF4ng \u1ED5n \u0111\u1ECBnh."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134096
    m_Localized: "\u0110\u01B0\u1EE3c. V\u1EADy tr\u01B0\u1EDBc h\u1EBFt h\xE3y ch\u1EB7n
      \u1EDF con \u0111\u01B0\u1EDDng b\xEAn k\xEAnh n\u01B0\u1EDBc!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134097
    m_Localized: "C\u1EA9n th\u1EADn khi \u0111\u1EBFn g\u1EA7n m\xE9p n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134098
    m_Localized: "N\u1EBFu c\xF3 ai r\u01A1i xu\u1ED1ng n\u01B0\u1EDBc th\xEC c\xF3
      khi t\xF4i s\u1EBD m\u1EAFng h\u1ECD tr\u01B0\u1EDBc c\u1EA3 khi ch\u1EEFa
      tr\u1ECB..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233865134099
    m_Localized: "Nh\xF3m b\xEAn ph\xEDa kho h\xE0ng \u0111ang \u0111\u1EBFn g\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328384
    m_Localized: "Ch\xFAng \u0111ang ti\u1EBFn v\xE0o con \u0111\u01B0\u1EDDng h\u1EB9p
      gi\u1EEFa c\xE1c kho h\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328385
    m_Localized: "H\xE3y ch\u1EB7n ch\xFAng \u1EDF con \u0111\u01B0\u1EDDng b\xEAn
      k\xEAnh n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328386
    m_Localized: "H\xE3y ng\u0103n qu\xE1i v\u1EADt ti\u1EBFn s\xE2u v\xE0o ph\xEDa
      trong kho h\xE0ng cho \u0111\u1EBFn khi s\u1EEDa xong d\xF2ng n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328387
    m_Localized: "Thi\u1EC7t h\u1EA1i quanh khu kho h\xE0ng kh\xF4ng lan r\u1ED9ng
      th\xEAm."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328388
    m_Localized: "Nh\u01B0ng ph\u1EA3i s\u1EEDa k\xEAnh n\u01B0\u1EDBc ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328389
    m_Localized: "D\u1EA5u v\u1EBFt c\u1EE7a nh\xF3m l\u1EDBn ch\u01B0a k\u1EBFt
      th\xFAc \u1EDF \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328390
    m_Localized: "N\xF3 d\u1EABn v\u1EC1 ph\xEDa qu\u1EA3ng tr\u01B0\u1EDDng tr\u01B0\u1EDBc
      dinh l\xE3nh ch\xFAa."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328391
    m_Localized: "\u0110\u1EBFn qu\u1EA3ng tr\u01B0\u1EDDng th\xEC ch\u1EB3ng ph\u1EA3i
      s\u1EBD c\xF3 nhi\u1EC1u ng\u01B0\u1EDDi t\u1EADp trung h\u01A1n sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328392
    m_Localized: "Khu v\u1EF1c s\u01A1 t\xE1n n\u1EB1m g\u1EA7n qu\u1EA3ng tr\u01B0\u1EDDng
      tr\u01B0\u1EDBc dinh l\xE3nh ch\xFAa."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328393
    m_Localized: "Hi\u1EC7n t\u1EA1i l\xEDnh canh \u0111ang ch\u1EB7n ph\xEDa ngo\xE0i
      qu\u1EA3ng tr\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328394
    m_Localized: "C\xF3 v\u1EBB k\xEAnh n\u01B0\u1EDBc b\u1ECB ch\u1EB7n \u0111\xE3
      khi\u1EBFn c\xE1c tuy\u1EBFn \u0111\u01B0\u1EDDng r\u1ED1i lo\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328395
    m_Localized: "Qu\xE1i v\u1EADt kh\xF4ng \u0111i theo d\xF2ng n\u01B0\u1EDBc,
      nh\u01B0ng d\xF2ng n\u01B0\u1EDBc b\u1ECB ch\u1EB7n \u0111\xE3 d\u1ED3n ch\xFAng
      l\xEAn nh\u1EEFng con \u0111\u01B0\u1EDDng ng\u01B0\u1EDDi d\xE2n s\u1EED d\u1EE5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328396
    m_Localized: "V\u1EADy l\xE0 ph\u1EA3i kh\u01A1i th\xF4ng d\xF2ng n\u01B0\u1EDBc,
      ch\u1EB7n qu\xE1i v\u1EADt v\xE0 b\u1EA3o v\u1EC7 ng\u01B0\u1EDDi d\xE2n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328397
    m_Localized: "H\xF4m nay c\xF3 qu\xE1 nhi\u1EC1u th\u1EE9 ph\u1EA3i lo li\u1EC7u..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328398
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn v\u1EABn c\xF2n \u1EDF ph\xEDa
      qu\u1EA3ng tr\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328399
    m_Localized: "N\xF3 n\u1EB7ng h\u01A1n h\u1EB3n nh\xF3m \u0111i xu\u1ED1ng tr\u01B0\u1EDBc
      \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328400
    m_Localized: "Tr\u01B0\u1EDBc khi \u0111\u1EBFn qu\u1EA3ng tr\u01B0\u1EDDng,
      h\xE3y s\u1EEDa k\xEAnh n\u01B0\u1EDBc v\xE0 tuy\u1EBFn ph\xF2ng th\u1EE7."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328401
    m_Localized: "Ph\u1EA3i l\xE0m ch\u1EADm chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a
      qu\xE1i v\u1EADt \u0111ang d\u1ED3n v\u1EC1 qu\u1EA3ng tr\u01B0\u1EDDng, d\xF9
      ch\u1EC9 \u0111\u01B0\u1EE3c m\u1ED9t ch\xFAt."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328402
    m_Localized: "\u1EEA. Mau \u0111\u1EA9y nhanh vi\u1EC7c s\u1EEDa ch\u1EEFa th\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328403
    m_Localized: "N\u1EBFu c\u1EE9 \u0111\u1EC3 nguy\xEAn th\xEC tuy\u1EBFn ph\xF2ng
      th\u1EE7 \u1EDF qu\u1EA3ng tr\u01B0\u1EDDng s\u1EBD lung lay s\u1EDBm h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328404
    m_Localized: "Hi\u1EC3u r\u1ED3i. T\xF4i s\u1EBD gi\u1EEF con \u0111\u01B0\u1EDDng
      gi\u1EEFa c\xE1c kho h\xE0ng trong l\xFAc s\u1EEDa ch\u1EEFa!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328405
    m_Localized: "V\u1EADy t\xF4i s\u1EBD ki\u1EC3m tra ph\xEDa \u0111\u1ED9i s\u1EEDa
      ch\u1EEFa tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328406
    m_Localized: "Sau m\u1ED7i l\u1EA7n l\xE0m vi\u1EC7c g\u1EA7n m\xE9p n\u01B0\u1EDBc,
      th\u1EBF n\xE0o c\u0169ng c\xF3 ng\u01B0\u1EDDi b\u1ECB tr\u01B0\u1EE3t ng\xE3..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328407
    m_Localized: "Tuy\u1EBFn ph\xF2ng th\u1EE7 t\u1EA1m th\u1EDDi \u1EDF k\xEAnh
      n\u01B0\u1EDBc v\xE0 khu kho h\xE0ng Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328408
    m_Localized: "D\xF2ng n\u01B0\u1EDBc b\u1ECB ch\u1EB7n \u0111\xE3 \u0111\u01B0\u1EE3c
      kh\u01A1i th\xF4ng m\u1ED9t ph\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328409
    m_Localized: "Nh\u01B0ng mu\u1ED1n d\u1ECDn h\u1EBFt \u0111\u1EA5t \u0111\xE1
      th\xEC v\u1EABn c\u1EA7n th\xEAm th\u1EDDi gian."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328410
    m_Localized: "Gi\u1EDD kh\xF4ng c\xF3 th\u1EDDi gian \u0111\u1EC3 d\u1ECDn h\u1EBFt
      m\u1ECDi th\u1EE9."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328411
    m_Localized: "Ph\u1EA3i k\xE9o d\xE0i th\u1EDDi gian \u0111\u1EC3 tuy\u1EBFn
      ph\xF2ng th\u1EE7 \u1EDF l\u1ED1i v\xE0o qu\u1EA3ng tr\u01B0\u1EDDng c\xF3
      th\u1EC3 tr\u1EE5 v\u1EEFng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328412
    m_Localized: "\u0110\u01B0\u1EE3c. V\u1EADy ch\xEDnh ch\xFAng ta s\u1EBD kh\u01A1i
      d\xF2ng n\u01B0\u1EDBc th\xEAm m\u1ED9t ch\xFAt n\u1EEFa!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328413
    m_Localized: "Tuy\u1EBFn ph\xF2ng th\u1EE7 d\u1EF1ng v\u1ED9i l\xFAc n\xE0o c\u0169ng
      l\u1EA1i g\xE2y r\u1EAFc r\u1ED1i..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328414
    m_Localized: "D\xF9 v\u1EADy, tr\u01B0\u1EDBc m\u1EAFt ph\u1EA3i gi\u1EEF cho
      n\xF3 kh\xF4ng s\u1EE5p xu\u1ED1ng \u0111\xE3..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328415
    m_Localized: "D\u1EA5u v\u1EBFt c\u1EE7a nh\xF3m l\u1EDBn v\u1EABn ti\u1EBFp
      t\u1EE5c d\u1EABn v\u1EC1 ph\xEDa qu\u1EA3ng tr\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328416
    m_Localized: "C\u1EA3 nh\u1EEFng qu\xE1i v\u1EADt xung quanh c\u0169ng \u0111ang
      b\u1ECB cu\u1ED1n v\u1EC1 ph\xEDa qu\u1EA3ng tr\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328417
    m_Localized: "V\u1EABn ch\u01B0a bi\u1EBFt con th\u1EC3 l\u1EDBn \u0111ang d\u1EABn
      c\u1EA3 nh\xF3m hay c\u0169ng b\u1ECB d\u1ED3n \u0111\u1EBFn \u0111\xE2y nh\u01B0
      nh\u1EEFng con kh\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328418
    m_Localized: "Nh\u01B0ng c\xF3 m\u1ED9t \u0111i\u1EC1u ch\u1EAFc ch\u1EAFn. N\u1EBFu
      ch\xFAng v\u01B0\u1EE3t qua l\u1ED1i v\xE0o qu\u1EA3ng tr\u01B0\u1EDDng th\xEC
      thi\u1EC7t h\u1EA1i s\u1EBD lan r\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328419
    m_Localized: "H\xE3y chu\u1EA9n b\u1ECB ph\xF2ng th\u1EE7 qu\u1EA3ng tr\u01B0\u1EDDng
      tr\u01B0\u1EDBc dinh l\xE3nh ch\xFAa, r\u1ED3i l\u1EADp t\u1EE9c di chuy\u1EC3n
      ngay khi s\u1EEDa ch\u1EEFa t\u1EA1m th\u1EDDi xong."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328420
    m_Localized: "Ch\xFAng t\xF4i s\u1EBD gia c\u1ED1 tuy\u1EBFn ph\xF2ng th\u1EE7
      t\u1EA1m th\u1EDDi b\xEAn k\xEAnh n\u01B0\u1EDBc v\xE0 c\u0169ng b\xE1o cho
      c\xE1c l\xEDnh canh \u1EDF ph\xEDa qu\u1EA3ng tr\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328421
    m_Localized: "H\xE3y h\u01B0\u1EDBng ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng
      \u0111\u1EBFn \u0111\u01B0\u1EDDng s\u01A1 t\xE1n ph\xEDa sau dinh l\xE3nh
      ch\xFAa."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328422
    m_Localized: "N\u1EBFu \u0111\u01B0\u1EDDng s\u01A1 t\xE1n b\u1ECB ch\u1EB7n
      th\xEC vi\u1EC7c ch\u1EEFa tr\u1ECB c\u0169ng s\u1EBD ch\u1EADm l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328423
    m_Localized: "Hi\u1EC3u r\u1ED3i. T\xF4i s\u1EBD \u0111\u1EC3 \u0111\u01B0\u1EDDng
      s\u01A1 t\xE1n th\xF4ng tho\xE1ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328424
    m_Localized: "Qu\xE1i v\u1EADt \u1EDF ph\xEDa k\xEAnh n\u01B0\u1EDBc \u0111\xE3
      ch\u1EADm l\u1EA1i m\u1ED9t ch\xFAt."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328425
    m_Localized: "C\xF3 v\u1EBB vi\u1EC7c m\u1EDF d\xF2ng n\u01B0\u1EDBc \u0111\xE3
      c\xF3 t\xE1c d\u1EE5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328426
    m_Localized: "V\u1EADy th\xEC ph\u1EA3i tranh th\u1EE7 l\xFAc n\xE0y \u0111\u1EC3
      s\u1EEDa ch\u1EEFa. Nh\u01B0ng kh\xF4ng \u0111\u01B0\u1EE3c m\u1EAFc k\u1EB9t
      \u1EDF \u0111\xE2y qu\xE1 l\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328427
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a con th\u1EC3 l\u1EDBn \u0111ang
      \u0111\u1EBFn g\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328428
    m_Localized: "Nh\xF3m ph\xEDa tr\u01B0\u1EDBc s\u1EBD \u0111\u1EBFn l\u1ED1i
      v\xE0o qu\u1EA3ng tr\u01B0\u1EDDng tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328429
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y di chuy\u1EC3n \u0111\u1EBFn l\u1ED1i
      v\xE0o qu\u1EA3ng tr\u01B0\u1EDDng v\xE0 ch\u1EB7n ch\xFAng tr\u01B0\u1EDBc
      khi ch\xFAng ti\u1EBFn v\xE0o trung t\xE2m Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328430
    m_Localized: "Qu\u1EA3ng tr\u01B0\u1EDDng tr\u01B0\u1EDBc dinh l\xE3nh ch\xFAa
      Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328431
    m_Localized: "C\u01B0 d\xE2n \u0111\xE3 di chuy\u1EC3n \u0111\u1EBFn \u0111\u01B0\u1EDDng
      s\u01A1 t\xE1n ph\xEDa sau dinh l\xE3nh ch\xFAa."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328432
    m_Localized: "Ch\u1EC9 c\u1EA7n gi\u1EEF l\u1ED1i v\xE0o qu\u1EA3ng tr\u01B0\u1EDDng
      th\xEC c\xF3 th\u1EC3 ng\u0103n thi\u1EC7t h\u1EA1i lan \u0111\u1EBFn khu trung
      t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328433
    m_Localized: "V\u1EADy th\xEC k\u1EBFt th\xFAc chuy\u1EC7n n\xE0y \u1EDF l\u1ED1i
      v\xE0o qu\u1EA3ng tr\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328434
    m_Localized: "T\xF4i s\u1EBD b\u1EA3o v\u1EC7 trung t\xE2m Zeppel!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328435
    m_Localized: "D\u1EA5u v\u1EBFt c\u1EE7a nh\xF3m l\u1EDBn t\u1EEB ph\xEDa k\xEAnh
      n\u01B0\u1EDBc v\u1EABn ti\u1EBFp t\u1EE5c \u0111\u1EBFn l\u1ED1i v\xE0o qu\u1EA3ng
      tr\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328436
    m_Localized: "D\u1EA5u v\u1EBFt c\u1EE7a nh\u1EEFng qu\xE1i v\u1EADt xung quanh
      c\u0169ng ch\u1ED3ng l\xEAn nhau theo c\xF9ng m\u1ED9t h\u01B0\u1EDBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328437
    m_Localized: "Sau khi s\u1EEDa k\xEAnh n\u01B0\u1EDBc, ngay c\u1EA3 l\xEDnh canh
      c\u0169ng c\xF3 th\u1EC3 ch\u1EB7n \u0111\u01B0\u1EE3c qu\xE1i v\u1EADt \u1EDF
      ph\xEDa \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328438
    m_Localized: "Nh\u01B0ng n\u1EBFu con th\u1EC3 l\u1EDBn c\u1EA7m c\u1EF1 qu\xE1
      l\xE2u th\xEC tuy\u1EBFn ph\xF2ng th\u1EE7 \u1EDF l\u1ED1i v\xE0o qu\u1EA3ng
      tr\u01B0\u1EDDng s\u1EBD lung lay."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328439
    m_Localized: "Qu\u1EA3ng tr\u01B0\u1EDDng r\u1ED9ng n\xEAn ch\u1EAFc s\u1EBD
      d\u1EC5 t\xECm ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng h\u01A1n, nh\u01B0ng..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328440
    m_Localized: "Nh\u01B0 v\u1EADy c\xF3 v\u1EBB t\xF4i c\u0169ng s\u1EBD ph\u1EA3i
      ch\u1EA1y \u0111i ch\u1EA1y l\u1EA1i nhi\u1EC1u h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328441
    m_Localized: "H\xE3y \u0111\u1EC3 \u0111\u01B0\u1EDDng s\u01A1 t\xE1n th\xF4ng
      tho\xE1ng v\xE0 ch\u1EB7n ch\xFAng \u1EDF l\u1ED1i v\xE0o qu\u1EA3ng tr\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328442
    m_Localized: "D\xF9 con th\u1EC3 l\u1EDBn xu\u1EA5t hi\u1EC7n, tr\u01B0\u1EDBc
      h\u1EBFt h\xE3y ch\u1EB7n nh\xF3m \u0111i xu\u1ED1ng tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328443
    m_Localized: "\u1EEA. Con th\u1EC3 l\u1EDBn v\u1EABn c\xF2n \u1EDF ph\xEDa sau
      nh\xF3m \u0111i tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328444
    m_Localized: "Nh\xF3m \u0111ang \u1EDF tr\u01B0\u1EDBc con th\u1EC3 l\u1EDBn
      s\u1EBD \u0111\u1EBFn l\u1ED1i v\xE0o qu\u1EA3ng tr\u01B0\u1EDDng tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328445
    m_Localized: "T\xF4i s\u1EBD ch\u1EB7n nh\xF3m \u0111i tr\u01B0\u1EDBc!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328446
    m_Localized: "Khi con th\u1EC3 l\u1EDBn \u0111\u1EBFn th\xEC ch\xFAng ta ch\u1EB7n
      lu\xF4n n\xF3 l\xE0 \u0111\u01B0\u1EE3c!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328447
    m_Localized: "\u1EEA. Nh\u01B0ng n\u1EBFu nh\xF3m \u0111i tr\u01B0\u1EDBc t\u1EA3n
      ra th\xEC \u0111\u01B0\u1EDDng s\u01A1 t\xE1n s\u1EBD g\u1EB7p nguy hi\u1EC3m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328448
    m_Localized: "N\u1EBFu b\u1ECB th\u01B0\u01A1ng th\xEC l\u1EADp t\u1EE9c l\xF9i
      v\xE0o ph\xEDa trong tuy\u1EBFn ph\xF2ng th\u1EE7."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328449
    m_Localized: "N\u1EBFu c\u1ED1 ch\u1ECBu \u0111\u1EF1ng ch\u1EC9 v\xEC \u0111\xE2y
      l\xE0 tr\u1EADn cu\u1ED1i th\xEC sau khi xong s\u1EBD c\xE0ng kh\xF3 kh\u0103n
      h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328450
    m_Localized: "Nh\xF3m qu\xE1i v\u1EADt \u0111ang ti\u1EBFn v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328451
    m_Localized: "Nh\xF3m \u0111i tr\u01B0\u1EDBc s\u1EBD s\u1EDBm \u0111\u1EBFn
      l\u1ED1i v\xE0o qu\u1EA3ng tr\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328452
    m_Localized: "\u0110\u01B0\u1EE3c. Tr\u01B0\u1EDBc h\u1EBFt h\xE3y ch\u1EB7n
      nh\xF3m \u0111i tr\u01B0\u1EDBc \u1EDF l\u1ED1i v\xE0o qu\u1EA3ng tr\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328453
    m_Localized: "\u0110\xE3 ng\u0103n thi\u1EC7t h\u1EA1i lan s\xE2u h\u01A1n v\xE0o
      qu\u1EA3ng tr\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233869328454
    m_Localized: "Trung t\xE2m Zeppel c\u0169ng an to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233873522688
    m_Localized: "\u0110\u01B0\u1EE3c r\u1ED3i! M\u1ECDi ng\u01B0\u1EDDi \u0111\xE3
      b\u1EA3o v\u1EC7 \u0111\u01B0\u1EE3c Zeppel r\u1ED3i!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233873522689
    m_Localized: "Cu\u1ED1i c\xF9ng c\u0169ng c\xF3 tin t\u1ED1t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233873522690
    m_Localized: "Th\u1EBF n\xE0y th\xEC ch\u1EB3ng ph\u1EA3i ch\xFAng ta c\u0169ng
      b\u1EA3o v\u1EC7 \u0111\u01B0\u1EE3c gi\u1EDD ngh\u1EC9 r\u1ED3i sao...?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233873522691
    m_Localized: "C\xF2n qu\xE1 s\u1EDBm \u0111\u1EC3 k\u1EBFt lu\u1EADn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233873522692
    m_Localized: "Con th\u1EC3 l\u1EDBn c\u0169ng kh\xF4ng \u0111\u1ECBnh d\u1EEBng
      l\u1EA1i \u1EDF qu\u1EA3ng tr\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233873522693
    m_Localized: "D\u1EA5u v\u1EBFt c\u1EE7a n\xF3 gi\u1ED1ng nh\u01B0 \u0111ang
      \u0111i xuy\xEAn qua qu\u1EA3ng tr\u01B0\u1EDDng \u0111\u1EC3 ti\u1EBFp t\u1EE5c
      ti\u1EBFn l\xEAn h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233873522694
    m_Localized: "V\u1EADy Zeppel kh\xF4ng ph\u1EA3i m\u1EE5c ti\xEAu c\u1EE7a n\xF3,
      ch\u1EC9 l\xE0 m\u1ED9t n\u01A1i n\u1EB1m tr\xEAn \u0111\u01B0\u1EDDng \u0111i
      th\xF4i sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233873522695
    m_Localized: "\u1EEA. T\u1EA5t c\u1EA3 d\u1EA5u v\u1EBFt ch\xFAng ta th\u1EA5y
      cho \u0111\u1EBFn gi\u1EDD \u0111\u1EC1u cho th\u1EA5y nh\u01B0 v\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233873522696
    m_Localized: "\u0110\xE3 c\xF3 th\xEAm b\xE1o c\xE1o g\u1EEDi \u0111\u1EBFn trong
      l\xFAc s\u1EEDa k\xEAnh n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233873522697
    m_Localized: "Nghe n\xF3i c\u1EA3 d\xF2ng n\u01B0\u1EDBc h\u1EA1 l\u01B0u c\u1EE7a
      k\xEAnh v\xE0 d\u1EA5u v\u1EBFt qu\xE1i v\u1EADt \u0111\u1EC1u d\u1EABn v\u1EC1
      ph\xEDa r\u1EEBng Lumer."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233873522698
    m_Localized: "R\u1EEBng Lumer sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233873522699
    m_Localized: "R\u1EEBng ngh\u0129a l\xE0 l\u1EA1i ph\u1EA3i \u0111i b\u1ED9 n\u1EEFa
      r\u1ED3i..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233873522700
    m_Localized: "S\u1EBD c\xF3 b\xF3ng r\xE2m d\u01B0\u1EDBi nh\u1EEFng t\xE1n c\xE2y,
      ph\u1EA3i kh\xF4ng...? L\xE0m \u01A1n, nh\u1EA5t \u0111\u1ECBnh ph\u1EA3i c\xF3
      \u0111i..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233873522701
    m_Localized: "V\u1EADy th\xEC qu\xE1i v\u1EADt \u1EDF Zeppel c\u0169ng c\xF3
      th\u1EC3 \u0111\xE3 b\u1ECB d\u1ED3n ra t\u1EEB ph\xEDa khu r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233873522702
    m_Localized: "C\u0169ng c\xF3 kh\u1EA3 n\u0103ng. Nh\u01B0ng v\u1EABn ch\u01B0a
      bi\u1EBFt nguy\xEAn nh\xE2n. Ph\u1EA3i t\u1EF1 m\xECnh ki\u1EC3m tra th\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233873522703
    m_Localized: "D\u1EA5u v\u1EBFt v\u1EC1 ph\xEDa r\u1EEBng l\xE0 r\xF5 nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233873522704
    m_Localized: "C\u1EA3 d\xF2ng n\u01B0\u1EDBc l\u1EABn d\u1EA5u ch\xE2n \u0111\u1EC1u
      ch\u1EC9 v\u1EC1 ph\xEDa r\u1EEBng Lumer."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233873522705
    m_Localized: "N\u1EBFu l\u1EA1i c\xF3 qu\xE1i v\u1EADt b\u1ECB d\u1ED3n ra t\u1EEB
      ph\xEDa r\u1EEBng th\xEC Zeppel s\u1EBD g\u1EB7p nguy hi\u1EC3m l\u1EA7n n\u1EEFa."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877716992
    m_Localized: "H\xE3y b\xE0n giao vi\u1EC7c ph\xF2ng th\u1EE7 Zeppel cho ng\u01B0\u1EDDi
      qu\u1EA3n l\xFD, c\xF2n ch\xFAng ta di chuy\u1EC3n \u0111\u1EBFn l\u1ED1i v\xE0o
      r\u1EEBng Lumer."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877716993
    m_Localized: "\u1EEA. Ph\u1EA3i xem chuy\u1EC3n \u0111\u1ED9ng ch\xFAng ta th\u1EA5y
      \u1EDF Zeppel c\xF2n k\xE9o d\xE0i \u0111\u1EBFn \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877716994
    m_Localized: "L\u1ED1i v\xE0o r\u1EEBng Lumer."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877716995
    m_Localized: "D\u1EA5u v\u1EBFt ch\xFAng ta th\u1EA5y \u1EDF Zeppel v\u1EABn
      ti\u1EBFp t\u1EE5c \u0111\u1EBFn t\u1EADn \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877716996
    m_Localized: "H\u01B0\u1EDBng \u0111i l\xE0 t\u1EEB s\xE2u trong r\u1EEBng ra
      ph\xEDa ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877716997
    m_Localized: "V\u1EADy l\xE0 qu\xE1i v\u1EADt \u0111\xE3 t\u1EEB \u0111\xE2y
      d\u1ED3n v\u1EC1 ph\xEDa Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877716998
    m_Localized: "C\xF2n qu\xE1 s\u1EDBm \u0111\u1EC3 kh\u1EB3ng \u0111\u1ECBnh \u0111\xE2y
      l\xE0 \u0111i\u1EC3m b\u1EAFt \u0111\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877716999
    m_Localized: "Nh\u01B0ng c\xF3 m\u1ED9t \u0111i\u1EC1u ch\u1EAFc ch\u1EAFn: qu\xE1i
      v\u1EADt \u0111\xE3 b\u1ECB d\u1ED3n t\u1EEB s\xE2u trong r\u1EEBng ra ph\xEDa
      ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717000
    m_Localized: "Kh\xF4ng ng\u1EDD d\u1EA5u v\u1EBFt n\xE0y l\u1EA1i k\xE9o d\xE0i
      v\xE0o khu r\u1EEBng gi\xE1p v\u1EDBi Zeppel..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717001
    m_Localized: "D\xF9 nh\xECn l\u1EA1i sau khi ch\u1EB7n \u0111\u01B0\u1EE3c ch\xFAng,
      t\xF4i v\u1EABn th\u1EA5y ch\u1EB3ng d\u1EC5 ch\u1ECBu ch\xFAt n\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717002
    m_Localized: "T\xF4i c\u1EE9 ngh\u0129 r\u1EEBng l\xE0 n\u01A1i y\xEAn t\u0129nh..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717003
    m_Localized: "C\xF3 nh\u1EEFng n\u01A1i c\xE0ng y\xEAn t\u0129nh l\u1EA1i c\xE0ng
      khi\u1EBFn ng\u01B0\u1EDDi ta kh\xF3 ch\u1ECBu."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717004
    m_Localized: "Kh\xF4ng sao! Khi c\xF2n y\xEAn t\u0129nh th\xEC tranh th\u1EE7
      ki\u1EC3m tra l\xE0 \u0111\u01B0\u1EE3c!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717005
    m_Localized: "...Vi\u1EC7c kh\xF4ng c\xF3 ti\u1EBFng \u0111\u1ED9ng l\u1EA1i
      khi\u1EBFn t\xF4i b\u1EA5t an h\u01A1n r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717006
    m_Localized: "Tr\u01B0\u1EDBc khi ti\u1EBFn v\xE0o b\xEAn trong, h\xE3y ki\u1EC3m
      tra d\u1EA5u v\u1EBFt g\u1EA7n l\u1ED1i v\xE0o tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717007
    m_Localized: "D\u1EA5u ch\xE2n b\u1ECB t\u1EA3n ra."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717008
    m_Localized: "Kh\xF4ng ph\u1EA3i ch\xFAng t\u1EADp trung \u0111\u1EC3 chi\u1EBFn
      \u0111\u1EA5u. D\u1EA5u v\u1EBFt cho th\u1EA5y ch\xFAng m\u1EA5t ph\u01B0\u01A1ng
      h\u01B0\u1EDBng v\xE0 b\u1ECB d\u1ED3n v\u1EC1 ph\xEDa l\u1ED1i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717009
    m_Localized: "D\u1EA5u ch\xE2n h\u01B0\u1EDBng ra ngo\xE0i s\xE2u h\u01A1n, c\xF2n
      d\u1EA5u ch\xE2n quay v\xE0o trong th\xEC n\xF4ng h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717010
    m_Localized: "C\xF3 v\u1EBB sau khi b\u1ECB d\u1ED3n ra b\u1EB1ng s\u1EE9c m\u1EA1nh,
      ch\xFAng \u0111\xE3 \u0111\u1ECBnh tr\u1ED1n tr\u1EDF l\u1EA1i v\xE0o r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717011
    m_Localized: "Kh\xF4ng ph\u1EA3i d\u1EA5u v\u1EBFt \u0111i \u0111i l\u1EA1i l\u1EA1i
      \u1EDF c\xF9ng m\u1ED9t ch\u1ED7. Ch\xFAng \u0111\xE3 c\u1ED1 ch\u1ED1ng l\u1EA1i
      vi\u1EC7c b\u1ECB d\u1ED3n ra ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717012
    m_Localized: "N\u1EBFu ch\xFAng b\u1ECB l\u1EA1c th\xEC ch\xFAng ta c\xE0ng ph\u1EA3i
      c\u1EA9n th\u1EADn h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717013
    m_Localized: "V\xEC s\u1EBD kh\xF4ng bi\u1EBFt ch\xFAng s\u1EBD ch\u1EA1y v\u1EC1
      h\u01B0\u1EDBng n\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717014
    m_Localized: "\u1EEA. Thay v\xEC \u0111u\u1ED5i theo m\u1ED9t c\xE1ch li\u1EC1u
      l\u0129nh, ph\u1EA3i ch\u1EB7n \u1EDF ph\xEDa l\u1ED1i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717015
    m_Localized: "N\u1EBFu t\u1EA3n ra \u1EDF \u0111\xE2y th\xEC ch\xFAng c\xF3 th\u1EC3
      l\u1EA1i \u0111i xu\u1ED1ng ph\xEDa Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717016
    m_Localized: "V\u1EADy th\xEC ph\u1EA3i ng\u0103n ch\xFAng t\u1EA3n ra th\xEAm
      \u1EDF l\u1ED1i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717017
    m_Localized: "T\xF4i s\u1EBD lo l\u1ED1i v\xE0o r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717018
    m_Localized: "T\xF4i s\u1EBD kh\xF4ng \u0111\u1EC3 ch\xFAng \u0111i ra kh\u1ECFi
      r\u1EEBng!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717019
    m_Localized: "N\u1EBFu b\u1ECB th\u01B0\u01A1ng tr\xEAn \u0111\u01B0\u1EDDng
      r\u1EEBng th\xEC c\u0169ng kh\xF3 \u0111\u01B0a \u0111i ch\u1EEFa tr\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717020
    m_Localized: "Mong l\xE0 m\u1ECDi ng\u01B0\u1EDDi ch\u1EC9 ng\xE3 \u1EDF ch\u1ED7
      b\u1EB1ng ph\u1EB3ng th\xF4i..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717021
    m_Localized: "Nh\xF3m \u1EDF s\xE2u trong r\u1EEBng \u0111\xE3 \u0111\u1EBFn
      g\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717022
    m_Localized: "Ch\xFAng \u0111ang b\u1ECB d\u1ED3n ra ph\xEDa l\u1ED1i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717023
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n ch\xFAng \u1EDF l\u1ED1i
      v\xE0o r\u1EEBng Lumer tr\u01B0\u1EDBc khi ch\xFAng tr\xE0n v\u1EC1 ph\xEDa
      Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717024
    m_Localized: "\u0110\xE3 ch\u1EB7n \u0111\u01B0\u1EE3c ch\xFAng, nh\u01B0ng...
      l\u1EA1 th\u1EADt."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717025
    m_Localized: "C\u1EA3m gi\xE1c gi\u1ED1ng nh\u01B0 ch\xFAng \u0111ang c\u1ED1
      tho\xE1t ra h\u01A1n l\xE0 lao v\xE0o t\u1EA5n c\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717026
    m_Localized: "Ch\xFAng kh\xF4ng c\xF3 v\u1EBB mu\u1ED1n chi\u1EBFn \u0111\u1EA5u,
      nh\u01B0ng ch\xFAng ta kh\xF4ng th\u1EC3 \u0111\u1EC3 ch\xFAng l\u1EA1i \u0111i
      xu\u1ED1ng ph\xEDa Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717027
    m_Localized: "\u1EEA. \u0110\xE2y kh\xF4ng ph\u1EA3i d\u1EA5u v\u1EBFt c\u1EE7a
      nh\u1EEFng con t\u1EADp trung v\u1EC1 ph\xEDa ch\xFAng ta."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717028
    m_Localized: "Ch\xFAng \u0111\xE3 b\u1ECB d\u1ED3n ra ph\xEDa l\u1ED1i v\xE0o
      v\xEC \u0111ang ch\u1EA1y tr\u1ED1n th\u1EE9 g\xEC \u0111\xF3 b\xEAn trong."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717029
    m_Localized: "\u1EDE \u0111\xE2y r\xF5 r\xE0ng h\u01A1n nh\u1EEFng g\xEC ch\xFAng
      ta th\u1EA5y \u1EDF Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717030
    m_Localized: "\u0110\xE2y kh\xF4ng ph\u1EA3i ch\u1EC9 l\xE0 di chuy\u1EC3n theo
      con \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717031
    m_Localized: "V\u1EADy ngh\u0129a l\xE0 b\xEAn trong r\u1EEBng c\xF3 th\u1EE9
      g\xEC c\xF2n kinh kh\u1EE7ng h\u01A1n n\u1EEFa...?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717032
    m_Localized: "Ch\u1EC9 nghe th\xF4i c\u0169ng khi\u1EBFn t\xF4i mu\u1ED1n ngh\u1EC9
      r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717033
    m_Localized: "T\xF4i hi\u1EC3u c\u1EA3m gi\xE1c mu\u1ED1n ngh\u1EC9 c\u1EE7a
      c\u1EADu."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717034
    m_Localized: "Nh\u01B0ng tr\u01B0\u1EDBc h\u1EBFt ph\u1EA3i xem v\xEC sao ch\xFAng
      l\u1EA1i d\u1EEBng \u1EDF l\u1ED1i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717035
    m_Localized: "D\u1EA5u ch\xE2n d\u1EABn v\u1EC1 ph\xEDa con \u0111\u01B0\u1EDDng
      nh\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717036
    m_Localized: "M\u1ED9t s\u1ED1 d\u1EA5u ch\xE2n c\xF3 v\u1EBB \u0111\xE3 quay
      l\u1EA1i v\xE0o s\xE2u trong r\u1EEBng \u1EDF l\u1ED1i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717037
    m_Localized: "V\u1EADy l\xE0 chuy\u1EC7n v\u1EABn ch\u01B0a k\u1EBFt th\xFAc
      \u1EDF \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717038
    m_Localized: "Nguy hi\u1EC3m m\xE0 qu\xE1i v\u1EADt ch\u1EA1y tr\u1ED1n v\u1EABn
      c\xF2n \u1EDF s\xE2u trong r\u1EEBng, \u0111\xFAng kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717039
    m_Localized: "H\xE3y s\u1EAFp x\u1EBFp l\u1EA1i ghi ch\xE9p tr\u1EADn chi\u1EBFn
      \u1EDF l\u1ED1i v\xE0o r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717040
    m_Localized: "Sau khi \u0111\u1ED1i chi\u1EBFu v\u1EDBi d\u1EA5u v\u1EBFt ch\xFAng
      ta th\u1EA5y \u1EDF Zeppel, h\xE3y chu\u1EA9n b\u1ECB ti\u1EBFn v\xE0o b\xEAn
      trong."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717041
    m_Localized: "\u1EEA. Ph\u1EA3i xem x\xE9t k\u1EF9 h\u01A1n l\xFAc \u1EDF Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717042
    m_Localized: "\u0110i\u1EC3m t\u1EADp k\u1EBFt t\u1EA1m th\u1EDDi \u1EDF l\u1ED1i
      v\xE0o r\u1EEBng Lumer."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717043
    m_Localized: "D\u1EA5u ch\xE2n kh\xF4ng \u0111i th\xE0nh m\u1ED9t h\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717044
    m_Localized: "Ch\xFAng \u0111\xE3 \u0111\u1ED5i h\u01B0\u1EDBng nhi\u1EC1u l\u1EA7n,
      nh\u01B0ng cu\u1ED1i c\xF9ng l\u1EA1i b\u1ECB d\u1ED3n v\u1EC1 c\xF9ng m\u1ED9t
      ph\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717045
    m_Localized: "D\u1EA5u ch\xE2n s\xE2u d\u1EABn ra ngo\xE0i r\u1EEBng, c\xF2n
      d\u1EA5u ch\xE2n n\xF4ng d\u1EABn s\xE2u h\u01A1n v\xE0o b\xEAn trong."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717046
    m_Localized: "C\xF3 v\u1EBB nh\u1EEFng con qu\xE1i v\u1EADt b\u1ECB l\u1EA1c
      \u0111\xE3 c\xF9ng l\xFAc b\u1ECB d\u1ED3n v\u1EC1 m\u1ED9t ph\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717047
    m_Localized: "\u1EEA. Nh\u01B0ng h\u01B0\u1EDBng \u0111i gi\u1ED1ng nhau qu\xE1
      m\u1EE9c n\u1EBFu ch\u1EC9 l\xE0 ch\xFAng \u0111i lang thang."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717048
    m_Localized: "Thay v\xEC l\u1EA7n theo c\u1EA3 con \u0111\u01B0\u1EDDng nh\u1ECF,
      ph\u1EA3i xem n\u01A1i ch\xFAng t\u1EE5 l\u1EA1i theo c\xF9ng m\u1ED9t h\u01B0\u1EDBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717049
    m_Localized: "Ng\u01B0\u1EDDi m\xE0 l\u1EA1c trong r\u1EEBng c\u0169ng \u0111\xE3
      kh\xE1 nguy hi\u1EC3m r\u1ED3i..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233877717050
    m_Localized: "\u0110\u1EBFn qu\xE1i v\u1EADt c\u0169ng b\u1ECB l\u1EA1c th\xEC
      c\xF2n phi\u1EC1n ph\u1EE9c h\u01A1n n\u1EEFa nh\u1EC9."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911296
    m_Localized: "H\xE3y \u0111i theo con \u0111\u01B0\u1EDDng nh\u1ECF v\xE0 x\xE1c
      \u0111\u1ECBnh h\u01B0\u1EDBng tr\u01B0\u1EDBc khi d\u1EA5u v\u1EBFt l\u1EA1i
      t\xE1ch ra."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911297
    m_Localized: "C\u0169ng \u0111\u1EC3 l\u1EA1i d\u1EA5u ch\u1EC9 v\u1EC1 ph\xEDa
      Zeppel. Kh\xF4ng \u0111\u01B0\u1EE3c \u0111\u1EC3 \u0111\u01B0\u1EDDng quay
      v\u1EC1 b\u1ECB ch\u1EB7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911298
    m_Localized: "\u1ED2, \u0111\u01B0\u1EDDng quay v\u1EC1 th\u1EF1c s\u1EF1 quan
      tr\u1ECDng nh\u1EC9..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911299
    m_Localized: "D\u1EA5u ch\xE2n b\xEAn con \u0111\u01B0\u1EDDng nh\u1ECF n\xF4ng
      h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911300
    m_Localized: "Kh\xF4ng gi\u1ED1ng ch\u1EA1y, d\u1EA5u v\u1EBFt n\xE0y cho th\u1EA5y
      ch\xFAng \u0111\xE3 c\u1ED1 ch\u1ED1ng l\u1EA1i vi\u1EC7c b\u1ECB d\u1ED3n
      ra."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911301
    m_Localized: "C\xF3 th\u1EC3 s\xE2u trong r\u1EEBng c\xF3 ph\u1EA3n \u1EE9ng
      n\xE0o \u0111\xF3 \u0111ang l\xE0m chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a qu\xE1i
      v\u1EADt r\u1ED1i lo\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911302
    m_Localized: "Tr\u01B0\u1EDBc m\u1EAFt c\u1EE9 coi \u0111\xF3 l\xE0 m\u1ED9t
      kh\u1EA3 n\u0103ng th\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911303
    m_Localized: "Ph\u1EA3n \u1EE9ng c\u1EE7a \u0111\xE1 t\xEDn hi\u1EC7u c\u0169ng
      y\u1EBFu, nh\u01B0ng v\u1EABn k\xE9o d\xE0i v\xE0o s\xE2u trong r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911304
    m_Localized: "Ch\u01B0a ch\u1EAFc \u0111\xF3 l\xE0 nguy\xEAn nh\xE2n, nh\u01B0ng
      \xEDt nh\u1EA5t c\u0169ng l\xE0 d\u1EA5u v\u1EBFt c\xF3 th\u1EC3 l\u1EA7n theo."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911305
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ti\u1EBFn v\xE0o m\xE0 \u0111\u1EEBng
      b\u1ECF s\xF3t c\xE1c d\u1EA5u ch\u1EC9!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911306
    m_Localized: "\u0110i v\xE0o th\xEC \u0111\u01B0\u1EE3c, nh\u01B0ng c\u0169ng
      ph\u1EA3i nh\u1EDB \u0111\u01B0\u1EDDng ra n\u1EEFa."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911307
    m_Localized: "S\u1EBD r\u1EAFc r\u1ED1i n\u1EBFu ch\xFAng ta c\u0169ng b\u1ECB
      th\xEAm v\xE0o danh s\xE1ch nh\u1EEFng th\u1EE9 b\u1ECB l\u1EA1c trong r\u1EEBng..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911308
    m_Localized: "Con \u0111\u01B0\u1EDDng nh\u1ECF trong r\u1EEBng Lumer."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911309
    m_Localized: "T\u1EEB \u0111\xE2y d\u1EA5u v\u1EBFt tr\u1EDF n\xEAn ph\u1EE9c
      t\u1EA1p h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911310
    m_Localized: "Ch\xFAng \u0111i theo \u0111\u01B0\u1EDDng, r\u1EBD v\xE0o b\u1EE5i
      r\u1EADm, r\u1ED3i l\u1EA1i quay v\u1EC1 \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911311
    m_Localized: "C\xF3 v\u1EBB ch\xFAng kh\xF4ng t\xECm \u0111\u01B0\u1EE3c \u0111\u01B0\u1EDDng
      khi \u0111ang ch\u1EA1y tr\u1ED1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911312
    m_Localized: "Nh\u01B0ng h\u01B0\u1EDBng cu\u1ED1i c\xF9ng g\u1EA7n nh\u01B0
      gi\u1ED1ng nhau."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911313
    m_Localized: "D\xF9 tr\xF4ng nh\u01B0 \u0111\xE3 t\u1EA3n ra, cu\u1ED1i c\xF9ng
      ch\xFAng v\u1EABn \u0111ang b\u1ECB d\u1ED3n v\u1EC1 c\xF9ng m\u1ED9t ph\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911314
    m_Localized: "D\u1EC5 b\u1ECB th\u01B0\u01A1ng khi b\u1ECB \u0111\u1EA9y qua
      \u0111\u1EA9y l\u1EA1i tr\xEAn con \u0111\u01B0\u1EDDng h\u1EB9p."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233881911315
    m_Localized: "V\u1EBFt x\u01B0\u1EDBc do b\u1EE5i r\u1EADm g\xE2y ra c\u0169ng
      dai d\u1EB3ng h\u01A1n t\u01B0\u1EDFng t\u01B0\u1EE3ng..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105600
    m_Localized: "\u0110\u01B0\u1EDDng h\u1EB9p th\xEC d\u1EC5 ch\u1EB7n, nh\u01B0ng
      n\u1EBFu \u0111\u1EC3 m\u1EA5t d\u1EA5u th\xEC s\u1EBD kh\xF3 t\xECm l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105601
    m_Localized: "\u0110\xFAng v\u1EADy. V\xEC th\u1EBF kh\xF4ng \u0111\u01B0\u1EE3c
      \u0111\u1EC3 tr\u1ED1ng gi\u1EEFa con \u0111\u01B0\u1EDDng nh\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105602
    m_Localized: "Gi\u1EEF \u1EDF gi\u1EEFa con \u0111\u01B0\u1EDDng nh\u1ECF, nh\u01B0ng
      \u0111\u1EEBng \u0111u\u1ED5i qu\xE1 s\xE2u v\xE0o trong."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105603
    m_Localized: "H\xE3y ch\u1EB7n \u0111\u1EC3 c\xE1c nh\xF3m r\u1EA3i r\xE1c kh\xF4ng
      tho\xE1t v\u1EC1 ph\xEDa Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105604
    m_Localized: "C\xF3 chuy\u1EC3n \u0111\u1ED9ng trong b\u1EE5i r\u1EADm b\xEAn
      tr\xE1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105605
    m_Localized: "C\u0169ng c\xF3 m\u1ED9t nh\xF3m nh\u1ECF \u0111ang \u1EA9n d\u01B0\u1EDBi
      con \u0111\u01B0\u1EDDng b\xEAn ph\u1EA3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105606
    m_Localized: "V\u1EADy t\xF4i s\u1EBD gi\u1EEF \u1EDF gi\u1EEFa."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105607
    m_Localized: "N\u1EBFu c\xF3 nh\xF3m n\xE0o l\u1ECDt qua m\u1ED9t trong hai b\xEAn
      th\xEC b\xE1o ngay cho t\xF4i!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105608
    m_Localized: "B\u1EE5i r\u1EADm khi\u1EBFn ch\xFAng ta kh\xF3 quan s\xE1t c\u1EA3
      hai b\xEAn c\xF9ng l\xFAc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105609
    m_Localized: "N\u1EBFu \u0111u\u1ED5i theo m\u1ED9t c\xE1ch li\u1EC1u l\u0129nh
      th\xEC ng\u01B0\u1EE3c l\u1EA1i c\xF3 th\u1EC3 m\u1EA5t d\u1EA5u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105610
    m_Localized: "D\u1EA5u ch\xE2n b\xEAn ph\u1EA3i n\xF4ng. L\xE0 m\u1ED9t nh\xF3m
      nh\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105611
    m_Localized: "C\xE0nh c\xE2y b\xEAn tr\xE1i v\u1EEBa g\xE3y. M\u1ED9t nh\xF3m
      l\u1EDBn h\u01A1n \u0111ang \u1EDF g\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105612
    m_Localized: "V\u1EADy tr\u01B0\u1EDBc h\u1EBFt ch\u1EB7n nh\xF3m l\u1EDBn b\xEAn
      tr\xE1i, c\xF2n nh\xF3m nh\u1ECF b\xEAn ph\u1EA3i th\xEC x\u1EED l\xFD \u1EDF
      ph\xEDa trong con \u0111\u01B0\u1EDDng nh\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105613
    m_Localized: "\u0110\u01B0\u1EE3c. T\xF4i s\u1EBD gi\u1EEF nh\xF3m l\u1EDBn h\u01A1n!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105614
    m_Localized: "N\u1EBFu b\u1ECB th\u01B0\u01A1ng th\xEC \u0111\u1EBFn th\u1EB3ng
      ch\u1ED7 Ch\u1EC9 huy. T\xF4i s\u1EBD xem cho."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105615
    m_Localized: "N\u1EBFu ai \u0111\xF3 l\u0103n ra kh\u1ECFi b\u1EE5i r\u1EADm
      th\xEC t\xF4i s\u1EBD th\u1EDF d\xE0i tr\u01B0\u1EDBc r\u1ED3i m\u1EDBi ch\u1EEFa
      tr\u1ECB..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105616
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a c\u1EA3 hai nh\xF3m b\u1EAFt
      \u0111\u1EA7u r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105617
    m_Localized: "Ch\xFAng \u0111ang c\xF9ng l\xFAc \u0111i ra t\u1EEB hai b\xEAn
      con \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105618
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n ch\xFAng \u1EDF gi\u1EEFa
      con \u0111\u01B0\u1EDDng nh\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105619
    m_Localized: "\u0110\u1EEBng \u0111\u1EC3 ch\xFAng c\xF3 c\u01A1 h\u1ED9i tho\xE1t
      v\u1EC1 ph\xEDa Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105620
    m_Localized: "\xCDt nh\u1EA5t ch\xFAng ta \u0111\xE3 ng\u0103n \u0111\u01B0\u1EE3c
      ch\xFAng t\u1EA3n ra."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105621
    m_Localized: "\u0110\xFAng nh\u01B0 m\xECnh ngh\u0129, b\u1ECDn ch\xFAng di chuy\u1EC3n
      nh\u01B0 \u0111ang s\u1EE3 h\xE3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105622
    m_Localized: "Kh\xF4ng h\u1EB3n l\xE0 s\u1EE3 h\xE3i, m\xE0 vi\u1EC7c kh\xF4ng
      bi\u1EBFt ch\xFAng s\u1EBD ch\u1EA1y v\u1EC1 \u0111\xE2u ti\u1EBFp theo m\u1EDBi
      khi\u1EBFn t\xF4i m\u1EC7t h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105623
    m_Localized: "\u0110\xFAng v\u1EADy. Ch\xFAng kh\xF4ng t\u1EA3n ra \u0111\u1EC3
      t\u1EA5n c\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105624
    m_Localized: "Ch\xFAng t\xECm ch\u1ED7 tr\xE1nh n\xE9 r\u1ED3i b\u1ECB d\u1ED3n
      v\u1EC1 c\xF9ng m\u1ED9t ph\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105625
    m_Localized: "N\u1EBFu l\xE0 di chuy\u1EC3n t\u1EF1 nhi\xEAn th\xEC ch\xFAng
      s\u1EBD kh\xF4ng l\u1EA1i t\u1EE5 v\u1EC1 c\xF9ng m\u1ED9t \u0111i\u1EC3m nh\u01B0
      th\u1EBF n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105626
    m_Localized: "V\u1EABn c\xF2n \u0111i\u1EC1u g\xEC \u0111\xF3 \u1EDF s\xE2u trong
      r\u1EEBng c\u1EA7n ph\u1EA3i ki\u1EC3m tra."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105627
    m_Localized: "M\u1ED7i l\u1EA7n nghe n\xF3i c\xF2n \u0111i\u1EC1u ph\u1EA3i ki\u1EC3m
      tra l\xE0 t\xF4i l\u1EA1i th\u1EA5y \u0111\xE1ng s\u1EE3 h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105628
    m_Localized: "D\xF9 v\u1EADy, n\u1EBFu d\u1EEBng l\u1EA1i b\xE2y gi\u1EDD th\xEC
      t\xF4i c\xF2n th\u1EA5y b\u1EE9t r\u1EE9t h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105629
    m_Localized: "Ph\xEDa tr\u01B0\u1EDBc c\xF3 khu khai th\xE1c g\u1ED7."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105630
    m_Localized: "D\u1EA5u v\u1EBFt b\u1ECB x\xE1o tr\u1ED9n m\u1EA1nh m\u1ED9t l\u1EA7n
      \u1EDF tr\u01B0\u1EDBc khu khai th\xE1c g\u1ED7."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105631
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng g\u1EA7n khu khai th\xE1c g\u1ED7 l\u1EA1i
      t\u0103ng l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105632
    m_Localized: "Ch\xFAng \u0111ang tr\xE0n v\u1EC1 ph\xEDa con \u0111\u01B0\u1EDDng
      nh\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711259
    m_Localized: "T\u1EA5n c\xF4ng t\u0103ng {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711260
    m_Localized: "T\u1ED1c \u0111\u1ED9 t\u1EA5n c\xF4ng t\u0103ng {0:P0}."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711261
    m_Localized: "T\u1EF7 l\u1EC7 ch\xED m\u1EA1ng t\u0103ng {0:P0}."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711262
    m_Localized: "S\xE1t th\u01B0\u01A1ng ch\xED m\u1EA1ng t\u0103ng {0:P0}."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711263
    m_Localized: "HP t\u1ED1i \u0111a t\u0103ng {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711264
    m_Localized: "HP hi\u1EC7n t\u1EA1i h\u1ED3i {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711265
    m_Localized: "Ph\xF2ng th\u1EE7 t\u0103ng {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711266
    m_Localized: "T\u1ED1c \u0111\u1ED9 di chuy\u1EC3n t\u0103ng {0:P0}."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711267
    m_Localized: "T\u1EA5n c\xF4ng t\u0103ng {0}, v\xE0 T\u1ED1c \u0111\u1ED9 t\u1EA5n
      c\xF4ng <color=#FF4A4A>gi\u1EA3m</color> {1:P0}."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711268
    m_Localized: "T\u1ED1c \u0111\u1ED9 t\u1EA5n c\xF4ng t\u0103ng {0:P0}, v\xE0
      T\u1EF7 l\u1EC7 ch\xED m\u1EA1ng t\u0103ng {1:P0}."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711269
    m_Localized: "HP t\u1ED1i \u0111a t\u0103ng {0}, v\xE0 T\u1ED1c \u0111\u1ED9
      di chuy\u1EC3n <color=#FF4A4A>gi\u1EA3m</color> {1:P0}."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711270
    m_Localized: "T\u1EA5n c\xF4ng t\u0103ng {0}, v\xE0 HP t\u1ED1i \u0111a <color=#FF4A4A>gi\u1EA3m</color>
      {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711271
    m_Localized: "Ph\xF2ng th\u1EE7 t\u0103ng {0}, v\xE0 HP t\u1ED1i \u0111a t\u0103ng
      {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 8336625686110208
    m_Localized: "HP t\u1ED1i \u0111a c\u1EE7a Serah t\u0103ng {0}%<br>Ph\xF2ng th\u1EE7
      c\u1EE7a Serah t\u0103ng {1}%<br>T\u1ED1c \u0111\u1ED9 di chuy\u1EC3n c\u1EE7a
      Serah <color=#FF4A4A>gi\u1EA3m</color> {2:P0}"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858944
    m_Localized: "Serah h\u1ED3i {0}% HP t\u1ED1i \u0111a m\u1ED7i gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858945
    m_Localized: "HP t\u1ED1i \u0111a c\u1EE7a Serah t\u0103ng {0}%<br>T\u1EA5n c\xF4ng
      c\u1EE7a Serah t\u0103ng {1}%<br>Ph\xF2ng th\u1EE7 c\u1EE7a Serah t\u0103ng
      {2}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858946
    m_Localized: "T\u1EF7 l\u1EC7 t\u1EA5n c\xF4ng k\xE9p c\u1EE7a Noah t\u0103ng
      {0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858947
    m_Localized: "Noah nh\u1EADn M\u01B0a T\xEAn<br>S\xE1t th\u01B0\u01A1ng M\u01B0a
      T\xEAn t\u0103ng {1}%<br>M\u01B0a T\xEAn k\xEDch ho\u1EA1t m\u1ED7i {2} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858948
    m_Localized: "HP t\u1ED1i \u0111a c\u1EE7a Noah t\u0103ng {0}%<br>T\u1EA5n c\xF4ng
      c\u1EE7a Noah t\u0103ng {1}%<br>Ph\xF2ng th\u1EE7 c\u1EE7a Noah t\u0103ng {2}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858949
    m_Localized: "T\u1EA7m k\u1EF9 n\u0103ng c\u1EE7a Alice t\u0103ng {0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858950
    m_Localized: "Alice nh\u1EADn Ma Thu\u1EADt \u0110\u1ED9ng \u0110\u1EA5t<br>S\xE1t
      th\u01B0\u01A1ng Ma Thu\u1EADt \u0110\u1ED9ng \u0110\u1EA5t t\u0103ng {1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858951
    m_Localized: "HP t\u1ED1i \u0111a c\u1EE7a Alice t\u0103ng {0}%<br>T\u1EA5n c\xF4ng
      c\u1EE7a Alice t\u0103ng {1}%<br>Ph\xF2ng th\u1EE7 c\u1EE7a Alice t\u0103ng
      {2}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858952
    m_Localized: "L\u01B0\u1EE3ng h\u1ED3i ph\u1EE5c c\u1EE7a Spayne t\u0103ng {0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858953
    m_Localized: "Spayne nh\u1EADn Ma Thu\u1EADt L\xE1 Ch\u1EAFn<br>Th\u1EDDi gian
      Ma Thu\u1EADt L\xE1 Ch\u1EAFn t\u0103ng {1} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858954
    m_Localized: "HP t\u1ED1i \u0111a c\u1EE7a Spayne t\u0103ng {0}%<br>T\u1EA5n
      c\xF4ng c\u1EE7a Spayne t\u0103ng {1}%<br>Ph\xF2ng th\u1EE7 c\u1EE7a Spayne
      t\u0103ng {2}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858955
    m_Localized: "HP t\u01B0\u1EDDng th\xE0nh h\u1ED3i {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858956
    m_Localized: "HP t\u1ED1i \u0111a c\u1EE7a t\u01B0\u1EDDng th\xE0nh t\u0103ng
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858957
    m_Localized: "Ch\u1EC9 s\u1ED1 c\u1EE7a t\u1EA5t c\u1EA3 anh h\xF9ng t\u0103ng
      {0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858958
    m_Localized: "HP t\u1ED1i \u0111a c\u1EE7a Serah t\u0103ng {0}%<br>Ph\xF2ng th\u1EE7
      c\u1EE7a Serah t\u0103ng {1}%<br>T\u1ED1c \u0111\u1ED9 di chuy\u1EC3n c\u1EE7a
      Serah <color=#FF4A4A>gi\u1EA3m</color> {2:P0}"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858959
    m_Localized: "Serah h\u1ED3i {0}% HP t\u1ED1i \u0111a m\u1ED7i gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858960
    m_Localized: "HP t\u1ED1i \u0111a c\u1EE7a Serah t\u0103ng {0}%<br>T\u1EA5n c\xF4ng
      c\u1EE7a Serah t\u0103ng {1}%<br>Ph\xF2ng th\u1EE7 c\u1EE7a Serah t\u0103ng
      {2}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858961
    m_Localized: "T\u1EF7 l\u1EC7 t\u1EA5n c\xF4ng k\xE9p c\u1EE7a Noah t\u0103ng
      {0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858962
    m_Localized: "S\xE1t th\u01B0\u01A1ng M\u01B0a T\xEAn t\u0103ng {1}%<br>Th\u1EDDi
      gian gi\u1EEFa c\xE1c l\u1EA7n k\xEDch ho\u1EA1t M\u01B0a T\xEAn <color=#FF4A4A>gi\u1EA3m</color>
      {2} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858963
    m_Localized: "HP t\u1ED1i \u0111a c\u1EE7a Noah t\u0103ng {0}%<br>T\u1EA5n c\xF4ng
      c\u1EE7a Noah t\u0103ng {1}%<br>Ph\xF2ng th\u1EE7 c\u1EE7a Noah t\u0103ng {2}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858964
    m_Localized: "T\u1EA7m k\u1EF9 n\u0103ng c\u1EE7a Alice t\u0103ng {0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858965
    m_Localized: "S\xE1t th\u01B0\u01A1ng Ma Thu\u1EADt \u0110\u1ED9ng \u0110\u1EA5t
      t\u0103ng {1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858966
    m_Localized: "HP t\u1ED1i \u0111a c\u1EE7a Alice t\u0103ng {0}%<br>T\u1EA5n c\xF4ng
      c\u1EE7a Alice t\u0103ng {1}%<br>Ph\xF2ng th\u1EE7 c\u1EE7a Alice t\u0103ng
      {2}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858967
    m_Localized: "L\u01B0\u1EE3ng h\u1ED3i ph\u1EE5c c\u1EE7a Spayne t\u0103ng {0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858968
    m_Localized: "Th\u1EDDi gian Ma Thu\u1EADt L\xE1 Ch\u1EAFn t\u0103ng {1} gi\xE2y"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858969
    m_Localized: "HP t\u1ED1i \u0111a c\u1EE7a Spayne t\u0103ng {0}%<br>T\u1EA5n
      c\xF4ng c\u1EE7a Spayne t\u0103ng {1}%<br>Ph\xF2ng th\u1EE7 c\u1EE7a Spayne
      t\u0103ng {2}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858970
    m_Localized: "HP t\u01B0\u1EDDng th\xE0nh h\u1ED3i {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858971
    m_Localized: "HP t\u1ED1i \u0111a c\u1EE7a t\u01B0\u1EDDng th\xE0nh t\u0103ng
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 8336625723858972
    m_Localized: "Ch\u1EC9 s\u1ED1 c\u1EE7a t\u1EA5t c\u1EA3 anh h\xF9ng t\u0103ng
      {0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 8695235997949952
    m_Localized: "C\u1ED5ng ngo\xE0i Zeppel"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039892992
    m_Localized: "Ph\xE2n t\xEDch ph\xF2ng th\u1EE7 c\u1ED5ng"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039892993
    m_Localized: "Khu n\xF4ng tr\u1EA1i Zeppel"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039892994
    m_Localized: "Ph\u1ED1 ch\u1EE3 Zeppel"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039892995
    m_Localized: "Khu k\xEAnh n\u01B0\u1EDBc v\xE0 kho h\xE0ng Zeppel"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039892996
    m_Localized: "B\u1EA3o tr\xEC k\xEAnh n\u01B0\u1EDBc tr\u01B0\u1EDBc tr\u1EADn
      Boss"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039892997
    m_Localized: "Qu\u1EA3ng tr\u01B0\u1EDDng tr\u01B0\u1EDBc dinh l\xE3nh ch\xFAa
      Zeppel"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039892998
    m_Localized: "L\u1ED1i v\xE0o r\u1EEBng Lumer"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039892999
    m_Localized: "Truy d\u1EA5u \u0111\u01B0\u1EDDng r\u1EEBng"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893000
    m_Localized: "L\u1ED1i m\xF2n r\u1EEBng Lumer"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893001
    m_Localized: "Khu khai th\xE1c g\u1ED7 r\u1EEBng Lumer"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893002
    m_Localized: "\u0110\u1EA7m l\u1EA7y s\xE2u trong r\u1EEBng Lumer"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893003
    m_Localized: "B\u1EA3o tr\xEC \u0111\u01B0\u1EDDng r\u1EEBng tr\u01B0\u1EDBc
      tr\u1EADn Boss"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893004
    m_Localized: "B\xE3i tr\u1ED1ng trung t\xE2m r\u1EEBng Lumer"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893005
    m_Localized: "L\xE0ng m\u1ECF Verdin"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893006
    m_Localized: "H\u1ED7 tr\u1EE3 l\xE0ng m\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893007
    m_Localized: "L\u1ED1i v\xE0o m\u1ECF Verdin"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893008
    m_Localized: "H\u1EA7m m\u1ECF b\u1ECF hoang Verdin"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893009
    m_Localized: "\u0110\u01B0\u1EDDng ray v\u1EADn chuy\u1EC3n Verdin"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893010
    m_Localized: "B\u1EA3o tr\xEC \u0111\u01B0\u1EDDng ray tr\u01B0\u1EDBc tr\u1EADn
      Boss"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893011
    m_Localized: "Khu s\xE2u nh\u1EA5t c\u1EE7a m\u1ECF Verdin"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893012
    m_Localized: "L\xE0ng ven h\u1ED3 Milen"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893013
    m_Localized: "T\u0103ng c\u01B0\u1EDDng ph\xF2ng th\u1EE7 ven h\u1ED3"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893014
    m_Localized: "\u0110\u1EA7m lau s\u1EADy Milen"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893015
    m_Localized: "C\u1EA7u n\u1ED5i Milen"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893016
    m_Localized: "B\u1EBFn thuy\u1EC1n h\u1ED3 Milen"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893017
    m_Localized: "B\u1EA3o tr\xEC b\u1EBFn thuy\u1EC1n tr\u01B0\u1EDBc tr\u1EADn
      Boss"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893018
    m_Localized: "\u0110\u1EA3o gi\u1EEFa h\u1ED3 Milen"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893019
    m_Localized: "L\u1ED1i v\xE0o cao nguy\xEAn Norua"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893020
    m_Localized: "Th\xEDch nghi v\u1EDBi gi\xF3 cao nguy\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893021
    m_Localized: "\u0110\u1ED3i gi\xF3 Norua"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893022
    m_Localized: "V\xF9ng ngo\xE0i di t\xEDch c\u1ED5 Norua"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893023
    m_Localized: "H\xE0nh lang di t\xEDch Norua"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893024
    m_Localized: "B\u1EA3o tr\xEC di t\xEDch tr\u01B0\u1EDBc tr\u1EADn Boss"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893025
    m_Localized: "Ph\xF2ng \u0111i\u1EC1u khi\u1EC3n di t\xEDch Norua"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893026
    m_Localized: "\u0110\u1ED3ng b\u1EB1ng trung t\xE2m Atra"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893027
    m_Localized: "T\u1EADp k\u1EBFt t\u1EA1i tuy\u1EBFn ph\xF2ng th\u1EE7 cu\u1ED1i"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893028
    m_Localized: "V\xF9ng ngo\xE0i v\u01B0\u01A1ng \u0111\xF4 Atra"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893029
    m_Localized: "C\u1ED5ng th\xE0nh v\u01B0\u01A1ng \u0111\xF4 Atra"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893030
    m_Localized: "Tuy\u1EBFn ph\xF2ng th\u1EE7 cu\u1ED1i Atra"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893031
    m_Localized: "B\u1EA3o tr\xEC t\u01B0\u1EDDng th\xE0nh tr\u01B0\u1EDBc tr\u1EADn
      cu\u1ED1i"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236039893032
    m_Localized: "Qu\u1EA3ng tr\u01B0\u1EDDng trung t\xE2m Atra"
    m_Metadata:
      m_Items: []
  - m_Id: 9819496586240000
    m_Localized: "L\u01B0u tr\u1EEF"
    m_Metadata:
      m_Items: []
  - m_Id: 9819496623988736
    m_Localized: "C\u1ED1t truy\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087296
    m_Localized: "M\xE0n h\u01B0\u1EDBng d\u1EABn"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087297
    m_Localized: "M\xE0n th\u01B0\u1EDDng"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087298
    m_Localized: "M\xE0n s\u1EF1 ki\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087299
    m_Localized: "M\xE0n boss"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087300
    m_Localized: "M\xE0n b\u1EA3o tr\xEC"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087301
    m_Localized: "{0} \u0111\xE3 nh\u1EB7t \u0111\u01B0\u1EE3c th\u1EE9 g\xEC \u0111\xF3!"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087302
    m_Localized: "Qu\xE0 c\u1EE7a {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087303
    m_Localized: "Ch\u1EC9 c\xF3 th\u1EC3 ch\u1ECDn 1."
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087304
    m_Localized: "HP t\u01B0\u1EDDng hi\u1EC7n t\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087305
    m_Localized: "H\u1ED3i 150 HP cho t\u01B0\u1EDDng th\xE0nh"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087306
    m_Localized: "Nh\u1EADn 1 di v\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087308
    m_Localized: "Boss ti\u1EBFp theo"
    m_Metadata:
      m_Items: []
  - m_Id: 9819496623988737
    m_Localized: "T\u1EF1 \u0111\u1ED9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 9819496623988738
    m_Localized: "\u1EA8n"
    m_Metadata:
      m_Items: []
  - m_Id: 9819496623988739
    m_Localized: "L\u1ECBch s\u1EED h\u1ED9i tho\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 9819496623988740
    m_Localized: "B\u1ECF qua"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087309
    m_Localized: "Xem qu\u1EA3ng c\xE1o \u0111\u1EC3 l\xE0m m\u1EDBi 1 l\u1EA7n"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087310
    m_Localized: "C\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087311
    m_Localized: "Kh\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087312
    m_Localized: "X\xE1c nh\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087313
    m_Localized: "Xu\u1EA5t k\xEDch"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087314
    m_Localized: "Quay l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 9819496623988741
    m_Localized: "\xC2m thanh"
    m_Metadata:
      m_Items: []
  - m_Id: 9819496623988742
    m_Localized: "Nh\u1EA1c n\u1EC1n"
    m_Metadata:
      m_Items: []
  - m_Id: 9819496623988743
    m_Localized: "Hi\u1EC7u \u1EE9ng \xE2m thanh"
    m_Metadata:
      m_Items: []
  - m_Id: 9819496623988744
    m_Localized: Rung
    m_Metadata:
      m_Items: []
  - m_Id: 9819496623988745
    m_Localized: "C\u01B0\u1EDDng \u0111\u1ED9 rung"
    m_Metadata:
      m_Items: []
  - m_Id: 9819496623988746
    m_Localized: "Ng\xF4n ng\u1EEF"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535612252160
    m_Localized: "V\u1EC7 binh Zeppel"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535654195200
    m_Localized: "Qu\u1EA3n l\xFD n\xF4ng tr\u1EA1i Zeppel"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535654195201
    m_Localized: "Th\u01B0\u01A1ng nh\xE2n Zeppel"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535654195202
    m_Localized: "Qu\u1EA3n l\xFD Zeppel"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535654195203
    m_Localized: "Qu\u1EA3n l\xFD m\u1ECF Verdin"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535654195204
    m_Localized: "Th\u1EE3 m\u1ECF Verdin"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535654195205
    m_Localized: "Qu\u1EA3n l\xFD l\xE0ng Milen"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535654195206
    m_Localized: "Qu\u1EA3n l\xFD b\u1EBFn thuy\u1EC1n Milen"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535654195207
    m_Localized: "V\u1EC7 binh Milen"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535654195208
    m_Localized: "\u0110\u1ED9i tr\u01B0\u1EDFng ph\xF2ng th\u1EE7 Atra"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535654195209
    m_Localized: "\u0110\u1EA1i di\u1EC7n c\u01B0 d\xE2n Atra"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105633
    m_Localized: "L\xF9i l\u1EA1i \u0111i. \u0110\u01B0\u1EDDng h\u1EB9p n\xEAn kh\xF4ng
      th\u1EC3 c\xF9ng l\xFAc r\xFAt lui h\u1EBFt."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105634
    m_Localized: "T\xF4i s\u1EBD ch\u1EB7n ph\xEDa tr\u01B0\u1EDBc. M\u1ECDi ng\u01B0\u1EDDi
      \u0111i tr\u01B0\u1EDBc \u0111i!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105635
    m_Localized: "Serah, l\xF9i l\u1EA1i c\xF9ng ch\xFAng t\xF4i!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105636
    m_Localized: "Kh\xF4ng sao! C\u1EADu bi\u1EBFt t\xF4i r\u1EA5t gi\u1ECFi gi\u1EEF
      ch\xE2n ch\xFAng m\xE0!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105637
    m_Localized: "T\xF4i s\u1EBD theo ngay!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105638
    m_Localized: "\u0110\u1EEBng n\xF3i chuy\u1EC7n li\u1EC1u l\u0129nh nh\u01B0
      th\u1EC3 s\u1EBD \u1EDF l\u1EA1i m\u1ED9t m\xECnh...! C\u1EADu kh\xF4ng ngh\u0129
      \u0111\u1EBFn vi\u1EC7c sau \u0111\xF3 t\xF4i s\u1EBD ph\u1EA3i ch\u1EEFa cho
      c\u1EADu sao?!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105639
    m_Localized: "...Kh\xF4ng nghe th\u1EA5y ti\u1EBFng b\u01B0\u1EDBc ch\xE2n c\u1EE7a
      Serah."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105640
    m_Localized: "Serah! Tr\u1EA3 l\u1EDDi \u0111i...!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105641
    m_Localized: "C\xE2y \u0111\u1ED5 \u0111\xE3 ch\u1EB7n k\xEDn con \u0111\u01B0\u1EDDng.
      Kh\xF4ng th\u1EC3 \u0111i qua t\u1EEB ph\xEDa con \u0111\u01B0\u1EDDng nh\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105642
    m_Localized: "Ph\u1EA3i t\xECm \u0111\u01B0\u1EDDng v\xF2ng. N\u1EBFu Serah b\u1ECB
      th\u01B0\u01A1ng th\xEC t\xF4i ph\u1EA3i l\u1EADp t\u1EE9c xem cho c\xF4 \u1EA5y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105643
    m_Localized: "Khoan \u0111\xE3. C\xF3 d\u1EA5u v\u1EBFt cho th\u1EA5y Serah \u0111\xE3
      tr\u01B0\u1EE3t xu\u1ED1ng b\xEAn d\u01B0\u1EDBi con \u0111\u01B0\u1EDDng s\u1EE5p."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105644
    m_Localized: "C\u0169ng c\xF3 v\u1EBFt ki\u1EBFm c\xE0o tr\xEAn m\u1EB7t \u0111\u1EA5t.
      C\xF3 kh\u1EA3 n\u0103ng c\xF4 \u1EA5y v\u1EABn c\xF2n di chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105645
    m_Localized: "V\u1EADy h\xE3y \u0111i xu\u1ED1ng theo \u0111\u01B0\u1EDDng v\xF2ng
      qua ph\xEDa khu khai th\xE1c g\u1ED7."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105646
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y tin Serah v\xE0 l\u1EA7n theo d\u1EA5u
      v\u1EBFt."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105647
    m_Localized: "V\u1EEBa ch\u1EB7n qu\xE1i v\u1EADt \u1EDF khu khai th\xE1c g\u1ED7,
      v\u1EEBa nh\u1EA5t \u0111\u1ECBnh ph\u1EA3i t\xECm Serah."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105648
    m_Localized: "...\u0110\u01B0\u1EE3c. \u0110\u1EEBng \u0111\u1EC3 m\u1EA5t d\u1EA5u
      ch\xE2n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105649
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a qu\xE1i v\u1EADt g\u1EA7n khu
      khai th\xE1c g\u1ED7 v\u1EABn c\xF2n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105650
    m_Localized: "Nh\u1EDD kho\u1EA3ng tr\u1ED1ng Serah t\u1EA1o ra m\xE0 ch\xFAng
      ta c\xF3 th\u1EC3 \u0111i tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105651
    m_Localized: "H\xE3y di chuy\u1EC3n tr\u01B0\u1EDBc khi kho\u1EA3ng tr\u1ED1ng
      \u0111\xF3 kh\xE9p l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105652
    m_Localized: "Khu khai th\xE1c g\u1ED7 trong r\u1EEBng Lumer."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105653
    m_Localized: "Khoan \u0111\xE3. C\xF3 d\u1EA5u ch\xE2n c\u1EE7a Serah \u1EDF
      s\xE2u h\u01A1n trong khu khai th\xE1c g\u1ED7!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105654
    m_Localized: "Kh\xF4ng b\u1ECB ng\u1EAFt. N\xF3 v\u1EABn ti\u1EBFp t\u1EE5c k\xE9o
      d\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105655
    m_Localized: "Th\u1EADt sao...? Noah, c\u1EADu ch\u1EAFc ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105656
    m_Localized: "\u1EEA. V\u1EABn c\xF2n c\u1EA3 d\u1EA5u ki\u1EBFm c\xE0o tr\xEAn
      m\u1EB7t \u0111\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105657
    m_Localized: "\u0110i th\xF4i. Tr\u01B0\u1EDBc khi d\u1EA5u ch\xE2n bi\u1EBFn
      m\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105658
    m_Localized: "Serah...! N\u1EBFu nghe th\u1EA5y th\xEC tr\u1EA3 l\u1EDDi \u0111i...!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105659
    m_Localized: "Khoan. C\xF3 g\xEC \u0111\xF3 v\u1EEBa chuy\u1EC3n \u0111\u1ED9ng
      ph\xEDa sau nh\u1EEFng th\xE2n c\xE2y b\u1ECB \u0111\u1ED1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105660
    m_Localized: "T\xF4i c\xF2n nghe th\u1EA5y ti\u1EBFng ki\u1EBFm c\xE0o tr\xEAn
      m\u1EB7t \u0111\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105661
    m_Localized: "...\u0110\xFAng r\u1ED3i. L\xE0 Serah."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105662
    m_Localized: Serah!
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105663
    m_Localized: "M\u1ECDi ng\u01B0\u1EDDi, t\xF4i \u1EDF \u0111\xE2y...!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105664
    m_Localized: "T\xF4i \u1ED5n! M\u1ECDi ng\u01B0\u1EDDi kh\xF4ng sao ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105665
    m_Localized: "\u0110\xF3 l\xE0 \u0111i\u1EC1u b\u1ECDn t\xF4i ph\u1EA3i h\u1ECFi
      c\u1EADu ch\u1EE9...!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105666
    m_Localized: "C\u1EADu c\xF3 b\u1ECB th\u01B0\u01A1ng \u1EDF \u0111\xE2u kh\xF4ng?
      C\u1EADu th\u1EADt s\u1EF1 \u1ED5n ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105667
    m_Localized: "Ch\u1EC9 n\xF3i \u1ED5n sau khi ki\u1EC3m tra \u0111\xE3. Spayne,
      xem gi\xFAp c\u1EADu \u1EA5y \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105668
    m_Localized: "\u1EEA... L\u1EA7n n\xE0y t\xF4i s\u1EBD kh\xF4ng b\u1ECF qua ch\u1EC9
      v\xEC c\u1EADu n\xF3i m\xECnh \u1ED5n \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105669
    m_Localized: "\u0110\u01B0\u1EE3c r\u1ED3i. C\u1EE9 ki\u1EC3m tra \u0111i. Nh\u01B0ng
      t\xF4i kh\xF4ng b\u1ECB th\u01B0\u01A1ng n\u1EB7ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105670
    m_Localized: "Sao c\u1EADu l\u1EA1i \u1EDF l\u1EA1i m\u1ED9t m\xECnh...? B\u1ECDn
      t\xF4i c\u0169ng c\xF3 th\u1EC3 chi\u1EBFn \u0111\u1EA5u c\xF9ng c\u1EADu m\xE0..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105671
    m_Localized: "Xin l\u1ED7i. T\xF4i ngh\u0129 \u0111\xF3 l\xE0 c\xE1ch duy nh\u1EA5t
      \u0111\u1EC3 m\u1ECDi ng\u01B0\u1EDDi tho\xE1t ra."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105672
    m_Localized: "M\u1EEBng v\xEC c\u1EADu kh\xF4ng sao, Serah. Sao c\u1EADu \u0111\u1EBFn
      t\u1EADn \u0111\xE2y sau khi con \u0111\u01B0\u1EDDng s\u1EE5p xu\u1ED1ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105673
    m_Localized: "Khi con \u0111\u01B0\u1EDDng s\u1EE5p xu\u1ED1ng, t\xF4i b\u1ECB
      tr\u01B0\u1EE3t xu\u1ED1ng theo s\u01B0\u1EDDn d\u1ED1c, nh\u01B0ng n\xF3 ch\u01B0a
      b\u1ECB \u0111\u1EE9t ho\xE0n to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105674
    m_Localized: "N\xF3 v\u1EABn n\u1ED1i ch\xE9o xu\u1ED1ng nh\u01B0 m\u1ED9t con
      \u0111\u01B0\u1EDDng l\xE0m vi\u1EC7c c\u0169."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105675
    m_Localized: "V\u1EADy n\xEAn d\u1EA5u ch\xE2n c\u1EE7a c\u1EADu kh\xF4ng b\u1ECB
      ng\u1EAFt."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105676
    m_Localized: "\u1EEA. T\xF4i ch\u1ED1ng ng\u01B0\u1EDDi b\u1EB1ng ki\u1EBFm r\u1ED3i
      leo l\xEAn. Tr\xEAn \u0111\u01B0\u1EDDng c\u0169ng \u0111\u1EE5ng ph\u1EA3i
      v\xE0i con qu\xE1i v\u1EADt."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105677
    m_Localized: "\u0110\u1EEBng n\xF3i chuy\u1EC7n \u0111\xF3 m\u1ED9t c\xE1ch b\xECnh
      th\u1EA3n nh\u01B0 v\u1EADy..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105678
    m_Localized: "Xin l\u1ED7i. T\xF4i c\u0169ng \u0111\u1ECBnh quay l\u1EA1i ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105679
    m_Localized: "Nh\u01B0ng \u1EDF cu\u1ED1i con \u0111\u01B0\u1EDDng l\xE0m vi\u1EC7c
      ph\xEDa d\u01B0\u1EDBi, t\xF4i nh\xECn th\u1EA5y m\u1ED9t lu\u1ED3ng s\xE1ng
      k\u1EF3 l\u1EA1."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105680
    m_Localized: "C\u1EADu kh\xF4ng ch\u1EA1m v\xE0o lu\u1ED3ng s\xE1ng \u0111\xF3,
      \u0111\xFAng kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105681
    m_Localized: "Kh\xF4ng. T\xF4i kh\xF4ng ch\u1EA1m v\xE0o. Ng\u01B0\u1EE3c l\u1EA1i,
      qu\xE1i v\u1EADt \u0111\xE3 ch\u1EA1y ra \u0111\u1EC3 tr\xE1nh lu\u1ED3ng s\xE1ng
      \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105682
    m_Localized: "T\xF4i ch\u1EC9 ch\u1EB7n nh\u1EEFng con qu\xE1i v\u1EADt b\u1ECB
      d\u1ED3n v\xE0o con \u0111\u01B0\u1EDDng l\xE0m vi\u1EC7c."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105683
    m_Localized: "V\u1EADy l\xE0 ph\u1EA3n \u1EE9ng v\u1ED1n \u0111\xE3 c\xF3 \u1EDF
      \u0111\xE2y c\u0169ng xu\u1EA5t hi\u1EC7n tr\xEAn con \u0111\u01B0\u1EDDng
      l\xE0m vi\u1EC7c."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105684
    m_Localized: "Tr\xEAn t\u1EA3ng \u0111\xE1 \u1EDF trung t\xE2m c\u0169ng c\xF3
      m\u1ED9t k\xFD hi\u1EC7u t\u01B0\u01A1ng t\u1EF1."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105685
    m_Localized: "H\xE3y ki\u1EC3m tra xem hai d\u1EA5u v\u1EBFt \u0111\xF3 c\xF3
      n\u1ED1i v\u1EDBi nhau kh\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105686
    m_Localized: "D\u1EA5u ch\xE2n \u0111i v\xF2ng quanh m\xE9p b\xE3i tr\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105687
    m_Localized: "H\u1EA7u nh\u01B0 kh\xF4ng c\xF3 d\u1EA5u v\u1EBFt n\xE0o ti\u1EBFn
      l\u1EA1i g\u1EA7n trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105688
    m_Localized: "Ch\xFAng kh\u1EF1ng l\u1EA1i tr\u01B0\u1EDBc k\xFD hi\u1EC7u r\u1ED3i
      r\u1EBD sang b\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105689
    m_Localized: "Kh\xF4ng ph\u1EA3i ch\xFAng c\u1ED1 t\xECnh \u0111i v\xF2ng, m\xE0
      gi\u1ED1ng nh\u01B0 b\u1ECB \u0111\u1EA9y sang b\xEAn tr\u01B0\u1EDBc k\xFD
      hi\u1EC7u sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105690
    m_Localized: "\u1EEA. D\u1EA5u v\u1EBFt cho th\u1EA5y ch\xFAng \u0111\xE3 ch\u1ED1ng
      l\u1EA1i r\u1ED3i b\u1ECB \u0111\u1EA9y sang b\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105691
    m_Localized: "M\u1ED9t k\xFD hi\u1EC7u kh\xF4ng r\xF5 \u1EDF gi\u1EEFa khu r\u1EEBng..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105692
    m_Localized: "M\u1ED9t k\xFD hi\u1EC7u ch\u1EC9 \u0111\u01B0\u1EDDng c\u0169
      th\xEC hay bi\u1EBFt m\u1EA5y... nh\u01B0ng xem ra kh\xF4ng ph\u1EA3i v\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105693
    m_Localized: "N\u1EBFu ngay c\u1EA3 d\u1EA5u ch\u1EC9 \u0111\u01B0\u1EDDng c\u0169ng
      \u0111\xE1ng ng\u1EA1i th\u1EBF n\xE0y th\xEC ph\u1EA3i \u0111\xE1nh d\u1EA5u
      \u0111\u01B0\u1EDDng quay v\u1EC1 c\u1EA9n th\u1EADn h\u01A1n r\u1ED3i..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105694
    m_Localized: "\u0110\u1EEBng ch\u1EA1m v\xE0o khu v\u1EF1c quanh k\xFD hi\u1EC7u.
      Tr\u01B0\u1EDBc h\u1EBFt h\xE3y quan s\xE1t chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a
      qu\xE1i v\u1EADt."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233886105695
    m_Localized: "C\xF3 chuy\u1EC3n \u0111\u1ED9ng \u1EDF ph\xEDa s\xE2u trong khu
      khai th\xE1c g\u1ED7."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299904
    m_Localized: "Ch\xFAng \u0111ang t\xE1ch sang hai b\xEAn \u0111\u1EC3 tr\xE1nh
      k\xFD hi\u1EC7u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299905
    m_Localized: "H\u01B0\u1EDBng tr\xE1nh c\u1EE7a ch\xFAng kh\xE1 \u0111\u1EC1u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299906
    m_Localized: "Kh\xE1c v\u1EDBi vi\u1EC7c ch\u1EC9 \u0111i v\xF2ng qua m\u1ED9t
      ch\u01B0\u1EDBng ng\u1EA1i v\u1EADt."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299907
    m_Localized: "V\u1EADy l\xE0 ch\xFAng \u0111\u1EBFn t\u1EEB c\u1EA3 hai ph\xEDa
      sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299908
    m_Localized: "H\xE3y c\xF9ng ch\u1EB7n ch\xFAng tr\u01B0\u1EDBc khi ch\xFAng
      t\u1EA3n ra!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299909
    m_Localized: "C\u1EA9n th\u1EADn \u0111\u1EC3 kh\xF4ng v\u1EA5p v\xE0o nh\u1EEFng
      th\xE2n c\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299910
    m_Localized: "\u1EDE \u0111\xE2y c\xF3 qu\xE1 nhi\u1EC1u th\u1EE9 c\xF3 th\u1EC3
      khi\u1EBFn ng\u01B0\u1EDDi ta b\u1ECB th\u01B0\u01A1ng n\u1EBFu ng\xE3..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299911
    m_Localized: "Ch\xFAng \u0111ang \u0111i ra t\u1EEB c\u1EA3 hai b\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299912
    m_Localized: "Ch\xFAng \u0111ang tr\xE1nh khu trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299913
    m_Localized: "H\xE3y ch\u1EB7n ch\xFAng \u1EDF r\xECa khu khai th\xE1c g\u1ED7."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299914
    m_Localized: "\u0110\u1EEBng d\u1ED3n ch\xFAng v\u1EC1 ph\xEDa k\xFD hi\u1EC7u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299915
    m_Localized: "Qu\xE1i v\u1EADt \u0111\xE3 tr\xE1nh khu trung t\xE2m \u0111\u1EBFn
      t\u1EADn cu\u1ED1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299916
    m_Localized: "Kh\xF4ng gi\u1ED1ng nh\u01B0 ch\xFAng t\u1EF1 ch\u1ECDn tr\xE1nh,
      m\xE0 c\xF3 v\u1EBB ch\xFAng kh\xF4ng th\u1EC3 \u0111\u1EBFn g\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299917
    m_Localized: "Tr\u1EADn chi\u1EBFn k\u1EBFt th\xFAc r\u1ED3i. H\xE3y xem k\u1EF9
      ph\xEDa k\xFD hi\u1EC7u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299918
    m_Localized: "C\u1EA3 d\u1EA5u v\u1EBFt khai th\xE1c g\u1ED7 l\u1EABn k\xFD hi\u1EC7u
      \u0111\u1EC1u \u0111\xE3 c\u0169. C\xF3 v\u1EBB g\u1EA7n \u0111\xE2y kh\xF4ng
      ai ch\u1EA1m v\xE0o ch\xFAng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299919
    m_Localized: "Nh\u01B0ng ph\u1EA3n \u1EE9ng b\xEAn d\u01B0\u1EDBi k\xFD hi\u1EC7u
      b\u1ECB ng\u1EAFt r\u1ED3i l\u1EA1i ti\u1EBFp t\u1EE5c."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299920
    m_Localized: "V\u1EADy th\u1EE9 t\xF4i nh\xECn th\u1EA5y \u0111\xFAng l\xE0 m\u1ED9t
      manh m\u1ED1i r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299921
    m_Localized: "\u1EEA. Kh\u1EA3 n\u0103ng \u0111\xF3 l\xE0 manh m\u1ED1i r\u1EA5t
      cao."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299922
    m_Localized: "Ch\u01B0a th\u1EC3 kh\u1EB3ng \u0111\u1ECBnh \u0111\xF3 l\xE0 thi\u1EBFt
      b\u1ECB, nh\u01B0ng c\xF3 v\u1EBB kh\xF4ng ph\u1EA3i k\xFD hi\u1EC7u \u0111\u01A1n
      thu\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299923
    m_Localized: "T\xF4i c\u0169ng b\u1EAFt \u0111\u01B0\u1EE3c m\u1ED9t ph\u1EA3n
      \u1EE9ng y\u1EBFu gi\u1ED1ng \u0111\xE1 t\xEDn hi\u1EC7u. C\xF3 v\u1EBB n\xF3
      n\u1ED1i ti\u1EBFp t\u1EEB s\xE2u h\u01A1n trong r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299924
    m_Localized: "T\xF4i kh\xF4ng mu\u1ED1n \u1EDF c\u1EA1nh m\u1ED9t k\xFD hi\u1EC7u
      l\u1EA1 qu\xE1 l\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299925
    m_Localized: "D\xF9 c\xF3 th\u1EC3 ch\u1EC9 l\xE0 do t\xE2m l\xFD, t\xF4i v\u1EABn
      c\u1EA3m th\u1EA5y c\u01A1 th\u1EC3 m\xECnh n\u1EB7ng h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299926
    m_Localized: "D\u1EA5u ch\xE2n d\u1EABn v\u1EC1 ph\xEDa \u0111\u1EA7m l\u1EA7y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299927
    m_Localized: "Sau khi tr\xE1nh k\xFD hi\u1EC7u, d\u1EA5u v\u1EBFt b\u1ECB x\xE1o
      tr\u1ED9n m\u1EA1nh h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299928
    m_Localized: "H\xE3y ghi l\u1EA1i v\u1ECB tr\xED k\xFD hi\u1EC7u r\u1ED3i ki\u1EC3m
      tra ph\xEDa \u0111\u1EA7m l\u1EA7y n\u01A1i d\u1EA5u ch\xE2n d\u1EABn \u0111\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299929
    m_Localized: "\u0110\u1EA7m l\u1EA7y s\xE2u trong r\u1EEBng Lumer."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299930
    m_Localized: "\u0110\u1EA7m l\u1EA7y \u0111\xFAng l\xE0 t\u1EC7 nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299931
    m_Localized: "Ch\xE2n th\xEC l\xFAn, qu\u1EA7n \xE1o th\xEC \u01B0\u1EDBt, ng\u01B0\u1EDDi
      b\u1ECB th\u01B0\u01A1ng l\u1EA1i c\xE0ng n\u1EB7ng h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299932
    m_Localized: "N\u1EBFu b\u1ECB th\u01B0\u01A1ng tr\xEAn b\xF9n th\xEC ngay c\u1EA3
      ki\u1EC3m tra v\u1EBFt th\u01B0\u01A1ng c\u0169ng kh\xF3..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299933
    m_Localized: "D\xF9 v\u1EADy, d\u1EA5u v\u1EBFt v\u1EABn d\u1EABn \u0111\u1EBFn
      \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299934
    m_Localized: "Kh\xF4ng th\u1EC3 c\u1EE9 th\u1EBF quay v\u1EC1 \u0111\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299935
    m_Localized: "D\u1EA5u ch\xE2n li\xEAn t\u1EE5c bi\u1EBFn m\u1EA5t \u1EDF m\xE9p
      n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299936
    m_Localized: "Nh\u01B0ng ngay c\u1EA3 sau khi m\u1EA5t d\u1EA5u, h\u01B0\u1EDBng
      \u0111i v\u1EABn v\u1EC1 ph\xEDa b\xE3i tr\u1ED1ng trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299937
    m_Localized: "Ph\u1EA3n \u1EE9ng c\u1EE7a \u0111\xE1 t\xEDn hi\u1EC7u \u0111ang
      dao \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299938
    m_Localized: "Ph\u1EA3n \u1EE9ng ch\xFAng ta th\u1EA5y \u1EDF khu khai th\xE1c
      g\u1ED7 tr\u1EDF n\xEAn th\u1EA5t th\u01B0\u1EDDng h\u01A1n \u1EDF \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299939
    m_Localized: "C\u1EADu \u0111ang ph\xE1t hi\u1EC7n ph\u1EA3n \u1EE9ng ma l\u1EF1c
      sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299940
    m_Localized: "\u1EEA. Nh\u01B0ng v\u1EABn ch\u01B0a \u0111\u1EE7 \u0111\u1EC3
      n\xF3i \u0111\xF3 l\xE0 nguy\xEAn nh\xE2n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299941
    m_Localized: "\u0110\xFAng h\u01A1n l\xE0 c\xF3 ph\u1EA3n \u1EE9ng \u0111ang
      r\xF2 r\u1EC9 t\u1EEB m\u1ED9t c\xF4ng tr\xECnh c\u0169."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299942
    m_Localized: "C\xF3 d\u1EA5u ch\xE2n l\u1EDBn g\u1EA7n m\xE9p n\u01B0\u1EDBc
      n\u01A1i ph\u1EA3n \u1EE9ng \u0111ang dao \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299943
    m_Localized: "Nh\u1EEFng con qu\xE1i v\u1EADt nh\u1ECF \u0111\xE3 \u0111i v\xF2ng
      \u0111\u1EC3 tr\xE1nh d\u1EA5u v\u1EBFt \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299944
    m_Localized: "Th\u1EE9 g\xEC \u0111\xF3 l\u1EDBn \u0111\xE3 \u0111i qua tr\u01B0\u1EDBc
      sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299945
    m_Localized: "C\xF3 v\u1EBB l\xE0 v\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299946
    m_Localized: "Kh\xF4ng c\xF3 d\u1EA5u hi\u1EC7u qu\xE1i v\u1EADt l\u1EDBn \u0111u\u1ED5i
      theo nh\u1EEFng con nh\u1ECF. T\u1EA5t c\u1EA3 nh\u1EEFng con nh\u1ECF \u0111\u1EC1u
      \u0111ang tr\xE1nh n\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299947
    m_Localized: "V\u1EADy l\xE0 ch\xFAng ta \u0111ang \u0111i v\xE0o n\u01A1i t\u1EA5t
      c\u1EA3 qu\xE1i v\u1EADt nh\u1ECF \u0111\u1EC1u tr\xE1nh...?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299948
    m_Localized: "Nghe nh\u01B0 m\u1ED9t l\u1EF1a ch\u1ECDn kh\xE1 t\u1EC7."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299949
    m_Localized: "D\xF9 l\xE0 l\u1EF1a ch\u1ECDn t\u1EC7, n\u1EBFu d\u1EEBng \u1EDF
      \u0111\xE2y th\xEC con \u0111\u01B0\u1EDDng v\u1EC1 ph\xEDa Zeppel l\u1EA1i
      g\u1EB7p nguy hi\u1EC3m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299950
    m_Localized: "C\u1EADu n\xF3i \u0111\xFAng, nh\u01B0ng c\xE0ng \u0111\xFAng th\xEC
      con \u0111\u01B0\u1EDDng l\u1EA1i c\xE0ng kh\xF3 \u0111i..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299951
    m_Localized: "\u0110\xFAng v\u1EADy. V\xEC th\u1EBF c\xE0ng ph\u1EA3i ki\u1EC3m
      tra ti\u1EBFp."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299952
    m_Localized: "Ph\u1EA3i xem ph\u1EA3n \u1EE9ng n\xE0y c\xF3 l\xE0m chuy\u1EC3n
      \u0111\u1ED9ng c\u1EE7a qu\xE1i v\u1EADt r\u1ED1i lo\u1EA1n kh\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299953
    m_Localized: "Nh\xF3m g\u1EA7n m\xE9p n\u01B0\u1EDBc \u0111\xE3 \u0111\u1EBFn
      g\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299954
    m_Localized: "Ch\xFAng \u0111ang \u0111i v\xF2ng qua m\xE9p n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299955
    m_Localized: "H\xE3y ch\u1EB7n \u1EDF r\xECa \u0111\u1EA7m l\u1EA7y tr\u01B0\u1EDBc
      khi qu\xE1i v\u1EADt b\u1ECB d\u1ED3n v\xE0o b\xE3i tr\u1ED1ng trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299956
    m_Localized: "Kh\xF4ng ch\u1EC9 c\xF3 m\u1ED9t k\xFD hi\u1EC7u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299957
    m_Localized: "K\xFD hi\u1EC7u ph\xEDa \u0111\u1EA7m l\u1EA7y n\u1ED1i v\u1EDBi
      nh\u1EEFng m\u1EA3nh tr\xF4ng nh\u01B0 b\u1ED9 ph\u1EADn c\u1EE7a m\u1ED9t
      thi\u1EBFt b\u1ECB b\u1ECB ch\xF4n d\u01B0\u1EDBi n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299958
    m_Localized: "N\u1EBFu l\xE0 thi\u1EBFt b\u1ECB th\xEC ai \u0111\xE3 t\u1EA1o
      ra n\xF3?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299959
    m_Localized: "V\u1EABn ch\u01B0a bi\u1EBFt."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299960
    m_Localized: "Ch\u1EC9 c\xF3 th\u1EC3 x\xE1c nh\u1EADn nh\u1EEFng m\u1EA3nh tr\xF4ng
      nh\u01B0 thi\u1EBFt b\u1ECB \u0111\xE3 c\u0169 v\xE0 h\u1ECFng, c\xF2n ph\u1EA3n
      \u1EE9ng v\u1EABn \u0111ang r\xF2 r\u1EC9 t\u1EEB \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299961
    m_Localized: "Qu\xE1i v\u1EADt \u0111\xE3 tr\xE1nh khu v\u1EF1c n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299962
    m_Localized: "Nh\u01B0ng trong l\xFAc tr\xE1nh, ch\xFAng l\u1EA1i b\u1ECB d\u1ED3n
      v\u1EC1 ph\xEDa b\xE3i tr\u1ED1ng trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299963
    m_Localized: "V\u1EADy n\u01A1i ch\xFAng ta c\u1EA7n \u0111\u1EBFn c\u0169ng
      l\xE0 b\xE3i tr\u1ED1ng trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299964
    m_Localized: "M\u1ED7i l\u1EA7n ki\u1EC3u suy lu\u1EADn n\xE0y \u0111\xFAng l\xE0
      t\xF4i l\u1EA1i m\u1EC7t h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299965
    m_Localized: "D\u1EA5u ch\xE2n l\u1EDBn c\u0169ng d\u1EABn v\u1EC1 b\xE3i tr\u1ED1ng
      trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299966
    m_Localized: "\u0110\xE2y l\xE0 d\u1EA5u ch\xE2n s\xE2u nh\u1EA5t trong s\u1ED1
      nh\u1EEFng g\xEC ch\xFAng ta \u0111\xE3 th\u1EA5y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299967
    m_Localized: "H\xE3y \u0111\u1EA3m b\u1EA3o \u0111\u01B0\u1EDDng r\xFAt lui tr\u01B0\u1EDBc
      khi ti\u1EBFn v\xE0o b\xE3i tr\u1ED1ng trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299968
    m_Localized: "N\u1EBFu ti\u1EBFn v\xE0o m\xE0 kh\xF4ng chu\u1EA9n b\u1ECB th\xEC
      ch\xFAng ta s\u1EBD kh\xF4ng c\xF3 th\u1EDDi gian ki\u1EC3m tra ph\u1EA3n \u1EE9ng
      \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299969
    m_Localized: "\u1EEA. T\xF4i c\u0169ng s\u1EBD ghi l\u1EA1i v\u1ECB tr\xED ph\u1EA3n
      \u1EE9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299970
    m_Localized: "N\u1EBFu n\xF3 n\u1ED1i v\u1EDBi ph\u1EA3n \u1EE9ng \u1EDF b\xE3i
      tr\u1ED1ng trung t\xE2m th\xEC ph\u1EA3i t\xECm c\xE1ch \u1ED5n \u0111\u1ECBnh
      n\xF3, thay v\xEC \u0111\u1EADp ph\xE1 b\u1EEBa b\xE3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299971
    m_Localized: "C\u0169ng ph\u1EA3i \u0111\u1ED1i chi\u1EBFu xem n\xF3 c\xF3 c\xF9ng
      hoa v\u0103n v\u1EDBi k\xFD hi\u1EC7u \u1EDF khu khai th\xE1c g\u1ED7 kh\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299972
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y s\u1EEDa ch\u1EEFa r\u1ED3i ti\u1EBFn
      v\xE0o!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299973
    m_Localized: "N\u1EBFu t\xECm \u0111\u01B0\u1EE3c ch\xFAt \u0111\u1EA5t kh\xF4
      n\xE0o th\xEC s\u1EEDa ch\u1EEFa \u1EDF \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299974
    m_Localized: "Ngh\u1EC9 ng\u01A1i tr\xEAn \u0111\u1EA7m l\u1EA7y th\xEC ch\u1EB3ng
      t\xEDnh l\xE0 ngh\u1EC9..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299975
    m_Localized: "L\u1ED1i v\xE0o b\xE3i tr\u1ED1ng trung t\xE2m c\u1EE7a r\u1EEBng
      Lumer."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299976
    m_Localized: "Th\u1EBF n\xE0y th\xEC \xEDt nh\u1EA5t c\xE1ng c\u0169ng c\xF3
      th\u1EC3 \u0111i qua."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299977
    m_Localized: "Kh\xF4ng ph\u1EA3i con \u0111\u01B0\u1EDDng t\u1ED1t, nh\u01B0ng
      v\u1EABn h\u01A1n l\xE0 kh\xF4ng c\xF3 \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299978
    m_Localized: "\u0110\xE2y s\u1EBD l\xE0 \u0111\u01B0\u1EDDng r\xFAt lui c\u1EE7a
      ch\xFAng ta sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299979
    m_Localized: "\u1EEA. N\u1EBFu b\u1ECB \u0111\u1EA9y l\xF9i kh\u1ECFi b\xE3i
      tr\u1ED1ng trung t\xE2m th\xEC h\xE3y r\xFAt theo \u0111\u01B0\u1EDDng n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299980
    m_Localized: "Nh\u01B0ng n\u1EBFu c\xF3 th\u1EC3 th\xEC ph\u1EA3i k\u1EBFt th\xFAc
      \u1EDF b\xEAn trong b\xE3i tr\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299981
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn \u0111ang \u1EDF ph\xEDa trong
      b\xE3i tr\u1ED1ng trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299982
    m_Localized: "Nh\u1EEFng qu\xE1i v\u1EADt xung quanh \u0111ang tr\xE1nh chuy\u1EC3n
      \u0111\u1ED9ng l\u1EDBn r\u1ED3i b\u1ECB d\u1ED3n ra ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299983
    m_Localized: "V\u1EABn ch\u01B0a bi\u1EBFt con th\u1EC3 l\u1EDBn l\xE0 nguy\xEAn
      nh\xE2n hay c\u0169ng b\u1ECB cu\u1ED1n v\xE0o c\xF9ng ph\u1EA3n \u1EE9ng \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299984
    m_Localized: "\u0110i\u1EC1u ch\u1EAFc ch\u1EAFn l\xE0 ph\u1EA3n \u1EE9ng g\u1EA7n
      b\xE3i tr\u1ED1ng b\u1EA5t \u1ED5n nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299985
    m_Localized: "V\u1EADy th\xEC v\xE0o trong xem t\u1EADn m\u1EAFt th\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299986
    m_Localized: "Ch\u1EC9 c\u1EA7n ch\u1EB7n ch\xFAng tr\u01B0\u1EDBc khi nhi\u1EC1u
      qu\xE1i v\u1EADt h\u01A1n b\u1ECB d\u1ED3n ra ngo\xE0i!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299987
    m_Localized: "T\u1EF1 tin l\xE0 t\u1ED1t, nh\u01B0ng \u0111\u1EEBng \u0111i qu\xE1
      xa v\xE0o trong b\xE3i tr\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299988
    m_Localized: "\u0110\u01B0\u1EDDng quay v\u1EC1 c\u0169ng l\xE0 m\u1ED9t ph\u1EA7n
      c\u1EE7a tr\u1EADn chi\u1EBFn..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299989
    m_Localized: "Hi\u1EC3u r\u1ED3i. D\xF9 ti\u1EBFn l\xEAn th\xEC t\xF4i c\u0169ng
      s\u1EBD ch\u1EEBa \u0111\u01B0\u1EDDng quay v\u1EC1."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299990
    m_Localized: "D\u1EA5u ch\xE2n cong th\xE0nh m\u1ED9t v\xF2ng tr\xF2n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299991
    m_Localized: "\u0110\xE2y l\xE0 d\u1EA5u v\u1EBFt cho th\u1EA5y ch\xFAng \u0111i
      v\xF2ng r\u1ED9ng \u0111\u1EC3 tr\xE1nh ph\xEDa c\xF3 chuy\u1EC3n \u0111\u1ED9ng
      l\u1EDBn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299992
    m_Localized: "K\xFD hi\u1EC7u \u1EDF khu khai th\xE1c g\u1ED7, nh\u1EEFng m\u1EA3nh
      v\u1EE1 trong \u0111\u1EA7m l\u1EA7y v\xE0 ph\u1EA3n \u1EE9ng \u1EDF b\xE3i
      tr\u1ED1ng trung t\xE2m c\xF3 th\u1EC3 \u0111\u1EC1u n\u1ED1i v\u1EDBi nhau."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299993
    m_Localized: "Thay v\xEC c\u1ED1 c\u1EAFt ph\u1EA3n \u1EE9ng, t\xF4i ngh\u0129
      ph\u1EA3i \u1ED5n \u0111\u1ECBnh ph\u1EA7n b\u1EA5t \u1ED5n nh\u1EA5t tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299994
    m_Localized: "V\u1EADy l\xE0 kh\xF4ng \u0111\u01B0\u1EE3c ph\xE1 n\xF3 sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299995
    m_Localized: "\u01AF\u1EDBc g\xEC \u0111\xE2y l\xE0 lo\u1EA1i thi\u1EBFt b\u1ECB
      ch\u1EC9 c\u1EA7n \u0111\u1EADp v\u1EE1 l\xE0 xong..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299996
    m_Localized: "H\xE3y k\u1EBFt lu\u1EADn sau khi ki\u1EC3m tra b\xE3i tr\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299997
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a nh\xF3m b\xEAn trong b\xE3i
      tr\u1ED1ng m\u1EA1nh h\u01A1n r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299998
    m_Localized: "Ch\xFAng \u0111ang b\u1ECB d\u1ED3n t\u1EEB trong b\xE3i tr\u1ED1ng
      ra ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890299999
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y v\xE0o b\xE3i tr\u1ED1ng trung t\xE2m
      v\xE0 ch\u1EB7n nh\xF3m l\u1EDBn tr\u01B0\u1EDBc khi ch\xFAng t\u1EA3n ra."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300000
    m_Localized: "B\xE3i tr\u1ED1ng trung t\xE2m trong r\u1EEBng Lumer."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300001
    m_Localized: "T\u1EA5t c\u1EA3 d\u1EA5u ch\xE2n \u0111\u1EC1u d\u1EABn \u0111\u1EBFn
      \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300002
    m_Localized: "V\xE0 t\u1EEB \u0111\xE2y ch\xFAng l\u1EA1i b\u1ECB d\u1ED3n ra
      ph\xEDa ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300003
    m_Localized: "V\u1EADy \u0111\xE2y l\xE0 n\u01A1i c\xE1c chuy\u1EC3n \u0111\u1ED9ng
      s\xE2u trong r\u1EEBng h\u1ED9i t\u1EE5."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300004
    m_Localized: "Ph\u1EA3n \u1EE9ng c\u1EE7a \u0111\xE1 t\xEDn hi\u1EC7u c\u0169ng
      b\u1EA5t \u1ED5n nh\u1EA5t \u1EDF \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300005
    m_Localized: "Thay v\xEC t\u1EA1o ra ph\u1EA3n \u1EE9ng, c\xF3 v\u1EBB c\xF4ng
      tr\xECnh n\xE0y \u0111ang ti\u1EBFp nh\u1EADn ph\u1EA3n \u1EE9ng t\u1EEB b\xEAn
      ngo\xE0i r\u1ED3i dao \u0111\u1ED9ng theo n\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300006
    m_Localized: "D\u1EA5u ch\xE2n quanh c\xF4ng tr\xECnh b\u1ECB l\xFAn s\xE2u xu\u1ED1ng
      \u0111\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300007
    m_Localized: "C\xF3 v\u1EBB qu\xE1i v\u1EADt \u0111\xE3 c\u1ED1 ch\u1ED1ng c\u1EF1
      \u1EDF \u0111\xE2y r\u1ED3i l\u1EA1i b\u1ECB d\u1ED3n ra ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300008
    m_Localized: "T\xF4i kh\xF4ng bao gi\u1EDD th\xEDch chi\u1EBFn \u0111\u1EA5u
      \u1EDF n\u01A1i c\xF3 qu\xE1 nhi\u1EC1u \u0111i\u1EC1u ch\u01B0a bi\u1EBFt."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300009
    m_Localized: "\u0110\u1EB7c bi\u1EC7t l\xE0 khi c\xF3 th\u1EE9 g\xEC \u0111\xF3
      ph\xE1t s\xE1ng d\u01B0\u1EDBi l\xF2ng \u0111\u1EA5t..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300010
    m_Localized: "H\xE3y ch\u1EB7n nh\xF3m \u0111ang ti\u1EBFn ra ngo\xE0i b\xE3i
      tr\u1ED1ng tr\u01B0\u1EDBc khi ch\xFAng tho\xE1t v\u1EC1 ph\xEDa Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300011
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn \u0111ang \u1EDF ph\xEDa sau
      c\xF4ng tr\xECnh gi\u1EEFa b\xE3i tr\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300012
    m_Localized: "Nh\u1EEFng qu\xE1i v\u1EADt xung quanh \u0111ang di chuy\u1EC3n
      \u0111\u1EC3 tr\xE1nh n\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300013
    m_Localized: "V\u1EADy tr\u01B0\u1EDBc ti\xEAn ch\u1EB7n nh\xF3m \u0111i ra,
      r\u1ED3i x\u1EED l\xFD con th\u1EC3 l\u1EDBn sau c\u0169ng \u0111\u01B0\u1EE3c
      \u0111\xFAng kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300014
    m_Localized: "\u1EEA. Ph\u1EA3i gi\u1EEF nh\xF3m \u0111i ra tr\u01B0\u1EDBc kh\xF4ng
      \u0111\u1EC3 ch\xFAng t\u1EA3n ra."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300015
    m_Localized: "N\u1EBFu nh\xF3m t\u1EA3n ra th\xEC s\u1EF1 h\u1ED7n lo\u1EA1n
      c\xF3 th\u1EC3 lan ng\u01B0\u1EE3c \u0111\u1EBFn l\u1ED1i v\xE0o r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300016
    m_Localized: "N\u1EBFu b\u1ECB th\u01B0\u01A1ng th\xEC r\xFAt theo \u0111\u01B0\u1EDDng
      r\xFAt lui."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300017
    m_Localized: "N\u1EBFu c\u1ED1 qu\xE1 \u1EDF \u0111\xE2y th\xEC \u0111\u01B0\u1EDDng
      quay v\u1EC1 ch\u1EC9 c\xE0ng d\xE0i h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300018
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a nh\xF3m trong b\xE3i tr\u1ED1ng
      b\u1EAFt \u0111\u1EA7u r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300019
    m_Localized: "Nh\xF3m \u0111i ra tr\u01B0\u1EDBc \u0111\xE3 \u0111\u1EBFn r\xECa
      b\xE3i tr\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300020
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n ch\xFAng \u1EDF b\xE3i tr\u1ED1ng
      trung t\xE2m c\u1EE7a r\u1EEBng Lumer tr\u01B0\u1EDBc khi nh\xF3m l\u1EDBn
      b\u1ECB d\u1ED3n ra kh\u1ECFi r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300021
    m_Localized: "Nh\xF3m l\u1EDBn c\u0169ng b\u1ECB ch\u1EB7n r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300022
    m_Localized: "V\u1EADy th\xEC t\u1EEB gi\u1EDD s\u1ED1 qu\xE1i v\u1EADt b\u1ECB
      d\u1ED3n t\u1EEB r\u1EEBng v\u1EC1 ph\xEDa Zeppel s\u1EBD gi\u1EA3m \u0111i,
      \u0111\xFAng kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300023
    m_Localized: "\u1EEA. Ti\u1EBFng b\u01B0\u1EDBc ch\xE2n n\u1EB7ng n\u1EC1 t\u1EEBng
      d\u1ED3n ra ngo\xE0i t\u1EA1m th\u1EDDi \u0111\xE3 l\u1EAFng xu\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300024
    m_Localized: "Nh\u01B0ng ph\u1EA3n \u1EE9ng s\xE2u trong r\u1EEBng v\u1EABn \u0111ang
      dao \u0111\u1ED9ng m\u1EA1nh quanh c\xF4ng tr\xECnh n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300025
    m_Localized: "Xem ph\u1EA1m vi ma l\u1EF1c th\xEC ph\u1EA3n \u1EE9ng v\u1EABn
      ti\u1EBFp t\u1EE5c xu\u1ED1ng b\xEAn d\u01B0\u1EDBi c\xF4ng tr\xECnh."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300026
    m_Localized: "N\u1EBFu c\u1EE9 \u0111\u1EC3 th\u1EBF n\xE0y th\xEC chuy\u1EC3n
      \u0111\u1ED9ng s\xE2u trong r\u1EEBng c\xF3 th\u1EC3 l\u1EA1i r\u1ED1i lo\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300027
    m_Localized: "V\u1EADy h\xE3y ch\u1EB7n n\xF3 ngay b\xE2y gi\u1EDD. Kh\xF4ng
      th\u1EC3 \u0111\u1EC3 qu\xE1i v\u1EADt l\u1EA1i tr\xE0n v\u1EC1 ph\xEDa Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300028
    m_Localized: "T\xF4i s\u1EBD d\xF9ng \u0111\xE1 t\xEDn hi\u1EC7u \u0111\u1EC3
      \xE1p ch\u1EBF ph\u1EA3n \u1EE9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300029
    m_Localized: "Kh\xF4ng ph\u1EA3i s\u1EEDa ho\xE0n to\xE0n, m\xE0 l\xE0 b\u1ECBt
      ph\u1EA7n \u0111ang r\xF2 r\u1EC9."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300030
    m_Localized: "V\u1EADy kh\xF4ng ph\u1EA3i s\u1EEDa, ch\u1EC9 l\xE0m cho n\xF3
      r\xF2 r\u1EC9 \xEDt h\u01A1n th\xF4i..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300031
    m_Localized: "Ch\u1EC9 v\u1EADy th\xF4i h\xF4m nay c\u0169ng \u0111\xE3 l\xE0
      vi\u1EC7c l\u1EDBn r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300032
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a qu\xE1i v\u1EADt gi\u1EA3m
      r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300033
    m_Localized: "Ti\u1EBFng b\u01B0\u1EDBc ch\xE2n t\u1EEBng d\u1ED3n ra ngo\xE0i
      c\u0169ng \u0111ang xa d\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300034
    m_Localized: "T\u1ED1t. \xCDt nh\u1EA5t ch\xFAng ta \u0111\xE3 ch\u1EB7n \u0111\u01B0\u1EE3c
      chuy\u1EC3n \u0111\u1ED9ng \u0111ang tr\xE0n v\u1EC1 ph\xEDa Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300035
    m_Localized: "Ph\u1EA3n \u1EE9ng \u1EDF b\xE3i tr\u1ED1ng trung t\xE2m t\u1EA1m
      th\u1EDDi \u0111\xE3 \u1ED5n \u0111\u1ECBnh."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300036
    m_Localized: "Nh\u01B0ng v\u1EABn c\xF2n h\u01B0\u1EDBng m\xE0 ph\u1EA3n \u1EE9ng
      truy\u1EC1n \u0111\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300037
    m_Localized: "N\xF3 d\u1EABn \u0111i \u0111\xE2u?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300038
    m_Localized: "D\u1EF1a theo h\u01B0\u1EDBng c\u1EE7a ph\u1EA3n \u1EE9ng th\xEC
      n\xF3 d\u1EABn v\u1EC1 ph\xEDa khu m\u1ECF Verdin."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300039
    m_Localized: "C\xF3 kh\u1EA3 n\u0103ng n\xF3 n\u1ED1i v\u1EDBi m\u1EA1ch \u0111\u1ECBa
      kh\xED trong m\u1ECF ho\u1EB7c m\u1ED9t c\u01A1 s\u1EDF c\u0169."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300040
    m_Localized: "Sau r\u1EEBng l\u1EA1i \u0111\u1EBFn m\u1ECF sao...?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300041
    m_Localized: "V\u1EADy l\xE0 sau n\u01A1i \u1EA9m \u01B0\u1EDBt, ch\xFAng ta
      l\u1EA1i ph\u1EA3i \u0111\u1EBFn m\u1ED9t n\u01A1i t\u1ED1i t\u0103m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300042
    m_Localized: "Kh\xF4ng ng\u1EDD v\u1EABn c\xF2n n\u01A1i kh\xF3 ngh\u1EC9 ng\u01A1i
      h\u01A1n c\u1EA3 khu r\u1EEBng..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300043
    m_Localized: "D\xF9 sao th\xEC h\u01B0\u1EDBng \u0111i \u0111\xE3 r\xF5. Ch\xFAng
      ta bi\u1EBFt ph\u1EA3i ki\u1EC3m tra \u1EDF \u0111\xE2u ti\u1EBFp theo."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300044
    m_Localized: "C\xF3 v\u1EBB con qu\xE1i v\u1EADt l\u1EDBn c\u0169ng \u0111\xE3
      c\u1ED1 tr\xE1nh ph\u1EA3n \u1EE9ng n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300045
    m_Localized: "Kh\xF4ng c\xF3 d\u1EA5u hi\u1EC7u n\xF3 ch\u1EDD \u1EDF \u0111\xE2y
      \u0111\u1EC3 t\u1EA5n c\xF4ng ch\xFAng ta."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300046
    m_Localized: "V\u1EADy l\xE0 v\u1EABn ch\u01B0a k\u1EBFt th\xFAc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300047
    m_Localized: "V\u1EABn c\xF2n d\u1EA5u v\u1EBFt ti\u1EBFp t\u1EE5c d\u1EABn \u0111i,
      \u0111\xFAng kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300048
    m_Localized: "\u1EEA. N\u1EBFu ph\u1EA3n \u1EE9ng ch\xFAng ta x\xE1c nh\u1EADn
      trong r\u1EEBng Lumer ti\u1EBFp t\u1EE5c v\u1EC1 ph\xEDa m\u1ECF th\xEC ph\u1EA3i
      ki\u1EC3m tra."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300049
    m_Localized: "D\xF9 v\u1EADy, tr\u01B0\u1EDBc m\u1EAFt h\xE3y ghi l\u1EA1i vi\u1EC7c
      ch\xFAng ta \u0111\xE3 gi\u1EA3m hi\u1EC7n t\u01B0\u1EE3ng qu\xE1i v\u1EADt
      tr\xE0n ra t\u1EEB r\u1EEBng Lumer."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300050
    m_Localized: "H\xE3y s\u1EAFp x\u1EBFp l\u1EA1i ghi ch\xE9p v\u1EC1 r\u1EEBng
      Lumer r\u1ED3i ki\u1EC3m tra ph\u1EA3n \u1EE9ng d\u1EABn v\u1EC1 ph\xEDa khu
      m\u1ECF Verdin."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300051
    m_Localized: "H\xE3y ghi ch\xE9p th\u1EADt c\u1EA9n th\u1EADn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300052
    m_Localized: "\u0110\u1EC3 sau n\xE0y l\u1EE1 qu\xEAn m\u1EA5t v\xEC sao ch\xFAng
      ta l\u1EA1i \u0111i \u0111\u1EBFn t\u1EADn \u0111\xE2y th\xEC oan l\u1EAFm..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300053
    m_Localized: "L\u1ED1i v\xE0o l\xE0ng m\u1ECF Verdin."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300054
    m_Localized: "C\xE1c v\u1ECB l\xE0 H\u1ED9 V\u1EC7 \u0111\u1EBFn t\u1EEB r\u1EEBng
      Lumer ph\u1EA3i kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300055
    m_Localized: "\u0110\xFAng v\u1EADy. Ph\u1EA3n \u1EE9ng ch\xFAng ta x\xE1c nh\u1EADn
      quanh c\xF4ng tr\xECnh trong r\u1EEBng Lumer k\xE9o d\xE0i v\u1EC1 ph\xEDa
      m\u1ECF Verdin."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300056
    m_Localized: "T\xECnh h\xECnh \u1EDF Verdin c\u0169ng kh\xF4ng t\u1ED1t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300057
    m_Localized: "Qu\xE1i v\u1EADt \u0111ang b\u1ECB d\u1ED3n l\xEAn t\u1EEB ph\xEDa
      d\u01B0\u1EDBi m\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300058
    m_Localized: "M\u1ED7i khi \u0111\u01B0\u1EDDng h\u1EA7m l\xE0m vi\u1EC7c ph\xEDa
      d\u01B0\u1EDBi rung chuy\u1EC3n, con d\u1ED1c v\u1EC1 ph\xEDa l\xE0ng c\u0169ng
      rung theo."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300059
    m_Localized: "Ch\xFAng t\xF4i \u0111ang s\u01A1 t\xE1n d\xE2n l\xE0ng theo con
      \u0111\u01B0\u1EDDng \u0111\u1EBFn qu\u1EA3ng tr\u01B0\u1EDDng, nh\u01B0ng
      c\xF3 qu\xE1 nhi\u1EC1u thi\u1EBFt b\u1ECB n\xEAn t\u1ED1c \u0111\u1ED9 b\u1ECB
      ch\u1EADm l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300060
    m_Localized: "Kh\u1EDBp v\u1EDBi d\u1EA5u v\u1EBFt h\u01B0\u1EDBng v\u1EC1 Verdin
      m\xE0 ch\xFAng ta th\u1EA5y trong r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300061
    m_Localized: "D\u1EA5u ch\xE2n kh\xF4ng \u0111i xu\u1ED1ng t\u1EEB tr\xEAn n\xFAi,
      m\xE0 \u0111i ra t\u1EEB ph\xEDa \u0111\u01B0\u1EDDng h\u1EA7m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300062
    m_Localized: "\u0110\u1EA5t \u1EDF l\u1ED1i v\xE0o \u0111\u01B0\u1EDDng h\u1EA7m
      c\u0169ng b\u1ECB \u0111\u1EA9y ra ph\xEDa ngo\xE0i. \u0110\xE2y l\xE0 d\u1EA5u
      v\u1EBFt cho th\u1EA5y c\xF3 th\u1EE9 g\xEC \u0111\xF3 \u0111ang c\u1ED1 tho\xE1t
      ra t\u1EEB b\xEAn d\u01B0\u1EDBi."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300063
    m_Localized: "\u1EDE r\u1EEBng Lumer, ch\xFAng b\u1ECB d\u1ED3n ra ngo\xE0i,
      c\xF2n \u1EDF \u0111\xE2y th\xEC \u0111ang \u0111i l\xEAn t\u1EEB d\u01B0\u1EDBi
      l\xF2ng \u0111\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300064
    m_Localized: "C\xF3 th\u1EC3 c\xF9ng m\u1ED9t ph\u1EA3n \u1EE9ng b\u1EA5t th\u01B0\u1EDDng
      \u0111ang bi\u1EC3u hi\u1EC7n kh\xE1c nhau t\xF9y theo \u0111\u1ECBa h\xECnh."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233890300065
    m_Localized: "C\xF3 th\u1EC3 c\u1EA5u tr\xFAc c\u1EE7a m\u1ECF kh\xF4ng ch\u1EB7n
      ph\u1EA3n \u1EE9ng, m\xE0 \u0111ang d\u1ED3n n\xF3 \u0111i l\xEAn qua nh\u1EEFng
      con \u0111\u01B0\u1EDDng h\u1EB9p."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688512
    m_Localized: "L\xE0ng m\u1ECF th\xEC \u0111\u01B0\u1EDDng ch\u1EAFc c\u0169ng
      h\u1EB9p m\xE0 thi\u1EBFt b\u1ECB l\u1EA1i nhi\u1EC1u n\u1EEFa."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688513
    m_Localized: "N\u1EBFu b\u1ECB th\u01B0\u01A1ng th\xEC ngay c\u1EA3 vi\u1EC7c
      di chuy\u1EC3n c\u0169ng s\u1EBD th\xE0nh chuy\u1EC7n l\u1EDBn..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688514
    m_Localized: "V\u1EABn ch\u01B0a ph\u1EA3i t\u1EA5t c\u1EA3 c\xF4ng nh\xE2n \u1EDF
      ph\xEDa d\u01B0\u1EDBi \u0111\xE3 ra ngo\xE0i \u0111\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688515
    m_Localized: "\xCDt nh\u1EA5t ph\u1EA3i gi\u1EEF tr\u1ED1ng con \u0111\u01B0\u1EDDng
      v\u1EC1 ph\xEDa qu\u1EA3ng tr\u01B0\u1EDDng c\u1EE7a l\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688516
    m_Localized: "V\u1EADy ch\u1EC9 c\u1EA7n ng\u0103n qu\xE1i v\u1EADt kh\xF4ng
      v\xE0o qu\u1EA3ng tr\u01B0\u1EDDng l\xE0 \u0111\u01B0\u1EE3c \u0111\xFAng kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688517
    m_Localized: "T\xF4i s\u1EBD gi\u1EEF ph\xEDa tr\u01B0\u1EDBc trong l\xFAc m\u1ECDi
      ng\u01B0\u1EDDi r\xFAt ra."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688518
    m_Localized: "\u0110\u1EEBng \u0111i qu\xE1 s\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688519
    m_Localized: "N\u1EBFu c\xF3 th\xEAm qu\xE1i v\u1EADt tr\xE0n ra t\u1EEB \u0111\u01B0\u1EDDng
      h\u1EA7m th\xEC ch\xFAng ta c\u1EA7n ch\u1EEBa ch\u1ED7 \u0111\u1EC3 r\xFAt
      v\u1EC1 ph\xEDa l\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688520
    m_Localized: "T\xF4i bi\u1EBFt. \u0110\u1EE9ng \u1EDF ph\xEDa tr\u01B0\u1EDBc
      kh\xE1c v\u1EDBi lao v\xE0o m\u1ED9t c\xE1ch m\xF9 qu\xE1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688521
    m_Localized: "Nh\u1EEFng ng\u01B0\u1EDDi ph\xEDa sau ph\u1EA3i c\xF3 th\u1EC3
      tin t\xF4i r\u1ED3i di chuy\u1EC3n ch\u1EE9."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688522
    m_Localized: "\u1ED2, h\xF4m nay nghi\xEAm t\xFAc gh\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688523
    m_Localized: "T\u1EA5t nhi\xEAn r\u1ED3i. Tr\u01B0\u1EDBc \u0111\xE2y t\xF4i
      c\u1EA7m ki\u1EBFm \u0111\u1EC3 tr\xE1nh phi\xEAn n\u1EA5u \u0103n, nh\u01B0ng..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688524
    m_Localized: "L\xFD do \u0111\xF3 th\xEC t\xF4i nghe l\u1EA7n \u0111\u1EA7u \u0111\u1EA5y..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688525
    m_Localized: "Gi\u1EDD ph\xEDa sau t\xF4i c\xF3 nh\u1EEFng ng\u01B0\u1EDDi t\xF4i
      ph\u1EA3i b\u1EA3o v\u1EC7."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688526
    m_Localized: "Nh\xF3m qu\xE1i v\u1EADt t\u1EEB \u0111\u01B0\u1EDDng h\u1EA7m
      \u0111ang \u0111\u1EBFn g\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688527
    m_Localized: "Ch\xFAng \u0111ang \u0111i l\xEAn t\u1EEB con d\u1ED1c b\xEAn d\u01B0\u1EDBi
      \u0111\u01B0\u1EDDng h\u1EA7m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688528
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n ch\xFAng \u1EDF l\u1ED1i
      v\xE0o l\xE0ng m\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688529
    m_Localized: "H\xE3y gi\u1EEF con \u0111\u01B0\u1EDDng \u0111\u1EBFn qu\u1EA3ng
      tr\u01B0\u1EDDng cho \u0111\u1EBFn khi c\xE1c c\xF4ng nh\xE2n r\xFAt ra."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688530
    m_Localized: "\u0110\xE3 ng\u0103n \u0111\u01B0\u1EE3c thi\u1EC7t h\u1EA1i \u1EDF
      qu\u1EA3ng tr\u01B0\u1EDDng c\u1EE7a l\xE0ng, v\xE0 h\u1EA7u h\u1EBFt c\xF4ng
      nh\xE2n b\xEAn d\u01B0\u1EDBi c\u0169ng \u0111\xE3 ra ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688531
    m_Localized: "V\u1EABn c\xF2n nh\u1EEFng \u0111\u01B0\u1EDDng h\u1EA7m l\xE0m
      vi\u1EC7c ch\u01B0a ki\u1EC3m tra, nh\u01B0ng con \u0111\u01B0\u1EDDng \u0111\u1EBFn
      qu\u1EA3ng tr\u01B0\u1EDDng v\u1EABn th\xF4ng tho\xE1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688532
    m_Localized: "T\u1ED1t. Nh\u1EEFng ng\u01B0\u1EDDi \u0111\xE3 s\u01A1 t\xE1n
      \u0111\u1EC1u an to\xE0n ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688533
    m_Localized: "V\xE2ng. Nh\u1EDD c\xE1c v\u1ECB m\xE0 \u0111\u01B0\u1EDDng s\u01A1
      t\xE1n v\u1EABn m\u1EDF."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688534
    m_Localized: "Kh\xF4ng c\xF3 d\u1EA5u hi\u1EC7u qu\xE1i v\u1EADt bao v\xE2y ng\xF4i
      l\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688535
    m_Localized: "Ch\xFAng b\u1ECB d\u1ED3n l\xEAn t\u1EEB m\u1ECF r\u1ED3i b\u1ECB
      ch\u1EB7n \u1EDF l\u1ED1i v\xE0o l\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688536
    m_Localized: "Ph\u1EA3n \u1EE9ng b\u1EAFt \u0111\u01B0\u1EE3c t\u1EEB \u0111\xE1
      t\xEDn hi\u1EC7u m\u1EA1nh h\u01A1n l\xFAc \u1EDF trong r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688537
    m_Localized: "C\u1EA5u tr\xFAc d\u01B0\u1EDBi l\xF2ng \u0111\u1EA5t d\u01B0\u1EDDng
      nh\u01B0 \u0111ang gi\u1EEF ph\u1EA3n \u1EE9ng ma l\u1EF1c l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688538
    m_Localized: "Ch\u1EC9 mong th\u1EE9 b\u1ECB gi\u1EEF l\u1EA1i kh\xF4ng ph\u1EA3i
      l\xE0 ng\u01B0\u1EDDi..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688539
    m_Localized: "C\xE0ng \u0111i xu\u1ED1ng th\xEC \u0111\u01B0\u1EDDng quay v\u1EC1
      c\u0169ng c\xE0ng d\xE0i h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688540
    m_Localized: "\u0110\xE3 c\xF3 th\xEAm b\xE1o c\xE1o t\u1EEB ph\xEDa m\u1ECF
      b\u1ECF hoang."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688541
    m_Localized: "Nghe n\xF3i b\xEAn trong li\xEAn t\u1EE5c c\xF3 \xE2m thanh nh\u01B0
      qu\u1EB7ng \u0111ang ng\xE2n l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688542
    m_Localized: "Tr\u01B0\u1EDBc h\u1EBFt h\xE3y s\u1EAFp x\u1EBFp ghi ch\xE9p ph\xF2ng
      th\u1EE7 c\u1EE7a l\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688543
    m_Localized: "Ph\u1EA3i chu\u1EA9n b\u1ECB h\u1ED7 tr\u1EE3 tr\u01B0\u1EDBc khi
      v\xE0o m\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688544
    m_Localized: "\u1EEA. T\xF4i s\u1EBD \u0111\u1ED1i chi\u1EBFu v\u1EDBi ghi ch\xE9p
      v\u1EC1 ph\u1EA3n \u1EE9ng trong r\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688545
    m_Localized: "Tr\u1EA1m h\u1ED7 tr\u1EE3 t\u1EA1m th\u1EDDi \u1EDF l\xE0ng m\u1ECF
      Verdin."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688546
    m_Localized: "Ph\xF2ng th\u1EE7 quanh l\xE0ng \u0111\xE3 \u1ED5n \u0111\u1ECBnh."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688547
    m_Localized: "Nh\u01B0ng n\u1EBFu kh\xF4ng gi\u1EEF \u0111\u01B0\u1EE3c l\u1ED1i
      v\xE0o m\u1ECF th\xEC ch\xFAng s\u1EBD l\u1EA1i tr\xE0n l\xEAn ph\xEDa l\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688548
    m_Localized: "T\xF4i s\u1EBD t\u1EADp trung nh\u1EEFng c\xF4ng nh\xE2n \u0111\xE3
      s\u01A1 t\xE1n v\xE0o ph\xEDa trong tr\u1EA1m h\u1ED7 tr\u1EE3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688549
    m_Localized: "T\xF4i s\u1EBD b\u1ED1 tr\xED ri\xEAng nh\u1EEFng ng\u01B0\u1EDDi
      chuy\u1EC3n thi\u1EBFt b\u1ECB \u0111\u1EC3 h\u1ECD kh\xF4ng ch\u1EB7n con
      \u0111\u01B0\u1EDDng \u0111\u1EBFn qu\u1EA3ng tr\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688550
    m_Localized: "Tr\u01B0\u1EDBc h\u1EBFt h\xE3y chuy\u1EC3n nh\u1EEFng ng\u01B0\u1EDDi
      b\u1ECB th\u01B0\u01A1ng kh\xF3 \u0111i l\u1EA1i v\xE0o ph\xEDa trong tr\u1EA1m
      h\u1ED7 tr\u1EE3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688551
    m_Localized: "T\xF4i s\u1EBD b\u0103ng b\xF3 tr\u01B0\u1EDBc nh\u1EEFng v\u1EBFt
      th\u01B0\u01A1ng nh\u1EB9, c\xF2n vi\u1EC7c ch\u1EEFa tr\u1ECB s\u1EBD chia
      ra l\xE0m t\u1EEBng \u0111\u1EE3t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688552
    m_Localized: "Kh\xF4ng ch\u1EEFa ngay c\xF3 sao kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688553
    m_Localized: "V\u1EBFt th\u01B0\u01A1ng c\xF3 th\u1EC3 ch\u1EDD kh\xE1c v\u1EDBi
      v\u1EBFt th\u01B0\u01A1ng s\u1EBD nguy hi\u1EC3m n\u1EBFu b\u1ECF l\u1EE1 l\xFAc
      n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688554
    m_Localized: "T\xF4i t\u1EEBng c\u1ED1 x\u1EED l\xFD ngay t\u1EA5t c\u1EA3 v\u1EBFt
      th\u01B0\u01A1ng tr\u01B0\u1EDBc m\u1EAFt r\u1ED3i \u0111\u1EBFn mu\u1ED9n
      khi t\xECnh h\xECnh l\u1EDBn h\u01A1n x\u1EA3y ra..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688555
    m_Localized: "V\u1EADy n\xEAn b\xE2y gi\u1EDD c\u1EADu \u0111ang chia th\u1EE9
      t\u1EF1 ra."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688556
    m_Localized: "\u1EEA. Kh\xF4ng ph\u1EA3i t\xF4i tr\xEC ho\xE3n v\xEC ng\u1EA1i
      \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688557
    m_Localized: "T\xF4i ph\xE2n lo\u1EA1i tr\u01B0\u1EDBc \u0111\u1EC3 sau n\xE0y
      ch\xFAng kh\xF4ng tr\u1EDF n\xEAn phi\u1EC1n ph\u1EE9c h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688558
    m_Localized: "C\xF3 r\u1EA5t nhi\u1EC1u d\u1EA5u ch\xE2n g\u1EA7n l\u1ED1i v\xE0o
      m\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688559
    m_Localized: "T\u1EA5t c\u1EA3 \u0111\u1EC1u cho th\u1EA5y qu\xE1i v\u1EADt b\u1ECB
      d\u1ED3n t\u1EEB b\xEAn trong ra ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688560
    m_Localized: "Ch\xFAng ch\u1ED3ng l\xEAn nhau theo c\xF9ng m\u1ED9t h\u01B0\u1EDBng,
      tr\xF4ng nh\u01B0 b\u1ECB \u0111\u1EA9y ra c\xF9ng m\u1ED9t l\xFAc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688561
    m_Localized: "Ph\u1EA3n \u1EE9ng c\u1EE7a \u0111\xE1 t\xEDn hi\u1EC7u c\u0169ng
      n\u1EB7ng n\u1EC1 h\u01A1n l\xFAc \u1EDF r\u1EEBng Lumer."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688562
    m_Localized: "Qu\u1EB7ng ho\u1EB7c m\u1ED9t thi\u1EBFt b\u1ECB c\u0169 n\xE0o
      \u0111\xF3 c\xF3 th\u1EC3 \u0111ang gi\u1EEF ph\u1EA3n \u1EE9ng l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688563
    m_Localized: "Sau khi ki\u1EC3m tra l\u1ED1i v\xE0o m\u1ECF, ch\xFAng ta c\xF3
      th\u1EC3 \u0111\u1ED1i chi\u1EBFu xem n\xF3 gi\u1ED1ng ph\u1EA3n \u1EE9ng \u1EDF
      r\u1EEBng \u0111\u1EBFn m\u1EE9c n\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688564
    m_Localized: "\xC2m thanh kim lo\u1EA1i than kh\xF3c v\u1EABn ti\u1EBFp t\u1EE5c
      vang l\xEAn t\u1EEB b\xEAn trong m\u1ECF b\u1ECF hoang."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688565
    m_Localized: "C\xE1c th\u1EE3 m\u1ECF n\xF3i c\xF3 v\u1EBB \xE2m thanh b\u1EAFt
      \u0111\u1EA7u t\u1EEB ph\xEDa \u0111\u01B0\u1EDDng ray v\u1EADn chuy\u1EC3n
      c\u0169."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688566
    m_Localized: "H\xE3y ki\u1EC3m tra l\u1ED1i v\xE0o m\u1ECF tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688567
    m_Localized: "M\u1ECF b\u1ECF hoang v\xE0 khu \u0111\u01B0\u1EDDng ray s\u1EBD
      v\xE0o sau."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688568
    m_Localized: "\u0110\u01B0\u1EE3c. Ph\u1EA3i gi\u1EEF l\u1ED1i v\xE0o th\xEC
      m\u1EDBi c\xF3 th\u1EC3 ti\u1EBFn v\xE0o b\xEAn trong."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688569
    m_Localized: "N\u1EBFu l\u1ED1i v\xE0o s\u1EE5p xu\u1ED1ng th\xEC \u0111\u01B0\u1EDDng
      quay v\u1EC1 c\u0169ng s\u1EBD b\u1ECB ch\u1EB7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688570
    m_Localized: "T\xF4i s\u1EBD \u0111\xE1nh d\u1EA5u \u0111\u01B0\u1EDDng tr\u01B0\u1EDBc
      khi v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688571
    m_Localized: "L\u1ED1i v\xE0o m\u1ECF Verdin."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688572
    m_Localized: "\u0110\xE2y l\xE0 \u0111\u01B0\u1EDDng h\u1EA7m ch\xEDnh."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688573
    m_Localized: "Qu\xE1i v\u1EADt \u0111ang \u0111i l\xEAn t\u1EEB con d\u1ED1c
      b\xEAn d\u01B0\u1EDBi."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688574
    m_Localized: "C\xE1c c\u1ED9t ch\u1ED1ng \u0111ang rung chuy\u1EC3n, n\xEAn nh\u1EEFng
      l\u1ED1i \u0111i b\xEAn trong s\u1EBD kh\xF4ng th\u1EC3 tr\u1EE5 l\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688575
    m_Localized: "N\u1EBFu m\u1EA5t l\u1ED1i v\xE0o th\xEC vi\u1EC7c ki\u1EC3m tra
      s\xE2u trong \u0111\u01B0\u1EDDng h\u1EA7m t\u1EEB ph\xEDa l\xE0ng c\u0169ng
      s\u1EBD kh\xF3 kh\u0103n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688576
    m_Localized: "T\u1EA5t c\u1EA3 d\u1EA5u ch\xE2n \u0111\u1EC1u h\u01B0\u1EDBng
      l\xEAn tr\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688577
    m_Localized: "Ch\xFAng kh\xF4ng \u0111i v\u1EC1 ph\xEDa l\xE0ng. Ch\xFAng b\u1ECB
      d\u1ED3n ra t\u1EEB b\xEAn d\u01B0\u1EDBi."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688578
    m_Localized: "S\xE0n con d\u1ED1c c\u0169ng b\u1ECB c\xE0o v\u1EC1 ph\xEDa ngo\xE0i.
      \u0110\xE2y l\xE0 d\u1EA5u v\u1EBFt cho th\u1EA5y ch\xFAng \u0111\xE3 c\u1ED1
      ch\u1ED1ng c\u1EF1 khi \u0111i l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688579
    m_Localized: "\u01AF...!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688580
    m_Localized: "C\u0169ng c\xF3 chuy\u1EC3n \u0111\u1ED9ng \u1EDF ph\xEDa b\xEAn
      ph\u1EA3i s\xE2u h\u01A1n b\xEAn trong. Kh\xF4ng ch\u1EC9 c\xF3 m\u1ED9t nh\xF3m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688581
    m_Localized: "C\u1EADu kh\xF4ng sao ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688582
    m_Localized: "\u1EEA, t\xF4i \u1ED5n. Nh\u01B0ng t\xF4i s\u1EBD kh\xF4ng b\u1ECF
      qua chuy\u1EC7n n\xE0y \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688583
    m_Localized: "Tr\u01B0\u1EDBc \u0111\xE2y t\xF4i t\u1EEBng do d\u1EF1 r\u1ED3i
      b\xE1o qu\xE1 mu\u1ED9n... L\u1EA7n n\xE0y t\xF4i s\u1EBD n\xF3i ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688584
    m_Localized: "L\xE0m t\u1ED1t l\u1EAFm. B\xE2y gi\u1EDD b\xE1o c\xE1o \u0111\xF3
      l\xE0 \u0111i\u1EC1u quan tr\u1ECDng nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688585
    m_Localized: "Chuy\u1EC7n b\u1ECB gi\u1EADt m\xECnh th\xEC \u0111\u1EC3 l\xFAc
      ngh\u1EC9 r\u1ED3i x\u1EED l\xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688586
    m_Localized: "Ngay l\xFAc n\xE0y, tr\u01B0\u1EDBc h\u1EBFt ph\u1EA3i gi\u1EEF
      cho \u0111\u01B0\u1EDDng quay v\u1EC1 kh\xF4ng b\u1ECB ch\u1EB7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688587
    m_Localized: "H\xE3y v\xE0o v\u1ECB tr\xED tr\u01B0\u1EDBc l\u1ED1i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688588
    m_Localized: "C\u0169ng ph\u1EA3i \u0111\u1EC3 \xFD chuy\u1EC3n \u0111\u1ED9ng
      b\xEAn ph\u1EA3i ph\xEDa trong."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688589
    m_Localized: "T\xF4i s\u1EBD ch\u1EB7n l\u1ED1i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688590
    m_Localized: "\u0110\u1EEBng \u0111\u1EC3 s\xF3t c\u1EA3 ph\xEDa b\xEAn ph\u1EA3i
      m\xE0 Noah \u0111\xE3 n\xF3i!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688591
    m_Localized: "B\u1EE9c t\u01B0\u1EDDng b\xEAn tr\xE1i v\u1EABn c\xF2n y\xEAn
      t\u0129nh."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688592
    m_Localized: "C\u0169ng ph\u1EA3i ki\u1EC3m tra l\u1EA1i ph\xEDa \u0111\xE3 m\u1EA5t
      ti\u1EBFng \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688593
    m_Localized: "C\xF3 th\u1EC3 \xE2m thanh kh\xF4ng bi\u1EBFn m\u1EA5t, m\xE0 \u0111ang
      men theo b\u1EE9c t\u01B0\u1EDDng r\u1ED3i v\u1ECDng tr\u1EDF l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688594
    m_Localized: "Con d\u1ED1c b\xEAn ph\u1EA3i h\u1EB9p."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688595
    m_Localized: "N\u1EBFu ch\xFAng d\u1ED3n sang b\xEAn ph\u1EA3i th\xEC t\xF4i
      s\u1EBD x\u1EED l\xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688596
    m_Localized: "Y\xEAn t\u0129nh kh\xF4ng c\xF3 ngh\u0129a l\xE0 an to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688597
    m_Localized: "Trong m\u1ECF, \u0111\xF4i khi th\u1EE9 kh\xF4ng nghe th\u1EA5y
      c\xF2n \u0111\xE1ng s\u1EE3 h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688598
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a nh\xF3m b\xEAn d\u01B0\u1EDBi
      \u0111\u01B0\u1EDDng h\u1EA7m nhanh h\u01A1n r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688599
    m_Localized: "Ch\xFAng \u0111ang b\u1ECB d\u1ED3n l\xEAn t\u1EEB b\xEAn d\u01B0\u1EDBi."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688600
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n \u1EDF l\u1ED1i v\xE0o m\u1ECF
      v\xE0 kh\xF4ng \u0111\u1EC3 ch\xFAng tr\xE0n v\u1EC1 ph\xEDa l\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688601
    m_Localized: "\u0110\xE3 ch\u1EB7n \u0111\u01B0\u1EE3c l\u1ED1i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688602
    m_Localized: "D\xF9 ch\u1EB7n \u1EDF l\u1ED1i v\xE0o, ti\u1EBFng b\xEAn trong
      v\u1EABn ti\u1EBFp t\u1EE5c."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688603
    m_Localized: "V\u1EADy l\xE0 ch\u1EB7n \u1EDF l\u1ED1i v\xE0o c\u0169ng kh\xF4ng
      khi\u1EBFn ph\xEDa d\u01B0\u1EDBi y\xEAn t\u0129nh."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688604
    m_Localized: "D\u1EA5u ch\xE2n \u0111i l\xEAn t\u1EEB n\u01A1i s\xE2u h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688605
    m_Localized: "H\u1EA7u nh\u01B0 kh\xF4ng c\xF3 d\u1EA5u v\u1EBFt ch\xFAng d\u1EEBng
      l\u1EA1i g\u1EA7n l\u1ED1i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688606
    m_Localized: "\u0110\xE2y kh\xF4ng ph\u1EA3i nh\xF3m \u0111\u1EE9ng ch\u1EDD,
      m\xE0 l\xE0 chuy\u1EC3n \u0111\u1ED9ng li\xEAn t\u1EE5c b\u1ECB d\u1ED3n l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688607
    m_Localized: "Ch\xFAng kh\xF4ng nh\u1EAFm v\xE0o l\xE0ng hay l\u1ED1i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688608
    m_Localized: "C\xF3 v\u1EBB ph\u1EA3n \u1EE9ng d\u01B0\u1EDBi l\xF2ng \u0111\u1EA5t
      \u0111\xE3 \u0111\u1EA9y ch\xFAng \u0111i l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688609
    m_Localized: "V\u1EADy n\u1EBFu b\u1ECF m\u1EB7c ph\xEDa d\u01B0\u1EDBi th\xEC
      ch\xFAng s\u1EBD ti\u1EBFp t\u1EE5c \u0111i l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688610
    m_Localized: "Ch\u1EC9 ch\u1EB7n l\u1ED1i v\xE0o th\xEC kh\xF4ng th\u1EC3 k\u1EBFt
      th\xFAc chuy\u1EC7n n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688611
    m_Localized: "\xC2m thanh vang l\u1EDBn h\u01A1n \u1EDF ph\xEDa m\u1ECF b\u1ECF
      hoang."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688612
    m_Localized: "Con \u0111\u01B0\u1EDDng \u0111\xF3 \u0111\xE3 b\u1ECB ch\u1EB7n
      t\u1EEB l\xE2u, nh\u01B0ng g\u1EA7n \u0111\xE2y m\u1EDBi b\u1EAFt \u0111\u1EA7u
      vang tr\u1EDF l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688613
    m_Localized: "M\u1ED9t con \u0111\u01B0\u1EDDng b\u1ECB ch\u1EB7n t\u1EEB l\xE2u
      l\u1EA1i vang l\xEAn kh\xF4ng ph\u1EA3i tin t\u1ED1t g\xEC."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688614
    m_Localized: "Th\u01B0\u1EDDng ph\u1EA3i c\xF3 l\xFD do th\xEC ng\u01B0\u1EDDi
      ta m\u1EDBi ch\u1EB7n m\u1ED9t con \u0111\u01B0\u1EDDng..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688615
    m_Localized: "H\xE3y di chuy\u1EC3n v\u1EC1 ph\xEDa m\u1ECF b\u1ECF hoang."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688616
    m_Localized: "H\xE3y x\xE1c \u0111\u1ECBnh n\u01A1i \xE2m thanh b\u1EAFt \u0111\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688617
    m_Localized: "T\xF4i s\u1EBD ti\u1EBFp t\u1EE5c \u0111\u1EC3 l\u1EA1i d\u1EA5u
      ch\u1EC9 \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688618
    m_Localized: "Kh\xF4ng \u0111\u01B0\u1EE3c \u0111\u1EC3 m\u1EA5t \u0111\u01B0\u1EDDng
      quay v\u1EC1."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688619
    m_Localized: "L\u1ED1i v\xE0o m\u1ECF b\u1ECF hoang Verdin."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688620
    m_Localized: "\u0110\xE2y l\xE0 m\u1ECF b\u1ECF hoang \u0111\xE3 b\u1ECB ch\u1EB7n
      t\u1EEB l\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688621
    m_Localized: "Nh\u01B0ng v\xE0i ng\xE0y nay, b\xEAn trong li\xEAn t\u1EE5c vang
      l\xEAn \xE2m thanh nh\u01B0 kim lo\u1EA1i than kh\xF3c."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688622
    m_Localized: "H\xF4m nay c\u0169ng l\xE0 l\u1EA7n \u0111\u1EA7u ch\xFAng t\xF4i
      x\xE1c nh\u1EADn l\u1ED1i v\xE0o b\u1ECB ch\u1EB7n \u0111ang t\u1EEB t\u1EEB
      m\u1EDF ra t\u1EEB b\xEAn trong."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688623
    m_Localized: "Kh\xF4ng c\xF3 d\u1EA5u hi\u1EC7u con ng\u01B0\u1EDDi \u0111i v\xE0o
      r\u1ED3i m\u1EDF n\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688624
    m_Localized: "D\u1EA5u ch\xE2n quanh l\u1ED1i v\xE0o tr\xF4ng nh\u01B0 qu\xE1i
      v\u1EADt \u0111\xE3 do d\u1EF1."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688625
    m_Localized: "C\u0169ng c\xF3 d\u1EA5u v\u1EBFt cho th\u1EA5y ch\xFAng \u0111\u1ECBnh
      \u0111i v\xE0o r\u1ED3i l\u1EA1i b\u1ECB \u0111\u1EA9y ra."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688626
    m_Localized: "Bi\u1EC3u t\u01B0\u1EE3ng tr\xEAn t\u01B0\u1EDDng gi\u1ED1ng k\xFD
      hi\u1EC7u trong r\u1EEBng Lumer."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688627
    m_Localized: "Nh\u01B0ng bi\u1EC3u t\u01B0\u1EE3ng n\xE0y kh\xF4ng c\xF3 v\u1EBB
      t\u1EF1 nhi\xEAn, m\xE0 gi\u1ED1ng d\u1EA5u hi\u1EC7u c\u1EE7a m\u1ED9t thi\u1EBFt
      b\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688628
    m_Localized: "Sao c\u1EADu bi\u1EBFt \u0111\xF3 l\xE0 d\u1EA5u hi\u1EC7u c\u1EE7a
      thi\u1EBFt b\u1ECB?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688629
    m_Localized: "T\xF4i t\u1EEBng th\u1EA5y ghi ch\xE9p t\u01B0\u01A1ng t\u1EF1
      \u1EDF h\u1ECDc vi\u1EC7n ph\xE9p thu\u1EADt."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688630
    m_Localized: "Thi\u1EBFt b\u1ECB thu th\u1EADp ho\u1EB7c \u0111i\u1EC1u h\u01B0\u1EDBng
      ph\u1EA3n \u1EE9ng ma l\u1EF1c \u0111\xF4i khi \u0111\u1EC3 l\u1EA1i d\u1EA5u
      ch\u1EC9 h\u01B0\u1EDBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688631
    m_Localized: "V\u1ECB tr\xED c\u1EE7a bi\u1EC3u t\u01B0\u1EE3ng c\u0169ng quan
      tr\u1ECDng. N\u1EBFu ch\u1EC9 l\xE0 \u0111\u1ED3 trang tr\xED th\xEC n\xF3
      s\u1EBD kh\xF4ng k\xE9o d\xE0i xu\u1ED1ng t\u1EADn ph\xEDa s\xE0n nh\u01B0
      th\u1EBF n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688632
    m_Localized: "\u1EDE tr\u01B0\u1EDDng c\u0169ng d\u1EA1y nh\u1EEFng th\u1EE9
      \u0111\xF3 sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688633
    m_Localized: "C\xF3. C\xE0ng l\xE0 lo\u1EA1i ma thu\u1EADt khi\u1EBFn ng\u01B0\u1EDDi
      ta s\u1EE3 th\xEC c\xE0ng ph\u1EA3i hi\u1EC3u quy t\u1EAFc c\u1EE7a n\xF3 \u0111\u1EC3
      b\u1EDBt s\u1EE3 h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688634
    m_Localized: "V\xEC th\u1EBF t\xF4i kh\xF4ng mu\u1ED1n b\u1ECF qua nh\u1EEFng
      d\u1EA5u hi\u1EC7u nh\u01B0 th\u1EBF n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688635
    m_Localized: "H\xE3y ghi l\u1EA1i v\u1ECB tr\xED bi\u1EC3u t\u01B0\u1EE3ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688636
    m_Localized: "Tr\u01B0\u1EDBc m\u1EAFt h\xE3y ki\u1EC3m tra chuy\u1EC3n \u0111\u1ED9ng
      b\xEAn trong m\u1ECF b\u1ECF hoang."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688637
    m_Localized: "S\xE0n ph\xEDa s\xE2u h\u01A1n b\xEAn trong b\u1ECB c\xE0o r\u1EA5t
      s\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688638
    m_Localized: "C\xF3 v\u1EBB qu\xE1i v\u1EADt \u0111\xE3 c\u1ECD v\xE0o t\u01B0\u1EDDng
      khi b\u1ECB d\u1ED3n ra ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688639
    m_Localized: "Nh\u1EEFng v\u1EBFt c\xF2n l\u1EA1i tr\xEAn t\u01B0\u1EDDng c\u0169ng
      c\xF9ng m\u1ED9t h\u01B0\u1EDBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688640
    m_Localized: "N\u1EBFu thi\u1EBFt b\u1ECB \u0111\xE3 ho\u1EA1t \u0111\u1ED9ng
      th\xEC c\xF3 th\u1EC3 n\xF3 \u0111\u1EC3 l\u1EA1i d\u1EA5u v\u1EBFt theo h\u01B0\u1EDBng
      \u0111\u1EA9y ph\u1EA3n \u1EE9ng ma l\u1EF1c."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688641
    m_Localized: "Ch\u1EC9 quanh bi\u1EC3u t\u01B0\u1EE3ng l\xE0 \xEDt b\u1EE5i b\xE1m
      h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688642
    m_Localized: "\u0110\u01B0\u1EDDng h\u1EB9p th\xEC d\u1EC5 ch\u1EB7n t\u1EEB
      ph\xEDa tr\u01B0\u1EDBc, nh\u01B0ng n\u1EBFu b\u1ECB \u0111\u1EA9y l\xF9i s\u1EBD
      r\u1EA5t nguy hi\u1EC3m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688643
    m_Localized: "Trong l\xFAc t\xF4i c\u1EA7m ch\xE2n ch\xFAng, h\xE3y ki\u1EC3m
      tra c\u1EA3 hai b\u1EE9c t\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688644
    m_Localized: "N\u1EBFu b\u1ECB \u0111\u1EA9y l\xF9i trong m\u1ECF b\u1ECF hoang
      th\xEC ngay c\u1EA3 vi\u1EC7c r\xFAt v\u1EC1 l\u1ED1i v\xE0o c\u0169ng s\u1EBD
      r\u1EA5t kh\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688645
    m_Localized: "\u0110\u01B0\u1EDDng x\u1EA5u th\xEC th\u01B0\u1EDDng vi\u1EC7c
      ch\u1EEFa tr\u1ECB c\u0169ng t\u1EC7 \u0111i theo..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688646
    m_Localized: "Nh\xF3m b\xEAn trong m\u1ECF b\u1ECF hoang \u0111ang ti\u1EBFn
      \u0111\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688647
    m_Localized: "Ch\xFAng \u0111ang \u0111i l\xEAn t\u1EEB l\u1ED1i th\u1EA5p b\xEAn
      trong m\u1ECF b\u1ECF hoang."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688648
    m_Localized: "H\xE3y ch\u1EB7n \u1EDF l\u1ED1i v\xE0o m\u1ECF b\u1ECF hoang v\xE0
      kh\xF4ng \u0111\u1EC3 ch\xFAng b\u1ECB d\u1ED3n v\u1EC1 ph\xEDa bi\u1EC3u t\u01B0\u1EE3ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688649
    m_Localized: "\xC2m thanh \u0111\xE3 nh\u1ECF \u0111i nh\u01B0ng ch\u01B0a bi\u1EBFn
      m\u1EA5t ho\xE0n to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688650
    m_Localized: "D\u1EA5u ch\xE2n c\u0169ng ch\u01B0a k\u1EBFt th\xFAc \u1EDF \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688651
    m_Localized: "Ch\xFAng ti\u1EBFp t\u1EE5c v\u1EC1 ph\xEDa \u0111\u01B0\u1EDDng
      ray v\u1EADn chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688652
    m_Localized: "H\u01B0\u1EDBng c\u1EE7a bi\u1EC3u t\u01B0\u1EE3ng c\u0169ng l\xE0
      ph\xEDa \u0111\u01B0\u1EDDng ray v\u1EADn chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688653
    m_Localized: "M\u1ECF b\u1ECF hoang c\xF3 v\u1EBB kh\xF4ng ph\u1EA3i \u0111i\u1EC3m
      b\u1EAFt \u0111\u1EA7u, m\xE0 ph\u1EA3n \u1EE9ng t\u1EEB ph\xEDa \u0111\u01B0\u1EDDng
      ray \u0111\xE3 lan \u0111\u1EBFn \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688654
    m_Localized: "Kh\xF4ng ch\u1EC9 bi\u1EC3u t\u01B0\u1EE3ng tr\xEAn t\u01B0\u1EDDng,
      nh\u1EEFng \u0111\u01B0\u1EDDng c\xE0o d\u01B0\u1EDBi s\xE0n c\u0169ng ti\u1EBFp
      t\u1EE5c theo c\xF9ng m\u1ED9t h\u01B0\u1EDBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688655
    m_Localized: "C\u0169ng c\xF3 d\u1EA5u v\u1EBFt qu\xE1i v\u1EADt tr\xE1nh sang
      b\xEAn \u0111\u1EC3 kh\xF4ng gi\u1EABm l\xEAn nh\u1EEFng \u0111\u01B0\u1EDDng
      \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688656
    m_Localized: "V\u1EADy n\u01A1i ph\xE1t ra \xE2m thanh c\xF2n \u1EDF s\xE2u h\u01A1n
      n\u1EEFa."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688657
    m_Localized: "D\xF9 kh\xF4ng ph\u1EA3i \u0111i\u1EC3m b\u1EAFt \u0111\u1EA7u
      th\xEC ch\xFAng ta c\u0169ng \u0111ang \u0111\u1EBFn g\u1EA7n h\u01A1n, \u0111\xFAng
      kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688658
    m_Localized: "\u0110\u01B0\u1EDDng ray v\u1EADn chuy\u1EC3n tr\u01B0\u1EDBc \u0111\xE2y
      \u0111\u01B0\u1EE3c d\xF9ng \u0111\u1EC3 chuy\u1EC3n qu\u1EB7ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688659
    m_Localized: "Gi\u1EDD ch\u1EC9 c\xF2n l\u1EA1i m\u1ED9t s\u1ED1 \u0111o\u1EA1n,
      c\xF2n ph\u1EA7n b\xEAn trong g\u1EA7n nh\u01B0 kh\xF4ng \u0111\u01B0\u1EE3c
      s\u1EED d\u1EE5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688660
    m_Localized: "\u0110\u01B0\u1EDDng kh\xF4ng d\xF9ng m\xE0 c\xF2n g\xE2y r\u1EAFc
      r\u1ED1i th\xEC c\xE0ng phi\u1EC1n h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688661
    m_Localized: "C\xF3 kh\u1EA3 n\u0103ng c\u1EA3 ghi ch\xE9p b\u1EA3o tr\xEC c\u0169ng
      \u0111\xE3 c\u0169..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688662
    m_Localized: "D\xF9 v\u1EADy, n\u1EBFu c\xF3 ghi ch\xE9p th\xEC v\u1EABn c\xF3
      th\u1EC3 tr\u1EDF th\xE0nh manh m\u1ED1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688663
    m_Localized: "N\u1EBFu l\xE0 thi\u1EBFt b\u1ECB c\u0169 th\xEC c\xF3 th\u1EC3
      d\u1EA5u v\u1EBFt c\u1EE7a n\xF3 c\xF2n trong ghi ch\xE9p v\u1EADn chuy\u1EC3n
      ho\u1EB7c b\u1EA3o tr\xEC."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688664
    m_Localized: "H\xE3y di chuy\u1EC3n \u0111\u1EBFn \u0111\u01B0\u1EDDng ray v\u1EADn
      chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688665
    m_Localized: "H\xE3y ki\u1EC3m tra xem d\u1EA5u v\u1EBFt c\u1EE7a thi\u1EBFt
      b\u1ECB v\xE0 chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a qu\xE1i v\u1EADt c\xF3 c\xF9ng
      h\u01B0\u1EDBng kh\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688666
    m_Localized: "\u0110\u01B0\u1EDDng ray v\u1EADn chuy\u1EC3n Verdin."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688667
    m_Localized: "\u0110\u01B0\u1EDDng ray n\xE0y tr\u01B0\u1EDBc \u0111\xE2y \u0111\u01B0\u1EE3c
      d\xF9ng \u0111\u1EC3 chuy\u1EC3n qu\u1EB7ng t\u1EEB khu s\xE2u nh\u1EA5t ra
      ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688668
    m_Localized: "Gi\u1EDD ch\u1EC9 c\xF2n m\u1ED9t s\u1ED1 \u0111o\u1EA1n \u0111\u01B0\u1EE3c
      gi\u1EEF l\u1EA1i \u0111\u1EC3 ki\u1EC3m tra."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688669
    m_Localized: "T\u1EEB khi xe d\u1EEBng ch\u1EA1y, ch\xFAng t\xF4i c\u0169ng kh\xF4ng
      th\u1EC3 th\u01B0\u1EDDng xuy\xEAn ki\u1EC3m tra ph\u1EA7n b\xEAn trong."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688670
    m_Localized: "V\xEC v\u1EADy d\xF9 b\u1EA3ng ghi ch\xE9p v\u1EABn c\xF2n, c\u0169ng
      c\u1EA7n ki\u1EC3m tra xem n\xF3 c\xF3 kh\u1EDBp v\u1EDBi t\xECnh tr\u1EA1ng
      hi\u1EC7n t\u1EA1i kh\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688671
    m_Localized: "D\u1EA5u ch\xE2n ti\u1EBFp t\u1EE5c b\xEAn c\u1EA1nh \u0111\u01B0\u1EDDng
      ray."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688672
    m_Localized: "C\xF3 v\u1EBB qu\xE1i v\u1EADt tr\xE1nh \u0111i tr\xEAn \u0111\u01B0\u1EDDng
      ray nh\u01B0ng v\u1EABn b\u1ECB d\u1ED3n theo c\xF9ng m\u1ED9t h\u01B0\u1EDBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688673
    m_Localized: "Ph\u1EA3n \u1EE9ng c\u1EE7a qu\u1EB7ng kh\xF4ng \u1ED5n \u0111\u1ECBnh."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688674
    m_Localized: "Ph\u1EA3n \u1EE9ng d\u01B0\u1EDBi \u0111\u01B0\u1EDDng ray b\u1ECB
      ng\u1EAFt r\u1ED3i l\u1EA1i ti\u1EBFp t\u1EE5c."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688675
    m_Localized: "N\u1EBFu \u0111\u01B0\u1EDDng ray b\u1ECB \u0111\u1EE9t th\xEC
      \u0111\u01B0\u1EDDng \u0111i c\u1EE7a ch\xFAng ta c\u0169ng b\u1ECB \u0111\u1EE9t
      theo, \u0111\xFAng kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688676
    m_Localized: "N\u1EBFu \u0111\u01B0\u1EDDng v\xE0o v\xE0 \u0111\u01B0\u1EDDng
      ra l\xE0 c\xF9ng m\u1ED9t ch\u1ED7 th\xEC c\xE0ng ph\u1EA3i c\u1EA9n th\u1EADn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688677
    m_Localized: "V\u1EADy ph\u1EA3i v\u1EEBa \u0111i v\u1EEBa b\u1EA3o v\u1EC7 \u0111\u01B0\u1EDDng
      ray r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688678
    m_Localized: "Ch\u1EC9 c\u1EA7n xe ch\u1EDF h\xE0ng di chuy\u1EC3n \u0111\u01B0\u1EE3c
      th\xEC ch\xFAng ta c\u0169ng c\xF3 th\u1EC3 gi\u1EEF \u0111\u01B0\u1EE3c \u0111\u01B0\u1EDDng!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688679
    m_Localized: "Khoan. C\xF3 b\u1EA3ng ghi ch\xE9p b\u1EA3o tr\xEC b\xEAn c\u1EA1nh
      xe."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688680
    m_Localized: "\u0110\xE3 qu\xE1 c\u0169 n\xEAn b\u1ECB phai m\u1EA5t, nh\u01B0ng
      v\u1EABn \u0111\u1ECDc \u0111\u01B0\u1EE3c m\u1ED9t ph\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688681
    m_Localized: "Ph\u1EA7n k\xFD hi\u1EC7u r\xF5 h\u01A1n ch\u1EEF vi\u1EBFt. C\xF3
      v\u1EBB c\xF9ng m\u1ED9t ng\u01B0\u1EDDi \u0111\xE3 s\u1EEDa l\u1EA1i nhi\u1EC1u
      l\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688682
    m_Localized: "N\xF3 ghi g\xEC v\u1EADy?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688683
    m_Localized: "`V\u1ECB tr\xED thi\u1EBFt b\u1ECB ma l\u1EF1c h\u1ECFng: b\xEAn
      d\u01B0\u1EDBi h\xE0nh lang di t\xEDch cao nguy\xEAn Norua`."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688684
    m_Localized: "N\xF3 c\xF2n ghi `t\u1EA1m ho\xE3n thu h\u1ED3i` v\xE0 `duy tr\xEC
      k\u1EBFt n\u1ED1i m\u1ECF`."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688685
    m_Localized: "Cao nguy\xEAn Norua? \u0110\xF3 l\xE0 n\u01A1i kh\xE1c m\xE0."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688686
    m_Localized: "\u1EEA. \u0110\xF3 kh\xF4ng ph\u1EA3i manh m\u1ED1i ch\xFAng ta
      n\xEAn l\u1EA7n theo ngay b\xE2y gi\u1EDD."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688687
    m_Localized: "Nh\u01B0ng c\xF3 th\u1EC3 l\xE0 b\u1EB1ng ch\u1EE9ng cho th\u1EA5y
      m\u1ECF n\xE0y t\u1EEBng n\u1ED1i v\u1EDBi m\u1ED9t thi\u1EBFt b\u1ECB kh\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688688
    m_Localized: "N\u1EBFu vi\u1EC7c thu h\u1ED3i b\u1ECB t\u1EA1m ho\xE3n th\xEC
      c\xF3 ngh\u0129a l\xE0 ai \u0111\xF3 bi\u1EBFt v\u1ECB tr\xED nh\u01B0ng \u0111\xE3
      kh\xF4ng ch\u1EA1m v\xE0o n\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688689
    m_Localized: "Nh\u1EEFng chuy\u1EC7n nh\u01B0 v\u1EADy th\u01B0\u1EDDng v\u1EC1
      sau s\u1EBD c\xE0ng phi\u1EC1n ph\u1EE9c h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688690
    m_Localized: "Ngay b\xEAn d\u01B0\u1EDBi b\u1EA3ng ghi ch\xE9p c\u0169ng c\xF3
      c\xF9ng m\u1ED9t k\xFD hi\u1EC7u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688691
    m_Localized: "C\xF3 m\u1ED9t \u0111\u01B0\u1EDDng \u0111\xE1nh d\u1EA5u k\xE9o
      d\xE0i v\xE0o ph\xEDa trong \u0111\u01B0\u1EDDng ray."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688692
    m_Localized: "Nh\xF3m b\xEAn trong \u0111\u01B0\u1EDDng ray \u0111ang \u0111\u1EBFn
      g\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688693
    m_Localized: "Ch\xFAng \u0111ang \u0111i l\xEAn t\u1EEB ph\xEDa \u0111\u01B0\u1EDDng
      ray rung chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688694
    m_Localized: "H\xE3y gi\u1EEF l\u1EA1i b\u1EA3ng ghi ch\xE9p v\xE0 b\u1EA3o v\u1EC7
      \u0111\u01B0\u1EDDng ray tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688695
    m_Localized: "\u0110\u1EEBng \u0111\u1EC3 con \u0111\u01B0\u1EDDng \u0111\u1EBFn
      khu s\xE2u nh\u1EA5t b\u1ECB \u0111\u1EE9t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688696
    m_Localized: "\u0110\xE3 b\u1EA3o v\u1EC7 \u0111\u01B0\u1EE3c \u0111\u01B0\u1EDDng
      ray."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688697
    m_Localized: "Nh\u01B0ng kh\xF3 m\xE0 b\u1ECF qua ghi ch\xE9p \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688698
    m_Localized: "\u0110\xFAng v\u1EADy. \u0110\xF3 kh\xF4ng ph\u1EA3i ghi ch\xE9p
      v\u1EC1 thi\u1EBFt b\u1ECB th\xF4ng th\u01B0\u1EDDng d\xF9ng trong m\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688699
    m_Localized: "`B\xEAn d\u01B0\u1EDBi h\xE0nh lang di t\xEDch cao nguy\xEAn Norua`
      c\xF3 th\u1EC3 ch\u1EC9 m\u1ED9t c\u01A1 s\u1EDF c\u1ED5 x\u01B0a h\u01A1n
      nhi\u1EC1u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688700
    m_Localized: "Vi\u1EC7c ghi ch\xE9p v\u1EABn c\xF2n trong m\u1ECF c\u0169ng c\xF3
      th\u1EC3 c\xF3 ngh\u0129a \u0111\u01B0\u1EDDng ray n\xE0y t\u1EEBng n\u1ED1i
      v\u1EDBi c\u01A1 s\u1EDF \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688701
    m_Localized: "V\u1EADy \u0111\u01B0\u1EDDng ray n\xE0y c\xF3 th\u1EC3 kh\xF4ng
      ch\u1EC9 d\xF9ng \u0111\u1EC3 v\u1EADn chuy\u1EC3n qu\u1EB7ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233898688702
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a qu\xE1i v\u1EADt v\u1EABn ti\u1EBFp
      t\u1EE5c v\u1EC1 ph\xEDa khu s\xE2u nh\u1EA5t, kh\xF4ng ph\u1EA3i v\u1EC1 ph\xEDa
      Norua."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077120
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn nh\u1EA5t v\u1EABn c\xF2n \u1EDF
      s\xE2u b\xEAn trong khu s\xE2u nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077121
    m_Localized: "N\u01A1i ch\xFAng ta c\u1EA7n \u0111\u1EBFn l\xFAc n\xE0y kh\xF4ng
      ph\u1EA3i Norua."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077122
    m_Localized: "Nh\u01B0ng nh\u1EA5t \u0111\u1ECBnh ph\u1EA3i gi\u1EEF l\u1EA1i
      ghi ch\xE9p v\u1ECB tr\xED \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077123
    m_Localized: "D\u1EA5u ch\xE2n r\u1EBD \u0111i \u0111\u1EC3 tr\xE1nh ph\u1EA3n
      \u1EE9ng c\u1EE7a \u0111\u01B0\u1EDDng ray."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077124
    m_Localized: "C\xF3 v\u1EBB ch\xFAng b\u1ECB d\u1ED3n s\xE2u h\u01A1n n\u1EEFa
      v\xE0o trong."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077125
    m_Localized: "N\u1EBFu ti\u1EBFn v\xE0o khu s\xE2u nh\u1EA5t khi \u0111\u01B0\u1EDDng
      ray v\u1EABn \u0111ang rung chuy\u1EC3n th\xEC l\xFAc quay v\u1EC1 s\u1EBD
      g\u1EB7p v\u1EA5n \u0111\u1EC1."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077126
    m_Localized: "S\u1EEDa tr\u01B0\u1EDBc s\u1EBD \u0111\u1EE1 phi\u1EC1n h\u01A1n.
      Th\u1EADt \u0111\u1EA5y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077127
    m_Localized: "Mu\u1ED1n \u0111\u1EBFn khu s\xE2u nh\u1EA5t th\xEC ph\u1EA3i s\u1EEDa
      \xEDt nh\u1EA5t m\u1ED9t ph\u1EA7n \u0111\u01B0\u1EDDng xe ch\u1EDF h\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077128
    m_Localized: "N\u1EBFu \u0111\u01B0\u1EDDng ray b\u1ECB ch\u1EB7n th\xEC s\u1EBD
      kh\xF3 tho\xE1t ra t\u1EEB b\xEAn trong."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077129
    m_Localized: "Tr\u01B0\u1EDBc khi v\xE0o khu s\xE2u nh\u1EA5t, h\xE3y s\u1EEDa
      \u0111\u01B0\u1EDDng ray v\xE0 \u0111\u01B0\u1EDDng quay v\u1EC1."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077130
    m_Localized: "Alice, h\xE3y b\u1EA3o qu\u1EA3n b\u1EA3ng ghi ch\xE9p."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077131
    m_Localized: "\u1EEA. T\xF4i s\u1EBD \u0111\xE1nh d\u1EA5u ri\xEAng ghi ch\xE9p
      v\u1ECB tr\xED Norua."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077132
    m_Localized: "\u0110i\u1EC3m s\u1EEDa ch\u1EEFa \u0111\u01B0\u1EDDng ray v\u1EADn
      chuy\u1EC3n Verdin."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077133
    m_Localized: "Kh\xF4ng th\u1EC3 kh\xF4i ph\u1EE5c ho\xE0n to\xE0n \u0111\u01B0\u1EDDng
      ray."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077134
    m_Localized: "Nh\u01B0ng c\xF3 th\u1EC3 \u0111\u1EA3m b\u1EA3o \u0111\u1EE7 \u0111\u1EC3
      \u0111i \u0111\u1EBFn khu s\xE2u nh\u1EA5t r\u1ED3i quay ra."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077135
    m_Localized: "Ch\xFAng t\xF4i s\u1EBD bu\u1ED9c t\u1EA1m c\xE1c c\u1ED9t ch\u1ED1ng
      b\u1ECB g\xE3y v\xE0 tr\u01B0\u1EDBc h\u1EBFt ch\u1EC9 m\u1EDF \u0111\u1EE7
      r\u1ED9ng cho xe ch\u1EDF h\xE0ng \u0111i qua."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077136
    m_Localized: "D\xF9 kh\xF4ng th\u1EC3 tr\u1EE5 l\xE2u, ch\xFAng t\xF4i v\u1EABn
      c\xF3 th\u1EC3 t\u1EA1o m\u1ED9t l\u1ED1i \u0111\u1EC3 \u0111i v\xE0o r\u1ED3i
      quay ra m\u1ED9t l\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077137
    m_Localized: "Th\u1EBF l\xE0 \u0111\u1EE7 r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077138
    m_Localized: "\u0110i\u1EC1u c\u1EA7n l\xFAc n\xE0y kh\xF4ng ph\u1EA3i \u0111\u01B0\u1EDDng
      ray ho\xE0n h\u1EA3o, m\xE0 l\xE0 m\u1ED9t con \u0111\u01B0\u1EDDng kh\xF4ng
      s\u1EE5p tr\u01B0\u1EDBc khi ch\xFAng ta quay v\u1EC1."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077139
    m_Localized: "V\u1EADy l\xE0 ph\u1EA3i lo \u0111\u01B0\u1EDDng quay v\u1EC1 tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077140
    m_Localized: "Kh\xF4ng th\u1EC3 ch\u1EC9 ngh\u0129 \u0111\u1EBFn vi\u1EC7c ti\u1EBFn
      l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077141
    m_Localized: "D\u1EA5u ch\xE2n v\u1EC1 ph\xEDa khu s\xE2u nh\u1EA5t l\xFAn s\xE2u
      nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077142
    m_Localized: "C\xF3 v\u1EBB nh\u1EEFng qu\xE1i v\u1EADt xung quanh tr\xE1nh ph\u1EA3n
      \u1EE9ng \u1EDF khu s\xE2u nh\u1EA5t r\u1ED3i b\u1ECB d\u1ED3n ra ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077143
    m_Localized: "Ph\u1EA3n \u1EE9ng c\u1EE7a qu\u1EB7ng c\u0169ng m\u1EA1nh nh\u1EA5t
      \u1EDF khu s\xE2u nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077144
    m_Localized: "Nh\u01B0ng kh\xF3 kh\u1EB3ng \u0111\u1ECBnh \u0111\xF3 l\xE0 trung
      t\xE2m. C\u1EA3 khu m\u1ECF tr\xF4ng gi\u1ED1ng m\u1ED9t \u0111i\u1EC3m n\u1ED1i
      h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077145
    m_Localized: "Ph\u1EA3n \u1EE9ng c\xF3 v\u1EBB kh\xF4ng b\u1EAFt \u0111\u1EA7u
      t\u1EEB m\u1ED9t n\u01A1i, m\xE0 nhi\u1EC1u \u0111\u01B0\u1EDDng ph\u1EA3n
      \u1EE9ng ch\u1ED3ng l\xEAn nhau \u1EDF khu s\xE2u nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077146
    m_Localized: "C\xF3 l\u1EBD v\xEC th\u1EBF m\xE0 qu\xE1i v\u1EADt kh\xF4ng th\u1EC3
      tho\xE1t theo m\u1ED9t h\u01B0\u1EDBng m\xE0 c\u1EE9 \u0111i v\xF2ng quanh."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077147
    m_Localized: "C\xF2n ghi ch\xE9p v\u1ECB tr\xED Norua th\xEC sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077148
    m_Localized: "T\xF4i gi\u1EEF r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077149
    m_Localized: "Hi\u1EC7n gi\u1EDD ph\u1EA3i ki\u1EC3m tra ph\u1EA3n \u1EE9ng \u1EDF
      khu s\xE2u nh\u1EA5t tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077150
    m_Localized: "Ghi ch\xE9p th\xEC kh\xF4ng ch\u1EA1y m\u1EA5t, nh\u01B0ng qu\xE1i
      v\u1EADt th\xEC c\xF3 th\u1EC3 b\u1ECF ch\u1EA1y ho\u1EB7c tr\xE0n ra..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077151
    m_Localized: "H\xE3y x\u1EED l\xFD th\u1EE9 phi\u1EC1n ph\u1EE9c h\u01A1n tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077152
    m_Localized: "C\xE2u \u0111\xF3 l\u1EA1i thuy\u1EBFt ph\u1EE5c m\u1ED9t c\xE1ch
      k\u1EF3 l\u1EA1."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077153
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn kh\xF4ng ti\u1EBFn v\u1EC1
      ph\xEDa ch\xFAng ta."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077154
    m_Localized: "N\xF3 \u0111ang \u0111i v\xF2ng quanh c\xF9ng m\u1ED9t ch\u1ED7
      b\xEAn trong khu s\xE2u nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077155
    m_Localized: "C\xF3 th\u1EC3 n\xF3 \u0111ang t\xECm n\u01A1i \u0111\u1EC3 tr\xE1nh."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077156
    m_Localized: "Khi ch\xFAng ta ti\u1EBFn v\xE0o th\xEC ph\u1EA3i ch\u1EB7n n\xF3
      tr\u01B0\u1EDBc khi n\xF3 t\u1EA3n ra."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077157
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y v\xE0o khu s\xE2u nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077158
    m_Localized: "H\xE3y ki\u1EC3m tra chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn v\xE0
      ng\u0103n kh\xF4ng cho n\xF3 tr\xE0n v\u1EC1 ph\xEDa l\xE0ng m\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077159
    m_Localized: "Khu s\xE2u nh\u1EA5t c\u1EE7a m\u1ECF Verdin."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077160
    m_Localized: "D\u1EA5u ch\xE2n l\u1EDBn \u0111ang \u0111i v\xF2ng quanh \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077161
    m_Localized: "C\u0169ng c\xF3 d\u1EA5u v\u1EBFt n\xF3 \u0111\u1ECBnh \u0111i
      ra ngo\xE0i nh\u01B0ng r\u1ED3i l\u1EA1i b\u1ECB d\u1ED3n v\xE0o trong."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077162
    m_Localized: "Ph\u1EA3n \u1EE9ng c\u1EE7a qu\u1EB7ng ph\u1EE9c t\u1EA1p qu\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077163
    m_Localized: "\u0110\xE2y gi\u1ED1ng \u0111i\u1EC3m n\u1ED1i cho nhi\u1EC1u ph\u1EA3n
      \u1EE9ng \u0111i qua h\u01A1n l\xE0 trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077164
    m_Localized: "D\u1EA5u ch\xE2n c\u0169ng kh\xF4ng ch\u1EC9 c\xF3 m\u1ED9t h\u01B0\u1EDBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077165
    m_Localized: "Nhi\u1EC1u d\u1EA5u v\u1EBFt ch\u1ED3ng l\xEAn nhau \u1EDF ch\u1ED7
      ch\xFAng \u0111i v\xE0o r\u1ED3i l\u1EA1i r\u1EBD ng\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077166
    m_Localized: "V\u1EADy ch\u1EC9 ch\u1EB7n \u1EDF \u0111\xE2y th\xEC ch\u01B0a
      th\u1EC3 k\u1EBFt th\xFAc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077167
    m_Localized: "\u1EEA. Nh\u01B0ng n\u1EBFu kh\xF4ng ch\u1EB7n \u1EDF \u0111\xE2y
      th\xEC ch\xFAng s\u1EBD l\u1EA1i tr\xE0n v\u1EC1 ph\xEDa l\xE0ng m\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077168
    m_Localized: "Khu s\xE2u nh\u1EA5t \u0111\xFAng l\xE0 n\u01A1i t\xF4i gh\xE9t
      ch\u1EEFa tr\u1ECB nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077169
    m_Localized: "N\xF3 t\u1ED1i, h\u1EB9p, m\xE0 \u0111\u01B0\u1EDDng quay v\u1EC1
      c\u0169ng ch\u1EC9 c\xF3 m\u1ED9t..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077170
    m_Localized: "H\xE3y gi\u1EEF \u0111\u01B0\u1EDDng r\xFAt lui ph\xEDa \u0111\u01B0\u1EDDng
      ray v\xE0 k\u1EBFt th\xFAc chuy\u1EC7n n\xE0y trong khu s\xE2u nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077171
    m_Localized: "H\xE3y ch\u1EB7n chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn tr\u01B0\u1EDBc
      khi n\xF3 tho\xE1t ra ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077172
    m_Localized: "Nh\u1EEFng qu\xE1i v\u1EADt xung quanh \u0111ang tr\xE1nh d\u1EA5u
      v\u1EBFt c\u1EE7a con qu\xE1i v\u1EADt l\u1EDBn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077173
    m_Localized: "N\u1EBFu qu\xE1i v\u1EADt d\u1ED3n v\u1EC1 ph\xEDa m\u1EA1ch qu\u1EB7ng
      th\xEC ph\u1EA3n \u1EE9ng ma l\u1EF1c s\u1EBD c\xE0ng b\u1EA5t \u1ED5n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077174
    m_Localized: "V\u1EADy t\xF4i s\u1EBD x\u1EED l\xFD nh\xF3m \u0111i ra tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077175
    m_Localized: "T\xF4i giao \u0111\u01B0\u1EDDng r\xFAt lui ph\xEDa \u0111\u01B0\u1EDDng
      ray cho m\u1ECDi ng\u01B0\u1EDDi nh\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077176
    m_Localized: "N\u1EBFu ph\u1EA3n \u1EE9ng c\u1EE7a qu\u1EB7ng t\u0103ng l\xEAn
      th\xEC t\xF4i s\u1EBD b\xE1o ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077177
    m_Localized: "T\xF4i c\xF3 th\u1EC3 d\xF9ng ma thu\u1EADt \u0111\u1EC3 \xE1p
      ch\u1EBF ph\xEDa ph\u1EA3n \u1EE9ng b\xF9ng l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077178
    m_Localized: "N\u1EBFu b\u1ECB th\u01B0\u01A1ng th\xEC l\u1EADp t\u1EE9c r\xFAt
      v\u1EC1 ph\xEDa \u0111\u01B0\u1EDDng ray."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077179
    m_Localized: "Ch\xFAng ta ch\u1EEBa \u0111\u01B0\u1EDDng quay v\u1EC1 l\u1EA1i
      l\xE0 c\xF3 l\xFD do."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077180
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a nh\xF3m trong khu s\xE2u nh\u1EA5t
      b\u1EAFt \u0111\u1EA7u r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077181
    m_Localized: "Nh\xF3m \u0111i ra tr\u01B0\u1EDBc \u0111ang di chuy\u1EC3n, c\xF2n
      con qu\xE1i v\u1EADt l\u1EDBn \u1EDF ph\xEDa sau."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077182
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n \u1EDF khu s\xE2u nh\u1EA5t
      c\u1EE7a m\u1ECF Verdin v\xE0 kh\xF4ng \u0111\u1EC3 ch\xFAng tho\xE1t v\u1EC1
      ph\xEDa l\xE0ng m\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077183
    m_Localized: "Nh\xF3m l\u1EDBn \u0111\xE3 b\u1ECB ch\u1EB7n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077184
    m_Localized: "Ch\xFAng s\u1EBD kh\xF4ng l\u1EA1i tr\xE0n v\u1EC1 ph\xEDa l\xE0ng
      m\u1ECF \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077185
    m_Localized: "Ngay l\xFAc n\xE0y th\xEC ch\u01B0a."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077186
    m_Localized: "Nh\u01B0ng ph\u1EA3n \u1EE9ng ma l\u1EF1c ch\u01B0a k\u1EBFt th\xFAc
      \u1EDF \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077187
    m_Localized: "Khu m\u1ECF kh\xF4ng ph\u1EA3i trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077188
    m_Localized: "T\xE0n t\xEDch c\u1EE7a thi\u1EBFt b\u1ECB c\u0169 \u0111\xE3 khu\u1EBFch
      \u0111\u1EA1i ph\u1EA3n \u1EE9ng, nh\u01B0ng ph\u1EA3n \u1EE9ng ma l\u1EF1c
      \u0111ang tho\xE1t ra ph\xEDa ngo\xE0i khu m\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077189
    m_Localized: "Khu s\xE2u nh\u1EA5t kh\xF4ng ph\u1EA3i nguy\xEAn nh\xE2n, m\xE0
      l\xE0 n\u01A1i l\xE0m ph\u1EA3n \u1EE9ng \u0111i qua vang l\xEAn m\u1EA1nh
      h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077190
    m_Localized: "N\xF3 d\u1EABn v\u1EC1 \u0111\xE2u?"
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077191
    m_Localized: "D\u1EA5u v\u1EBFt v\u1EC1 ph\xEDa k\xEAnh tho\xE1t n\u01B0\u1EDBc
      r\xF5 nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077192
    m_Localized: "C\u0169ng c\xF2n d\u1EA5u v\u1EBFt n\u01B0\u1EDBc ch\u1EA3y b\xEAn
      d\u01B0\u1EDBi m\u1EA1ch qu\u1EB7ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077193
    m_Localized: "\u1EEA. V\u1EABn c\xF2n ph\u1EA3n \u1EE9ng theo h\u01B0\u1EDBng
      d\xF2ng n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077194
    m_Localized: "Ph\u1EA3n \u1EE9ng \u0111i qua b\xEAn d\u01B0\u1EDBi m\u1ECF \u0111ang
      ch\u1EA3y v\u1EC1 ph\xEDa khu h\u1ED3 Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077195
    m_Localized: "N\u1EBFu l\xE0 d\xF2ng n\u01B0\u1EDBc b\xEAn d\u01B0\u1EDBi m\u1ECF
      th\xEC l\u1EA7n n\xE0y n\xF3 d\u1EABn v\u1EC1 ph\xEDa h\u1ED3, kh\xF4ng ph\u1EA3i
      v\u1EC1 ph\xEDa l\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077196
    m_Localized: "Milen l\xE0 khu v\u1EF1c m\xE0 nh\u1EEFng d\xF2ng n\u01B0\u1EDBc
      t\u1EEB m\u1ECF ch\u1EA3y t\u1EDBi."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077197
    m_Localized: "M\u1ED9t s\u1ED1 k\xEAnh tho\xE1t n\u01B0\u1EDBc c\u0169 d\u1EABn
      v\u1EC1 ph\xEDa Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077198
    m_Localized: "Sau m\u1ECF l\u1EA1i l\xE0 h\u1ED3 sao..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077199
    m_Localized: "V\u1EADy l\xE0 sau n\u01A1i t\u1ED1i t\u0103m l\u1EA1i \u0111\u1EBFn
      n\u01A1i \u01B0\u1EDBt \xE1t. Tr\xECnh t\u1EF1 h\xF4m nay chu \u0111\xE1o th\u1EADt..."
    m_Metadata:
      m_Items: []
  - m_Id: 7178233907077200
    m_Localized: "Ghi ch\xE9p v\u1ECB tr\xED Norua v\u1EABn c\xF2n \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535696138240
    m_Localized: "Nh\u01B0ng l\xFAc n\xE0y d\u1EA5u v\u1EBFt v\u1EC1 ph\xEDa Milen
      r\xF5 h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535696138241
    m_Localized: "\u0110\xFAng v\u1EADy. H\xE3y b\u1EA3o qu\u1EA3n ri\xEAng ghi ch\xE9p
      `b\xEAn d\u01B0\u1EDBi h\xE0nh lang di t\xEDch cao nguy\xEAn Norua`."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535696138242
    m_Localized: "\u0110\xF3 l\xE0 manh m\u1ED1i nh\u1EA5t \u0111\u1ECBnh ph\u1EA3i
      xem l\u1EA1i sau n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535696138243
    m_Localized: "Hi\u1EC7n gi\u1EDD ch\xFAng ta s\u1EBD ki\u1EC3m tra Milen tr\u01B0\u1EDBc,
      \u0111\xFAng kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535696138244
    m_Localized: "\u1EEA. H\xE3y thu x\u1EBFp t\xECnh h\xECnh \u1EDF Verdin r\u1ED3i
      di chuy\u1EC3n \u0111\u1EBFn khu h\u1ED3 Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535696138245
    m_Localized: "H\xE3y l\u1EA7n theo ph\u1EA3n \u1EE9ng \u0111\xE3 tho\xE1t ra
      kh\u1ECFi m\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535696138246
    m_Localized: "L\xE0ng ven h\u1ED3 Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535696138247
    m_Localized: "C\xE1c v\u1ECB l\xE0 H\u1ED9 V\u1EC7 ph\u1EA3i kh\xF4ng? Ch\xFAng
      t\xF4i \u0111\xE3 nh\u1EADn \u0111\u01B0\u1EE3c li\xEAn l\u1EA1c t\u1EEB ph\xEDa
      Verdin."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535696138248
    m_Localized: "D\xF2ng n\u01B0\u1EDBc n\u1ED1i t\u1EEB k\xEAnh tho\xE1t n\u01B0\u1EDBc
      b\xEAn d\u01B0\u1EDBi m\u1ECF ch\u1EA3y \u0111\u1EBFn t\u1EADn l\xE0ng n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535696138249
    m_Localized: "T\u1EEB s\xE1ng s\u1EDBm h\xF4m nay, m\u1EF1c n\u01B0\u1EDBc \u0111\u1ED9t
      nhi\xEAn l\xEAn xu\u1ED1ng, v\xE0 qu\xE1i v\u1EADt \u0111\xE3 tr\xE0n ra t\u1EEB
      v\xF9ng n\u01B0\u1EDBc n\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535696138250
    m_Localized: "C\xE1c d\xF2ng n\u01B0\u1EDBc b\xEAn trong l\xE0ng t\xE1ch v\u1EC1
      ph\xEDa b\u1EBFn thuy\u1EC1n v\xE0 \u0111\u1EA7m l\u1EA7y lau s\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535696138251
    m_Localized: "H\u01B0\u1EDBng s\u01A1 t\xE1n c\u0169ng thay \u0111\u1ED5i t\xF9y
      theo d\xF2ng n\u01B0\u1EDBc n\xE0o tr\u1EDF n\xEAn b\u1EA5t \u1ED5n tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332544
    m_Localized: "D\u1EA5u ch\xE2n \u01B0\u1EDBt d\u1EABn s\xE2u h\u01A1n v\xE0o
      trong l\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332545
    m_Localized: "\u0110\u1ED9 s\xE2u d\u1EA5u ch\xE2n kh\xF4ng \u0111\u1EC1u. C\u0169ng
      c\xF3 d\u1EA5u v\u1EBFt ch\xFAng v\xF9ng v\u1EABy \u0111\u1EC3 tho\xE1t kh\u1ECFi
      m\u1EB7t n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332546
    m_Localized: "M\u1ED9t s\u1ED1 d\u1EEBng \u1EDF l\u1ED1i v\xE0o l\xE0ng, nh\u01B0ng
      m\u1ED9t s\u1ED1 kh\xE1c ti\u1EBFp t\u1EE5c \u0111\u1EBFn m\xE9p d\xF2ng n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332547
    m_Localized: "C\xF3 v\u1EBB ch\xFAng kh\xF4ng v\xE0o c\xF9ng m\u1ED9t l\xFAc,
      m\xE0 b\u1ECB d\u1ED3n ra m\u1ED7i khi m\u1EF1c n\u01B0\u1EDBc thay \u0111\u1ED5i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332548
    m_Localized: "Ph\u1EA3n \u1EE9ng t\u1EEB m\u1ECF c\u0169ng \u0111ang l\xE0m c\xE1c
      d\xF2ng n\u01B0\u1EDBc trong l\xE0ng n\xE0y dao \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332549
    m_Localized: "Nhi\u1EC1u d\xF2ng n\u01B0\u1EDBc ngh\u0129a l\xE0 ng\u01B0\u1EDDi
      d\xE2n c\xF3 nhi\u1EC1u \u0111\u01B0\u1EDDng \u0111\u1EC3 tr\xE1nh, nh\u01B0ng
      c\u0169ng c\xF3 ngh\u0129a qu\xE1i v\u1EADt c\xF3 nhi\u1EC1u \u0111\u01B0\u1EDDng
      \u0111\u1EC3 v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332550
    m_Localized: "Mu\u1ED1n b\u1EA3o v\u1EC7 l\xE0ng th\xEC kh\xF4ng th\u1EC3 ch\u1EC9
      nh\xECn v\xE0o m\xE9p n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332551
    m_Localized: "Ph\u1EA3i ki\u1EC3m tra m\u1ED7i d\xF2ng n\u01B0\u1EDBc r\u1EBD
      ra s\u1EBD d\u1EABn \u0111\u1EBFn \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332552
    m_Localized: "V\u1EADy th\xEC ph\u1EA3i b\u1EA3o v\u1EC7 \u0111\u01B0\u1EDDng
      \u0111\u1EC3 d\xE2n l\xE0ng c\xF3 th\u1EC3 s\u01A1 t\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332553
    m_Localized: "T\xF4i s\u1EBD kh\xF4ng \u0111\u1EC3 ch\xFAng ti\u1EBFn s\xE2u
      h\u01A1n v\u1EC1 ph\xEDa l\xE0ng ven h\u1ED3!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332554
    m_Localized: "Sau m\u1ECF l\u1EA1i l\xE0 h\u1ED3 sao..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332555
    m_Localized: "V\u1EADy l\xE0 sau khi ra kh\u1ECFi n\u01A1i t\u1ED1i t\u0103m,
      ch\xFAng ta ph\u1EA3i lo thi\u1EBFt b\u1ECB b\u1ECB \u01B0\u1EDBt. H\xF4m nay
      c\u0169ng chu \u0111\xE1o th\u1EADt..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332556
    m_Localized: "C\xF3 vi\u1EC7c c\u1EA7n xem tr\u01B0\u1EDBc c\u1EA3 thi\u1EBFt
      b\u1ECB \u01B0\u1EDBt."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332557
    m_Localized: "N\u1EBFu d\xF2ng n\u01B0\u1EDBc r\u1EBD s\xE2u v\xE0o trong l\xE0ng
      th\xEC s\u1EBD d\u1EABn th\u1EB3ng \u0111\u1EBFn ch\u1ED7 nh\u1EEFng ng\u01B0\u1EDDi
      \u0111ang s\u01A1 t\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332558
    m_Localized: "H\xE3y \u0111\u1EC3 \u0111\u01B0\u1EDDng s\u01A1 t\xE1n c\u1EE7a
      c\u01B0 d\xE2n th\xF4ng tho\xE1ng v\xE0 ch\u1EB7n nh\xF3m t\u1EEB ph\xEDa h\u1ED3
      \u0111i v\xE0o \u1EDF l\u1ED1i v\xE0o l\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332559
    m_Localized: "H\xE3y x\u1EED l\xFD ch\xFAng \u1EDF \u0111\xE2y tr\u01B0\u1EDBc
      khi ch\xFAng t\u1EA3n ra theo c\xE1c d\xF2ng n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332560
    m_Localized: "Noah, c\u1EE9 ti\u1EBFp t\u1EE5c ki\u1EC3m tra h\u01B0\u1EDBng
      v\u1EC1 ph\xEDa b\u1EBFn thuy\u1EC1n v\xE0 \u0111\u1EA7m l\u1EA7y lau s\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332561
    m_Localized: "S\xF3ng \u1EDF ph\xEDa \u0111\u1EA7m l\u1EA7y lau s\u1EADy d\u1EEF
      nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332562
    m_Localized: "Nh\u01B0ng nh\xF3m \u1EDF v\xF9ng n\u01B0\u1EDBc n\xF4ng tr\u01B0\u1EDBc
      l\xE0ng s\u1EBD \u0111\u1EBFn tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332563
    m_Localized: "\u0110\u01B0\u1EE3c. T\xF4i s\u1EBD gi\u1EEF ph\xEDa tr\u01B0\u1EDBc
      l\xE0ng tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332564
    m_Localized: "T\xF4i tuy\u1EC7t \u0111\u1ED1i kh\xF4ng \u0111\u1EC3 con \u0111\u01B0\u1EDDng
      m\u1ECDi ng\u01B0\u1EDDi \u0111ang \u0111i b\u1ECB ch\u1EB7n!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332565
    m_Localized: "N\u1EBFu b\u1ECB th\u01B0\u01A1ng th\xEC b\xE1o ngay cho t\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332566
    m_Localized: "Ng\u01B0\u1EDDi ng\xE3 g\u1EA7n m\xE9p n\u01B0\u1EDBc th\u01B0\u1EDDng
      kh\xF4ng \u1ED5n ch\xFAt n\xE0o v\xE0o l\xFAc h\u1ECD t\u1EF1 n\xF3i m\xECnh
      \u1ED5n..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332567
    m_Localized: "Nh\xF3m \u1EDF v\xF9ng n\u01B0\u1EDBc n\xF4ng \u0111ang \u0111\u1EBFn
      l\u1ED1i v\xE0o l\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332568
    m_Localized: "S\xF3ng t\u1EEB ph\xEDa \u0111\u1EA7m l\u1EA7y lau s\u1EADy c\u0169ng
      ti\u1EBFp t\u1EE5c d\u1ED3n t\u1EDBi."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332569
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y v\u1EEBa gi\u1EEF \u0111\u01B0\u1EDDng
      s\u01A1 t\xE1n c\u1EE7a c\u01B0 d\xE2n v\u1EEBa ch\u1EB7n \u1EDF l\u1ED1i v\xE0o
      l\xE0ng ven h\u1ED3 Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332570
    m_Localized: "\u0110\xE3 gi\u1EEF \u0111\u01B0\u1EE3c l\u1ED1i v\xE0o l\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332571
    m_Localized: "Gi\u1EDD c\u01B0 d\xE2n c\xF3 th\u1EC3 \u0111i theo \u0111\u01B0\u1EDDng
      s\u01A1 t\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332572
    m_Localized: "C\u1EA3m \u01A1n c\xE1c v\u1ECB. Thi\u1EC7t h\u1EA1i ph\xEDa trong
      l\xE0ng kh\xF4ng lan r\u1ED9ng th\xEAm."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332573
    m_Localized: "Nh\u01B0ng d\xF2ng n\u01B0\u1EDBc ph\xEDa \u0111\u1EA7m l\u1EA7y
      lau s\u1EADy v\u1EABn c\xF2n dao \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332574
    m_Localized: "S\xF3ng g\u1EA7n b\u1EBFn thuy\u1EC1n \u0111\xE3 l\u1EAFng xu\u1ED1ng
      m\u1ED9t ch\xFAt, nh\u01B0ng ph\xEDa \u0111\u1EA7m l\u1EA7y lau s\u1EADy v\u1EABn
      ti\u1EBFp t\u1EE5c d\u1EADp d\u1EC1nh."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332575
    m_Localized: "N\u1EBFu d\xE2n l\xE0ng quay v\u1EC1 ph\xEDa \u0111\u1EA7m l\u1EA7y
      lau s\u1EADy th\xEC h\u1ECD c\xF3 th\u1EC3 l\u1EA1i g\u1EB7p nguy hi\u1EC3m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332576
    m_Localized: "\u0110\xFAng v\u1EADy. D\u1EA5u ch\xE2n tr\u01B0\u1EDBc l\xE0ng
      k\u1EBFt th\xFAc \u1EDF \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332577
    m_Localized: "Nh\u01B0ng d\u1EA5u v\u1EBFt \u01B0\u1EDBt v\u1EABn d\u1EABn v\u1EC1
      ph\xEDa \u0111\u1EA7m l\u1EA7y lau s\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332578
    m_Localized: "Ph\u1EA3n \u1EE9ng c\u1EE7a d\xF2ng n\u01B0\u1EDBc c\u0169ng r\xF5
      h\u01A1n \u1EDF ph\xEDa \u0111\u1EA7m l\u1EA7y lau s\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332579
    m_Localized: "Kh\xF4ng gi\u1ED1ng nh\u01B0 ch\xFAng \u0111i qua l\xE0ng, chuy\u1EC3n
      \u0111\u1ED9ng n\xE0y c\xF3 v\u1EBB b\u1ECB d\u1ED3n ra t\u1EEB \u0111\u1EA7m
      l\u1EA7y lau s\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332580
    m_Localized: "Ch\xFAng ta \u0111\xE3 b\u1EA3o v\u1EC7 \u0111\u01B0\u1EE3c l\xE0ng,
      nh\u01B0ng \u0111i\u1EC3m b\u1EAFt \u0111\u1EA7u v\u1EA5n \u0111\u1EC1 \u1EDF
      Milen v\u1EABn c\xF2n \u1EDF s\xE2u b\xEAn trong."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332581
    m_Localized: "V\u1EADy l\xE0 \u0111\xE3 ch\u1EB7n \u1EDF l\xE0ng r\u1ED3i m\xE0
      v\u1EABn ph\u1EA3i \u0111i \u0111\u1EBFn n\u01A1i c\xF2n \u01B0\u1EDBt h\u01A1n
      n\u1EEFa..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332582
    m_Localized: "H\xF4m nay c\xF3 qu\xE1 nhi\u1EC1u th\u1EE9 ph\u1EA3i lo li\u1EC7u..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332583
    m_Localized: "D\xF9 v\u1EADy, ch\xFAng ta \u0111\xE3 b\u1EA3o v\u1EC7 \u0111\u01B0\u1EE3c
      d\xE2n l\xE0ng m\xE0."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332584
    m_Localized: "H\xE3y \u0111i theo con \u0111\u01B0\u1EDDng ti\u1EBFp theo v\xE0
      \u0111\u1EEBng \u0111\u1EC3 m\u1EA5t d\u1EA5u!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332585
    m_Localized: "N\u1EBFu lau s\u1EADy cao th\xEC t\u1EA7m nh\xECn s\u1EBD b\u1ECB
      h\u1EA1n ch\u1EBF."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332586
    m_Localized: "N\xEAn s\u1EAFp x\u1EBFp ghi ch\xE9p s\u01A1 t\xE1n v\xE0 chi\u1EBFn
      \u0111\u1EA5u tr\u01B0\u1EDBc khi v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332587
    m_Localized: "H\xE3y s\u1EAFp x\u1EBFp ghi ch\xE9p ph\xF2ng th\u1EE7 ven h\u1ED3
      r\u1ED3i chu\u1EA9n b\u1ECB v\xE0o \u0111\u1EA7m l\u1EA7y lau s\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332588
    m_Localized: "Khu c\u1EAFm tr\u1EA1i b\xEAn ngo\xE0i l\xE0ng ven h\u1ED3 Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332589
    m_Localized: "Ch\xFAng t\xF4i \u0111\xE3 \u0111\xE1nh d\u1EA5u v\u1ECB tr\xED
      con \u0111\u01B0\u1EDDng g\u1ED7 c\u0169 d\u1EABn v\xE0o \u0111\u1EA7m l\u1EA7y
      lau s\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332590
    m_Localized: "Khi n\u01B0\u1EDBc d\xE2ng, c\xE1c d\u1EA5u ch\u1EC9 th\u1EA5p
      s\u1EBD nhanh ch\xF3ng b\u1ECB ng\u1EADp. N\u1EBFu ng\xE0y mai c\xE1c v\u1ECB
      v\xE0o \u0111\xF3, h\xE3y bu\u1ED9c v\u1EA3i c\u1EA3 l\xEAn nh\u1EEFng c\xE2y
      lau s\u1EADy cao."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332591
    m_Localized: "T\u1ED1i nay ch\xFAng t\xF4i s\u1EBD gi\u1EEF kh\xF4ng cho d\xE2n
      l\xE0ng quay l\u1EA1i. C\xE1c v\u1ECB H\u1ED9 V\u1EC7 c\u0169ng h\xE3y ngh\u1EC9
      ng\u01A1i m\u1ED9t l\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332592
    m_Localized: "Cu\u1ED1i c\xF9ng c\u0169ng c\xF3 tin hay r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332593
    m_Localized: "\u0110\u1EB7t thi\u1EBFt b\u1ECB \u01B0\u1EDBt tr\u01B0\u1EDBc
      \u0111\u1ED1ng l\u1EEDa c\u0169ng l\xE0 m\u1ED9t ki\u1EC3u b\u1EA3o tr\xEC
      r\u1EA5t quan tr\u1ECDng..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332594
    m_Localized: "L\xE0m kh\xF4 thi\u1EBFt b\u1ECB th\xEC \u0111\xFAng, nh\u01B0ng
      \u0111\xE2y kh\xF4ng ph\u1EA3i chu\u1EA9n b\u1ECB \u0111i ng\u1EE7."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332595
    m_Localized: "Ph\u1EA3i quy\u1EBFt \u0111\u1ECBnh d\u1EA5u ch\u1EC9 ph\xEDa \u0111\u1EA7m
      l\u1EA7y lau s\u1EADy tr\u01B0\u1EDBc khi h\xF4m nay k\u1EBFt th\xFAc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332596
    m_Localized: "Hi\u1EC3u r\u1ED3i. V\u1EADy th\xEC ngh\u1EC9 m\u1ED9t ch\xFAt
      tr\u01B0\u1EDBc khi quy\u1EBFt \u0111\u1ECBnh d\u1EA5u ch\u1EC9 nh\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332597
    m_Localized: "L\xE2u r\u1ED3i m\u1EDBi \u0111\u01B0\u1EE3c ngh\u1EC9 tr\u01B0\u1EDBc
      \u0111\u1ED1ng l\u1EEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332598
    m_Localized: "D\u1EA5u ch\xE2n tr\u01B0\u1EDBc l\xE0ng \u0111\xE3 k\u1EBFt th\xFAc,
      nh\u01B0ng d\u1EA5u v\u1EBFt \u01B0\u1EDBt v\u1EC1 ph\xEDa \u0111\u1EA7m l\u1EA7y
      lau s\u1EADy v\u1EABn c\xF2n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332599
    m_Localized: "Ng\xE0y mai c\xF3 l\u1EBD ph\u1EA3i nh\xECn c\u1EA3 lau s\u1EADy
      lay \u0111\u1ED9ng v\xE0 s\xF3ng n\u01B0\u1EDBc thay v\xEC d\u1EA5u ch\xE2n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332600
    m_Localized: "H\xE3y s\u1EAFp x\u1EBFp ghi ch\xE9p h\xF4m nay r\u1ED3i ng\xE0y
      mai v\xE0o \u0111\u1EA7m l\u1EA7y lau s\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332601
    m_Localized: "H\xE3y ngh\u1EC9 ng\u01A1i v\xE0 chu\u1EA9n b\u1ECB, \u0111\u1EEBng
      c\u1ED1 qu\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332602
    m_Localized: "\u1EEAm. T\u1ED1t nh\u1EA5t l\xE0 \u0111\u1EEBng giao vi\u1EC7c
      tr\xF4ng n\u1ED3i cho t\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332603
    m_Localized: "Sao c\u1EADu l\u1EA1i ch\u1EAFc ch\u1EAFn nhanh th\u1EBF?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332604
    m_Localized: "N\u1EBFu giao vi\u1EC7c n\u1EA5u \u0103n cho t\xF4i th\xEC b\u1EEFa
      t\u1ED1i nay c\xF3 khi c\xF2n nguy hi\u1EC3m h\u01A1n \u0111\u1EA7m l\u1EA7y
      lau s\u1EADy ng\xE0y mai \u0111\u1EA5y!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332605
    m_Localized: "V\u1EADy th\xEC c\u1EE9 ti\u1EBFp t\u1EE5c c\u1EA7m ki\u1EBFm nh\xE9,
      Serah..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332606
    m_Localized: "Th\u1EADt ra l\xFAc \u0111\u1EA7u t\xF4i c\u0169ng ngh\u0129 nh\u01B0
      v\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332607
    m_Localized: "T\xF4i ngh\u0129 n\u1EBFu d\xF9ng ki\u1EBFm gi\u1ECFi th\xEC s\u1EBD
      \u0111\u01B0\u1EE3c ra nhi\u1EC7m v\u1EE5 ph\xEDa tr\u01B0\u1EDBc nhi\u1EC1u
      h\u01A1n, v\xE0 s\u1EBD b\u1EDBt ph\u1EA3i \u0111\u1EBFn l\u01B0\u1EE3t n\u1EA5u
      \u0103n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332608
    m_Localized: "\u0110\xF3 l\xE0 l\xFD do c\u1EADu b\u1EAFt \u0111\u1EA7u luy\u1EC7n
      ki\u1EBFm sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332609
    m_Localized: "\u1EEA! L\xFAc \u0111\u1EA7u \u0111\xFAng l\xE0 nh\u01B0 v\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332610
    m_Localized: "T\xF4i ngh\u0129 vung ki\u1EBFm \u1EDF b\xEAn ngo\xE0i t\u1ED1t
      h\u01A1n nhi\u1EC1u so v\u1EDBi \u1EDF trong b\u1EBFp."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332611
    m_Localized: "Nh\u01B0ng m\u1ED9t ng\xE0y n\u1ECD, m\u1ED9t con qu\xE1i v\u1EADt
      nh\u1EA3y ra tr\u01B0\u1EDBc tr\u1EA1m g\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332612
    m_Localized: "Khi t\xF4i ch\u1EB7n \u1EDF ph\xEDa tr\u01B0\u1EDBc, nh\u1EEFng
      ng\u01B0\u1EDDi ph\xEDa sau c\xF3 th\u1EDDi gian l\u1EA5y l\u1EA1i h\u01A1i
      th\u1EDF."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332613
    m_Localized: "L\xFAc \u0111\xF3 t\xF4i hi\u1EC3u. N\u1EBFu t\xF4i \u0111\u1EE9ng
      \u1EDF ph\xEDa tr\u01B0\u1EDBc, ai \u0111\xF3 \u1EDF ph\xEDa sau s\u1EBD c\xF3
      th\xEAm th\u1EDDi gian \u0111\u1EC3 tr\u1EE5 l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332614
    m_Localized: "V\xEC th\u1EBF t\xF4i mu\u1ED1n ti\u1EBFp t\u1EE5c m\u1EA1nh h\u01A1n.
      T\xF4i b\u1EAFt \u0111\u1EA7u \u0111\u1EC3 tr\xE1nh phi\xEAn n\u1EA5u \u0103n,
      nh\u01B0ng \u0111\xF3 kh\xF4ng c\xF2n l\xE0 to\xE0n b\u1ED9 l\xFD do n\u1EEFa."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332615
    m_Localized: "V\u1EADy n\xEAn Serah kh\xF4ng s\u1EE3 \u0111\u1EE9ng \u1EDF ph\xEDa
      tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332616
    m_Localized: "Kh\xF4ng ph\u1EA3i l\xE0 t\xF4i ho\xE0n to\xE0n kh\xF4ng s\u1EE3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332617
    m_Localized: "Nh\u01B0ng khi c\xF3 ai \u0111\xF3 \u1EDF ph\xEDa sau, \xFD ngh\u0129
      t\xF4i ph\u1EA3i ti\u1EBFn l\xEAn lu\xF4n \u0111\u1EBFn tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332618
    m_Localized: "B\xE2y gi\u1EDD c\u0169ng v\u1EADy. Ng\xE0y mai \u1EDF \u0111\u1EA7m
      l\u1EA7y lau s\u1EADy, t\xF4i s\u1EBD quan s\xE1t ph\xEDa tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332619
    m_Localized: "Quan s\xE1t ph\xEDa tr\u01B0\u1EDBc th\xEC \u0111\u01B0\u1EE3c.
      Nh\u01B0ng h\xE3y di chuy\u1EC3n trong kho\u1EA3ng c\xF2n nh\xECn th\u1EA5y
      d\u1EA5u ch\u1EC9."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332620
    m_Localized: "Hi\u1EC3u r\u1ED3i. T\xF4i s\u1EBD kh\xF4ng bi\u1EBFn m\u1EA5t
      m\u1ED9t m\xECnh theo ki\u1EC3u th\u1EADt ng\u1EA7u \u0111\xE2u!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332621
    m_Localized: "Chuy\u1EC7n \u0111\xF3 ch\u1EB3ng ng\u1EA7u ch\xFAt n\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332622
    m_Localized: "T\xF4i bi\u1EBFt. V\xEC th\u1EBF t\xF4i m\u1EDBi n\xF3i l\xE0 s\u1EBD
      kh\xF4ng l\xE0m m\xE0!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332623
    m_Localized: "Nh\u01B0ng Alice, sao c\u1EADu l\u1EA1i th\xEDch nh\u1EEFng th\u1EE9
      l\u1EA5p l\xE1nh \u0111\u1EBFn v\u1EADy?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332624
    m_Localized: "L\xE0 v\xEC c\u1EADu l\xE0 ph\xE1p s\u01B0, hay v\xEC c\u1EADu
      l\xE0 Alice?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332625
    m_Localized: "C\u1EA3 hai \u0111\u1EC1u \u0111\xFAng m\u1ED9t ch\xFAt."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332626
    m_Localized: "Khi c\xF2n nh\u1ECF, t\xF4i t\u1EEBng g\u1EB7p m\u1ED9t ph\xE1p
      s\u01B0. Ng\u01B0\u1EDDi \u0111\xF3 \u0103n m\u1EB7c r\u1EF1c r\u1EE1 v\xE0
      n\u1ED5i b\u1EADt h\u01A1n b\u1EA5t k\u1EF3 ai."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332627
    m_Localized: "M\u1ECDi ng\u01B0\u1EDDi th\u01B0\u1EDDng h\u01A1i e ng\u1EA1i
      ph\xE1p s\u01B0. C\xF3 nh\u1EEFng \xE1nh m\u1EAFt nh\u01B0 th\u1EC3 kh\xF4ng
      n\xEAn \u0111\u1EBFn g\u1EA7n ch\xFAng t\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332628
    m_Localized: "Nh\u01B0ng ng\u01B0\u1EDDi \u0111\xF3 kh\xF4ng tr\xE1nh nh\u1EEFng
      \xE1nh m\u1EAFt \u1EA5y. Ng\u01B0\u1EE3c l\u1EA1i, ng\u01B0\u1EDDi \u0111\xF3
      c\xF2n c\u01B0\u1EDDi r\u1EA1ng r\u1EE1 h\u01A1n v\xE0 ch\u1EE7 \u0111\u1ED9ng
      v\u1EABy tay tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332629
    m_Localized: "Ng\u01B0\u1EDDi \u0111\xF3 cho m\u1ECDi ng\u01B0\u1EDDi th\u1EA5y
      b\u1EB1ng ch\xEDnh v\u1EBB ngo\xE0i c\u1EE7a m\xECnh r\u1EB1ng ph\xE1p s\u01B0
      kh\xF4ng ch\u1EC9 l\xE0 nh\u1EEFng ng\u01B0\u1EDDi \u0111\xE1ng s\u1EE3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332630
    m_Localized: "T\xF4i c\u0169ng mu\u1ED1n tr\u1EDF th\xE0nh m\u1ED9t ph\xE1p s\u01B0
      nh\u01B0 v\u1EADy. M\u1ED9t ph\xE1p s\u01B0 m\xE0 m\u1ECDi ng\u01B0\u1EDDi
      c\xF3 th\u1EC3 ch\u1EE7 \u0111\u1ED9ng \u0111\u1EBFn g\u1EA7n v\xE0 b\u1EAFt
      chuy\u1EC7n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332631
    m_Localized: "V\u1EADy n\xEAn Alice c\u1ED1 \xFD \u0103n m\u1EB7c n\u1ED5i b\u1EADt
      nh\u01B0 v\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332632
    m_Localized: "\u1EEA. T\xF4i kh\xF4ng \u0103n m\u1EB7c th\u1EBF n\xE0y \u0111\u1EC3
      tr\xF4ng h\u1EDDi h\u1EE3t."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332633
    m_Localized: "N\u1EBFu ph\xE1p s\u01B0 v\u1ED1n t\u1EA1o c\u1EA3m gi\xE1c kh\xF3
      \u0111\u1EBFn g\u1EA7n, t\xF4i mu\u1ED1n ph\xE1 b\u1ECF c\u1EA3m gi\xE1c \u0111\xF3
      m\u1ED9t c\xE1ch tr\u1EF1c di\u1EC7n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332634
    m_Localized: "V\u1EADy b\u1ED9 \u0111\u1ED3 \u0111\xF3 kh\xF4ng ch\u1EC9 l\xE0
      \u0111\u1ED3 trang tr\xED v\u1EDBi Alice."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332635
    m_Localized: "C\u1EA3m \u01A1n v\xEC \u0111\xE3 nh\xECn n\xF3 nh\u01B0 v\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332636
    m_Localized: "Gi\u1EDD h\xE3y d\xF9ng nh\u1EEFng m\xE0u d\u1EC5 th\u1EA5y \u0111\xF3
      \u0111\u1EC3 ch\u1ECDn d\u1EA5u ch\u1EC9 cho ng\xE0y mai."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332637
    m_Localized: "Tr\u01B0\u1EDBc h\u1EBFt, ng\xE0y mai lau s\u1EADy \u1EDF \u0111\u1EA7m
      l\u1EA7y s\u1EBD cao v\xE0 m\u1EF1c n\u01B0\u1EDBc c\u0169ng d\xE2ng. D\u1EA5u
      ch\u1EC9 b\xECnh th\u01B0\u1EDDng s\u1EBD nhanh ch\xF3ng b\u1ECB v\xF9i m\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332638
    m_Localized: "V\xEC th\u1EBF ph\u1EA3i c\u1ED1 \xFD \u0111\u1EC3 \u0111\u01B0\u1EDDng
      quay v\u1EC1 th\u1EADt d\u1EC5 th\u1EA5y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332639
    m_Localized: "N\xEAn d\xF9ng m\xE0u kh\xE1c nhau cho \u0111\u01B0\u1EDDng \u0111i
      v\xE0o v\xE0 \u0111\u01B0\u1EDDng quay v\u1EC1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332640
    m_Localized: "Khi n\u01B0\u1EDBc d\xE2ng, d\u1EA5u ch\u1EC9 th\u1EA5p s\u1EBD
      b\u1ECB ng\u1EADp, n\xEAn c\u0169ng ph\u1EA3i bu\u1ED9c l\xEAn ph\xEDa tr\xEAn
      nh\u1EEFng c\xE2y lau s\u1EADy cao."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332641
    m_Localized: "T\u1ED1t. N\u1EBFu \u0111\u01B0\u1EDDng quay v\u1EC1 d\u1EC5 th\u1EA5y
      th\xEC t\xF4i s\u1EBD b\u1EDBt b\u1ECB \u01B0\u1EDBt khi \u0111i t\xECm ng\u01B0\u1EDDi
      b\u1ECB l\u1EA1c..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332642
    m_Localized: "V\u1EADy d\u1EA5u ch\u1EC9 th\u1EA5p bu\u1ED9c tr\xEAn \u0111\u01B0\u1EDDng
      g\u1ED7, c\xF2n d\u1EA5u ch\u1EC9 cao bu\u1ED9c g\u1EA7n ph\xEDa tr\xEAn lau
      s\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332643
    m_Localized: "T\xF4i s\u1EBD chia m\xE0u cho \u0111\u01B0\u1EDDng \u0111i v\xE0o
      v\xE0 \u0111\u01B0\u1EDDng quay v\u1EC1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332644
    m_Localized: "\u0110\u01B0\u1EE3c. Alice l\xE0m cho con \u0111\u01B0\u1EDDng
      d\u1EC5 th\u1EA5y, c\xF2n t\xF4i s\u1EBD lo ph\xEDa tr\u01B0\u1EDBc!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332645
    m_Localized: "H\xE3y s\u1EAFp x\u1EBFp theo ti\xEAu ch\xED \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332646
    m_Localized: "Ng\xE0y mai h\xE3y v\u1EEBa ki\u1EC3m tra d\u1EA5u ch\u1EC9 v\u1EEBa
      theo d\xF5i s\xF3ng n\u01B0\u1EDBc \u0111\u1EC3 ti\u1EBFn v\xE0o \u0111\u1EA7m
      l\u1EA7y lau s\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332647
    m_Localized: "\u0110\u1EA7m l\u1EA7y lau s\u1EADy Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332648
    m_Localized: "H\u1EA7u nh\u01B0 kh\xF4ng c\xF2n d\u1EA5u ch\xE2n n\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332649
    m_Localized: "Thay v\xE0o \u0111\xF3, c\xF3 th\u1EC3 th\u1EA5y h\u01B0\u1EDBng
      lau s\u1EADy b\u1ECB b\u1EBB v\xE0 h\u01B0\u1EDBng g\u1EE3n n\u01B0\u1EDBc
      lan ra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332650
    m_Localized: "C\xE1c d\u1EA5u ch\u1EC9 v\u1EABn c\xF2n nh\xECn th\u1EA5y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332651
    m_Localized: "N\u01B0\u1EDBc \u0111\xE3 d\xE2ng l\xEAn m\u1ED9t ch\xFAt, nh\u01B0ng
      d\u1EA5u ch\u1EC9 bu\u1ED9c tr\xEAn nh\u1EEFng c\xE2y lau s\u1EADy cao v\u1EABn
      c\xF2n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332652
    m_Localized: "Kh\xF3 nh\xECn th\u1EA5y ph\xEDa tr\u01B0\u1EDBc qu\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332653
    m_Localized: "D\xF9 v\u1EADy, ch\xFAng ta \u0111\xE3 \u0111\xE1nh d\u1EA5u \u0111\u01B0\u1EDDng
      r\u1ED3i, n\xEAn \u0111\u1EEBng b\u1ECF s\xF3t m\xE0 c\u1EE9 \u0111i theo!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332654
    m_Localized: "N\u1EBFu c\xF9ng l\xFAc lao v\xE0o th\xEC c\u1EA3 \u0111\xE1m lau
      s\u1EADy s\u1EBD rung l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332655
    m_Localized: "Khi \u0111\xF3 s\u1EBD kh\xF3 ph\xE2n bi\u1EC7t d\u1EA5u v\u1EBFt
      do qu\xE1i v\u1EADt di chuy\u1EC3n v\u1EDBi d\u1EA5u v\u1EBFt ch\xFAng ta t\u1EA1o
      ra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332656
    m_Localized: "\u0110\u1EB7c bi\u1EC7t n\u1EBFu c\u1EA3 d\u1EA5u ch\u1EC9 \u0111\u01B0\u1EDDng
      quay v\u1EC1 c\u0169ng rung l\xEAn th\xEC s\u1EBD kh\xF3 x\xE1c \u0111\u1ECBnh
      \u0111\u01B0\u1EDDng r\xFAt lui."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332657
    m_Localized: "Serah, c\u1EE9 quan s\xE1t ph\xEDa tr\u01B0\u1EDBc nh\u01B0ng \u0111\u1EEBng
      \u0111i qu\xE1 xa kh\u1ECFi d\u1EA5u ch\u1EC9."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332658
    m_Localized: "N\u01B0\u1EDBc y\xEAn qu\xE1 n\xEAn l\u1EA1i c\xE0ng kh\xF3 bi\u1EBFt
      th\u1EE9 g\xEC \u0111ang di chuy\u1EC3n \u1EDF \u0111\xE2u..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332659
    m_Localized: "Kh\xF4ng sao! Ch\u1EC9 c\u1EA7n lau s\u1EADy lay \u0111\u1ED9ng
      l\xE0 ch\xFAng ta s\u1EBD bi\u1EBFt ngay m\xE0!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332660
    m_Localized: "...Nghe nh\u01B0 n\xF3 c\xF3 th\u1EC3 nh\u1EA3y ra tr\u01B0\u1EDBc
      khi lau s\u1EADy k\u1ECBp lay \u0111\u1ED9ng v\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332661
    m_Localized: "Lau s\u1EADy b\xEAn ph\u1EA3i v\u1EEBa lay \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332662
    m_Localized: "Kh\xF4ng ph\u1EA3i do gi\xF3. G\u1EE3n n\u01B0\u1EDBc \u0111ang
      lan theo h\u01B0\u1EDBng ng\u01B0\u1EE3c l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332663
    m_Localized: "G\u1EE3n n\u01B0\u1EDBc \u0111ang b\u1ECB \u0111\u1EA9y t\u1EEB
      b\xEAn trong ra ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332664
    m_Localized: "\u0110\u1ED9 cao n\u01B0\u1EDBc \u0111\u1ECDng tr\xEAn lau s\u1EADy
      c\u0169ng kh\u1EDBp v\u1EDBi h\u01B0\u1EDBng \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332665
    m_Localized: "C\xF3 \xE1nh s\xE1ng m\u1EDD d\u01B0\u1EDBi \u0111\xE1m lau s\u1EADy
      b\xEAn ph\u1EA3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332666
    m_Localized: "Qu\xE1i v\u1EADt kh\xF4ng \u0111i v\u1EC1 ph\xEDa \xE1nh s\xE1ng,
      m\xE0 c\xF3 v\u1EBB tr\xE1nh khu v\u1EF1c quanh \u0111\xF3 r\u1ED3i lao ra
      ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332667
    m_Localized: "Ch\xFAng kh\xF4ng \u0111\u1ECBnh \u0111i qua n\u01A1i c\xF3 \xE1nh
      s\xE1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332668
    m_Localized: "Ch\xFAng tr\xE1nh khu v\u1EF1c \u0111\xF3 r\u1ED3i b\u1ECB d\u1ED3n
      v\u1EC1 ph\xEDa con \u0111\u01B0\u1EDDng g\u1ED7."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332669
    m_Localized: "V\u1EADy th\xEC ph\u1EA3i ch\u1EB7n nh\xF3m \u0111ang lao ra con
      \u0111\u01B0\u1EDDng g\u1ED7 \u0111\u1EC3 tr\xE1nh \xE1nh s\xE1ng tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332670
    m_Localized: "T\xF4i s\u1EBD gi\u1EEF l\u1ED1i v\xE0o con \u0111\u01B0\u1EDDng
      g\u1ED7!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332671
    m_Localized: "H\xE3y \u0111\u1EC3 con \u0111\u01B0\u1EDDng g\u1ED7 th\xF4ng tho\xE1ng
      v\xE0 ch\u1EB7n nh\xF3m \u0111ang lao ra gi\u1EEFa c\xE1c b\u1EE5i lau s\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332672
    m_Localized: "H\xE3y ki\u1EC3m tra v\u1ECB tr\xED c\u1EE7a nhau \u0111\u1EC3
      kh\xF4ng b\u1ECB m\u1EA5t d\u1EA5u ch\u1EC9."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332673
    m_Localized: "N\u1EBFu ng\xE3 th\xEC b\xE1o ngay cho t\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535700332674
    m_Localized: "N\u1EBFu ai \u0111\xF3 n\u1EB1m \u01B0\u1EDBt im l\xECm gi\u1EEFa
      \u0111\xE1m lau s\u1EADy th\xEC c\xF3 khi ng\u01B0\u1EDDi \u0111i t\xECm c\u0169ng
      mu\u1ED1n \u0111\u01B0\u1EE3c ch\u1EEFa tr\u1ECB..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721152
    m_Localized: "S\xF3ng b\xEAn tr\xE1i c\u0169ng l\u1EDBn h\u01A1n r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721153
    m_Localized: "Nh\xF3m \u0111i ra tr\u01B0\u1EDBc \u0111ang \u0111\u1EBFn con
      \u0111\u01B0\u1EDDng g\u1ED7."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721154
    m_Localized: "Ph\u1EA3n \u1EE9ng \xE1nh s\xE1ng v\u1EABn c\xF2n \u1EDF ph\xEDa
      trong."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721155
    m_Localized: "N\u1EBFu t\u1EA3n ra kh\u1ECFi con \u0111\u01B0\u1EDDng g\u1ED7
      th\xEC s\u1EF1 h\u1ED7n lo\u1EA1n s\u1EBD lan \u0111\u1EBFn t\u1EADn c\u1EA7u
      n\u1ED5i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721156
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n \u1EDF con \u0111\u01B0\u1EDDng
      g\u1ED7 c\u1EE7a \u0111\u1EA7m l\u1EA7y lau s\u1EADy Milen tr\u01B0\u1EDBc
      khi ch\xFAng lan v\u1EC1 ph\xEDa c\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721157
    m_Localized: "\u0110\xE3 gi\u1EEF \u0111\u01B0\u1EE3c con \u0111\u01B0\u1EDDng
      g\u1ED7."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721158
    m_Localized: "C\xF3 v\u1EBB c\u0169ng kh\xF4ng c\xF2n nh\xF3m n\xE0o lao ra t\u1EEB
      s\xE2u h\u01A1n trong lau s\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721159
    m_Localized: "D\xF9 v\u1EADy, n\u1EBFu kh\xF4ng c\xF3 d\u1EA5u ch\u1EC9 th\xEC
      ch\xFAng ta c\u0169ng \u0111\xE3 \u0111i l\xF2ng v\xF2ng kh\xE1 l\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721160
    m_Localized: "Ngay l\xFAc n\xE0y th\xEC ch\u01B0a."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721161
    m_Localized: "Nh\u01B0ng s\xF3ng n\u01B0\u1EDBc v\u1EABn ti\u1EBFp t\u1EE5c v\u1EC1
      ph\xEDa c\u1EA7u n\u1ED5i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721162
    m_Localized: "N\u01B0\u1EDBc d\u01B0\u1EDBi con \u0111\u01B0\u1EDDng g\u1ED7
      \u0111ang ch\u1EA3y xu\u1ED1ng b\xEAn d\u01B0\u1EDBi c\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721163
    m_Localized: "Ph\u1EA3n \u1EE9ng \xE1nh s\xE1ng c\u0169ng kh\xF4ng k\u1EBFt th\xFAc
      trong \u0111\xE1m lau s\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721164
    m_Localized: "C\xF3 v\u1EBB n\xF3 ti\u1EBFp t\u1EE5c d\u01B0\u1EDBi n\u01B0\u1EDBc
      r\u1ED3i \u0111i qua b\xEAn d\u01B0\u1EDBi c\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721165
    m_Localized: "M\u1ED9t ph\u1EA3n \u1EE9ng k\xE9o d\xE0i d\u01B0\u1EDBi n\u01B0\u1EDBc
      sao..."
    m_Metadata:
      m_Items: []
  - m_Id: 12273840514490368
    m_Localized: "Nh\u1EEFng con \u0111\u01B0\u1EDDng kh\xF4ng nh\xECn th\u1EA5y
      \u0111\xFAng l\xE0 ch\u1EB3ng th\xE2n thi\u1EC7n ch\xFAt n\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 12273840543850496
    m_Localized: "D\xF9 sao th\xEC v\u1EABn nh\xECn th\u1EA5y \u0111\u01B0\u1EDDng
      \u0111\u1EBFn c\u1EA7u n\u1ED5i."
    m_Metadata:
      m_Items: []
  - m_Id: 12273840543850497
    m_Localized: "H\xE3y v\u1EEBa \u0111i v\u1EEBa b\u1EA3o v\u1EC7 con \u0111\u01B0\u1EDDng
      nh\xECn th\u1EA5y \u0111\u01B0\u1EE3c tr\u01B0\u1EDBc!"
    m_Metadata:
      m_Items: []
  - m_Id: 12273840543850498
    m_Localized: "N\u1EBFu c\u1EA7u s\u1EADp th\xEC \u0111\u01B0\u1EDDng \u0111\u1EBFn
      \u0111\u1EA3o trung t\xE2m c\u0169ng b\u1ECB ch\u1EB7n."
    m_Metadata:
      m_Items: []
  - m_Id: 12273840543850499
    m_Localized: "L\u1EA7n sau ph\u1EA3i v\u1EEBa xem t\xECnh tr\u1EA1ng c\xE2y c\u1EA7u
      v\u1EEBa chi\u1EBFn \u0111\u1EA5u."
    m_Metadata:
      m_Items: []
  - m_Id: 12273840543850500
    m_Localized: "B\u1EA3n th\xE2n c\xE2y c\u1EA7u v\u1EEBa l\xE0 tuy\u1EBFn ph\xF2ng
      th\u1EE7 ti\u1EBFp theo v\u1EEBa l\xE0 \u0111\u01B0\u1EDDng di chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 12273840543850501
    m_Localized: "H\xE3y di chuy\u1EC3n \u0111\u1EBFn c\u1EA7u n\u1ED5i."
    m_Metadata:
      m_Items: []
  - m_Id: 12273840543850502
    m_Localized: "H\xE3y ki\u1EC3m tra c\u1EA3 s\xF3ng n\u01B0\u1EDBc v\xE0 ph\u1EA3n
      \u1EE9ng \xE1nh s\xE1ng b\xEAn d\u01B0\u1EDBi c\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 12273840543850503
    m_Localized: "C\u1EA7u n\u1ED5i Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 12273840543850504
    m_Localized: "Ph\u1EA3i \u0111i qua c\u1EA7u n\xE0y m\u1EDBi \u0111\u1EBFn \u0111\u01B0\u1EE3c
      b\u1EBFn thuy\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 12273840543850505
    m_Localized: "Chi\u1EBFc thuy\u1EC1n \u0111i \u0111\u1EBFn \u0111\u1EA3o trung
      t\xE2m c\u0169ng \u0111ang neo \u1EDF b\u1EBFn thuy\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 12273840543850506
    m_Localized: "M\u1ED9t v\xE0i c\u1ECDc b\xEAn d\u01B0\u1EDBi c\u1EA7u \u0111\xE3
      rung chuy\u1EC3n r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 12273840543850507
    m_Localized: "N\u1EBFu tr\u1EADn chi\u1EBFn k\xE9o d\xE0i th\xEC \u0111\u01B0\u1EDDng
      \u0111\u1EBFn b\u1EBFn thuy\u1EC1n s\u1EBD b\u1EA5t \u1ED5n tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 12273840543850508
    m_Localized: "S\xF3ng t\u1EEB ph\xEDa \u0111\u1EA7m l\u1EA7y lau s\u1EADy \u0111ang
      \u0111i qua b\xEAn d\u01B0\u1EDBi c\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721166
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng b\xEAn d\u01B0\u1EDBi l\u1EDBn h\u01A1n
      d\u1EA5u ch\xE2n tr\xEAn c\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721167
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng d\u01B0\u1EDBi n\u01B0\u1EDBc \u0111ang
      v\xF2ng quanh c\xE1c tr\u1EE5 c\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721168
    m_Localized: "Nh\u01B0ng h\u01B0\u1EDBng c\u1EE7a n\xF3 c\u1EE9 thay \u0111\u1ED5i
      n\xEAn c\xF2n \u0111\u1EC3 l\u1EA1i d\u1EA5u va v\xE0o tr\u1EE5."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721169
    m_Localized: "N\u1EBFu c\u1EA7u rung chuy\u1EC3n th\xEC ch\xFAng ta s\u1EBD g\u1EB7p
      v\u1EA5n \u0111\u1EC1 c\xF2n l\u1EDBn h\u01A1n vi\u1EC7c ch\u1EB7n qu\xE1i
      v\u1EADt."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721170
    m_Localized: "C\u1EA3 \u0111\u01B0\u1EDDng \u0111\u1EBFn b\u1EBFn thuy\u1EC1n
      l\u1EABn \u0111\u01B0\u1EDDng quay v\u1EC1 \u0111\u1EC1u c\xF3 th\u1EC3 b\u1ECB
      c\u1EAFt."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721171
    m_Localized: "V\u1EADy th\xEC nh\u1EA5t \u0111\u1ECBnh ph\u1EA3i b\u1EA3o v\u1EC7
      c\xE2y c\u1EA7u r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721172
    m_Localized: "T\xF4i s\u1EBD ch\u1EB7n nh\xF3m \u0111i t\u1EEB ph\xEDa tr\u01B0\u1EDBc!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721173
    m_Localized: "T\xF4i gh\xE9t chi\u1EBFn \u0111\u1EA5u tr\xEAn c\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721174
    m_Localized: "N\u1EBFu ai \u0111\xF3 ng\xE3 th\xEC kh\xF4ng ch\u1EC9 b\u1ECB
      \u01B0\u1EDBt, m\xE0 ng\u01B0\u1EDDi \u0111i t\xECm c\u0169ng s\u1EBD kh\u1ED5
      theo..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721175
    m_Localized: "V\xEC v\u1EADy ph\u1EA3i di chuy\u1EC3n ch\u1EADm h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721176
    m_Localized: "N\u1EBFu \u0111\u1EC3 tr\u1ED1ng gi\u1EEFa c\u1EA7u th\xEC d\xF9
      n\xF3 rung m\u1EA1nh h\u01A1n c\u0169ng v\u1EABn c\xF3 ch\u1ED7 \u0111\u1EC3
      r\xFAt."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721177
    m_Localized: "H\xE3y \u0111\u1EC3 tr\u1ED1ng gi\u1EEFa c\u1EA7u v\xE0 ch\u1EB7n
      c\xE1c nh\xF3m \u0111i v\xE0o t\u1EEB hai \u0111\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721178
    m_Localized: "H\xE3y b\u1EA3o v\u1EC7 \u0111\u01B0\u1EDDng \u0111\u1EBFn b\u1EBFn
      thuy\u1EC1n \u0111\u1EC3 n\xF3 kh\xF4ng b\u1ECB c\u1EAFt."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721179
    m_Localized: "M\u1ED9t chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn v\u1EEBa \u0111i qua
      d\u01B0\u1EDBi n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721180
    m_Localized: "N\xF3 kh\xF4ng \u0111\u1ECBnh \u0111\xE2m v\xE0o c\u1EA7u. C\xF3
      v\u1EBB n\xF3 va ph\u1EA3i c\u1EA7u khi \u0111ang c\u1ED1 tr\xE1nh."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721181
    m_Localized: "D\xF9 kh\xF4ng c\xF3 \xFD \u0111\u1ECBnh th\xEC k\u1EBFt qu\u1EA3
      v\u1EABn v\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721182
    m_Localized: "N\u1EBFu m\u1ED9t tr\u1EE5 g\xE3y th\xEC \u0111\u01B0\u1EDDng \u0111\u1EBFn
      b\u1EBFn thuy\u1EC1n s\u1EBD b\u1ECB c\u1EAFt."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721183
    m_Localized: "D\xF9 kh\xF4ng mu\u1ED1n chi\u1EBFn \u0111\u1EA5u, ch\xFAng ta
      c\u0169ng kh\xF4ng th\u1EC3 \u0111\u1EC3 ch\xFAng ph\xE1 c\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721184
    m_Localized: "T\xF4i kh\xF4ng \u0111\u1EC3 ch\xFAng ph\xE1 c\u1EA3 con \u0111\u01B0\u1EDDng
      m\u1ECDi ng\u01B0\u1EDDi \u0111i \u0111\xE2u!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721185
    m_Localized: "\u1ED2, c\xE2u \u0111\xF3 nghe \u0111\u01B0\u1EE3c \u0111\u1EA5y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721186
    m_Localized: "\u0110\u01B0\u1EDDng \u0111i c\xF2n quan tr\u1ECDng h\u01A1n khi
      quay v\u1EC1..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721187
    m_Localized: "Nh\xF3m \u0111i ra tr\u01B0\u1EDBc \u0111ang \u0111\u1EBFn l\u1ED1i
      v\xE0o c\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721188
    m_Localized: "Nh\xF3m d\u01B0\u1EDBi n\u01B0\u1EDBc c\u0169ng \u0111\u1ED3ng
      th\u1EDDi tr\u1ED3i l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721189
    m_Localized: "Ph\u1EA3i ch\u1EB7n ch\xFAng tr\u01B0\u1EDBc khi ch\xFAng ch\u1EA1m
      v\xE0o c\xE1c tr\u1EE5 c\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721190
    m_Localized: "N\u1EBFu tr\u1EE5 c\u1EA7u rung th\xEC \u0111\u01B0\u1EDDng v\u1EC1
      ph\xEDa b\u1EBFn thuy\u1EC1n s\u1EBD b\u1EA5t \u1ED5n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721191
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n \u1EDF l\u1ED1i v\xE0o c\u1EA7u
      n\u1ED5i Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721192
    m_Localized: "H\xE3y b\u1EA3o v\u1EC7 c\xE1c tr\u1EE5 c\u1EA7u v\xE0 \u0111\u01B0\u1EDDng
      \u0111\u1EBFn b\u1EBFn thuy\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721193
    m_Localized: "C\u1EA7u \u0111\xE3 tr\u1EE5 \u0111\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721194
    m_Localized: "\u0110\u01B0\u1EDDng \u0111\u1EBFn b\u1EBFn thuy\u1EC1n v\u1EABn
      c\xF2n th\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721195
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng b\xEAn d\u01B0\u1EDBi \u0111\xE3 ti\u1EBFp
      t\u1EE5c v\u1EC1 ph\xEDa b\u1EBFn thuy\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721196
    m_Localized: "S\xF3ng t\xE1ch th\xE0nh nhi\u1EC1u nh\xE1nh r\u1ED3i l\u1EA1i
      t\u1EE5 v\u1EC1 m\u1ED9t ch\u1ED7."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721197
    m_Localized: "Nh\u1EEFng v\u1EBFt tr\xEAn tr\u1EE5 c\u1EA7u c\u0169ng ti\u1EBFp
      t\u1EE5c v\u1EC1 ph\xEDa b\u1EBFn thuy\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721198
    m_Localized: "C\xF3 v\u1EBB nh\xF3m d\u01B0\u1EDBi n\u01B0\u1EDBc \u0111\xE3
      \u0111\u1ED5i h\u01B0\u1EDBng khi \u0111i qua d\u01B0\u1EDBi c\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721199
    m_Localized: "C\xE1c d\xF2ng n\u01B0\u1EDBc h\u1ED9i t\u1EE5 \u1EDF b\u1EBFn
      thuy\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721200
    m_Localized: "N\u1EBFu \u0111\u1EC3 ch\xFAng v\u01B0\u1EE3t qua th\xEC c\u1EA3
      nh\u1EEFng chi\u1EBFc thuy\u1EC1n \u0111\u1EBFn \u0111\u1EA3o trung t\xE2m
      c\u0169ng s\u1EBD g\u1EB7p nguy hi\u1EC3m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721201
    m_Localized: "C\u1EA7u n\u1ED5i \u0111\xE3 tr\u1EE5 \u0111\u01B0\u1EE3c, nh\u01B0ng
      n\u1EBFu b\u1EBFn thuy\u1EC1n b\u1EA5t \u1ED5n th\xEC ch\xFAng ta s\u1EBD kh\xF4ng
      c\xF2n \u0111\u01B0\u1EDDng \u0111i ti\u1EBFp."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721202
    m_Localized: "V\u1EABn c\xF2n nh\xE2n vi\xEAn s\u1EEDa ch\u1EEFa \u1EDF b\u1EBFn
      thuy\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721203
    m_Localized: "C\xE1c c\u1ECDc neo thuy\u1EC1n c\u0169ng \u0111ang rung v\xEC
      s\xF3ng n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721204
    m_Localized: "V\u1EADy ph\u1EA3i nhanh l\xEAn v\xE0 b\u1EA3o v\u1EC7 nh\xE2n
      vi\xEAn s\u1EEDa ch\u1EEFa tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721205
    m_Localized: "H\xE3y ch\u1EB7n l\u1ED1i v\xE0o b\u1EBFn thuy\u1EC1n tr\u01B0\u1EDBc
      khi thuy\u1EC1n b\u1ECB cu\u1ED1n tr\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721206
    m_Localized: "N\u1EBFu thuy\u1EC1n b\u1ECB cu\u1ED1n tr\xF4i th\xEC \u0111\u1EBFn
      \u0111\u1EA3o trung t\xE2m \u0111\xE3 kh\xF3, m\xE0 quay v\u1EC1 c\u0169ng
      kh\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721207
    m_Localized: "L\u1EA7n n\xE0y th\u1EADt s\u1EF1 ph\u1EA3i lo \u0111\u01B0\u1EDDng
      quay v\u1EC1 tr\u01B0\u1EDBc..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721208
    m_Localized: "H\xE3y di chuy\u1EC3n \u0111\u1EBFn b\u1EBFn thuy\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721209
    m_Localized: "Tr\u01B0\u1EDBc h\u1EBFt ki\u1EC3m tra thuy\u1EC1n v\xE0 tuy\u1EBFn
      ph\xF2ng th\u1EE7 t\u1EA1m th\u1EDDi, r\u1ED3i b\u1EA3o v\u1EC7 \u0111\u01B0\u1EDDng
      \u0111\u1EBFn \u0111\u1EA3o trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721210
    m_Localized: "B\u1EBFn thuy\u1EC1n h\u1ED3 Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721211
    m_Localized: "Mu\u1ED1n \u0111\u1EBFn \u0111\u1EA3o trung t\xE2m th\xEC ph\u1EA3i
      d\xF9ng chi\u1EBFc thuy\u1EC1n n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721212
    m_Localized: "Nh\u01B0ng s\xF3ng l\u1EDBn khi\u1EBFn c\xE1c c\u1ECDc neo v\xE0
      d\xE2y th\u1EEBng li\xEAn t\u1EE5c b\u1ECB tu\u1ED9t."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721213
    m_Localized: "N\u1EBFu s\u1EE3i d\xE2y ph\xEDa ngo\xE0i tu\u1ED9t tr\u01B0\u1EDBc
      th\xEC thuy\u1EC1n s\u1EBD b\u1ECB \u0111\u1EA9y s\xE2u v\xE0o trong h\u1ED3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721214
    m_Localized: "Ph\u1EA3i bu\u1ED9c ri\xEAng c\u1EA3 chi\u1EBFc thuy\u1EC1n quay
      v\u1EC1, kh\xF4ng ch\u1EC9 chi\u1EBFc thuy\u1EC1n \u0111i \u0111\u1EBFn \u0111\u1EA3o
      trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721215
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng t\u1EEB b\xEAn d\u01B0\u1EDBi c\u1EA7u
      n\u1ED5i l\u1EA1i h\u1ED9i t\u1EE5 \u1EDF \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721216
    m_Localized: "S\xF3ng t\u1EEB ph\xEDa \u0111\u1EA7m l\u1EA7y lau s\u1EADy v\xE0
      s\xF3ng t\u1EEB ph\xEDa s\xE2u trong h\u1ED3 ch\u1ED3ng l\xEAn nhau tr\u01B0\u1EDBc
      b\u1EBFn thuy\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721217
    m_Localized: "S\xF3ng n\u01B0\u1EDBc \u0111ang va v\xE0o nhau b\xEAn d\u01B0\u1EDBi
      b\u1EBFn thuy\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721218
    m_Localized: "V\xEC v\u1EADy c\xE1c c\u1ECDc neo thuy\u1EC1n c\u0169ng rung theo
      c\xF9ng m\u1ED9t h\u01B0\u1EDBng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721219
    m_Localized: "\u0110\xE2y l\xE0 m\u1ED9t \u0111i\u1EC3m ph\xE2n nh\xE1nh."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721220
    m_Localized: "N\u1EBFu \u0111\u1EC3 qu\xE1i v\u1EADt v\u01B0\u1EE3t qua b\u1EBFn
      thuy\u1EC1n th\xEC ch\xFAng c\xF3 th\u1EC3 lan v\u1EC1 c\u1EA3 ph\xEDa l\xE0ng
      l\u1EABn \u0111\u1EA3o trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721221
    m_Localized: "Mu\u1ED1n gi\u1EEF \u0111\u01B0\u1EDDng \u0111\u1EBFn \u0111\u1EA3o
      trung t\xE2m th\xEC ph\u1EA3i gi\u1EEF l\u1ED1i v\xE0o b\u1EBFn thuy\u1EC1n
      tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721222
    m_Localized: "V\u1EADy tr\u01B0\u1EDBc h\u1EBFt h\xE3y ch\u1EB7n l\u1ED1i v\xE0o
      b\u1EBFn thuy\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721223
    m_Localized: "C\xF3 th\u1EC3 bu\u1ED9c thuy\u1EC1n \u1EDF ph\xEDa trong b\u1EBFn
      thuy\u1EC1n \u0111\xFAng kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721224
    m_Localized: "Bu\u1ED9c thuy\u1EC1n c\u0169ng r\u1EA5t quan tr\u1ECDng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721225
    m_Localized: "N\u1EBFu \u0111\u1EBFn \u0111\u01B0\u1EE3c \u0111\u1EA3o trung
      t\xE2m m\xE0 kh\xF4ng c\xF2n thuy\u1EC1n quay v\u1EC1 th\xEC \u0111\xF3 kh\xF4ng
      ph\u1EA3i v\u1EA5n \u0111\u1EC1 t\xF4i c\xF3 th\u1EC3 gi\u1EA3i quy\u1EBFt
      b\u1EB1ng ch\u1EEFa tr\u1ECB..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721226
    m_Localized: "\u0110\xFAng v\u1EADy. Ph\u1EA3i v\u1EEBa b\u1EA3o v\u1EC7 thuy\u1EC1n
      v\u1EEBa gi\u1EEF b\u1EBFn thuy\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721227
    m_Localized: "Nh\u01B0ng ph\u1EA3i c\u1ED1 \u0111\u1ECBnh tuy\u1EBFn chi\u1EBFn
      \u0111\u1EA5u \u1EDF l\u1ED1i v\xE0o b\u1EBFn thuy\u1EC1n. N\u1EBFu chi\u1EBFn
      \u0111\u1EA5u g\u1EA7n thuy\u1EC1n th\xEC d\xE2y s\u1EBD \u0111\u1EE9t tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721228
    m_Localized: "H\xE3y ch\u1EB7n nh\xF3m \u0111ang ti\u1EBFn v\xE0o \u1EDF l\u1ED1i
      v\xE0o b\u1EBFn thuy\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721229
    m_Localized: "H\xE3y b\u1EA3o v\u1EC7 thuy\u1EC1n v\xE0 c\xE1c c\u1ECDc neo b\xEAn
      trong b\u1EBFn, \u0111\u1ED3ng th\u1EDDi gi\u1EEF th\xF4ng tho\xE1ng \u0111\u01B0\u1EDDng
      \u0111\u1EBFn \u0111\u1EA3o trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721230
    m_Localized: "H\xE3y s\u01A1 t\xE1n nh\xE2n vi\xEAn s\u1EEDa ch\u1EEFa v\xE0o
      ph\xEDa trong b\u1EBFn v\xE0 kh\xF4ng \u0111\u1EC3 ai \u1EDF l\u1EA1i g\u1EA7n
      c\xE1c c\u1ECDc neo."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721231
    m_Localized: "Trong l\xFAc ch\xFAng ta ch\u1EB7n \u1EDF l\u1ED1i v\xE0o, ch\u1EC9
      c\u1EA7n chu\u1EA9n b\u1ECB bu\u1ED9c l\u1EA1i thuy\u1EC1n l\xE0 \u0111\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721232
    m_Localized: "Ch\xFAng t\xF4i s\u1EBD s\u01A1 t\xE1n nh\xE2n vi\xEAn s\u1EEDa
      ch\u1EEFa v\xE0o ph\xEDa trong b\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721233
    m_Localized: "Ngay khi tr\u1EADn chi\u1EBFn k\u1EBFt th\xFAc, ch\xFAng t\xF4i
      s\u1EBD bu\u1ED9c l\u1EA1i c\xE1c c\u1ECDc neo v\xE0 d\xE2y th\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721234
    m_Localized: "S\xF3ng \u1EDF l\u1ED1i v\xE0o b\u1EBFn \u0111ang d\xE2ng cao d\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721235
    m_Localized: "C\xF3 m\u1ED9t nh\xF3m \u0111ang b\u1ECB d\u1ED3n v\xE0o t\u1EEB
      d\u01B0\u1EDBi n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721236
    m_Localized: "\u0110\u01B0\u1EE3c. T\xF4i s\u1EBD ch\u1EB7n l\u1ED1i v\xE0o b\u1EBFn!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721237
    m_Localized: "T\xF4i s\u1EBD kh\xF4ng \u0111\u1EC3 ch\xFAng \u0111\u1EBFn \u0111\u01B0\u1EE3c
      ch\u1ED7 thuy\u1EC1n!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721238
    m_Localized: "Mong l\xE0 ch\xFAng \u0111\u1EEBng \u0111\u1EBFn g\u1EA7n thuy\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721239
    m_Localized: "V\u1EA5p v\xE0o d\xE2y th\u1EEBng \u01B0\u1EDBt c\xF3 th\u1EC3
      \xEDt nguy hi\u1EC3m h\u01A1n qu\xE1i v\u1EADt, nh\u01B0ng l\u1EA1i x\u1EA5u
      h\u1ED5 h\u01A1n nhi\u1EC1u..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721240
    m_Localized: "Nh\xF3m \u0111i ra tr\u01B0\u1EDBc \u0111ang \u0111\u1EBFn l\u1ED1i
      v\xE0o b\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721241
    m_Localized: "S\xF3ng ph\xEDa \u0111\u1EA3o trung t\xE2m c\u0169ng b\u1EAFt \u0111\u1EA7u
      dao \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721242
    m_Localized: "N\u1EBFu ch\xFAng t\u1EA3n ra \u1EDF l\u1ED1i v\xE0o b\u1EBFn th\xEC
      s\u1EBD kh\xF3 b\u1EA3o v\u1EC7 thuy\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721243
    m_Localized: "Ph\u1EA3i ch\u1EB7n t\u1EA5t c\u1EA3 \u1EDF l\u1ED1i v\xE0o m\u1ED9t
      l\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721244
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n \u1EDF l\u1ED1i v\xE0o b\u1EBFn
      h\u1ED3 Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721245
    m_Localized: "H\xE3y b\u1EA3o v\u1EC7 thuy\u1EC1n v\xE0 ch\u1EEBa \u0111\u01B0\u1EDDng
      \u0111\u1EBFn \u0111\u1EA3o trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721246
    m_Localized: "\u0110\xE3 ch\u1EB7n \u0111\u01B0\u1EE3c l\u1ED1i v\xE0o b\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721247
    m_Localized: "Thuy\u1EC1n v\u1EABn c\xF2n \u0111\u01B0\u1EE3c bu\u1ED9c ch\u1EAFc!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721248
    m_Localized: "Nh\u1EDD c\xE1c v\u1ECB m\xE0 thuy\u1EC1n v\u1EABn an to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721249
    m_Localized: "Nh\u01B0ng v\u1EDBi t\xECnh tr\u1EA1ng n\xE0y th\xEC kh\xF3 \u0111i
      \u0111\u1EBFn \u0111\u1EA3o trung t\xE2m r\u1ED3i quay v\u1EC1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721250
    m_Localized: "C\u0169ng ph\u1EA3i d\u1EF1ng l\u1EA1i h\xE0ng r\xE0o g\u1ED7 \u1EDF
      l\u1ED1i v\xE0o b\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721251
    m_Localized: "N\u1EBFu b\u1EBFn b\u1EA5t \u1ED5n sau khi ch\xFAng ta \u0111\u1EBFn
      \u0111\u1EA3o trung t\xE2m th\xEC \u0111\u01B0\u1EDDng quay v\u1EC1 s\u1EBD
      b\u1ECB ch\u1EB7n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721252
    m_Localized: "S\xF3ng ph\xEDa \u0111\u1EA3o trung t\xE2m v\u1EABn ti\u1EBFp t\u1EE5c
      l\u1EDBn h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721253
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn \u0111ang \u0111i v\xF2ng quanh
      \u0111\u1EA3o."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721254
    m_Localized: "N\u1EBFu v\xE0o ngay th\xEC \u0111\u01B0\u1EDDng quay v\u1EC1 v\u1EABn
      ch\u01B0a \u1ED5n \u0111\u1ECBnh."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721255
    m_Localized: "Ph\u1EA3i s\u1EEDa b\u1EBFn v\xE0 thuy\u1EC1n tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721256
    m_Localized: "\u1ED2, cu\u1ED1i c\xF9ng c\u0169ng c\xF3 tin hay r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721257
    m_Localized: "\u0110\u01B0\u1EDDng quay v\u1EC1 th\u1EF1c s\u1EF1 quan tr\u1ECDng..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721258
    m_Localized: "Mu\u1ED1n \u0111\u1EBFn \u0111\u1EA3o trung t\xE2m c\u1EA7n m\u1ED9t
      chi\u1EBFc thuy\u1EC1n, c\xF2n mu\u1ED1n quay v\u1EC1 th\xEC c\u1EA7n th\xEAm
      m\u1ED9t chi\u1EBFc n\u1EEFa."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721259
    m_Localized: "H\xE3y s\u1EEDa b\u1EBFn tr\u01B0\u1EDBc khi v\xE0o \u0111\u1EA3o
      trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721260
    m_Localized: "Bu\u1ED9c l\u1EA1i thuy\u1EC1n v\xE0 d\u1EF1ng tuy\u1EBFn ph\xF2ng
      th\u1EE7 t\u1EA1m th\u1EDDi, r\u1ED3i ki\u1EC3m tra chuy\u1EC3n \u0111\u1ED9ng
      l\u1EDBn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721261
    m_Localized: "B\u1EBFn h\u1ED3 Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721262
    m_Localized: "\u0110\xE3 c\u1ED1 \u0111\u1ECBnh m\u1ED9t chi\u1EBFc thuy\u1EC1n
      \u0111\u1EC3 c\xF3 th\u1EC3 \u0111i \u0111\u1EBFn \u0111\u1EA3o trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535708721263
    m_Localized: "Ch\xFAng t\xF4i s\u1EBD bu\u1ED9c chi\u1EBFc thuy\u1EC1n c\xF2n
      l\u1EA1i b\xEAn trong b\u1EBFn \u0111\u1EC3 chu\u1EA9n b\u1ECB cho l\xFAc quay
      v\u1EC1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915456
    m_Localized: "Ch\xFAng t\xF4i c\u0169ng \u0111\xE3 d\u1EF1ng t\u1EA1m l\u1EA1i
      h\xE0ng r\xE0o g\u1ED7 \u1EDF l\u1ED1i v\xE0o b\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915457
    m_Localized: "D\xF9 kh\xF4ng th\u1EC3 tr\u1EE5 l\xE2u, n\xF3 v\u1EABn \u0111\u1EE7
      \u0111\u1EC3 ch\xFAng ta c\xF3 th\u1EDDi gian \u0111i \u0111\u1EBFn \u0111\u1EA3o
      trung t\xE2m r\u1ED3i quay v\u1EC1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915458
    m_Localized: "T\u1ED1t. C\xF3 thuy\u1EC1n ri\xEAng \u0111\u1EC3 \u0111i v\xE0
      v\u1EC1 th\xEC t\u1ED1t h\u01A1n nhi\u1EC1u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915459
    m_Localized: "N\u1EBFu \u0111\u1EB7t m\u1ECDi hy v\u1ECDng v\xE0o m\u1ED9t chi\u1EBFc
      thuy\u1EC1n, ch\u1EC9 c\u1EA7n nghe ti\u1EBFng n\xF3 k\u1EBDo k\u1EB9t l\xE0
      t\xF4i c\u0169ng c\u1EA7n \u0111\u01B0\u1EE3c ch\u1EEFa tr\u1ECB m\u1EA5t..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915460
    m_Localized: "Gi\u1EDD \u0111\xE3 lo \u0111\u01B0\u1EE3c thuy\u1EC1n quay v\u1EC1
      th\xEC ch\xFAng ta c\xF3 th\u1EC3 \u0111i \u0111\u1EBFn \u0111\u1EA3o trung
      t\xE2m r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915461
    m_Localized: "D\xF9 v\u1EADy, v\u1EABn ph\u1EA3i ti\u1EBFp t\u1EE5c gi\u1EEF
      l\u1ED1i v\xE0o b\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915462
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn \u0111ang \u0111i v\xF2ng quanh
      \u0111\u1EA3o trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915463
    m_Localized: "C\xF3 v\u1EBB n\xF3 kh\xF4ng th\u1EC3 tr\xE1nh h\xF2n \u0111\u1EA3o
      d\u01B0\u1EDBi n\u01B0\u1EDBc n\xEAn c\u1EE9 \u0111i v\xF2ng quanh m\u1ED9t
      ch\u1ED7."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915464
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng \u0111i th\u1EB3ng v\u1EC1 ph\xEDa b\u1EBFn
      \u0111\xE3 gi\u1EA3m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915465
    m_Localized: "Thay v\xE0o \u0111\xF3, nh\u1EEFng con s\xF3ng l\u1EDBn v\u1EABn
      ti\u1EBFp t\u1EE5c l\u1EB7p l\u1EA1i quanh \u0111\u1EA3o."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915466
    m_Localized: "Kh\xF3 kh\u1EB3ng \u0111\u1ECBnh \u0111\u1EA3o trung t\xE2m l\xE0
      nguy\xEAn nh\xE2n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915467
    m_Localized: "Nh\u01B0ng \u0111\xFAng l\xE0 ph\u1EA3n \u1EE9ng s\xE2u trong h\u1ED3
      h\u1ED9i t\u1EE5 m\u1EA1nh nh\u1EA5t \u1EDF \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915468
    m_Localized: "C\xF2n chuy\u1EC3n \u0111\u1ED9ng ph\xEDa b\u1EBFn th\xEC sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915469
    m_Localized: "Nh\xF3m \u0111i v\xE0o l\u1ED1i b\u1EBFn \u0111\xE3 gi\u1EA3m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915470
    m_Localized: "Nh\u01B0ng chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn ph\xEDa \u0111\u1EA3o
      trung t\xE2m v\u1EABn kh\xF4ng \u0111\u1ED5i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915471
    m_Localized: "Khi s\u1EEDa ch\u1EEFa xong, ng\u01B0\u1EDDi qu\u1EA3n l\xFD v\xE0
      l\xEDnh canh s\u1EBD c\xF3 th\u1EC3 gi\u1EEF \u0111\u01B0\u1EE3c ph\xEDa b\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915472
    m_Localized: "Ch\xFAng ta ph\u1EA3i ch\u1EB7n chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn
      \u1EDF \u0111\u1EA3o trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915473
    m_Localized: "V\u1EABn ch\u01B0a th\u1EC3 ch\u1EAFc ch\u1EAFn m\u1ECDi chuy\u1EC7n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915474
    m_Localized: "Nh\u01B0ng t\xF4i n\xF3i tr\u01B0\u1EDBc. T\xF4i ngh\u0129 chuy\u1EC3n
      \u0111\u1ED9ng quanh \u0111\u1EA3o trung t\xE2m s\u1EBD l\u1EDBn h\u01A1n n\u1EBFu
      ch\xFAng ta ch\u1EDD."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915475
    m_Localized: "\u1EEA. L\u1EA7n n\xE0y ch\u1EDD \u0111\u1EBFn khi ch\u1EAFc ch\u1EAFn
      l\u1EA1i nguy hi\u1EC3m h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915476
    m_Localized: "\xC2m thanh d\u01B0\u1EDBi n\u01B0\u1EDBc c\u1EE9 khi\u1EBFn t\xF4i
      b\u1EADn t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915477
    m_Localized: "...V\u1EDBi v\u1EBB m\u1EB7t \u0111\xF3 th\xEC c\u1EADu kh\xF4ng
      ch\u1EC9 \u0111ang nghe ti\u1EBFng n\u01B0\u1EDBc \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915478
    m_Localized: "...Chuy\u1EC7n nh\u01B0 v\u1EADy \u0111\xE3 t\u1EEBng x\u1EA3y
      ra. Tr\xEAn \u0111\u01B0\u1EDDng r\u1EEBng t\xF4i nghe th\u1EA5y m\u1ED9t \xE2m
      thanh r\u1EA5t nh\u1ECF, nh\u01B0ng l\u1EA1i ngh\u0129 m\xECnh ch\u01B0a th\u1EC3
      ch\u1EAFc ch\u1EAFn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915479
    m_Localized: "T\xF4i s\u1EE3 m\xECnh tr\xF4ng nh\u01B0 \u0111ang ho\u1EA3ng s\u1EE3
      v\xF4 c\u1EDB, n\xEAn \u0111\u1ECBnh quan s\xE1t th\xEAm m\u1ED9t ch\xFAt r\u1ED3i
      m\u1EDBi n\xF3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915480
    m_Localized: "Trong l\xFAc \u0111\xF3, qu\xE1i v\u1EADt lao ra t\u1EEB b\u1EE5i
      c\u1ECF. M\u1ED9t \u0111\u1EE9a tr\u1EBB \u0111i c\xF9ng t\xF4i \u0111\xE3
      b\u1ECB th\u01B0\u01A1ng n\u1EB7ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915481
    m_Localized: "\u0110\u1EE9a tr\u1EBB \u0111\xE3 s\u1ED1ng s\xF3t, nh\u01B0ng
      \xE2m thanh nh\u1ECF \u0111\u1EA7u ti\xEAn \u0111\xF3 v\u1EABn c\xF2n trong
      \u0111\u1EA7u t\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915482
    m_Localized: "V\xEC v\u1EADy \u0111\u1EBFn b\xE2y gi\u1EDD c\u01A1 th\u1EC3 t\xF4i
      v\u1EABn c\u1EE9ng \u0111\u1EDD tr\u01B0\u1EDBc ti\xEAn m\u1ED7i khi nghe th\u1EA5y
      \xE2m thanh l\u1EA1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915483
    m_Localized: "Nh\u01B0ng gi\u1EDD t\xF4i s\u1EBD kh\xF4ng gi\u1EA5u \u0111i trong
      l\xFAc c\u1EE9ng \u0111\u1EDD n\u1EEFa. D\xF9 ch\u01B0a ch\u1EAFc ch\u1EAFn,
      t\xF4i c\u0169ng s\u1EBD n\xF3i tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915484
    m_Localized: "N\u1EBFu sai th\xEC ch\xFAng ta ki\u1EC3m tra l\u1EA1i. V\u1EABn
      t\u1ED1t h\u01A1n l\xE0 n\xF3i qu\xE1 mu\u1ED9n r\u1ED3i \u0111\u1EC3 ai \u0111\xF3
      b\u1ECB th\u01B0\u01A1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915485
    m_Localized: "\u1EEA. \u0110i \u0111\u01B0\u1EDDng v\xF2ng v\xEC ph\xE1n \u0111o\xE1n
      sai th\xEC kh\xF4ng sao."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915486
    m_Localized: "T\xF4i gh\xE9t vi\u1EC7c ph\u1EA3i chuy\u1EC3n th\xEAm ng\u01B0\u1EDDi
      b\u1ECB th\u01B0\u01A1ng v\xEC ch\xFAng ta \u0111\u1EBFn qu\xE1 mu\u1ED9n h\u01A1n
      nhi\u1EC1u..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915487
    m_Localized: "Spayne, c\u1EADu \u0111\xE3 th\u1EA5y chuy\u1EC7n \u0111\xF3 nhi\u1EC1u
      r\u1ED3i ph\u1EA3i kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915488
    m_Localized: "\u1EEA. T\xF4i \u0111\xE3 th\u1EA5y nhi\u1EC1u, v\xE0 b\u1EA3n
      th\xE2n c\u0169ng \u0111\xE3 sai nhi\u1EC1u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915489
    m_Localized: "Tr\u01B0\u1EDBc \u0111\xE2y t\xF4i lu\xF4n c\u1ED1 ch\u1EEFa ngay
      t\u1EA5t c\u1EA3 nh\u1EEFng v\u1EBFt th\u01B0\u01A1ng nh\xECn th\u1EA5y tr\u01B0\u1EDBc
      m\u1EAFt."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915490
    m_Localized: "D\xF9 l\xE0 v\u1EBFt th\u01B0\u01A1ng nh\u1ECF c\u0169ng khi\u1EBFn
      t\xF4i b\u1EADn t\xE2m n\u1EBFu \u0111\u1EC3 l\u1EA1i, v\xE0 m\u1ECDi ng\u01B0\u1EDDi
      \u0111\u1EC1u y\xEAn t\xE2m h\u01A1n m\u1ED9t ch\xFAt khi th\u1EA5y t\xF4i
      di chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915491
    m_Localized: "V\xEC th\u1EBF ban \u0111\u1EA7u t\xF4i \u0111\xE3 d\xF9ng r\u1EA5t
      nhi\u1EC1u b\u0103ng g\u1EA1c v\xE0 t\xEDn hi\u1EC7u h\u1ED3i ph\u1EE5c. Khi
      \u0111\xF3 t\xF4i ngh\u0129 m\xECnh l\xE0m \u0111\xFAng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915492
    m_Localized: "Nh\u01B0ng khi \u0111\u1EE3t t\u1EA5n c\xF4ng l\u1EDBn h\u01A1n
      \u0111\u1EBFn, t\xF4i l\u1EA1i kh\xF4ng c\xF2n s\u1EE9c cho l\xFAc th\u1EADt
      s\u1EF1 c\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915493
    m_Localized: "T\xF4i mu\u1ED1n gi\xFAp t\u1EA5t c\u1EA3 nh\u1EEFng ng\u01B0\u1EDDi
      tr\u01B0\u1EDBc m\u1EAFt, nh\u01B0ng \u0111\u1EBFn khi m\u1ECDi ng\u01B0\u1EDDi
      c\xF9ng dao \u0111\u1ED9ng th\xEC t\xF4i \u0111\xE3 qu\xE1 mu\u1ED9n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915494
    m_Localized: "Sau \u0111\xF3, c\xE1ch t\xF4i ngh\u0129 \u0111\xE3 thay \u0111\u1ED5i
      m\u1ED9t ch\xFAt."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915495
    m_Localized: "Ch\u1EEFa tr\u1ECB kh\xF4ng ch\u1EC9 l\xE0 th\u1EE9 t\xF4i d\xF9ng
      ngay b\xE2y gi\u1EDD. \u0110\u1EC3 d\xE0nh l\u1EA1i \u0111\u1EC3 c\xF3 th\u1EC3
      d\xF9ng sau c\u0169ng l\xE0 ch\u1EEFa tr\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915496
    m_Localized: "V\u1EADy n\xEAn c\u1EADu m\u1EDBi t\xEDnh ri\xEAng thuy\u1EC1n
      \u0111i v\xE0o v\xE0 thuy\u1EC1n quay v\u1EC1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915497
    m_Localized: "\u1EEA. Ch\u1EC9 c\xF3 \u0111\u01B0\u1EDDng \u0111i v\xE0o th\xEC
      tr\xF4ng c\xF3 v\u1EBB d\u0169ng c\u1EA3m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915498
    m_Localized: "Nh\u01B0ng n\u1EBFu kh\xF4ng c\xF3 \u0111\u01B0\u1EDDng quay v\u1EC1
      th\xEC ngay c\u1EA3 ng\u01B0\u1EDDi ch\u1EEFa tr\u1ECB c\u0169ng b\u1ECB m\u1EAFc
      k\u1EB9t..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915499
    m_Localized: "V\u1EADy l\xE0 d\xF9 v\xE0o \u0111\u1EA3o trung t\xE2m c\u0169ng
      ph\u1EA3i ch\u1EEBa \u0111\u1EE7 kh\u1EA3 n\u0103ng quay v\u1EC1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915500
    m_Localized: "\u1EEA. N\u1EBFu c\u1EADu b\xE1o s\u1EDBm chuy\u1EC3n \u0111\u1ED9ng
      l\u1EA1, t\xF4i s\u1EBD ph\xE2n b\u1ED5 xem m\xECnh c\xF3 th\u1EC3 d\xF9ng
      \u0111\u1EBFn \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915501
    m_Localized: "Hi\u1EC3u r\u1ED3i. N\u1EBFu s\xF3ng thay \u0111\u1ED5i t\xF4i
      s\u1EBD b\xE1o ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915502
    m_Localized: "T\xF4i c\u0169ng s\u1EBD \u0111\u1EC3 d\xE0nh t\xEDn hi\u1EC7u
      h\u1ED3i ph\u1EE5c \u0111\u1EBFn cu\u1ED1i. Ch\u1EC9 d\xF9ng khi th\u1EADt
      s\u1EF1 c\u1EA7n th\xEC s\u1EBD \u0111\u1EE1 \u0111au h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915503
    m_Localized: "Thuy\u1EC1n \u0111\xE3 \u0111\u01B0\u1EE3c bu\u1ED9c, v\xE0 \u0111\u01B0\u1EDDng
      quay v\u1EC1 c\u0169ng c\xF2n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915504
    m_Localized: "Gi\u1EDD ch\u1EC9 c\u1EA7n \u0111\u1EBFn n\u01A1i t\xF4i gh\xE9t
      nh\u1EA5t th\xF4i..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915505
    m_Localized: "D\xF9 kh\xF4ng th\xEDch th\xEC \u0111i ngay v\u1EABn t\u1ED1t h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915506
    m_Localized: "N\u1EBFu ch\u1EDD \u0111\u1EBFn khi b\u1EBFn l\u1EA1i rung chuy\u1EC3n
      th\xEC s\u1EBD c\xE0ng phi\u1EC1n ph\u1EE9c h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915507
    m_Localized: "D\xF9 l\xE0 n\u01A1i gh\xE9t nh\u1EA5t th\xEC ch\xFAng ta v\u1EABn
      ph\u1EA3i \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915508
    m_Localized: "H\xE3y \u0111\u1EBFn \u0111\u1EA3o trung t\xE2m v\xE0 \u0111i \u0111\u1EBFn
      t\u1EADn c\xF9ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915509
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y di chuy\u1EC3n \u0111\u1EBFn \u0111\u1EA3o
      trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915510
    m_Localized: "H\xE3y ch\u1EB7n chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn v\xE0 xem
      ph\u1EA3n \u1EE9ng d\u01B0\u1EDBi h\u1ED3 d\u1EABn \u0111\u1EBFn \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915511
    m_Localized: "\u0110\u1EA3o trung t\xE2m h\u1ED3 Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915512
    m_Localized: "Nh\u1EEFng t\u1EA3ng \u0111\xE1 \u1EDF r\xECa \u0111\u1EA3o c\u0169ng
      c\xF2n d\u1EA5u n\u01B0\u1EDBc d\xE2ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915513
    m_Localized: "N\u01B0\u1EDBc kh\xF4ng ng\u1EADp m\u1ED9t l\u1EA7n, m\xE0 c\xF3
      v\u1EBB m\u1EF1c n\u01B0\u1EDBc \u0111\xE3 thay \u0111\u1ED5i nhi\u1EC1u l\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915514
    m_Localized: "S\xF3ng \u0111ang h\u1ED9i t\u1EE5 t\u1EEB b\xEAn ngo\xE0i \u0111\u1EA3o
      v\xE0o ph\xEDa trong."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915515
    m_Localized: "D\u1EA5u ch\xE2n c\u0169ng \u0111i v\xF2ng r\u1ED9ng \u0111\u1EC3
      tr\xE1nh trung t\xE2m \u0111\u1EA3o."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915516
    m_Localized: "\u0110\xE2y l\xE0 \u0111i\u1EC3m ph\u1EA3n \u1EE9ng c\u1EE7a h\u1ED3
      h\u1ED9i t\u1EE5."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915517
    m_Localized: "Nh\u01B0ng c\xF2n qu\xE1 s\u1EDBm \u0111\u1EC3 kh\u1EB3ng \u0111\u1ECBnh
      \u0111\xE2y l\xE0 \u0111i\u1EC3m b\u1EAFt \u0111\u1EA7u. C\xF3 v\u1EBB ph\u1EA3n
      \u1EE9ng n\u1ED1i ti\u1EBFp d\u01B0\u1EDBi n\u01B0\u1EDBc \u0111\xE3 l\u1ED9
      ra \u1EDF \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915518
    m_Localized: "V\u1EADy ch\u1EC9 ch\u1EB7n \u1EDF \u0111\xE2y c\u0169ng ch\u01B0a
      k\u1EBFt th\xFAc \u0111\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915519
    m_Localized: "D\xF9 v\u1EADy, b\xE2y gi\u1EDD ph\u1EA3i ch\u1EB7n nh\xF3m l\u1EDBn
      \u1EDF \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915520
    m_Localized: "V\xEC \u1EDF tr\xEAn \u0111\u1EA3o n\xEAn c\xF3 \xEDt \u0111\u01B0\u1EDDng
      \u0111\u1EC3 tr\u1ED1n tho\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915521
    m_Localized: "H\xE3y c\u1EE9 nh\u1EAFc nhau r\u1EB1ng thuy\u1EC1n \u0111\xE3
      \u0111\u01B0\u1EE3c bu\u1ED9c ch\u1EAFc. \u0110\xF3 l\xE0 tin t\u1ED1t nh\u1EA5t
      l\xFAc n\xE0y..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915522
    m_Localized: "C\xF3 m\u1ED9t k\xFD hi\u1EC7u c\u0169 b\xEAn d\u01B0\u1EDBi c\xF4ng
      tr\xECnh trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915523
    m_Localized: "C\xE1c k\xFD hi\u1EC7u v\xE0 d\u1EA5u ch\u1EC9 h\u01B0\u1EDBng
      c\u1EE7a n\xF3 gi\u1ED1ng v\u1EDBi nh\u1EEFng g\xEC c\xF2n l\u1EA1i tr\xEAn
      b\u1EA3ng ghi ch\xE9p \u1EDF m\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915524
    m_Localized: "B\u1EA3ng ghi ch\xE9p \u1EDF m\u1ECF ghi l\u1EA1i m\u1ED9t v\u1ECB
      tr\xED, c\xF2n n\u01A1i n\xE0y gi\u1ED1ng m\u1ED9t d\u1EA5u ch\u1EC9 \u0111\u1EC3
      l\u1EA1i h\u01B0\u1EDBng \u0111i h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915525
    m_Localized: "T\xF4i ngh\u0129 ph\u1EA3i xem c\u1EA3 hai c\xF9ng nhau m\u1EDBi
      th\u1EA5y \u0111\u01B0\u1EE3c v\u1ECB tr\xED ti\u1EBFp theo."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915526
    m_Localized: "C\xF3 ngh\u0129a l\xE0 n\xF3 n\u1ED1i v\u1EDBi ghi ch\xE9p v\u1ECB
      tr\xED Norua sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915527
    m_Localized: "Tr\u01B0\u1EDBc m\u1EAFt ch\u1EC9 c\xF3 th\u1EC3 n\xF3i ghi ch\xE9p
      v\xE0 d\u1EA5u ch\u1EC9 h\u01B0\u1EDBng kh\u1EDBp v\u1EDBi nhau."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915528
    m_Localized: "Nh\u01B0ng c\xF3 th\u1EC3 x\xE1c nh\u1EADn ph\u1EA3n \u1EE9ng b\xEAn
      d\u01B0\u1EDBi h\u1ED3 ti\u1EBFp t\u1EE5c d\u01B0\u1EDBi con \u0111\xEA ph\xEDa
      b\u1EAFc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915529
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn \u0111ang \u0111i v\xF2ng \u0111\u1EC3
      tr\xE1nh khu v\u1EF1c b\xEAn d\u01B0\u1EDBi c\xF4ng tr\xECnh."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915530
    m_Localized: "Nh\u1EEFng qu\xE1i v\u1EADt xung quanh c\u0169ng c\u1ED1 tho\xE1t
      ra ph\xEDa m\xE9p n\u01B0\u1EDBc nh\u01B0ng l\u1EA1i b\u1ECB d\u1ED3n v\xE0o
      trong \u0111\u1EA3o."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915531
    m_Localized: "V\u1EADy kh\xF4ng th\u1EC3 \u0111\u1EC3 ch\xFAng ch\u1EA1m v\xE0o
      c\xF4ng tr\xECnh trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915532
    m_Localized: "T\xF4i s\u1EBD ch\u1EB7n nh\xF3m \u0111i ra tr\u01B0\u1EDBc. H\xE3y
      \u0111\u1EC3 tr\u1ED1ng \u0111\u01B0\u1EDDng ph\xEDa thuy\u1EC1n!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915533
    m_Localized: "N\u1EBFu b\u1ECB th\u01B0\u01A1ng th\xEC r\xFAt v\u1EC1 ph\xEDa
      thuy\u1EC1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915534
    m_Localized: "N\u1EBFu ai \u0111\xF3 ng\xE3 qu\u1EF5 \u1EDF gi\u1EEFa \u0111\u1EA3o
      th\xEC c\u1EA3 ng\u01B0\u1EDDi khi\xEAng h\u1ECD c\u0169ng c\xF3 th\u1EC3 b\u1ECB
      \u01B0\u1EDBt theo..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915535
    m_Localized: "N\u1EBFu ph\u1EA3n \u1EE9ng b\xEAn d\u01B0\u1EDBi c\xF4ng tr\xECnh
      l\u1EDBn l\xEAn, t\xF4i s\u1EBD l\u1EADp t\u1EE9c th\u1EED \xE1p ch\u1EBF n\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915536
    m_Localized: "N\u1EBFu k\xE9o d\xE0i qu\xE1 l\xE2u th\xEC to\xE0n b\u1ED9 d\xF2ng
      n\u01B0\u1EDBc c\xF3 th\u1EC3 l\u1EA1i dao \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915537
    m_Localized: "Nh\xF3m \u0111i ra tr\u01B0\u1EDBc \u0111ang \u0111\u1EBFn trung
      t\xE2m \u0111\u1EA3o."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915538
    m_Localized: "Qu\xE1i v\u1EADt l\u1EDBn \u0111ang \u0111i v\xF2ng ph\xEDa sau
      ch\xFAng theo nh\u1EEFng con s\xF3ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915539
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n \u1EDF \u0111\u1EA3o trung
      t\xE2m h\u1ED3 Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915540
    m_Localized: "H\xE3y gi\u1EEF \u0111\u01B0\u1EDDng r\xFAt lui v\u1EC1 ph\xEDa
      thuy\u1EC1n v\xE0 ch\u1EB7n chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn tr\u01B0\u1EDBc
      khi n\xF3 lan ra d\xF2ng n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915541
    m_Localized: "Nh\xF3m l\u1EDBn \u0111\xE3 b\u1ECB ch\u1EB7n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915542
    m_Localized: "Ch\xFAng s\u1EBD kh\xF4ng l\u1EA1i tr\xE0n v\u1EC1 ph\xEDa b\u1EBFn
      \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915543
    m_Localized: "Ngay l\xFAc n\xE0y th\xEC ch\u01B0a."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915544
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng quanh h\u1ED3 c\u0169ng gi\u1EA3m r\xF5
      r\u1EC7t."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915545
    m_Localized: "Ph\u1EA3n \u1EE9ng tr\xEAn \u0111\u1EA3o trung t\xE2m c\u0169ng
      y\u1EBFu \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915546
    m_Localized: "Nh\u01B0ng ph\u1EA3n \u1EE9ng b\xEAn d\u01B0\u1EDBi c\xF4ng tr\xECnh
      \u0111i\u1EC1u ti\u1EBFt m\u1EF1c n\u01B0\u1EDBc v\u1EABn ti\u1EBFp t\u1EE5c
      d\u01B0\u1EDBi con \u0111\xEA ph\xEDa b\u1EAFc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915547
    m_Localized: "N\u1EBFu ph\u1EA3n \u1EE9ng k\u1EBFt th\xFAc tr\xEAn h\xF2n \u0111\u1EA3o
      n\xE0y th\xEC \xE1nh s\xE1ng \u0111\xE1ng l\u1EBD ph\u1EA3i t\u1EAFt ho\xE0n
      to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915548
    m_Localized: "Ph\xEDa b\u1EAFc l\xE0 h\u01B0\u1EDBng cao nguy\xEAn Norua sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915549
    m_Localized: "\u1EEA. H\u01B0\u1EDBng \u0111\xF3 kh\u1EDBp v\u1EDBi ghi ch\xE9p
      ch\xFAng ta \u0111\xE3 b\u1EA3o qu\u1EA3n \u1EDF m\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915550
    m_Localized: "Gi\u1EDD kh\xF4ng th\u1EC3 ch\u1EC9 c\u1EA5t ghi ch\xE9p v\u1ECB
      tr\xED `b\xEAn d\u01B0\u1EDBi h\xE0nh lang di t\xEDch cao nguy\xEAn Norua`
      n\u1EEFa."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915551
    m_Localized: "\u0110\u01B0\u1EDDng b\xEAn d\u01B0\u1EDBi h\u1ED3 c\u0169ng ti\u1EBFp
      t\u1EE5c v\u1EC1 ph\xEDa cao nguy\xEAn Norua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915552
    m_Localized: "N\xF3 gi\u1ED1ng d\u1EA5u hi\u1EC7u c\u1EE7a m\u1ED9t c\xF4ng tr\xECnh
      c\u0169 h\u01A1n l\xE0 m\u1ED9t d\xF2ng n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915553
    m_Localized: "Sau h\u1ED3 l\u1EA1i \u0111\u1EBFn cao nguy\xEAn sao..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915554
    m_Localized: "Sau khi b\u1ECB \u01B0\u1EDBt m\xE0 c\xF2n ph\u1EA3i leo l\xEAn
      n\u01A1i cao th\xEC l\u1ECBch tr\xECnh n\xE0y chu \u0111\xE1o qu\xE1 r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915555
    m_Localized: "D\xF9 v\u1EADy, ch\xFAng ta \u0111\xE3 b\u1EA3o v\u1EC7 \u0111\u01B0\u1EE3c
      Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915556
    m_Localized: "Ch\u1EC9 c\u1EA7n \u0111i theo con \u0111\u01B0\u1EDDng ti\u1EBFp
      theo th\xF4i!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915557
    m_Localized: "S\xF3ng g\u1EA7n b\u1EBFn v\xE0 ph\xEDa l\xE0ng c\u0169ng \u0111ang
      l\u1EAFng xu\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915558
    m_Localized: "Khi chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn \u1EDF \u0111\u1EA3o trung
      t\xE2m d\u1EEBng l\u1EA1i, to\xE0n b\u1ED9 h\u1ED3 c\xF3 v\u1EBB \u0111\xE3
      \u1ED5n \u0111\u1ECBnh h\u01A1n m\u1ED9t ch\xFAt."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915559
    m_Localized: "M\u1EF1c n\u01B0\u1EDBc ph\xEDa \u0111\u1EA7m l\u1EA7y lau s\u1EADy
      c\u0169ng \u0111ang t\u1EEB t\u1EEB h\u1EA1 xu\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915560
    m_Localized: "D\xE2n l\xE0ng c\xF3 l\u1EBD c\xF3 th\u1EC3 quay l\u1EA1i ph\xEDa
      trong l\xE0ng trong h\xF4m nay."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915561
    m_Localized: "V\u1EA5n \u0111\u1EC1 c\u1EE7a Milen s\u1EBD kh\xF4ng l\u1EADp
      t\u1EE9c nghi\xEAm tr\u1ECDng tr\u1EDF l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915562
    m_Localized: "Nh\u01B0ng n\u1EBFu kh\xF4ng ki\u1EC3m tra ph\u1EA3n \u1EE9ng v\u1EC1
      ph\xEDa Norua th\xEC chuy\u1EC7n t\u01B0\u01A1ng t\u1EF1 c\xF3 th\u1EC3 l\u1EA1i
      x\u1EA3y ra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915563
    m_Localized: "H\xE3y thu x\u1EBFp t\xECnh h\xECnh \u1EDF Milen r\u1ED3i di chuy\u1EC3n
      \u0111\u1EBFn l\u1ED1i v\xE0o cao nguy\xEAn Norua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915564
    m_Localized: "Ph\u1EA3i ki\u1EC3m tra n\u01A1i \u0111\u01B0\u1EE3c ghi ch\xE9p
      \u1EDF m\u1ECF v\xE0 c\xE1c d\u1EA5u ch\u1EC9 b\xEAn d\u01B0\u1EDBi h\u1ED3
      h\u01B0\u1EDBng \u0111\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915565
    m_Localized: "L\u1ED1i v\xE0o cao nguy\xEAn Norua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915566
    m_Localized: "C\xF3 d\u1EA5u \u01B0\u1EDBt tr\xEAn con \u0111\u01B0\u1EDDng \u0111\u1EA5t
      c\u1EE7a cao nguy\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915567
    m_Localized: "\u0110\xFAng l\xE0 ph\u1EA3n \u1EE9ng t\u1EEB h\u1ED3 \u0111\xE3
      d\xE2ng l\xEAn \u0111\u1EBFn t\u1EADn \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915568
    m_Localized: "Nh\u01B0ng \u0111\xE2y \u0111\xE2u ph\u1EA3i con \u0111\u01B0\u1EDDng
      n\u01B0\u1EDBc ch\u1EA3y qua..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915569
    m_Localized: "C\xF3 v\u1EBB ph\u1EA3n \u1EE9ng ma l\u1EF1c c\xF2n l\u1EA1i b\xEAn
      trong c\xE1c d\u1EA5u ch\u1EC9 \u0111\xE3 k\xE9o h\u01A1i \u1EA9m l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915570
    m_Localized: "V\u1EADy kh\xF4ng ph\u1EA3i n\u01B0\u1EDBc leo l\xEAn \u0111\u1ED3i,
      m\xE0 \xE1nh s\xE1ng \u0111\xE3 \u0111i theo con \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915571
    m_Localized: "\u0110i\u1EC1u \u0111\xF3 c\xF2n khi\u1EBFn t\xF4i kh\xF4ng y\xEAn
      t\xE2m h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915572
    m_Localized: "\xC1nh s\xE1ng \u0111\xE3 \u0111i \u0111\u1EBFn n\u01A1i cao h\u01A1n
      c\u1EA3 n\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915573
    m_Localized: "C\xF3 d\u1EA5u v\u1EBFt n\xE0o quay xu\u1ED1ng ph\xEDa Milen kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915574
    m_Localized: "C\xF3. Nh\u01B0ng kh\xF4ng nhi\u1EC1u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915575
    m_Localized: "H\u1EA7u h\u1EBFt l\xE0 d\u1EA5u v\u1EBFt cho th\u1EA5y ch\xFAng
      \u0111\u1ECBnh \u0111i s\xE2u h\u01A1n v\xE0o cao nguy\xEAn, r\u1ED3i quay
      l\u1EA1i g\u1EA7n l\u1ED1i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915576
    m_Localized: "Vi\u1EC7c quay l\u1EA1i c\xF3 th\u1EC3 c\xF3 ngh\u0129a l\xE0 ch\xFAng
      g\u1EB7p ph\u1EA3n \u1EE9ng m\u1EA1nh h\u01A1n \u1EDF b\xEAn trong."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915577
    m_Localized: "V\u1EADy tr\u01B0\u1EDBc h\u1EBFt ch\u1EB7n nh\xF3m \u0111ang \u0111\u1ECBnh
      \u0111i xu\u1ED1ng t\u1EEB l\u1ED1i v\xE0o cao nguy\xEAn v\u1EC1 ph\xEDa Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915578
    m_Localized: "N\u1EBFu b\u1ECB d\u1ED3n xu\u1ED1ng t\u1EEB n\u01A1i cao th\xEC
      s\u1EBD c\xF3 ng\u01B0\u1EDDi l\u0103n xu\u1ED1ng m\u1EA5t..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915579
    m_Localized: "C\u1EADu \u0111ang n\xF3i v\u1EC1 qu\xE1i v\u1EADt \u0111\xFAng
      kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915580
    m_Localized: "T\xF4i mong l\xE0 c\u1EADu kh\xF4ng n\xF3i v\u1EC1 ch\xFAng ta..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915581
    m_Localized: "C\xE1c c\u1ED9t \u0111\xE1 ph\xEDa trong cao nguy\xEAn \u0111\u01B0\u1EE3c
      \u0111\u1EB7t c\xE1ch \u0111\u1EC1u nhau."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915582
    m_Localized: "C\u0169ng c\xF2n nh\u1EEFng v\u1EBFt c\xE0o gi\u1EEFa c\xE1c c\u1ED9t."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915583
    m_Localized: "Ch\xFAng kh\xF4ng ph\u1EA3i \u0111\xE1 t\u1EF1 nhi\xEAn. G\u1EA7n
      gi\u1ED1ng d\u1EA5u ch\u1EC9 c\u1EE7a m\u1ED9t c\xF4ng tr\xECnh c\u0169 h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915584
    m_Localized: "C\xF3 v\u1EBB con \u0111\u01B0\u1EDDng m\xE0 b\u1EA3ng ghi ch\xE9p
      \u1EDF m\u1ECF v\xE0 d\u1EA5u ch\u1EC9 tr\xEAn \u0111\u1EA3o trung t\xE2m ch\u1EC9
      \u0111\u1EBFn ti\u1EBFp t\u1EE5c \u1EDF \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915585
    m_Localized: "V\u1EADy l\u1ED1i v\xE0o cao nguy\xEAn n\xE0y l\xE0 \u0111i\u1EC3m
      \u0111\u1EA7u ti\xEAn ch\xFAng ta c\xF3 th\u1EC3 x\xE1c nh\u1EADn ghi ch\xE9p
      Norua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915586
    m_Localized: "\u1EEA. Ch\u01B0a v\xE0o t\u1EADn b\xEAn d\u01B0\u1EDBi h\xE0nh
      lang, nh\u01B0ng h\u01B0\u1EDBng th\xEC \u0111\xFAng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915587
    m_Localized: "C\xF3 chuy\u1EC3n \u0111\u1ED9ng \u0111ang \u0111i xu\u1ED1ng t\u1EEB
      ph\xEDa trong."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915588
    m_Localized: "Ti\u1EBFng b\u01B0\u1EDBc ch\xE2n kh\xF4ng nh\u1EB9. T\xF4i nghe
      th\u1EA5y nhi\u1EC1u h\u01B0\u1EDBng ch\u1ED3ng l\xEAn nhau gi\u1EEFa c\xE1c
      t\u1EA3ng \u0111\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915589
    m_Localized: "Ch\u1ED7 h\u1EB9p s\u1EBD d\u1EC5 ch\u1EB7n t\u1EEB ph\xEDa tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915590
    m_Localized: "Nh\u01B0ng ph\u1EA3i \u0111\u1EC3 tr\u1ED1ng \u0111\u01B0\u1EDDng
      quay v\u1EC1 Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915591
    m_Localized: "H\xE3y k\u1EBFt th\xFAc tr\u01B0\u1EDBc khi ch\xFAng ta h\u1EBFt
      h\u01A1i..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915592
    m_Localized: "T\xF4i kh\xF4ng mu\u1ED1n v\u1EEBa l\xEAn cao nguy\xEAn \u0111\xE3
      ph\u1EA3i c\xF5ng ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915593
    m_Localized: "Ph\u1EA3n \u1EE9ng \u0111ang dao \u0111\u1ED9ng g\u1EA7n c\xE1c
      c\u1ED9t."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915594
    m_Localized: "C\xF3 v\u1EBB m\u1ED7i khi qu\xE1i v\u1EADt \u0111i qua th\xEC
      c\xE1c d\u1EA5u ch\u1EC9 c\u0169ng rung l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915595
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n \u1EDF l\u1ED1i v\xE0o cao
      nguy\xEAn Norua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915596
    m_Localized: "Ch\u1EB7n nh\xF3m \u0111\u1ECBnh \u0111i xu\u1ED1ng ph\xEDa Milen
      v\xE0 \u0111\u1EEBng ch\u1EA1m v\xE0o c\xE1c d\u1EA5u ch\u1EC9 b\xEAn trong."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915597
    m_Localized: "Nh\xF3m \u0111i xu\u1ED1ng tr\u01B0\u1EDBc \u0111ang \u0111\u1EBFn
      l\u1ED1i v\xE0o cao nguy\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915598
    m_Localized: "C\u0169ng c\xF3 chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn h\u01A1n ph\xEDa
      sau s\u1ED1ng \u0111\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915599
    m_Localized: "T\xF4i s\u1EBD \u0111\xF3n nh\xF3m \u0111i xu\u1ED1ng tr\u01B0\u1EDBc!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915600
    m_Localized: "\u0110\u1EEBng \u0111\u1EBFn qu\xE1 g\u1EA7n c\xE1c d\u1EA5u ch\u1EC9.
      Ph\u1EA3n \u1EE9ng c\xF3 th\u1EC3 b\xF9ng l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915601
    m_Localized: "C\u1EA3m \u01A1n v\xEC \u0111\xE3 b\xE1o tr\u01B0\u1EDBc..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915602
    m_Localized: "M\u1ECDi ng\u01B0\u1EDDi, chu\u1EA9n b\u1ECB chi\u1EBFn \u0111\u1EA5u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915603
    m_Localized: "\u0110\xE3 ch\u1EB7n nh\xF3m \u1EDF ph\xEDa l\u1ED1i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915604
    m_Localized: "Kh\xF4ng c\xF3 chuy\u1EC3n \u0111\u1ED9ng n\xE0o \u0111i xu\u1ED1ng
      ph\xEDa Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915605
    m_Localized: "Nh\u01B0ng d\u1EA5u ch\xE2n t\u1EA3n v\xE0o ph\xEDa trong \u0111\xE3
      r\xF5 h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915606
    m_Localized: "Ph\u1EA3n \u1EE9ng c\u1EE7a c\xE1c d\u1EA5u ch\u1EC9 c\u0169ng
      gi\u1EA3m m\u1ED9t ch\xFAt."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915607
    m_Localized: "\u0110\xFAng l\xE0 ch\xFAng rung l\xEAn m\u1ED7i khi qu\xE1i v\u1EADt
      \u0111i qua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915608
    m_Localized: "V\u1EADy c\xE1c d\u1EA5u ch\u1EC9 kh\xF4ng g\u1ECDi qu\xE1i v\u1EADt
      \u0111\u1EBFn sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915609
    m_Localized: "V\u1EABn c\xF2n qu\xE1 s\u1EDBm \u0111\u1EC3 n\xF3i v\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915610
    m_Localized: "Nh\u01B0ng ch\u1EAFc ch\u1EAFn qu\xE1i v\u1EADt v\xE0 c\xE1c d\u1EA5u
      ch\u1EC9 \u0111ang ch\u1ECBu \u1EA3nh h\u01B0\u1EDFng t\u1EEB c\xF9ng m\u1ED9t
      ph\u1EA3n \u1EE9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915611
    m_Localized: "C\xE0ng c\xF3 nhi\u1EC1u \u0111i\u1EC1u ch\u1EAFc ch\u1EAFn th\xEC
      t\xF4i c\xE0ng th\u1EA5y kh\xF4ng vui..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915612
    m_Localized: "H\xE3y s\u1EAFp x\u1EBFp ghi ch\xE9p \u1EDF l\u1ED1i v\xE0o cao
      nguy\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915613
    m_Localized: "Ph\u1EA3i ki\u1EC3m tra d\u1EA5u ch\u1EC9 ti\u1EBFp theo d\u1EABn
      \u0111i \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915614
    m_Localized: "C\xE1c c\u1ED9t \u0111\xE1 ti\u1EBFp t\u1EE5c v\u1EC1 ph\xEDa \u0110\u1ED3i
      Gi\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915615
    m_Localized: "\u0110\u01B0\u1EE3c. D\xF9 gi\xF3 c\xF3 th\u1ED5i c\u0169ng \u0111\u1EEBng
      b\u1ECF s\xF3t d\u1EA5u ch\u1EC9 m\xE0 \u0111i!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915616
    m_Localized: "L\u1ED1i v\xE0o cao nguy\xEAn Norua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915617
    m_Localized: "C\xE1c d\u1EA5u ch\u1EC9 \u1EDF l\u1ED1i v\xE0o kh\xF4ng ch\u1EC9
      \u0111\u01A1n gi\u1EA3n l\xE0 bi\u1EC3n ch\u1EC9 \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915618
    m_Localized: "M\u1ED7i c\u1ED9t \u0111\u1EC1u c\xF2n c\xF9ng m\u1ED9t hoa v\u0103n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915619
    m_Localized: "C\xE1c v\u1EBFt c\xE0o t\u1EADp trung \u1EDF ph\xEDa ngo\xE0i c\xE1c
      c\u1ED9t."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915620
    m_Localized: "C\xF3 v\u1EBB qu\xE1i v\u1EADt \u0111\xE3 xoay ng\u01B0\u1EDDi
      \u0111\u1EC3 tr\xE1nh nh\u1EEFng hoa v\u0103n \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915621
    m_Localized: "N\u1EBFu qu\xE1i v\u1EADt c\u0169ng gh\xE9t hoa v\u0103n \u0111\xF3
      th\xEC ch\u1EB3ng ph\u1EA3i t\u1ED1t cho ch\xFAng ta sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915622
    m_Localized: "Kh\xF4ng h\u1EB3n \u0111\xE2u..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535712915623
    m_Localized: "Qu\xE1i v\u1EADt c\u0169ng c\xF3 th\u1EC3 gh\xE9t m\u1ED9t lo\u1EA1i
      thu\u1ED1c nguy hi\u1EC3m m\xE0."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109760
    m_Localized: "\u0110\xFAng v\u1EADy. Ch\u1EC9 v\xEC ch\xFAng tr\xE1nh n\xF3 kh\xF4ng
      c\xF3 ngh\u0129a l\xE0 n\xF3 an to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109761
    m_Localized: "C\xF3 th\u1EC3 ki\u1EC3m tra ph\u1EA3n \u1EE9ng c\u1EE7a hoa v\u0103n
      b\u1EB1ng \u0111\xE1 t\xEDn hi\u1EC7u kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109762
    m_Localized: "C\xF3 th\u1EC3. Nh\u01B0ng t\xF4i s\u1EBD kh\xF4ng \u0111\u1EC3
      ch\xFAng k\u1EBFt n\u1ED1i tr\u1EF1c ti\u1EBFp."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109763
    m_Localized: "N\u1EBFu ch\u1EA1m v\xE0o b\u1EA3n th\xE2n d\u1EA5u ch\u1EC9 th\xEC
      ghi ch\xE9p c\xF3 th\u1EC3 b\u1ECB x\xE1o tr\u1ED9n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109764
    m_Localized: "Ch\u1EC9 \u0111\u1ECDc ghi ch\xE9p th\xF4i, c\xF2n \u0111\xE1 t\xEDn
      hi\u1EC7u ph\xEDa H\u1ED9 V\u1EC7 th\xEC \u0111i\u1EC1u ch\u1EC9nh ri\xEAng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109765
    m_Localized: "D\u1EA5u ch\u1EC9 ph\xEDa \u0110\u1ED3i Gi\xF3 s\xE1ng h\u01A1n
      r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109766
    m_Localized: "C\xF3 v\u1EBB ph\u1EA3n \u1EE9ng \u0111\xE3 di chuy\u1EC3n sau
      tr\u1EADn chi\u1EBFn v\u1EEBa r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109767
    m_Localized: "V\u1EADy ti\u1EBFp theo l\xE0 \u0110\u1ED3i Gi\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109768
    m_Localized: "N\u1EBFu gi\xF3 m\u1EA1nh th\xEC qu\xE1i v\u1EADt c\u0169ng s\u1EBD
      lo\u1EA1ng cho\u1EA1ng nh\u1EC9?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109769
    m_Localized: "C\xE2u \u0111\xF3 c\u0169ng c\xF3 ngh\u0129a l\xE0 ch\xFAng ta
      s\u1EBD lo\u1EA1ng cho\u1EA1ng..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109770
    m_Localized: "Tr\xEAn cao nguy\xEAn, gi\xF3 c\xF3 th\u1EC3 l\xE0m \xE2m thanh
      v\xE0 d\u1EA5u v\u1EBFt b\u1ECB x\xE1o tr\u1ED9n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109771
    m_Localized: "H\xE3y di chuy\u1EC3n ch\u1EADm, l\u1EA5y nh\u1EEFng d\u1EA5u ch\u1EC9
      Noah \u0111\xE3 x\xE1c nh\u1EADn l\xE0m m\u1ED1c."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109772
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y s\u1EAFp x\u1EBFp ghi ch\xE9p tr\u1EADn
      chi\u1EBFn \u1EDF l\u1ED1i v\xE0o cao nguy\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109773
    m_Localized: "Ho\xE0n t\u1EA5t \u0111i\u1EC1u ch\u1EC9nh c\u01B0\u1EDDng h\xF3a
      r\u1ED3i di chuy\u1EC3n \u0111\u1EBFn \u0110\u1ED3i Gi\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109774
    m_Localized: "T\xF4i s\u1EBD quan s\xE1t ph\xEDa tr\u01B0\u1EDBc \u1EDF con \u0111\u01B0\u1EDDng
      ti\u1EBFp theo n\u1EEFa!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109775
    m_Localized: "Quan s\xE1t ph\xEDa tr\u01B0\u1EDBc th\xEC \u0111\u01B0\u1EE3c,
      nh\u01B0ng \u0111\u1EEBng \u0111\u1EBFn g\u1EA7n v\xE1ch \u0111\xE1..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109776
    m_Localized: "D\u1EA5u ch\u1EC9 ph\xEDa \u0110\u1ED3i Gi\xF3 l\u1EA1i s\xE1ng
      l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109777
    m_Localized: "\u0110\u1ED3i Gi\xF3 Norua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109778
    m_Localized: "Gi\xF3 l\xE0m ti\u1EBFng b\u01B0\u1EDBc ch\xE2n t\u1EA3n ra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109779
    m_Localized: "D\xF9 v\u1EADy, h\u01B0\u1EDBng b\u1ECB l\xFAn tr\xEAn \u0111\u1EA5t
      v\u1EABn c\xF2n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109780
    m_Localized: "C\xE1c d\u1EA5u ch\u1EC9 ti\u1EBFp t\u1EE5c d\u1ECDc theo s\u1ED1ng
      n\xFAi tr\xEAn \u0111\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109781
    m_Localized: "\u0110\xE2y kh\xF4ng ph\u1EA3i con \u0111\u01B0\u1EDDng tr\xE1nh
      gi\xF3, m\xE0 l\xE0 n\u01A1i gi\xF3 h\u1ED9i t\u1EE5."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109782
    m_Localized: "Con \u0111\u01B0\u1EDDng gi\xF3 h\u1ED9i t\u1EE5 kh\xF4ng c\xF3
      v\u1EBB t\u1ED1t \u0111\u1EC3 chi\u1EBFn \u0111\u1EA5u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109783
    m_Localized: "Ngay c\u1EA3 th\u1EDF c\u0169ng c\xF3 v\u1EBB s\u1EBD th\xE0nh
      vi\u1EC7c..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109784
    m_Localized: "\u0110\xE3 x\xE1c nh\u1EADn \u0111\u01B0\u1EDDng quay v\u1EC1 ph\xEDa
      Milen ch\u01B0a?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109785
    m_Localized: "Kh\xF4ng c\xF3 chuy\u1EC3n \u0111\u1ED9ng tr\xEAn \u0111\u01B0\u1EDDng
      quay v\u1EC1 Milen."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109786
    m_Localized: "Qu\xE1i v\u1EADt \u0111ang \u0111i v\xF2ng b\xEAn s\u01B0\u1EDDn
      \u0111\u1ED3i thay v\xEC \u0111i xu\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109787
    m_Localized: "C\xF3 v\u1EBB ch\xFAng tr\xE1nh ph\u1EA3n \u1EE9ng s\xE2u trong
      cao nguy\xEAn nh\u01B0ng v\u1EABn kh\xF4ng th\u1EC3 r\u1EDDi kh\u1ECFi khu
      v\u1EF1c quanh d\u1EA5u ch\u1EC9."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109788
    m_Localized: "Mu\u1ED1n tho\xE1t ra m\xE0 kh\xF4ng tho\xE1t \u0111\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109789
    m_Localized: "V\u1EADy ph\u1EA3i ch\u1EB7n \u1EDF \u0110\u1ED3i Gi\xF3 \u0111\u1EC3
      ch\xFAng kh\xF4ng t\u1EA3n ra th\xEAm."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109790
    m_Localized: "\u0110\u1ED3i r\u1ED9ng n\xEAn kh\xF3 x\xE1c \u0111\u1ECBnh ph\u1EA1m
      vi c\u1EA7n gi\u1EEF."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109791
    m_Localized: "N\u1EBFu ch\xFAng t\u1EA3n ra th\xEC vi\u1EC7c t\xECm ng\u01B0\u1EDDi
      b\u1ECB th\u01B0\u01A1ng c\u0169ng kh\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109792
    m_Localized: "C\u1ECF b\xEAn tr\xE1i b\u1ECB \u0111\xE8 b\u1EB9p."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109793
    m_Localized: "\u0110\xE2y kh\xF4ng ph\u1EA3i d\u1EA5u v\u1EBFt ch\u1EA1y. C\xF3
      th\u1EE9 g\xEC \u0111\xF3 \u0111\xE3 h\u1EA1 th\u1EA5p ng\u01B0\u1EDDi \u0111\u1EC3
      ch\u1ED1ng l\u1EA1i gi\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109794
    m_Localized: "Gi\xF3 g\u1EA7n nh\u1EEFng hoa v\u0103n kh\xF4ng \u1ED5n \u0111\u1ECBnh."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109795
    m_Localized: "N\u1EBFu l\xE0 gi\xF3 t\u1EF1 nhi\xEAn th\xEC n\xF3 s\u1EBD kh\xF4ng
      ng\u1EAFt qu\xE3ng r\u1ED3i quay l\u1EA1i nh\u01B0 th\u1EBF n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109796
    m_Localized: "C\xF3 kh\u1EA3 n\u0103ng \u0111\xE2y l\xE0 ph\u1EA3n \u1EE9ng t\u1EEB
      m\u1ED9t thi\u1EBFt b\u1ECB g\u1EA7n khu di t\xEDch kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109797
    m_Localized: "C\xF3 kh\u1EA3 n\u0103ng. Nh\u01B0ng v\u1EABn ch\u01B0a \u0111\u1EBFn
      m\u1EE9c kh\u1EB3ng \u0111\u1ECBnh \u0111\xF3 l\xE0 m\u1ED9t thi\u1EBFt b\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109798
    m_Localized: "C\u1EE9 \u0111\u1EC3 vi\u1EC7c x\xE1c \u0111\u1ECBnh sau. Tr\u01B0\u1EDBc
      m\u1EAFt h\xE3y ch\u1EB7n th\u1EE9 \u0111ang \u0111\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109799
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng \u0111ang \u0111i xu\u1ED1ng t\u1EEB
      ph\xEDa b\xEAn kia s\u1ED1ng n\xFAi \u0110\u1ED3i Gi\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109800
    m_Localized: "Ch\xFAng \u0111\u1EBFn theo nhi\u1EC1u h\u01B0\u1EDBng nh\u01B0ng
      \u0111ang b\u1ECB d\u1ED3n v\u1EC1 c\xF9ng m\u1ED9t ph\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109801
    m_Localized: "Ti\u1EBFng gi\xF3 khi\u1EBFn c\u1EA3m gi\xE1c v\u1EC1 kho\u1EA3ng
      c\xE1ch b\u1ECB sai l\u1EC7ch..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109802
    m_Localized: "\xC2m thanh t\u01B0\u1EDFng g\u1EA7n l\u1EA1i \u1EDF xa, c\xF2n
      \xE2m thanh t\u01B0\u1EDFng xa l\u1EA1i \u1EDF g\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109803
    m_Localized: "\u0110\u1EEBng \u0111\u1EE9ng gi\u1EEFa c\xE1c d\u1EA5u ch\u1EC9."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109804
    m_Localized: "Ph\u1EA3n \u1EE9ng b\xF9ng l\xEAn khi gi\xF3 l\xF9a qua gi\u1EEFa
      c\xE1c hoa v\u0103n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109805
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n \u1EDF ch\xE2n \u0110\u1ED3i
      Gi\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109806
    m_Localized: "H\xE3y \u0111\u1EC3 tr\u1ED1ng con \u0111\u01B0\u1EDDng gi\u1EEFa
      c\xE1c d\u1EA5u ch\u1EC9 v\xE0 ch\u1EB7n nh\xF3m \u0111i xu\u1ED1ng t\u1EEB
      s\u1ED1ng n\xFAi."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109807
    m_Localized: "\u1EEA. D\xF9 gi\xF3 c\xF3 \u0111\u1EA9y th\xEC t\xF4i c\u0169ng
      s\u1EBD gi\u1EEF \u1EDF ch\xE2n \u0111\u1ED3i!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109808
    m_Localized: "Nh\xF3m \u0111i xu\u1ED1ng tr\u01B0\u1EDBc s\u1EBD s\u1EDBm \u0111\u1EBFn
      ch\xE2n \u0111\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109809
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn h\u01A1n v\u1EABn c\xF2n \u1EDF
      tr\xEAn s\u1ED1ng n\xFAi."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109810
    m_Localized: "Ph\xEDa d\u01B0\u1EDBi \u0111\u1ED3i \u0111\xE3 \u0111\u01B0\u1EE3c
      d\u1ECDn r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109811
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn \u0111\xE3 l\xF9i s\xE2u h\u01A1n
      v\xE0o trong."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109812
    m_Localized: "Kh\xF4ng gi\u1ED1ng b\u1ECF ch\u1EA1y, c\xF3 v\u1EBB n\xF3 b\u1ECB
      k\xE9o v\u1EC1 ph\xEDa d\u1EA5u ch\u1EC9 s\xE1ng h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109813
    m_Localized: "Gi\xF3 v\u1EEBa thay \u0111\u1ED5i c\xF9ng v\u1EDBi chuy\u1EC3n
      \u0111\u1ED9ng c\u1EE7a qu\xE1i v\u1EADt."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109814
    m_Localized: "Kh\xF4ng gi\u1ED1ng t\u1EA1o ra gi\xF3, c\xF3 th\u1EC3 c\xE1c d\u1EA5u
      ch\u1EC9 \u0111\u01B0\u1EE3c c\u1EA5u t\u1EA1o \u0111\u1EC3 lu\u1ED3ng gi\xF3
      mang theo ph\u1EA3n \u1EE9ng c\u1EE7a ch\xFAng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109815
    m_Localized: "C\xF3 ngh\u0129a l\xE0 lu\u1ED3ng gi\xF3 d\u1EABn ra ngo\xE0i khu
      di t\xEDch sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109816
    m_Localized: "\u1EEA. Kh\u1EA3 n\u0103ng cao l\xE0 c\xF3 m\u1ED9t t\u1EA5m bia
      kh\u1EAFc l\u1EDBn h\u01A1n \u1EDF ph\xEDa b\xEAn kia s\u1ED1ng n\xFAi."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109817
    m_Localized: "Gi\xF3 d\u1EABn \u0111\u01B0\u1EDDng c\u0169ng ti\u1EC7n th\u1EADt,
      nh\u01B0ng..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109818
    m_Localized: "C\xF3 v\u1EBB kh\xF4ng ch\u1EC9 ch\xFAng ta \u0111\u01B0\u1EE3c
      d\u1EABn \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109819
    m_Localized: "D\xF9 v\u1EADy, h\u01B0\u1EDBng \u0111i \u0111\xE3 r\xF5 r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109820
    m_Localized: "D\xF9 gi\xF3 c\xF3 \u0111\u1EA9y, ch\xFAng ta ch\u1EC9 c\u1EA7n
      \u0111\u1EBFn tr\u01B0\u1EDBc r\u1ED3i ch\u1EB7n ch\xFAng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109821
    m_Localized: "T\xF4i nh\xECn th\u1EA5y m\u1ED9t phi\u1EBFn \u0111\xE1 v\u1EE1
      ph\xEDa tr\xEAn s\u1ED1ng n\xFAi."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109822
    m_Localized: "Hoa v\u0103n tr\xEAn \u0111\xF3 c\u0169ng l\u1EDBn h\u01A1n c\xE1c
      d\u1EA5u ch\u1EC9 tr\xEAn c\u1ED9t \u1EDF l\u1ED1i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109823
    m_Localized: "\u0110\xF3 h\u1EB3n l\xE0 t\u1EA5m bia kh\u1EAFc \u1EDF ngo\u1EA1i
      vi khu di t\xEDch."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109824
    m_Localized: "H\xE3y di chuy\u1EC3n \u0111\u1EBFn ngo\u1EA1i vi khu di t\xEDch."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109825
    m_Localized: "Ph\u1EA3i ki\u1EC3m tra t\u1EA5m bia kh\u1EAFc n\u1ED1i v\u1EDBi
      ph\u1EA3n \u1EE9ng tr\xEAn cao nguy\xEAn nh\u01B0 th\u1EBF n\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109826
    m_Localized: "Ngo\u1EA1i vi di t\xEDch c\u1ED5 Norua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109827
    m_Localized: "T\u1EA5m bia kh\u1EAFc \u0111\xF3 c\xF9ng h\u1EC7 th\u1ED1ng v\u1EDBi
      nh\u1EEFng d\u1EA5u ch\u1EC9 \u1EDF l\u1ED1i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109828
    m_Localized: "Ph\u1EA3n \u1EE9ng lan r\u1ED9ng h\u01A1n theo k\xEDch th\u01B0\u1EDBc
      c\u1EE7a n\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109829
    m_Localized: "D\u1EA5u ch\xE2n \u0111i v\xF2ng r\u1ED9ng b\xEAn ngo\xE0i t\u1EA5m
      bia."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109830
    m_Localized: "C\xF3 d\u1EA5u v\u1EBFt \u0111\u1EBFn g\u1EA7n, nh\u01B0ng kh\xF4ng
      c\xF3 d\u1EA5u v\u1EBFt gi\u1EABm l\xEAn trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109831
    m_Localized: "Qu\xE1i v\u1EADt \u0111\xE3 c\u1ED1 \xFD tr\xE1nh n\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109832
    m_Localized: "V\u1EADy ch\xFAng ta c\u0169ng n\xEAn tr\xE1nh khu trung t\xE2m..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109833
    m_Localized: "N\xF3 c\xF3 c\xF9ng hoa v\u0103n v\u1EDBi b\u1EA3ng ghi ch\xE9p
      trong m\u1ECF kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109834
    m_Localized: "Kh\xF4ng ho\xE0n to\xE0n gi\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109835
    m_Localized: "B\u1EA3ng ghi ch\xE9p trong m\u1ECF l\u01B0u l\u1EA1i m\u1ED9t
      v\u1ECB tr\xED, c\xF2n \u0111\xE2y gi\u1ED1ng m\u1ED9t t\u1EA5m b\u1EA3ng th\u1EF1c
      s\u1EF1 ti\u1EBFp nh\u1EADn ph\u1EA3n \u1EE9ng h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109836
    m_Localized: "B\u1EE5i b\u1ECB gi\xF3 th\u1ED5i t\u1EEB \u0110\u1ED3i Gi\xF3
      \u0111\xE3 t\xEDch t\u1EE5 trong c\xE1c r\xE3nh c\u1EE7a hoa v\u0103n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109837
    m_Localized: "R\xF5 r\xE0ng n\u01A1i n\xE0y \u0111\xE3 b\u1ECB b\u1ECF hoang
      t\u1EEB l\xE2u, nh\u01B0ng v\u1EABn c\xF3 d\u1EA5u hi\u1EC7u v\u1EEBa m\u1EDBi
      d\u1ECBch chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109838
    m_Localized: "Gi\u1EDD \u0111\xE3 r\xF5 c\xE1c d\u1EA5u ch\u1EC9 b\xEAn d\u01B0\u1EDBi
      h\u1ED3 ti\u1EBFp t\u1EE5c \u0111\u1EBFn t\u1EADn \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109839
    m_Localized: "Nh\u01B0ng v\u1EABn ph\u1EA3i ki\u1EC3m tra th\xEAm xem khu di
      t\xEDch n\xE0y c\xF3 ph\u1EA3i \u0111i\u1EC3m b\u1EAFt \u0111\u1EA7u c\u1EE7a
      m\u1ECDi ph\u1EA3n \u1EE9ng kh\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109840
    m_Localized: "V\u1EADy v\u1EABn c\xF2n qu\xE1 s\u1EDBm \u0111\u1EC3 kh\u1EB3ng
      \u0111\u1ECBnh \u0111\xE2y l\xE0 \u0111i\u1EC3m b\u1EAFt \u0111\u1EA7u sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109841
    m_Localized: "\u1EEA. L\u1EA7n n\xE0y ph\u1EA3i th\u1EADt s\u1EF1 c\u1EA9n th\u1EADn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109842
    m_Localized: "C\u1EA9n th\u1EADn l\xE0 t\u1ED1t, nh\u01B0ng..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109843
    m_Localized: "L\u1EA7n n\xE0o c\xF3 ng\u01B0\u1EDDi b\u1EA3o ph\u1EA3i c\u1EA9n
      th\u1EADn th\xEC sau \u0111\xF3 m\u1ECDi chuy\u1EC7n c\u0169ng nguy hi\u1EC3m
      h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109844
    m_Localized: "C\xF3 chuy\u1EC3n \u0111\u1ED9ng ph\xEDa sau b\u1EE9c t\u01B0\u1EDDng
      s\u1EE5p b\xEAn ph\u1EA3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109845
    m_Localized: "N\xF3 \u0111ang v\xF2ng v\u1EC1 ph\xEDa ch\xFAng ta \u0111\u1EC3
      tr\xE1nh t\u1EA5m bia kh\u1EAFc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109846
    m_Localized: "M\u1EE5c ti\xEAu c\u1EE7a ch\xFAng ta l\xE0 b\u1EA3o v\u1EC7 t\u1EA5m
      bia hay gi\u1EEF cho con \u0111\u01B0\u1EDDng th\xF4ng tho\xE1ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109847
    m_Localized: "C\u1EA3 hai."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109848
    m_Localized: "N\u1EBFu qu\xE1i v\u1EADt ch\u1EA1m v\xE0o t\u1EA5m bia th\xEC
      ph\u1EA3n \u1EE9ng c\xF3 th\u1EC3 m\u1EA1nh l\xEAn, c\xF2n n\u1EBFu m\u1EA5t
      \u0111\u01B0\u1EDDng th\xEC ch\xFAng ta kh\xF4ng th\u1EC3 v\xE0o h\xE0nh lang."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109849
    m_Localized: "V\u1EADy h\xE3y ch\u1EB7n kh\xF4ng cho ch\xFAng ch\u1EA1m v\xE0o
      t\u1EA5m bia v\xE0 gi\u1EEF th\xF4ng tho\xE1ng con \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109850
    m_Localized: "Kho\u1EA3ng gi\u1EEFa nh\u1EEFng b\u1EE9c t\u01B0\u1EDDng \u0111\xE1
      ngo\xE0i kh\xE1 h\u1EB9p."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109851
    m_Localized: "Nh\xF3m ph\xEDa b\xEAn kia t\u01B0\u1EDDng \u0111\xE1 \u0111ang
      ti\u1EBFn \u0111\u1EBFn kho\u1EA3ng h\u1EB9p \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109852
    m_Localized: "N\u1EBFu t\u01B0\u1EDDng \u0111\xE1 s\u1EE5p th\xEC \u0111\u01B0\u1EDDng
      r\xFAt lui c\u0169ng b\u1ECB ch\u1EB7n..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109853
    m_Localized: "L\u1EA7n n\xE0y th\u1EE9 ch\xFAng ta c\xF3 th\u1EC3 ng\xE3 l\xEAn
      kh\xF4ng ph\u1EA3i n\u01B0\u1EDBc m\xE0 l\xE0 \u0111\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109854
    m_Localized: "T\xF4i gh\xE9t c\u1EA3 hai, n\xEAn mau ch\u1EB7n ch\xFAng th\xF4i!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109855
    m_Localized: "M\u1ED9t r\xE3nh nh\u1ECF b\xEAn tr\xE1i t\u1EA5m bia kh\u1EAFc
      ch\u1EC9 v\u1EC1 ph\xEDa h\xE0nh lang."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109856
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n \u1EDF ngo\u1EA1i vi khu
      di t\xEDch."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109857
    m_Localized: "\u0110\u1EEBng ch\u1EA1m v\xE0o t\u1EA5m bia kh\u1EAFc. H\xE3y
      \u0111\u1EA3m b\u1EA3o con \u0111\u01B0\u1EDDng \u0111\u1EBFn l\u1ED1i v\xE0o
      h\xE0nh lang."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109858
    m_Localized: "Nh\xF3m \u0111i ra tr\u01B0\u1EDBc \u0111ang ti\u1EBFn v\xE0o gi\u1EEFa
      nh\u1EEFng b\u1EE9c t\u01B0\u1EDDng \u0111\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109859
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn h\u01A1n \u0111ang \u0111i
      v\xF2ng b\xEAn ngo\xE0i t\u1EA5m bia kh\u1EAFc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109860
    m_Localized: "\u0110\xE3 gi\u1EEF \u0111\u01B0\u1EE3c ph\xEDa ngo\u1EA1i vi!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109861
    m_Localized: "Kh\xF4ng ch\u1EA1m v\xE0o trung t\xE2m t\u1EA5m bia kh\u1EAFc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109862
    m_Localized: "Nh\u01B0ng c\xE1c r\xE3nh b\xEAn ngo\xE0i s\xE1ng h\u01A1n r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109863
    m_Localized: "Kh\xF4ng ph\u1EA3i do ch\u1EA5n \u0111\u1ED9ng tr\u1EADn chi\u1EBFn,
      m\xE0 l\xE0 ph\u1EA3n \u1EE9ng d\xE2ng l\xEAn t\u1EEB b\xEAn trong h\xE0nh
      lang."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109864
    m_Localized: "T\u1EA5m n\xE0y c\xF3 v\u1EBB kh\xF4ng ph\u1EA3i thi\u1EBFt b\u1ECB
      ch\u1EB7n \u0111\u01B0\u1EDDng, m\xE0 l\xE0 m\u1ED9t b\u1EA3ng ti\u1EBFp nh\u1EADn
      v\xE0 hi\u1EC3n th\u1ECB ph\u1EA3n \u1EE9ng c\u1EE7a h\xE0nh lang."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109865
    m_Localized: "Ph\xEDa trong h\xE0nh lang l\xE0 \u0111i\u1EC3m tr\u1EF1c ti\u1EBFp
      h\u01A1n sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109866
    m_Localized: "\u1EEA. \xCDt nh\u1EA5t n\xF3 g\u1EA7n trung t\xE2m h\u01A1n n\u01A1i
      n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109867
    m_Localized: "V\u1EADy l\xE0 gi\u1EDD ch\xFAng ta th\u1EADt s\u1EF1 \u0111i v\xE0o
      b\xEAn trong r\u1ED3i..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109868
    m_Localized: "T\xF4i \u0111\xE3 b\u1EAFt \u0111\u1EA7u nh\u1EDB ph\xEDa ngo\xE0i
      khu di t\xEDch r\u1ED3i..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109869
    m_Localized: "Kh\xF4ng sao. B\xEAn trong s\u1EBD h\u1EB9p h\u01A1n, n\xEAn c\xF3
      l\u1EBD s\u1EBD d\u1EC5 ch\u1EB7n ch\xFAng h\u01A1n!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109870
    m_Localized: "Sau nh\u1EEFng c\xE2u nh\u01B0 v\u1EADy th\u01B0\u1EDDng ch\u1EB3ng
      c\xF3 chuy\u1EC7n g\xEC t\u1ED1t c\u1EA3..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109871
    m_Localized: "C\xF3 ti\u1EBFng v\u1ECDng tr\u1EA7m t\u1EEB l\u1ED1i v\xE0o h\xE0nh
      lang."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109872
    m_Localized: "N\xF3 kh\xF4ng l\u1EABn v\u1EDBi ti\u1EBFng b\u01B0\u1EDBc ch\xE2n.
      \xC2m thanh \u0111\xF3 \u0111\u1EBFn t\u1EEB ph\xEDa thi\u1EBFt b\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109873
    m_Localized: "T\u1EEB \u0111\xE2y, c\xE1c thi\u1EBFt b\u1ECB ph\xF2ng th\u1EE7
      c\u1EE7a khu di t\xEDch c\u0169ng c\xF3 th\u1EC3 ph\u1EA3n \u1EE9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109874
    m_Localized: "H\xE3y ki\u1EC3m tra l\u1ED1i v\xE0o h\xE0nh lang."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109875
    m_Localized: "Ph\u1EA3i \u0111\u1EA3m b\u1EA3o con \u0111\u01B0\u1EDDng b\xEAn
      trong tr\u01B0\u1EDBc khi chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109876
    m_Localized: "H\xE0nh lang di t\xEDch Norua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109877
    m_Localized: "\u0110\xE1y h\xE0nh lang b\xEAn trong c\xF3 nhi\u1EC1u d\u1EA5u
      ch\xE2n ch\u1ED3ng l\xEAn nhau."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109878
    m_Localized: "Kh\xF4ng ch\u1EC9 qu\xE1i v\u1EADt, c\xF2n c\xF3 d\u1EA5u v\u1EBFt
      cho th\u1EA5y n\u1EC1n \u0111\xE1 c\u0169ng \u0111\xE3 chuy\u1EC3n \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109879
    m_Localized: "C\xE1c thi\u1EBFt b\u1ECB ph\xF2ng th\u1EE7 v\u1EABn ch\u01B0a
      ho\xE0n to\xE0n ng\u1EEBng ho\u1EA1t \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109880
    m_Localized: "Kh\xF4ng c\xF3 d\u1EA5u v\u1EBFt \u0111\u01B0\u1EE3c s\u1EEDa ch\u1EEFa
      g\u1EA7n \u0111\xE2y. Ch\xFAng \u0111ang th\u1EC9nh tho\u1EA3ng ho\u1EA1t \u0111\u1ED9ng
      ch\u1EC9 b\u1EB1ng ph\u1EA3n \u1EE9ng c\xF2n l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109881
    m_Localized: "V\u1EADy b\u1EA3n th\xE2n con \u0111\u01B0\u1EDDng c\u0169ng c\xF3
      th\u1EC3 chuy\u1EC3n \u0111\u1ED9ng sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109882
    m_Localized: "N\u1EBFu n\xF3 l\xE0m v\u1EADy th\xEC c\xF3 n\xEAn g\u1ECDi l\xE0
      \u0111\u01B0\u1EDDng n\u1EEFa kh\xF4ng...?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109883
    m_Localized: "C\xF3 x\xE1c \u0111\u1ECBnh \u0111\u01B0\u1EE3c h\u01B0\u1EDBng
      ph\xF2ng \u0111i\u1EC1u khi\u1EC3n kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109884
    m_Localized: "C\xE1c r\xE3nh tr\xEAn hoa v\u0103n \u1EDF t\u01B0\u1EDDng ti\u1EBFp
      t\u1EE5c v\xE0o s\xE2u trong h\xE0nh lang."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109885
    m_Localized: "Nh\u01B0ng m\u1ED9t s\u1ED1 r\xE3nh b\u1ECB \u0111\u1EE9t, n\xEAn
      ph\u1EA3i ki\u1EC3m tra l\u1ED1i n\xE0o \u0111ang m\u1EDF."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109886
    m_Localized: "D\u1EA5u ch\xE2n \u1EDF h\xE0nh lang b\xEAn tr\xE1i d\u1EEBng \u0111\u1ED9t
      ng\u1ED9t."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109887
    m_Localized: "Nh\u1EEFng v\u1EBFt c\xE0o k\xE9o d\xE0i ti\u1EBFp t\u1EE5c \u1EDF
      h\xE0nh lang b\xEAn ph\u1EA3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109888
    m_Localized: "V\u1EADy qu\xE1i v\u1EADt \u0111\xE3 \u0111i qua b\xEAn ph\u1EA3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109889
    m_Localized: "\u1EEA. D\u1EA5u v\u1EBFt cho th\u1EA5y ch\xFAng b\u1ECB \xE9p
      \u0111i theo h\u01B0\u1EDBng \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109890
    m_Localized: "N\u1EBFu b\u1ECB \xE9p \u0111i m\u1EA1nh \u0111\u1EBFn m\u1EE9c
      \u0111\xF3 th\xEC ch\xFAng ta c\u0169ng ph\u1EA3i c\u1EA9n th\u1EADn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109891
    m_Localized: "C\xE1c hoa v\u0103n tr\xEAn t\u01B0\u1EDDng h\xE0nh lang \u0111ang
      ph\u1EA3n \u1EE9ng v\u1EDBi chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a qu\xE1i v\u1EADt."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109892
    m_Localized: "Thi\u1EBFt b\u1ECB c\xF3 v\u1EBB kh\xF4ng ph\xE2n bi\u1EC7t \u0111\u1ECBch
      hay \u0111\u1ED3ng minh, m\xE0 ho\u1EA1t \u0111\u1ED9ng khi m\u1ED9t lo\u1EA1i
      ph\u1EA3n \u1EE9ng ma l\u1EF1c nh\u1EA5t \u0111\u1ECBnh \u0111i qua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109893
    m_Localized: "\u0110\xE1 t\xEDn hi\u1EC7u c\u1EE7a ch\xFAng ta c\u0169ng c\xF3
      th\u1EC3 k\xEDch ho\u1EA1t ch\xFAng sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109894
    m_Localized: "C\xF3 th\u1EC3. V\xEC v\u1EADy ph\u1EA3i h\u1EA1 m\u1EE9c \u0111i\u1EC1u
      ch\u1EC9nh khi \u0111i qua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109895
    m_Localized: "\xDD c\u1EADu l\xE0 ph\u1EA3i di chuy\u1EC3n th\u1EADt nh\u1EB9
      nh\xE0ng \u0111\xFAng kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109896
    m_Localized: "Ch\xEDnh x\xE1c h\u01A1n l\xE0 kh\xF4ng \u0111\u01B0\u1EE3c l\xE0m
      t\u0103ng ph\u1EA3n \u1EE9ng c\u1EE7a \u0111\xE1 t\xEDn hi\u1EC7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109897
    m_Localized: "C\xF3 chuy\u1EC3n \u0111\u1ED9ng b\xEAn d\u01B0\u1EDBi c\xE1nh
      c\u1EEDa \u0111\xE1 \u1EDF s\xE2u trong h\xE0nh lang."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109898
    m_Localized: "M\u1ED9t nh\xF3m qu\xE1i v\u1EADt \u0111ang \u0111i ra theo kho\u1EA3ng
      h\u1EDF khi c\xE1nh c\u1EEDa m\u1EDF."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109899
    m_Localized: "V\u1EADy ch\u1EC9 c\u1EA7n ch\u1EB7n kho\u1EA3ng h\u1EDF l\xFAc
      n\xF3 m\u1EDF l\xE0 \u0111\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109900
    m_Localized: "N\u1EBFu c\u1EEDa \u0111\xF3ng l\u1EA1i th\xEC sao...?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109901
    m_Localized: "V\u1EADy th\xEC ch\u1EB7n ch\xFAng tr\u01B0\u1EDBc khi c\u1EEDa
      \u0111\xF3ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109902
    m_Localized: "Nghe c\xF2n \u0111\xE1ng s\u1EE3 h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109903
    m_Localized: "N\u1EBFu \u0111\xF3ng ho\xE0n to\xE0n c\u1EEDa \u0111\xE1 th\xEC
      ph\u1EA3n \u1EE9ng c\xF3 th\u1EC3 b\u1ECB d\u1ED3n v\u1EC1 ph\xEDa ph\xF2ng
      \u0111i\u1EC1u khi\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109904
    m_Localized: "V\u1EADy h\xE3y ch\u1EB7n tr\u01B0\u1EDBc c\u1EEDa v\xE0 gi\u1EEF
      h\xE0nh lang th\xF4ng tho\xE1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109905
    m_Localized: "\u0110\u1EEBng c\u1EAFt c\xE1c r\xE3nh d\u1EABn \u0111\u1EBFn ph\xF2ng
      \u0111i\u1EC1u khi\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109906
    m_Localized: "Nh\xF3m \u0111i ra tr\u01B0\u1EDBc \u0111ang \u0111\u1EBFn b\xEAn
      d\u01B0\u1EDBi c\u1EEDa \u0111\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109907
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn h\u01A1n \u0111\xE3 d\u1EEBng
      \u1EDF s\xE2u trong h\xE0nh lang."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109908
    m_Localized: "Ph\xEDa tr\u01B0\u1EDBc c\u1EEDa \u0111\xE1 \u0111\xE3 \u0111\u01B0\u1EE3c
      d\u1ECDn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109909
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn \u0111\xE3 l\xF9i s\xE2u h\u01A1n
      v\xE0o h\xE0nh lang."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109910
    m_Localized: "N\xF3 \u0111ang di chuy\u1EC3n d\u1ECDc theo c\xE1c r\xE3nh d\u01B0\u1EDBi
      s\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109911
    m_Localized: "M\u1ED7i khi thi\u1EBFt b\u1ECB ph\xF2ng th\u1EE7 di chuy\u1EC3n,
      ph\u1EA3n \u1EE9ng l\u1EA1i t\u1EE5 theo c\xE1c r\xE3nh v\u1EC1 ph\xEDa ph\xF2ng
      \u0111i\u1EC1u khi\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109912
    m_Localized: "V\u1EADy ph\xF2ng \u0111i\u1EC1u khi\u1EC3n l\xE0 n\u01A1i thu
      th\u1EADp ph\u1EA3n \u1EE9ng sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109913
    m_Localized: "Kh\u1EA3 n\u0103ng \u0111\xF3 r\u1EA5t cao."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109914
    m_Localized: "Ph\u1EA3n \u1EE9ng t\u1EEBng lan \u0111\u1EBFn m\u1ECF v\xE0 h\u1ED3
      c\xF3 th\u1EC3 xu\u1EA5t ph\xE1t t\u1EEB ph\xF2ng \u0111i\u1EC1u khi\u1EC3n,
      ho\u1EB7c \u0111ang t\u1EADp trung tr\u1EDF l\u1EA1i \u1EDF \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109915
    m_Localized: "\u0110\xE3 lan ra r\u1ED3i l\u1EA1i t\u1EADp trung sao..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109916
    m_Localized: "T\xF4i gh\xE9t vi\u1EC7c thi\u1EBFt b\u1ECB nghe nh\u01B0 \u0111ang
      th\u1EDF."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109917
    m_Localized: "V\u1EADy kh\xF4ng ph\u1EA3i ch\u1EC9 c\u1EA7n khi\u1EBFn n\xF3
      ng\u1EEBng th\u1EDF l\xE0 \u0111\u01B0\u1EE3c sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109918
    m_Localized: "Serah, v\xED von th\xEC \u0111\xFAng, nh\u01B0ng th\u1EF1c t\u1EBF
      ph\u1EA3i \u0111i\u1EC1u ch\u1EC9nh n\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109919
    m_Localized: "C\xF9ng m\u1ED9t ti\u1EBFng v\u1ECDng c\u1EE9 l\u1EB7p l\u1EA1i
      \u1EDF cu\u1ED1i h\xE0nh lang."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109920
    m_Localized: "C\xF3 v\u1EBB \u0111\xF3 l\xE0 ti\u1EBFng thi\u1EBFt b\u1ECB ph\xF2ng
      th\u1EE7 tr\u01B0\u1EDBc ph\xF2ng \u0111i\u1EC1u khi\u1EC3n \u0111ang chuy\u1EC3n
      \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109921
    m_Localized: "H\xE3y s\u1EEDa ch\u1EEFa tr\u01B0\u1EDBc khi v\xE0o ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109922
    m_Localized: "H\xE3y ki\u1EC3m tra thi\u1EBFt b\u1ECB ph\xF2ng th\u1EE7 c\u1EE7a
      h\xE0nh lang v\xE0 ho\xE0n t\u1EA5t chu\u1EA9n b\u1ECB v\xE0o ph\xF2ng \u0111i\u1EC1u
      khi\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535717109923
    m_Localized: "\u0110\u01B0\u1EE3c. Chu\u1EA9n b\u1ECB r\u1ED3i v\xE0o th\xF4i!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498368
    m_Localized: "L\u1EA7n n\xE0y qu\u1EA3 th\u1EADt c\xF3 v\u1EBB r\u1EA5t c\u1EA7n
      chu\u1EA9n b\u1ECB..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498369
    m_Localized: "Cu\u1ED1i h\xE0nh lang di t\xEDch Norua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498370
    m_Localized: "Thi\u1EBFt b\u1ECB ph\xF2ng th\u1EE7 c\u1EE7a h\xE0nh lang ch\u01B0a
      h\u1ECFng ho\xE0n to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498371
    m_Localized: "V\xEC v\u1EADy ch\xFAng c\xE0ng nguy hi\u1EC3m. Ch\xFAng kh\xF3
      \u0111o\xE1n h\u01A1n thi\u1EBFt b\u1ECB \u0111\xE3 d\u1EEBng h\u1EB3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498372
    m_Localized: "Tr\xECnh t\u1EF1 chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a ch\xFAng kh\xE1
      \u0111\u1EC1u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498373
    m_Localized: "Ti\u1EBFng v\u1ECDng l\u1EDBn vang l\xEAn ba l\u1EA7n, r\u1ED3i
      c\u1EEDa \u0111\xE1 m\u1EDF."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498374
    m_Localized: "V\u1EADy ch\u1EC9 c\u1EA7n \u0111i qua tr\u01B0\u1EDBc ti\u1EBFng
      v\u1ECDng l\u1EA7n th\u1EE9 ba l\xE0 \u0111\u01B0\u1EE3c sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498375
    m_Localized: "L\xE0m \u01A1n \u0111\u1EEBng ch\u1EA1y qua theo ki\u1EC3u \u0111\xF3..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498376
    m_Localized: "C\xF3 th\u1EC3 d\u1EF1ng tuy\u1EBFn ph\xF2ng th\u1EE7 t\u1EA1m
      th\u1EDDi \u1EDF \u0111\xE2u?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498377
    m_Localized: "Gi\u1EEFa c\xE1c c\u1ED9t \u0111\xE1 tr\u01B0\u1EDBc ph\xF2ng \u0111i\u1EC1u
      khi\u1EC3n l\xE0 t\u1ED1t nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498378
    m_Localized: "Kh\xF4ng c\xF3 d\u1EA5u hi\u1EC7u g\u1EA7n \u0111\xE2y b\u1ECB
      s\u1EE5p gi\u1EEFa c\xE1c c\u1ED9t \u0111\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498379
    m_Localized: "H\xE0nh lang ch\xFAng ta v\u1EEBa \u0111i qua c\u0169ng ch\u01B0a
      b\u1ECB ch\u1EB7n ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498380
    m_Localized: "N\u1EBFu t\xF4i h\u1EA1 nh\u1EB9 hoa v\u0103n tr\xEAn c\xE1c c\u1ED9t
      \u0111\xE1 th\xEC ch\xFAng s\u1EBD kh\xF4ng xung \u0111\u1ED9t v\u1EDBi ph\u1EA3n
      \u1EE9ng c\u1EE7a \u0111\xE1 t\xEDn hi\u1EC7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498381
    m_Localized: "Nh\u01B0ng n\u1EBFu \u1EDF tr\u01B0\u1EDBc ph\xF2ng \u0111i\u1EC1u
      khi\u1EC3n qu\xE1 l\xE2u th\xEC ph\u1EA3n \u1EE9ng b\xEAn trong c\xF3 th\u1EC3
      t\u0103ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498382
    m_Localized: "V\u1EADy l\xE0 chu\u1EA9n b\u1ECB ng\u1EAFn th\xF4i r\u1ED3i v\xE0o
      ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498383
    m_Localized: "Chu\u1EA9n b\u1ECB ng\u1EAFn v\u1EABn t\u1ED1t h\u01A1n l\xE0 kh\xF4ng
      chu\u1EA9n b\u1ECB..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498384
    m_Localized: "T\xF4i ch\u1EC9 c\u1EA7n \u0111\u1EE7 ch\u1ED7 \u0111\u1EC3 l\u1EA5y
      d\u1EE5ng c\u1EE5 ch\u1EEFa tr\u1ECB ra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498385
    m_Localized: "H\xE3y \u0111i\u1EC1u ch\u1EC9nh \u0111\xE1 t\xEDn hi\u1EC7u th\xEAm
      m\u1ED9t l\u1EA7n n\u1EEFa tr\u01B0\u1EDBc ph\xF2ng \u0111i\u1EC1u khi\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498386
    m_Localized: "Ph\u1EA3n \u1EE9ng c\xF3 th\u1EC3 m\u1EA1nh l\xEAn b\xEAn trong,
      n\xEAn h\u1EA1 m\u1EE9c t\u1EEB b\xE2y gi\u1EDD s\u1EBD an to\xE0n h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498387
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y s\u1EAFp x\u1EBFp ghi ch\xE9p tr\u1EADn
      chi\u1EBFn trong h\xE0nh lang."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498388
    m_Localized: "Ho\xE0n t\u1EA5t \u0111i\u1EC1u ch\u1EC9nh c\u01B0\u1EDDng h\xF3a
      r\u1ED3i d\u1EF1ng tuy\u1EBFn ph\xF2ng th\u1EE7 tr\u01B0\u1EDBc ph\xF2ng \u0111i\u1EC1u
      khi\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498389
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn c\u1EE9 l\u1EB7p l\u1EA1i b\xEAn
      trong ph\xF2ng \u0111i\u1EC1u khi\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498390
    m_Localized: "T\xF4i nghe th\u1EA5y c\u1EA3 ti\u1EBFng qu\xE1i v\u1EADt chuy\u1EC3n
      \u0111\u1ED9ng l\u1EABn ti\u1EBFng thi\u1EBFt b\u1ECB kh\u1EDBp v\xE0o nhau."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498391
    m_Localized: "Con qu\xE1i v\u1EADt l\u1EDBn b\u1ECB k\u1EB9t b\xEAn trong thi\u1EBFt
      b\u1ECB sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498392
    m_Localized: "Kh\xF4ng h\u1EB3n b\u1ECB k\u1EB9t, c\xF3 v\u1EBB n\xF3 \u0111ang
      b\u1ECB cu\u1ED1n v\xE0o ph\u1EA3n \u1EE9ng c\u1EE7a thi\u1EBFt b\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498393
    m_Localized: "V\u1EADy c\xF3 l\u1EBD n\xF3 \u0111ang t\u1EE9c gi\u1EADn..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498394
    m_Localized: "H\xE3y ti\u1EBFn v\xE0o ph\xF2ng \u0111i\u1EC1u khi\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498395
    m_Localized: "Ph\u1EA3i ch\u1EB7n chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn tr\u01B0\u1EDBc
      khi n\xF3 l\xE0m thi\u1EBFt b\u1ECB ph\xF2ng th\u1EE7 b\u1EA5t \u1ED5n h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498396
    m_Localized: "\u1EEA. L\u1EA7n n\xE0y h\xE3y b\u1EA3o v\u1EC7 c\u1EA3 thi\u1EBFt
      b\u1ECB n\u1EEFa!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498397
    m_Localized: "Ph\xF2ng \u0111i\u1EC1u khi\u1EC3n di t\xEDch Norua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498398
    m_Localized: "\u0110\xE2y l\xE0 ph\xF2ng \u0111i\u1EC1u khi\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498399
    m_Localized: "C\xF3 nhi\u1EC1u t\u1EA5m bia kh\u1EAFc ch\u1ED3ng l\xEAn nhau
      b\xEAn d\u01B0\u1EDBi c\u1ED9t trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498400
    m_Localized: "C\xE1c r\xE3nh d\u01B0\u1EDBi s\xE0n t\xE1ch th\xE0nh b\u1ED1n
      h\u01B0\u1EDBng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498401
    m_Localized: "T\xF4i th\u1EA5y c\xE1c d\u1EA5u ch\u1EC9 ri\xEAng cho con \u0111\u01B0\u1EDDng
      ch\xFAng ta \u0111\xE3 \u0111i, ph\xEDa h\u1ED3 v\xE0 ph\xEDa m\u1ECF."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498402
    m_Localized: "V\u1EADy \u0111\xE2y l\xE0 n\u01A1i t\u1EADp h\u1EE3p nhi\u1EC1u
      con \u0111\u01B0\u1EDDng v\xE0o m\u1ED9t ch\u1ED7."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498403
    m_Localized: "N\u1EBFu c\xF3 b\u1ED1n \u0111\u01B0\u1EDDng th\xEC ph\u1EA3i ki\u1EC3m
      tra \u0111\u01B0\u1EDDng r\xFAt lui g\u1EA5p b\u1ED1n l\u1EA7n r\u1ED3i..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498404
    m_Localized: "C\xF3 d\u1EA5u ch\u1EC9 n\xE0o d\u1EABn v\u1EC1 ph\xEDa Cies ho\u1EB7c
      Zeppel kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498405
    m_Localized: "C\xF3, d\xF9 kh\xE1 m\u1EDD."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498406
    m_Localized: "Kh\xF4ng ph\u1EA3i n\u1ED1i tr\u1EF1c ti\u1EBFp, m\xE0 c\xF3 v\u1EBB
      ph\u1EA3n \u1EE9ng kh\u1EDBp v\u1EDBi nhau \u1EDF cu\u1ED1i c\xF9ng m\u1ED9t
      m\u1EA1ng l\u01B0\u1EDBi c\xF4ng tr\xECnh."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498407
    m_Localized: "D\u1EA5u ch\xE2n quanh c\u1ED9t trung t\xE2m r\u1EA5t l\u1EA1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498408
    m_Localized: "Qu\xE1i v\u1EADt kh\xF4ng t\u1EA5n c\xF4ng c\u1ED9t. D\u1EA5u v\u1EBFt
      cho th\u1EA5y ch\xFAng \u0111i v\xF2ng \u0111\u1EC3 tr\xE1nh c\u1ED9t r\u1ED3i
      l\u1EA1i b\u1ECB k\xE9o tr\u1EDF l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498409
    m_Localized: "Kh\xF3 m\xE0 n\xF3i ph\xF2ng \u0111i\u1EC1u khi\u1EC3n n\xE0y \u0111i\u1EC1u
      khi\u1EC3n qu\xE1i v\u1EADt."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498410
    m_Localized: "Nh\u01B0ng gi\u1EDD c\xF3 th\u1EC3 ch\u1EAFc ch\u1EAFn \u0111\xE2y
      l\xE0 thi\u1EBFt b\u1ECB t\u1EADp h\u1EE3p v\xE0 d\u1EABn truy\u1EC1n ph\u1EA3n
      \u1EE9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498411
    m_Localized: "V\xE0 ch\xEDnh ph\u1EA3n \u1EE9ng \u0111\xF3 \u0111\xE3 li\xEAn
      t\u1EE5c \u0111\u1EA9y qu\xE1i v\u1EADt ra ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498412
    m_Localized: "\u1EEA. \xCDt nh\u1EA5t hi\u1EC7n t\u01B0\u1EE3ng b\u1EA5t th\u01B0\u1EDDng
      \u1EDF nh\u1EEFng khu v\u1EF1c ch\xFAng ta \u0111\xE3 \u0111i qua \u0111\u1EC1u
      n\u1ED1i v\u1EDBi m\u1EA1ng l\u01B0\u1EDBi c\xF4ng tr\xECnh n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498413
    m_Localized: "Cu\u1ED1i c\xF9ng c\u0169ng \u0111\u1EBFn l\xFAc nghe c\xE2u m\u1ECDi
      th\u1EE9 \u0111\u01B0\u1EE3c n\u1ED1i v\u1EDBi nhau m\xE0 kh\xF4ng th\u1EA5y
      vui r\u1ED3i..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498414
    m_Localized: "C\xF3 th\u1EC3 d\u1EEBng thi\u1EBFt b\u1ECB kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498415
    m_Localized: "D\u1EEBng ho\xE0n to\xE0n s\u1EBD r\u1EA5t nguy hi\u1EC3m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498416
    m_Localized: "N\u1EBFu c\u1ED1 c\u1EAFt n\xF3 th\xEC ph\u1EA3n \u1EE9ng c\xF2n
      l\u1EA1i c\xF3 th\u1EC3 b\xF9ng ra theo m\u1ED9t con \u0111\u01B0\u1EDDng kh\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498417
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn \u0111ang \u1EDF ph\xEDa sau
      c\u1ED9t trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498418
    m_Localized: "M\u1ED7i khi thi\u1EBFt b\u1ECB vang l\xEAn th\xEC chuy\u1EC3n
      \u0111\u1ED9ng c\u0169ng dao \u0111\u1ED9ng theo."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498419
    m_Localized: "V\u1EADy tr\u01B0\u1EDBc h\u1EBFt ch\u1EB7n con qu\xE1i v\u1EADt
      l\u1EDBn, c\xF2n thi\u1EBFt b\u1ECB \u0111\u1EC3 Alice gi\u1EEF l\xE0 \u0111\u01B0\u1EE3c
      nh\u1EC9."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498420
    m_Localized: "Kh\xF4ng ph\u1EA3i gi\u1EEF, m\xE0 l\xE0 \xE1p ch\u1EBF n\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498421
    m_Localized: "Hi\u1EC3u r\u1ED3i. Trong l\xFAc c\u1EADu \xE1p ch\u1EBF th\xEC
      ch\xFAng t\xF4i s\u1EBD ch\u1EB7n ch\xFAng!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498422
    m_Localized: "N\xF3i th\xEC d\u1EC5, nh\u01B0ng c\xE1i c\u1ED9t kia c\u1EE9 vang
      l\xEAn m\xE3i..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498423
    m_Localized: "T\xF4i kh\xF4ng th\xEDch \xE2m thanh \u0111\xF3 gi\u1ED1ng ti\u1EBFng
      tim \u0111\u1EADp."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498424
    m_Localized: "N\u1EBFu ph\u1EA3n \u1EE9ng trong ph\xF2ng \u0111i\u1EC1u khi\u1EC3n
      l\u1EDBn l\xEAn th\xEC s\u1EBD lan ra ngo\xE0i theo c\xE1c r\xE3nh d\u01B0\u1EDBi
      s\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498425
    m_Localized: "N\xF3 s\u1EBD lan theo h\u01B0\u1EDBng n\xE0o?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498426
    m_Localized: "Hi\u1EC7n t\u1EA1i \u0111\u01B0\u1EDDng m\u1EA1nh nh\u1EA5t d\u1EABn
      v\u1EC1 ph\xEDa \u0110\u1ED3ng b\u1EB1ng trung t\xE2m Atra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498427
    m_Localized: "\u0110i\u1EC1u \u0111\xF3 c\xF3 ngh\u0129a Norua kh\xF4ng ph\u1EA3i
      \u0111i\u1EC3m cu\u1ED1i, m\xE0 l\xE0 m\u1ED9t ph\u1EA7n c\u1EE7a m\u1EA1ng
      l\u01B0\u1EDBi ph\xF2ng th\u1EE7 l\u1EDBn h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498428
    m_Localized: "Nh\xF3m \u0111i v\xE0o t\u1EEB h\xE0nh lang \u0111ang ti\u1EBFn
      \u0111\u1EBFn c\u1ED9t trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498429
    m_Localized: "Qu\xE1i v\u1EADt l\u1EDBn \u0111ang \u0111i v\xF2ng ph\xEDa sau
      c\u1ED9t trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498430
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n \u1EDF ph\xF2ng \u0111i\u1EC1u
      khi\u1EC3n di t\xEDch Norua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498431
    m_Localized: "H\xE3y gi\u1EEF ph\u1EA3n \u1EE9ng c\u1EE7a thi\u1EBFt b\u1ECB
      \u1EDF m\u1EE9c \xE1p ch\u1EBF v\xE0 ch\u1EB7n chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn
      tr\u01B0\u1EDBc khi n\xF3 lan v\u1EC1 ph\xEDa Atra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498432
    m_Localized: "\u0110\xE3 ch\u1EB7n \u0111\u01B0\u1EE3c con l\u1EDBn!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498433
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng trong ph\xF2ng \u0111i\u1EC1u khi\u1EC3n
      c\u0169ng gi\u1EA3m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498434
    m_Localized: "D\u1EA5u ch\xE2n quanh c\u1ED9t trung t\xE2m kh\xF4ng c\xF2n \u0111i
      v\xF2ng n\u1EEFa."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498435
    m_Localized: "Ph\u1EA3n \u1EE9ng ch\u01B0a t\u1EAFt ho\xE0n to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498436
    m_Localized: "Nh\u01B0ng ph\u1EA3n \u1EE9ng r\xF2 v\u1EC1 ph\xEDa m\u1ECF v\xE0
      h\u1ED3 \u0111\xE3 y\u1EBFu \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498437
    m_Localized: "V\u1EADy c\xE1c khu v\u1EF1c ch\xFAng ta \u0111\xE3 \u0111i qua
      c\xF3 th\u1EC3 \u1ED5n \u0111\u1ECBnh trong m\u1ED9t th\u1EDDi gian sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498438
    m_Localized: "\u1EEA. \xCDt nh\u1EA5t s\u1EF1 h\u1ED7n lo\u1EA1n c\xF9ng quy
      m\xF4 s\u1EBD kh\xF4ng l\u1EADp t\u1EE9c lan ra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498439
    m_Localized: "Thay v\xE0o \u0111\xF3, \u0111\u01B0\u1EDDng v\u1EC1 ph\xEDa \u0110\u1ED3ng
      b\u1EB1ng trung t\xE2m Atra \u0111\xE3 r\xF5 h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498440
    m_Localized: "V\u1EADy l\xE0 l\u1EA1i c\xF3 th\xEAm m\u1ED9t n\u01A1i ph\u1EA3i
      ch\u1EB7n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498441
    m_Localized: "Hy v\u1ECDng ph\u1EA7n l\u1ECBch tr\xECnh c\xF2n l\u1EA1i l\xE0
      \u0111i xu\u1ED1ng t\u1EEB n\u01A1i cao..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498442
    m_Localized: "\xCDt nh\u1EA5t nh\u01B0 v\u1EADy \u0111\u1EE1 v\u1EA5t v\u1EA3
      h\u01A1n leo l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498443
    m_Localized: "C\xF3 ch\u1EEF c\xF2n l\u1EA1i tr\xEAn s\xE0n ph\xF2ng \u0111i\u1EC1u
      khi\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498444
    m_Localized: "Tr\xF4ng gi\u1ED1ng tr\xECnh t\u1EF1 t\u1EEBng \u0111\u01B0\u1EE3c
      d\xF9ng \u0111\u1EC3 m\u1EDF m\u1EA1ng l\u01B0\u1EDBi ph\xF2ng th\u1EE7 c\u0169."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498445
    m_Localized: "Di t\xEDch Norua kh\xF4ng ph\u1EA3i nguy\xEAn nh\xE2n c\u1EE7a
      to\xE0n b\u1ED9 s\u1EF1 vi\u1EC7c, m\xE0 l\xE0 thi\u1EBFt b\u1ECB chuy\u1EC3n
      ti\u1EBFp."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498446
    m_Localized: "C\xF3 th\u1EC3 ai \u0111\xF3 \u0111\xE3 ch\u1EA1m v\xE0o m\u1EA1ng
      l\u01B0\u1EDBi ph\xF2ng th\u1EE7 n\xE0y l\u1EA7n n\u1EEFa, ho\u1EB7c ph\u1EA3n
      \u1EE9ng c\u0169 \u0111ang ch\u1EA3y ng\u01B0\u1EE3c t\u1EEB b\xEAn ngo\xE0i
      v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498447
    m_Localized: "Ti\u1EBFp theo l\xE0 \u0110\u1ED3ng b\u1EB1ng trung t\xE2m Atra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498448
    m_Localized: "H\xE3y t\xECm n\u01A1i trung t\xE2m m\u1EA1ng l\u01B0\u1EDBi ph\xF2ng
      th\u1EE7 \u0111ang dao \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498449
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y \u0111\u1EBFn Atra v\xE0 t\xECm n\u01A1i
      dao \u0111\u1ED9ng tr\u01B0\u1EDBc ti\xEAn!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498450
    m_Localized: "V\xE0 s\u1EBD t\u1ED1t h\u01A1n n\u1EBFu ch\xFAng ta ki\u1EC3m
      tra \u0111\u01B0\u1EDDng quay v\u1EC1 tr\u01B0\u1EDBc..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498451
    m_Localized: "H\xE3y mang theo ghi ch\xE9p c\u1EE7a ph\xF2ng \u0111i\u1EC1u khi\u1EC3n.
      \u0110\u1EBFn Atra s\u1EBD c\u1EA7n ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498452
    m_Localized: "\u0110\u1ED3ng b\u1EB1ng trung t\xE2m Atra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498453
    m_Localized: "\u0110\u01B0\u1EDDng n\u1ED1i t\u1EEB Norua \u0111\xE3 m\u1EDF
      r\u1ED9ng tr\xEAn kh\u1EAFp \u0111\u1ED3ng b\u1EB1ng trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498454
    m_Localized: "Kh\xF4ng ph\u1EA3i m\u1ED9t con \u0111\u01B0\u1EDDng, m\xE0 l\xE0
      d\u1EA5u v\u1EBFt lan ra to\xE0n b\u1ED9 \u0111\u1ED3ng b\u1EB1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498455
    m_Localized: "C\xE1c c\u1ED9t ph\u1EE5 \u0111\u01B0\u1EE3c b\u1ED1 tr\xED \u0111\u1EC3
      chia v\xE0 ti\u1EBFp nh\u1EADn ph\u1EA3n \u1EE9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498456
    m_Localized: "Norua l\xE0 thi\u1EBFt b\u1ECB chuy\u1EC3n ti\u1EBFp, c\xF2n n\u01A1i
      n\xE0y gi\u1ED1ng v\xF9ng \u0111\u1EC7m tr\u01B0\u1EDBc khi v\xE0o khu trung
      t\xE2m h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498457
    m_Localized: "N\u1EBFu l\xE0 v\xF9ng \u0111\u1EC7m th\xEC ch\u1EB3ng ph\u1EA3i
      ph\u1EA3i an to\xE0n sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498458
    m_Localized: "T\xF4i \u0111\xE3 quen v\u1EDBi vi\u1EC7c nh\u1EEFng l\u1EDDi nh\u01B0
      v\u1EADy kh\xF4ng c\xF2n nghe an to\xE0n n\u1EEFa..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498459
    m_Localized: "C\xE1c v\u1ECB l\xE0 H\u1ED9 V\u1EC7 ph\u1EA3i kh\xF4ng? Ch\xFAng
      t\xF4i \u0111\xE3 nh\u1EADn \u0111\u01B0\u1EE3c b\xE1o c\xE1o t\u1EEB Norua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498460
    m_Localized: "Qu\xE1i v\u1EADt \u0111ang \u0111\u1ED3ng lo\u1EA1t tr\xE0n v\xE0o
      t\u1EEB b\xEAn ngo\xE0i \u0111\u1ED3ng b\u1EB1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498461
    m_Localized: "Ph\u1EA3i l\xE0m gi\u1EA3m s\u1ED1 l\u01B0\u1EE3ng \u1EDF \u0111\xE2y
      tr\u01B0\u1EDBc khi ch\xFAng \u1EADp th\u1EB3ng \u0111\u1EBFn c\u1ED5ng kinh
      \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498462
    m_Localized: "Vi\u1EC7c s\u01A1 t\xE1n \u0111\xE3 ti\u1EBFn h\xE0nh \u0111\u1EBFn
      \u0111\xE2u r\u1ED3i?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498463
    m_Localized: "Ng\u01B0\u1EDDi d\xE2n t\u1EEB c\xE1c l\xE0ng ngo\u1EA1i vi \u0111ang
      di chuy\u1EC3n v\u1EC1 ph\xEDa kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498464
    m_Localized: "Nh\u01B0ng xe ch\u1EDF v\u1EADt t\u01B0 v\xE0 ng\u01B0\u1EDDi b\u1ECB
      th\u01B0\u01A1ng \u0111ang di chuy\u1EC3n ch\u1EADm."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498465
    m_Localized: "\u0110\u1ED3ng b\u1EB1ng r\u1ED9ng n\xEAn ng\u01B0\u1EDDi b\u1ECB
      th\u01B0\u01A1ng c\u0169ng s\u1EBD b\u1ECB ph\xE2n t\xE1n \u1EDF nhi\u1EC1u
      n\u01A1i..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498466
    m_Localized: "Ph\u1EA3i chia th\u1EE9 t\u1EF1 ch\u1EEFa tr\u1ECB t\u1EEB tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498467
    m_Localized: "D\u1EA5u ch\xE2n qu\xE1i v\u1EADt h\u1ED9i t\u1EE5 t\u1EEB ngo\xE0i
      \u0111\u1ED3ng b\u1EB1ng v\u1EC1 ph\xEDa b\xEAn trong."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498468
    m_Localized: "Kh\xF4ng gi\u1ED1ng nh\u1EAFm v\xE0o kinh \u0111\xF4, \u0111\xE2y
      l\xE0 d\u1EA5u v\u1EBFt m\u1ED9t nh\xF3m b\u1ECB d\u1ED3n v\xE0o t\u1EEB ph\xEDa
      sau."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498469
    m_Localized: "Gi\u1ED1ng chuy\u1EC3n \u0111\u1ED9ng ch\xFAng ta th\u1EA5y \u1EDF
      Cies."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498470
    m_Localized: "Ch\u1EC9 kh\xE1c h\u01B0\u1EDBng \u0111i, \u0111\xE2y kh\xF4ng
      ph\u1EA3i nh\xF3m t\u1EADp trung \u0111\u1EC3 t\u1EA5n c\xF4ng ai."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498471
    m_Localized: "Ngay t\u1EEB \u0111\u1EA7u \u0111\xE3 nh\u01B0 v\u1EADy. Ch\xFAng
      c\u0169ng b\u1ECB d\u1ED3n t\u1EEB ph\xEDa sau."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498472
    m_Localized: "V\u1EADy ch\u1EB7n nh\xF3m \u0111ang tr\xE0n v\xE0o tr\u01B0\u1EDBc
      khi ch\xFAng \u0111\u1EBFn c\u1ED5ng kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498473
    m_Localized: "C\u1ED9t ph\u1EE5 \u1EDF trung t\xE2m \u0111\u1ED3ng b\u1EB1ng
      \u0111ang rung chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498474
    m_Localized: "\xC1nh s\xE1ng c\u1EE7a n\xF3 m\u1EA1nh l\xEAn m\u1ED7i khi qu\xE1i
      v\u1EADt \u0111\u1EBFn g\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498475
    m_Localized: "C\u1ED9t kh\xF4ng g\u1ECDi qu\xE1i v\u1EADt \u0111\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535725498476
    m_Localized: "Ph\u1EA3n \u1EE9ng c\u1EE7a m\u1EA1ng l\u01B0\u1EDBi ph\xF2ng th\u1EE7
      v\xE0 ph\u1EA3n \u1EE9ng b\u1EA5t \u1ED5n c\u1EE7a qu\xE1i v\u1EADt c\xF3 v\u1EBB
      \u0111ang va ch\u1EA1m v\u1EDBi nhau."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692672
    m_Localized: "Kh\xF4ng ph\u1EA3i g\u1ECDi ch\xFAng, m\xE0 l\xE0 hai ph\u1EA3n
      \u1EE9ng \u0111ang \u0111\xE2m v\xE0o nhau."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692673
    m_Localized: "V\xE0 khi ch\xFAng va v\xE0o nhau, ng\u01B0\u1EDDi \u1EDF hi\u1EC7n
      tr\u01B0\u1EDDng lu\xF4n l\xE0 ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692674
    m_Localized: "C\xE1c \u0111\u1ED9i ph\xF2ng th\u1EE7 \u1EDF ph\xEDa c\u1ED5ng
      kinh \u0111\xF4 v\u1EABn \u0111ang v\xE0o v\u1ECB tr\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692675
    m_Localized: "N\u1EBFu c\xE1c v\u1ECB gi\u1EEF ch\xE2n ch\xFAng tr\xEAn \u0111\u1ED3ng
      b\u1EB1ng, ch\xFAng t\xF4i c\xF3 th\u1EC3 ho\xE0n t\u1EA5t s\u01A1 t\xE1n khu
      ngo\u1EA1i vi."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692676
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n \u1EDF \u0110\u1ED3ng b\u1EB1ng
      trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692677
    m_Localized: "H\xE3y \u0111\u1EC3 \u0111\u01B0\u1EDDng s\u01A1 t\xE1n th\xF4ng
      tho\xE1ng v\xE0 ch\u1EB7n nh\xF3m \u0111ang d\u1ED3n v\u1EC1 quanh c\u1ED9t
      ph\u1EE5."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692678
    m_Localized: "Nh\xF3m \u0111i ra tr\u01B0\u1EDBc \u0111ang \u0111\u1EBFn trung
      t\xE2m \u0111\u1ED3ng b\u1EB1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692679
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn h\u01A1n v\u1EABn c\xF2n \u1EDF
      s\u1ED1ng n\xFAi b\xEAn ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692680
    m_Localized: "T\xF4i s\u1EBD lo nh\xF3m \u0111i ra tr\u01B0\u1EDBc. H\xE3y \u0111\u1EC3
      tr\u1ED1ng \u0111\u01B0\u1EDDng cho xe ch\u1EDF h\xE0ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692681
    m_Localized: "\u0110\u1EEBng \u0111\u1EE9ng g\u1EA7n c\u1ED9t ph\u1EE5 qu\xE1
      l\xE2u. Ph\u1EA3n \u1EE9ng c\xF3 th\u1EC3 b\xF9ng l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692682
    m_Localized: "N\u1EBFu b\u1ECB th\u01B0\u01A1ng th\xEC r\xFAt v\u1EC1 ph\xEDa
      \u0111\u1ED1i di\u1EC7n c\u1ED9t."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692683
    m_Localized: "T\xF4i kh\xF4ng khuy\u1EBFn kh\xEDch ch\u1EEFa tr\u1ECB \u1EDF
      n\u01A1i \u0111ang ph\xE1t s\xE1ng \u0111\xE2u..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692684
    m_Localized: "M\u1ECDi ng\u01B0\u1EDDi, chu\u1EA9n b\u1ECB chi\u1EBFn \u0111\u1EA5u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692685
    m_Localized: "\u0110\xE3 ch\u1EB7n \u0111\u01B0\u1EE3c trung t\xE2m \u0111\u1ED3ng
      b\u1EB1ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692686
    m_Localized: "Kh\xF4ng c\xF3 chuy\u1EC3n \u0111\u1ED9ng n\xE0o tho\xE1t th\u1EB3ng
      v\u1EC1 ph\xEDa c\u1ED5ng kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692687
    m_Localized: "Nh\u01B0ng d\u1EA5u v\u1EBFt d\u1ECDc s\u1ED1ng n\xFAi b\xEAn ngo\xE0i
      v\u1EABn c\xF2n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692688
    m_Localized: "Ph\u1EA3n \u1EE9ng c\u1EE7a c\u1ED9t ph\u1EE5 c\u0169ng ch\u01B0a
      bi\u1EBFn m\u1EA5t ho\xE0n to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692689
    m_Localized: "C\xF3 v\u1EBB \u0111\u01B0\u1EDDng ch\xFAng ta th\u1EA5y trong
      ph\xF2ng \u0111i\u1EC1u khi\u1EC3n \u0111\xE3 t\xE1ch th\xE0nh nhi\u1EC1u nh\xE1nh
      tr\xEAn \u0110\u1ED3ng b\u1EB1ng trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692690
    m_Localized: "N\u1EBFu t\xE1ch th\xE0nh nhi\u1EC1u nh\xE1nh th\xEC v\xF9ng ngo\u1EA1i
      vi kinh \u0111\xF4 c\u0169ng c\xF3 th\u1EC3 dao \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692691
    m_Localized: "\u0110\xFAng v\u1EADy. M\u1ED9t s\u1ED1 con \u0111\u01B0\u1EDDng
      ng\u01B0\u1EDDi d\xE2n ngo\u1EA1i vi \u0111i qua c\u0169ng \u0111\xE3 b\u1ECB
      ch\u1EB7n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692692
    m_Localized: "Ng\u01B0\u1EDDi d\xE2n \u1EDF ngo\u1EA1i vi kinh \u0111\xF4 \u0111ang
      m\u1EDF \u0111\u01B0\u1EDDng s\u01A1 t\xE1n, nh\u01B0ng h\u1ECD c\u1EA7n h\u1ED7
      tr\u1EE3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692693
    m_Localized: "Tr\u1EADn chi\u1EBFn v\u1EEBa k\u1EBFt th\xFAc m\xE0 \u0111\xE3
      ph\u1EA3i lo \u0111\u01B0\u1EDDng s\u01A1 t\xE1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692694
    m_Localized: "D\xF9 v\u1EADy, lo ngay b\xE2y gi\u1EDD th\xEC sau n\xE0y s\u1EBD
      \u0111\u1EE1 v\u1EA5t v\u1EA3 h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692695
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y gi\xFAp ng\u01B0\u1EDDi d\xE2n ngo\u1EA1i
      vi tr\u01B0\u1EDBc!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692696
    m_Localized: "Tr\u01B0\u1EDBc \u0111\xF3 ph\u1EA3i s\u1EAFp x\u1EBFp ghi ch\xE9p
      tr\u1EADn chi\u1EBFn \u1EDF \u0111\u1ED3ng b\u1EB1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692697
    m_Localized: "Ph\u1EA3i bi\u1EBFt c\u1ED9t ph\u1EE5 n\xE0y n\u1ED1i v\u1EDBi
      nh\u1EEFng con \u0111\u01B0\u1EDDng n\xE0o th\xEC m\u1EDBi d\u1EF1ng \u0111\u01B0\u1EE3c
      tuy\u1EBFn ph\xF2ng th\u1EE7 ti\u1EBFp theo."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692698
    m_Localized: "C\u1ED9t ph\xEDa ngo\u1EA1i vi v\u1EABn \u0111ang nh\u1EA5p nh\xE1y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692699
    m_Localized: "N\u1EBFu \u0111\u1EBFn ngo\u1EA1i vi kinh \u0111\xF4 th\xEC s\u1EBD
      kh\xF4ng m\u1EA5t d\u1EA5u v\u1EBFt ti\u1EBFp theo."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692700
    m_Localized: "H\xE3y s\u1EAFp x\u1EBFp ghi ch\xE9p \u0110\u1ED3ng b\u1EB1ng trung
      t\xE2m r\u1ED3i di chuy\u1EC3n \u0111\u1EBFn ngo\u1EA1i vi kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692701
    m_Localized: "Ngo\u1EA1i vi \u0110\u1ED3ng b\u1EB1ng trung t\xE2m Atra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692702
    m_Localized: "Nh\u1EDD c\xE1c v\u1ECB H\u1ED9 V\u1EC7, \u0111\u01B0\u1EDDng s\u01A1
      t\xE1n tr\xEAn \u0111\u1ED3ng b\u1EB1ng \u0111\xE3 th\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692703
    m_Localized: "Nh\u01B0ng xe ch\u1EDF v\u1EADt t\u01B0 t\u1EEB c\xE1c l\xE0ng
      ngo\xE0i v\u1EABn ch\u01B0a ra \u0111\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692704
    m_Localized: "N\u1EBFu xe ch\u1EDF v\u1EADt t\u01B0 ch\u1EADm th\xEC cu\u1ED1i
      c\xF9ng ng\u01B0\u1EDDi d\xE2n c\u0169ng s\u1EBD ph\u1EA3i d\u1EEBng l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692705
    m_Localized: "Tr\u01B0\u1EDBc h\u1EBFt h\xE3y t\xE1ch \u0111\u01B0\u1EDDng. Ng\u01B0\u1EDDi
      b\u1ECB th\u01B0\u01A1ng \u0111i v\xE0o trong, v\u1EADt t\u01B0 \u0111i \u0111\u01B0\u1EDDng
      ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692706
    m_Localized: "T\xF4i s\u1EBD gi\u1EEF \u0111\u01B0\u1EDDng ph\xEDa ngo\xE0i!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692707
    m_Localized: "Ch\u1EC9 c\u1EA7n kh\xF4ng \u0111\u1EC3 ch\xFAng v\xE0o cho \u0111\u1EBFn
      khi xe \u0111i qua l\xE0 \u0111\u01B0\u1EE3c \u0111\xFAng kh\xF4ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692708
    m_Localized: "T\u1ED1t. Nh\u01B0ng ph\u1EA3n \u1EE9ng c\u1EE7a c\u1ED9t ph\u1EE5
      v\u1EABn c\xF2n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692709
    m_Localized: "\u0110\u1EEBng \u0111\u1EE9ng g\u1EA7n c\u1ED9t qu\xE1 l\xE2u khi
      \u0111ang b\u1EA3o v\u1EC7 \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692710
    m_Localized: "D\u1EA5u v\u1EBFt t\u1EEB \u0111\u1ED3ng b\u1EB1ng v\u1EC1 ph\xEDa
      ngo\u1EA1i vi t\xE1ch th\xE0nh ba nh\xE1nh."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692711
    m_Localized: "M\u1ED9t ph\u1EA7n \u0111\u01B0\u1EDDng ng\u01B0\u1EDDi d\xE2n
      s\u1EED d\u1EE5ng ch\u1ED3ng l\xEAn con \u0111\u01B0\u1EDDng qu\xE1i v\u1EADt
      b\u1ECB d\u1ED3n \u0111\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692712
    m_Localized: "Kh\xE1 gi\u1ED1ng t\xECnh h\xECnh ch\xFAng ta th\u1EA5y \u1EDF
      Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692713
    m_Localized: "\u0110\xFAng v\u1EADy. Nhi\u1EC1u \u0111\u01B0\u1EDDng th\xEC c\xF3
      nhi\u1EC1u ch\u1ED7 \u0111\u1EC3 tr\xE1nh, nh\u01B0ng c\u0169ng c\xF3 nhi\u1EC1u
      \u0111\u01B0\u1EDDng \u0111\u1EC3 ph\u1EA3n \u1EE9ng r\xF2 r\u1EC9."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692714
    m_Localized: "V\xF9ng ngo\u1EA1i vi kinh \u0111\xF4 c\xF3 c\u1EA3 kho v\u1EADt
      t\u01B0 v\xE0 n\u01A1i tr\xFA \u1EA9n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692715
    m_Localized: "Nh\u1EEFng ng\u01B0\u1EDDi ch\u01B0a th\u1EC3 v\xE0o c\u1ED5ng
      kinh \u0111\xF4 ngay ph\u1EA3i t\u1EA1m th\u1EDDi c\u1EA7m c\u1EF1 \u1EDF ngo\u1EA1i
      vi."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692716
    m_Localized: "V\u1EADy n\u1EBFu ngo\u1EA1i vi s\u1EE5p th\xEC ph\xEDa tr\u01B0\u1EDBc
      c\u1ED5ng kinh \u0111\xF4 c\u0169ng s\u1EBD dao \u0111\u1ED9ng theo..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692717
    m_Localized: "X\u1EED l\xFD ngay b\xE2y gi\u1EDD l\xE0 l\u1EF1a ch\u1ECDn \u0111\u1EE1
      kh\xF3 kh\u0103n h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692718
    m_Localized: "T\xF4i s\u1EBD \u0111\u01B0a ghi ch\xE9p tr\u1EADn chi\u1EBFn \u1EDF
      \u0110\u1ED3ng b\u1EB1ng trung t\xE2m v\xE0o \u0111\xE1 t\xEDn hi\u1EC7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692719
    m_Localized: "C\u01B0\u1EDDng h\xF3a ch\xFAng ta t\xEDch l\u0169y cho \u0111\u1EBFn
      gi\u1EDD s\u1EBD ti\u1EBFp t\u1EE5c \u0111\u1EBFn tr\u1EADn ph\xF2ng th\u1EE7
      cu\u1ED1i c\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692720
    m_Localized: "\u0110\u01B0\u1EE3c. Ho\xE0n t\u1EA5t \u0111i\u1EC1u ch\u1EC9nh
      c\u01B0\u1EDDng h\xF3a r\u1ED3i di chuy\u1EC3n \u0111\u1EBFn ngo\u1EA1i vi
      kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692721
    m_Localized: "N\u1EBFu c\u01B0\u1EDDng h\xF3a k\xE9o d\xE0i \u0111\u1EBFn t\u1EADn
      tr\u1EADn cu\u1ED1i th\xEC ph\u1EA3i ch\u1ECDn c\u1EA9n th\u1EADn h\u01A1n
      r\u1ED3i!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692722
    m_Localized: "Ti\u1EBFng b\u01B0\u1EDBc ch\xE2n t\u1EEB ph\xEDa ngo\u1EA1i vi
      nhi\u1EC1u h\u01A1n r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692723
    m_Localized: "\xC2m thanh c\u1EE7a ng\u01B0\u1EDDi s\u01A1 t\xE1n ch\u1ED3ng
      v\u1EDBi chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a qu\xE1i v\u1EADt n\xEAn kh\xF3
      ph\xE2n bi\u1EC7t."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692724
    m_Localized: "V\xEC v\u1EADy ph\u1EA3i ki\u1EC3m tra ch\u1EADm h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692725
    m_Localized: "\u0110\u01B0a ng\u01B0\u1EDDi d\xE2n ra tr\u01B0\u1EDBc, r\u1ED3i
      ch\u1EB7n ri\xEAng con \u0111\u01B0\u1EDDng qu\xE1i v\u1EADt \u0111i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692726
    m_Localized: "Ng\u01B0\u1EDDi d\xE2n \u1EDF ngo\u1EA1i vi s\u1EBD l\xE0m theo
      ch\u1EC9 d\u1EABn c\u1EE7a H\u1ED9 V\u1EC7."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692727
    m_Localized: "Ch\u1EC9 c\u1EA7n m\u1EDF \u0111\u01B0\u1EDDng, ch\xFAng t\xF4i
      s\u1EBD chuy\u1EC3n tr\u1EBB em v\xE0 ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng
      tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692728
    m_Localized: "T\u1ED1t. \u0110\xF3 l\xE0 th\u1EE9 t\u1EF1 \u0111\xFAng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692729
    m_Localized: "L\u1EA7n n\xE0y h\xE3y chia s\u1EE9c ngay t\u1EEB \u0111\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692730
    m_Localized: "H\xE3y \u0111\u1EA3m b\u1EA3o \u0111\u01B0\u1EDDng s\u01A1 t\xE1n
      \u1EDF ngo\u1EA1i vi."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692731
    m_Localized: "H\xE3y t\xE1ch ri\xEAng \u0111\u01B0\u1EDDng ng\u01B0\u1EDDi d\xE2n
      di chuy\u1EC3n v\xE0 \u0111\u01B0\u1EDDng ch\xFAng ta s\u1EBD ph\xF2ng th\u1EE7."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692732
    m_Localized: "\u1EEA. C\u1EE9 \u0111\u1EC3 ng\u01B0\u1EDDi b\xEAn trong \u0111i
      qua, c\xF2n nh\xF3m \u0111ang ti\u1EBFn v\xE0o t\xF4i s\u1EBD ch\u1EB7n!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692733
    m_Localized: "Tr\u01B0\u1EDBc h\u1EBFt ki\u1EC3m tra \u0111i\u1EC3m h\u1EB9p
      \u0111\u1EA7u ti\xEAn \u1EDF ngo\u1EA1i vi."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692734
    m_Localized: "Ngo\u1EA1i vi kinh \u0111\xF4 Atra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692735
    m_Localized: "Ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng v\xE0 tr\u1EBB em \u0111ang
      di chuy\u1EC3n \u0111\u1EBFn n\u01A1i tr\xFA \u1EA9n b\xEAn trong."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692736
    m_Localized: "Ch\xFAng t\xF4i \u0111ang chuy\u1EC3n xe v\u1EADt t\u01B0 sang
      \u0111\u01B0\u1EDDng ngo\xE0i, nh\u01B0ng \u0111i\u1EC3m h\u1EB9p c\u1EE9 li\xEAn
      t\u1EE5c b\u1ECB ch\u1EB7n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692737
    m_Localized: "D\u1EA5u ch\xE2n ch\u1ED3ng l\xEAn v\u1EBFt xe."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692738
    m_Localized: "Qu\xE1i v\u1EADt kh\xF4ng nh\u1EAFm v\xE0o xe. Ch\xFAng b\u1ECB
      d\u1ED3n theo c\xF9ng con \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692739
    m_Localized: "V\u1EADy ph\u1EA3i \u0111\u1EC3 tr\u1ED1ng \u0111\u01B0\u1EDDng
      cho xe \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692740
    m_Localized: "N\u1EBFu xe b\u1ECB ch\u1EB7n th\xEC v\u1EADt t\u01B0 ch\u1EEFa
      tr\u1ECB c\u0169ng b\u1ECB ch\u1EB7n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692741
    m_Localized: "\u0110\xE2y l\xE0 con \u0111\u01B0\u1EDDng quan tr\u1ECDng h\u01A1n
      v\u1EBB ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692742
    m_Localized: "Ph\u1EA3n \u1EE9ng c\u1EE7a c\u1ED9t ph\u1EE5 \u1EDF ngo\u1EA1i
      vi b\u1EA5t \u1ED5n h\u01A1n c\u1ED9t tr\xEAn \u0111\u1ED3ng b\u1EB1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692743
    m_Localized: "V\xEC ng\u01B0\u1EDDi v\xE0 qu\xE1i v\u1EADt c\xF9ng d\u1ED3n v\xE0o
      m\u1ED9t \u0111\u01B0\u1EDDng n\xEAn ph\u1EA3n \u1EE9ng c\u1EE7a \u0111\xE1
      t\xEDn hi\u1EC7u c\u0169ng ph\u1EE9c t\u1EA1p h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692744
    m_Localized: "Tr\u01B0\u1EDBc h\u1EBFt h\xE3y t\xE1ch \u0111\u01B0\u1EDDng ng\u01B0\u1EDDi
      d\xE2n \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692745
    m_Localized: "Qu\xE1i v\u1EADt \u0111ang \u0111i v\xE0o con \u0111\u01B0\u1EDDng
      n\xE0o?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692746
    m_Localized: "Ph\xEDa sau kho v\u1EADt t\u01B0 ph\xEDa b\u1EAFc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692747
    m_Localized: "D\u1EA5u ch\xE2n cong theo t\u01B0\u1EDDng kho r\u1ED3i ti\u1EBFp
      t\u1EE5c v\u1EC1 ph\xEDa c\u1ED5ng kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692748
    m_Localized: "H\xE3y ch\u1EB7n tr\u01B0\u1EDBc kho v\u1EADt t\u01B0 ph\xEDa b\u1EAFc
      tr\u01B0\u1EDBc khi ch\xFAng \u0111\u1EBFn c\u1ED5ng kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692749
    m_Localized: "T\xF4i s\u1EBD kh\xF4ng \u0111\u1EC3 ch\xFAng \u0111\u1EBFn con
      \u0111\u01B0\u1EDDng m\u1ECDi ng\u01B0\u1EDDi \u0111ang \u0111i!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692750
    m_Localized: "T\u1ED1t. T\xF4i s\u1EBD chuy\u1EC3n ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng
      sang \u0111\u01B0\u1EDDng b\xEAn ph\u1EA3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692751
    m_Localized: "\u0110\u1EEBng \u0111\u1EC3 h\u1ECD ch\u1EA1y, h\xE3y cho h\u1ECD
      \u0111i b\u1ED9. N\u1EBFu ng\xE3 th\xEC s\u1EBD c\xE0ng ch\u1EADm h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692752
    m_Localized: "\u0110\xE3 r\xF5. Ch\xFAng t\xF4i s\u1EBD h\u01B0\u1EDBng d\u1EABn
      h\u1ECD theo \u0111\u01B0\u1EDDng b\xEAn ph\u1EA3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692753
    m_Localized: "N\xF3 gi\u1ED1ng v\u1EA5n \u0111\u1EC1 k\xEAnh n\u01B0\u1EDBc ch\xFAng
      ta t\u1EEBng th\u1EA5y \u1EDF Zeppel."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692754
    m_Localized: "Khi \u0111\u01B0\u1EDDng b\u1ECB ch\u1EB7n, kh\xF4ng ch\u1EC9 qu\xE1i
      v\u1EADt m\xE0 vi\u1EC7c di chuy\u1EC3n c\u1EE7a ng\u01B0\u1EDDi d\xE2n c\u0169ng
      b\u1ECB ch\u1EB7n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692755
    m_Localized: "T\xF4i c\u0169ng th\u1EA5y chuy\u1EC3n \u0111\u1ED9ng \u1EDF \u0111\u01B0\u1EDDng
      b\xEAn c\u1EA1nh kho."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692756
    m_Localized: "N\u1EBFu ch\u1EC9 ch\u1EB7n \u0111\u01B0\u1EDDng ph\xEDa d\u01B0\u1EDBi
      th\xEC ch\xFAng c\xF3 th\u1EC3 l\u1ECDt ra \u0111\u01B0\u1EDDng b\xEAn c\u1EA1nh."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692757
    m_Localized: "Serah, ch\u1EB7n ph\xEDa tr\u01B0\u1EDBc kho. Noah, quan s\xE1t
      \u0111\u01B0\u1EDDng b\xEAn c\u1EA1nh."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692758
    m_Localized: "Alice, h\u1EA1 ph\u1EA3n \u1EE9ng c\u1EE7a c\u1ED9t ph\u1EE5 xu\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692759
    m_Localized: "C\u1EE9 giao cho t\xF4i! T\xF4i s\u1EBD kh\xF4ng \u0111\u1EC3 ch\xFAng
      \u0111i qua ph\xEDa tr\u01B0\u1EDBc kho!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692760
    m_Localized: "T\xF4i s\u1EBD quan s\xE1t \u0111\u01B0\u1EDDng b\xEAn c\u1EA1nh.
      N\u1EBFu chuy\u1EC3n \u0111\u1ED9ng t\xE1ch ra t\xF4i s\u1EBD b\xE1o ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692761
    m_Localized: "N\u1EBFu ph\u1EA3n \u1EE9ng c\u1EE7a c\u1ED9t gi\u1EA3m th\xEC
      dao \u0111\u1ED9ng ph\xEDa \u0111\u01B0\u1EDDng s\u01A1 t\xE1n c\u0169ng s\u1EBD
      gi\u1EA3m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692762
    m_Localized: "Trong l\xFAc \u0111\xF3 t\xF4i s\u1EBD chia ng\u01B0\u1EDDi b\u1ECB
      th\u01B0\u01A1ng th\xE0nh t\u1EEBng nh\xF3m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692763
    m_Localized: "Ph\u1EA3i ph\xE2n bi\u1EC7t ng\u01B0\u1EDDi c\u1EA7n ch\u1EEFa
      tr\u1ECB ngay v\u1EDBi ng\u01B0\u1EDDi c\xF3 th\u1EC3 \u0111\u1EE3i \u0111\u1EBFn
      khi v\xE0o b\xEAn trong c\u1ED5ng kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692764
    m_Localized: "H\xF4m nay m\u1ECDi ng\u01B0\u1EDDi s\u1EBD v\xE0o trong an to\xE0n
      c\u1EA3 th\xF4i!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692765
    m_Localized: "L\xE0m \u01A1n n\xF3i c\xE2u \u0111\xF3 nh\u1ECF h\u01A1n m\u1ED9t
      ch\xFAt..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692766
    m_Localized: "Nh\xF3m ph\xEDa sau kho \u0111ang ti\u1EBFn v\xE0o \u0111i\u1EC3m
      h\u1EB9p."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692767
    m_Localized: "M\u1ED9t nh\xF3m nh\u1ECF c\u0169ng t\xE1ch v\u1EC1 ph\xEDa \u0111\u01B0\u1EDDng
      b\xEAn c\u1EA1nh."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692768
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n \u1EDF ngo\u1EA1i vi kinh
      \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692769
    m_Localized: "H\xE3y \u0111\u1EC3 \u0111\u01B0\u1EDDng s\u01A1 t\xE1n th\xF4ng
      tho\xE1ng v\xE0 ch\u1EB7n nh\xF3m \u0111i v\xE0o t\u1EEB ph\xEDa sau kho."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692770
    m_Localized: "Ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng v\xE0 tr\u1EBB em \u0111\xE3
      v\xE0o b\xEAn trong c\u1ED5ng kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692771
    m_Localized: "H\u01A1n m\u1ED9t n\u1EEDa xe ch\u1EDF v\u1EADt t\u01B0 c\u0169ng
      \u0111\xE3 di chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692772
    m_Localized: "T\u1ED1t. \u0110\xE3 b\u1EA3o v\u1EC7 \u0111\u01B0\u1EE3c ngo\u1EA1i
      vi."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692773
    m_Localized: "Nh\u01B0ng d\u1EA5u v\u1EBFt qu\xE1i v\u1EADt ti\u1EBFp t\u1EE5c
      v\u1EC1 ph\xEDa c\u1ED5ng kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692774
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng kh\xF4ng k\u1EBFt th\xFAc \u1EDF ngo\u1EA1i
      vi."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692775
    m_Localized: "Ph\u1EA3n \u1EE9ng c\u1EE7a c\u1ED9t ph\u1EE5 c\u0169ng \u0111ang
      ch\u1EA3y v\u1EC1 ph\xEDa c\u1ED5ng kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692776
    m_Localized: "C\xE0ng \u0111\u1EBFn g\u1EA7n trung t\xE2m m\u1EA1ng l\u01B0\u1EDBi
      ph\xF2ng th\u1EE7, ph\u1EA3n \u1EE9ng c\xE0ng r\xF5."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692777
    m_Localized: "Khi m\u1ECDi ng\u01B0\u1EDDi t\u1EADp trung \u1EDF c\u1ED5ng kinh
      \u0111\xF4, th\u1EE9 t\u1EF1 ch\u1EEFa tr\u1ECB s\u1EBD c\xE0ng quan tr\u1ECDng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692778
    m_Localized: "Gi\u1EDD ph\u1EA3i ki\u1EC3m tra l\u1EA1i ng\u01B0\u1EDDi b\u1ECB
      th\u01B0\u01A1ng \u1EDF b\xEAn trong."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692779
    m_Localized: "H\xE3y duy tr\xEC s\u01A1 t\xE1n \u1EDF ngo\u1EA1i vi v\xE0 di
      chuy\u1EC3n \u0111\u1EBFn tuy\u1EBFn ph\xF2ng th\u1EE7 \u1EDF c\u1ED5ng kinh
      \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692780
    m_Localized: "N\u1EBFu c\u1ED5ng kinh \u0111\xF4 dao \u0111\u1ED9ng th\xEC s\u1EF1
      h\u1ED7n lo\u1EA1n s\u1EBD lan th\u1EB3ng v\xE0o b\xEAn trong kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692781
    m_Localized: "V\u1EADy th\xEC h\xE3y ch\u1EB7n ch\xFAng th\u1EADt ch\u1EAFc tr\u01B0\u1EDBc
      c\u1ED5ng kinh \u0111\xF4!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692782
    m_Localized: "T\xF4i nghe th\u1EA5y ti\u1EBFng b\u01B0\u1EDBc ch\xE2n n\u1EB7ng
      g\u1EA7n c\u1ED5ng kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692783
    m_Localized: "Ch\xFAng g\u1EA7n h\u01A1n nhi\u1EC1u so v\u1EDBi tr\xEAn \u0111\u1ED3ng
      b\u1EB1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535729692784
    m_Localized: "C\u1ED9t ph\u1EE5 \u1EDF c\u1ED5ng kinh \u0111\xF4 l\xE0 \u0111i\u1EC3m
      ki\u1EC3m tra ti\u1EBFp theo."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886976
    m_Localized: "C\u1ED5ng kinh \u0111\xF4 Atra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886977
    m_Localized: "Nh\u1EEFng ng\u01B0\u1EDDi s\u01A1 t\xE1n t\u1EEB ngo\u1EA1i vi
      \u0111ang \u0111i v\xE0o b\xEAn trong c\u1ED5ng kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886978
    m_Localized: "Nh\u01B0ng c\u1ED9t ph\u1EE5 \u1EDF c\u1ED5ng v\u1EABn li\xEAn
      t\u1EE5c rung chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886979
    m_Localized: "C\u1ED9t c\u1ED5ng l\xE0 m\u1ED9t \u0111i\u1EC3m ph\xE2n nh\xE1nh
      l\u1EDBn c\u1EE7a m\u1EA1ng l\u01B0\u1EDBi ph\xF2ng th\u1EE7."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886980
    m_Localized: "Ph\u1EA3n \u1EE9ng t\u1EEB \u0111\u1ED3ng b\u1EB1ng v\xE0 ngo\u1EA1i
      vi l\u1EA1i h\u1ED9i t\u1EE5 m\u1ED9t l\u1EA7n n\u1EEFa \u1EDF c\u1ED9t ph\u1EE5
      c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886981
    m_Localized: "D\u1EA5u ch\xE2n c\u0169ng h\u1ED9i t\u1EE5 tr\u01B0\u1EDBc c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886982
    m_Localized: "Ch\xFAng kh\xF4ng x\u1EBFp h\xE0ng \u0111\u1EC3 t\u1EA5n c\xF4ng
      c\u1ED5ng. \u0110\xE2y l\xE0 d\u1EA5u v\u1EBFt ch\xFAng m\u1EA5t ph\u01B0\u01A1ng
      h\u01B0\u1EDBng tr\u01B0\u1EDBc c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886983
    m_Localized: "D\xF9 b\u1ECB l\u1EA1c c\u0169ng kh\xF4ng th\u1EC3 \u0111\u1EC3
      ch\xFAng \u0111i qua c\u1ED5ng kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886984
    m_Localized: "\u1EDE \u0111\xE2y c\xF3 qu\xE1 nhi\u1EC1u ng\u01B0\u1EDDi ph\xEDa
      sau."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886985
    m_Localized: "Ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng \u0111\xE3 t\u1EADp trung
      b\xEAn trong c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886986
    m_Localized: "N\u1EBFu b\u1ECB \u0111\u1EA9y l\xF9i tr\u01B0\u1EDBc c\u1ED5ng
      th\xEC vi\u1EC7c s\u01A1 t\xE1n s\u1EBD s\u1EE5p \u0111\u1ED5 tr\u01B0\u1EDBc
      c\u1EA3 vi\u1EC7c ch\u1EEFa tr\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886987
    m_Localized: "C\xF3 th\u1EC3 \u0111\xF3ng c\u1ED5ng kinh \u0111\xF4 kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886988
    m_Localized: "N\u1EBFu \u0111\xF3ng ho\xE0n to\xE0n th\xEC nh\u1EEFng ng\u01B0\u1EDDi
      t\u1EEB ngo\u1EA1i vi \u0111\u1EBFn s\u1EBD b\u1ECB b\u1ECF l\u1EA1i b\xEAn
      ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886989
    m_Localized: "Ch\xFAng ta kh\xF4ng c\xF2n c\xE1ch n\xE0o kh\xE1c ngo\xE0i vi\u1EC7c
      gi\u1EEF n\xF3 m\u1EDF m\u1ED9t n\u1EEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886990
    m_Localized: "N\u1EBFu c\u1ED1 \u0111\xF3ng c\u1ED5ng th\xEC ph\u1EA3n \u1EE9ng
      c\u1EE7a c\u1ED9t ph\u1EE5 c\u0169ng c\xF3 th\u1EC3 b\xF9ng v\xE0o ph\xEDa
      trong."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886991
    m_Localized: "H\xE3y d\xF9ng c\u1ED5ng nh\u01B0 m\u1ED9t t\u1EA5m khi\xEAn, nh\u01B0ng
      \u0111\u1EEBng nh\u1ED1t ph\u1EA3n \u1EE9ng l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886992
    m_Localized: "V\u1EADy th\xEC ch\u1EB7n tr\u01B0\u1EDBc c\u1ED5ng v\xE0 ch\u1EEBa
      \u0111\u01B0\u1EDDng cho ng\u01B0\u1EDDi d\xE2n \u0111i v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886993
    m_Localized: "Khu v\u1EF1c b\xEAn d\u01B0\u1EDBi b\u1EE9c t\u01B0\u1EDDng b\xEAn
      tr\xE1i nguy hi\u1EC3m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886994
    m_Localized: "M\u1ED9t nh\xF3m nh\u1ECF \u0111ang \u0111i theo r\xE3nh d\u01B0\u1EDBi
      t\u01B0\u1EDDng, kh\xF4ng ph\u1EA3i qua khe c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886995
    m_Localized: "Ph\u1EA3i c\xF9ng l\xFAc \u0111\u1EC3 \xFD c\u1EA3 khe c\u1ED5ng
      l\u1EABn r\xE3nh d\u01B0\u1EDBi t\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886996
    m_Localized: "T\xF4i s\u1EBD \u0111\u01B0a ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng
      b\xEAn trong c\u1ED5ng l\xF9i v\xE0o s\xE2u h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886997
    m_Localized: "V\u1EBFt th\u01B0\u01A1ng nh\u1EB9 c\xF3 th\u1EC3 ch\u1EEFa sau,
      nh\u01B0ng kh\xF4ng \u0111\u01B0\u1EE3c \u0111\u1EC3 ai \u1EDF l\u1EA1i tr\u01B0\u1EDBc
      c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886998
    m_Localized: "Ch\xFAng ta ch\u1EB7n b\xE2y gi\u1EDD \u0111\u1EC3 sau n\xE0y c\xF3
      th\u1EC3 lo cho t\u1EA5t c\u1EA3 \u0111\xFAng kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733886999
    m_Localized: "\u1EEA. Ch\xFAng ta \u0111ang chia th\u1EE9 t\u1EF1, kh\xF4ng ph\u1EA3i
      b\u1ECF m\u1EB7c ai."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887000
    m_Localized: "C\xE1c hoa v\u0103n tr\xEAn c\u1ED9t c\u1ED5ng \u0111\u01B0\u1EE3c
      kh\u1EAFc theo c\xF9ng h\u01B0\u1EDBng v\u1EDBi ph\xF2ng \u0111i\u1EC1u khi\u1EC3n
      Norua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887001
    m_Localized: "Ph\u1EA3n \u1EE9ng \u0111\u01B0\u1EE3c chuy\u1EC3n ti\u1EBFp qua
      Norua ti\u1EBFp t\u1EE5c \u0111\u1EBFn t\u1EADn c\u1ED9t ph\u1EE5 \u1EDF c\u1ED5ng
      n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887002
    m_Localized: "V\u1EADy c\xF3 ngh\u0129a l\xE0 m\u1EA1ng l\u01B0\u1EDBi ph\xF2ng
      th\u1EE7 c\u1EE7a kinh \u0111\xF4 \u0111ang dao \u0111\u1ED9ng sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887003
    m_Localized: "Kh\u1EA3 n\u0103ng cao. Nh\u01B0ng trung t\xE2m v\u1EABn c\xF2n
      \u1EDF s\xE2u h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887004
    m_Localized: "Nh\xF3m ph\xEDa tr\u01B0\u1EDBc c\u1ED5ng \u0111ang ti\u1EBFn l\u1EA1i
      g\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887005
    m_Localized: "C\u0169ng c\xF3 nh\xF3m \u0111ang \u0111i v\xE0o theo r\xE3nh b\xEAn
      tr\xE1i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887006
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n \u1EDF c\u1ED5ng kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887007
    m_Localized: "H\xE3y \u0111\u1EC3 c\u1ED5ng m\u1EDF v\xE0 ch\u1EB7n c\xE1c nh\xF3m
      \u0111ang ti\u1EBFn v\xE0o tr\u01B0\u1EDBc c\u1ED5ng v\xE0 \u1EDF r\xE3nh b\xEAn
      tr\xE1i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887008
    m_Localized: "T\xF4i s\u1EBD kh\xF4ng \u0111\u1EC3 ch\xFAng \u0111i ra ph\xEDa
      sau c\u1ED5ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887009
    m_Localized: "T\xF4i s\u1EBD th\u1EED h\u1EA1 ph\u1EA3n \u1EE9ng c\u1EE7a c\u1ED9t
      ph\u1EE5."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887010
    m_Localized: "N\u1EBFu b\u1ECB th\u01B0\u01A1ng th\xEC r\xFAt v\u1EC1 ph\xEDa
      b\xEAn ph\u1EA3i b\xEAn trong c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887011
    m_Localized: "Nh\xF3m qu\xE1i v\u1EADt s\u1EBD s\u1EDBm \u0111\u1EBFn tuy\u1EBFn
      ph\xF2ng th\u1EE7 tr\u01B0\u1EDBc c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887012
    m_Localized: "\u0110\xE3 ch\u1EB7n \u0111\u01B0\u1EE3c ph\xEDa tr\u01B0\u1EDBc
      c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887013
    m_Localized: "Kh\xF4ng c\xF3 nh\xF3m n\xE0o v\xE0o \u0111\u01B0\u1EE3c b\xEAn
      trong."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887014
    m_Localized: "Nh\u01B0ng \xE1nh s\xE1ng t\u1EEB c\u1ED9t ph\u1EE5 v\u1EABn ti\u1EBFp
      t\u1EE5c v\u1EC1 ph\xEDa trong."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887015
    m_Localized: "Chuy\u1EC7n ch\u01B0a k\u1EBFt th\xFAc \u1EDF c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887016
    m_Localized: "C\u1ED5ng kinh \u0111\xF4 l\xE0 \u0111i\u1EC3m ph\xE2n nh\xE1nh
      cu\u1ED1i c\xF9ng tr\u01B0\u1EDBc khi v\xE0o trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887017
    m_Localized: "Ph\u1EA3n \u1EE9ng \u0111ang h\u1ED9i t\u1EE5 v\u1EC1 ph\xEDa tuy\u1EBFn
      ph\xF2ng th\u1EE7 cu\u1ED1i c\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887018
    m_Localized: "Tuy\u1EBFn ph\xF2ng th\u1EE7 cu\u1ED1i c\xF9ng l\xE0 b\u1EE9c t\u01B0\u1EDDng
      cu\u1ED1i tr\u01B0\u1EDBc qu\u1EA3ng tr\u01B0\u1EDDng trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887019
    m_Localized: "N\u1EBFu n\u01A1i \u0111\xF3 dao \u0111\u1ED9ng th\xEC trung t\xE2m
      kinh \u0111\xF4 s\u1EBD l\u1EADp t\u1EE9c g\u1EB7p nguy hi\u1EC3m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887020
    m_Localized: "Ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng b\xEAn trong c\u1ED5ng
      \u0111\xE3 \u0111\u01B0\u1EE3c di chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887021
    m_Localized: "Tr\u01B0\u1EDBc khi v\xE0o tuy\u1EBFn ph\xF2ng th\u1EE7 cu\u1ED1i
      c\xF9ng, ph\u1EA3i chia l\u1EA1i ngu\u1ED3n l\u1EF1c ch\u1EEFa tr\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887022
    m_Localized: "H\xE3y ghi l\u1EA1i ph\xF2ng th\u1EE7 c\u1ED5ng r\u1ED3i di chuy\u1EC3n
      \u0111\u1EBFn tuy\u1EBFn ph\xF2ng th\u1EE7 cu\u1ED1i c\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887023
    m_Localized: "Ph\u1EA3i ki\u1EC3m tra ph\u1EA3n \u1EE9ng d\u1EABn v\u1EC1 qu\u1EA3ng
      tr\u01B0\u1EDDng trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887024
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y \u0111\u1EBFn t\u1EADn tuy\u1EBFn ph\xF2ng
      th\u1EE7 cu\u1ED1i c\xF9ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887025
    m_Localized: "R\xE3nh b\xEAn d\u01B0\u1EDBi c\u1ED5ng v\u1EABn ti\u1EBFp t\u1EE5c
      k\xE9o d\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887026
    m_Localized: "Ch\xFAng ta s\u1EBD kh\xF4ng \u0111\u1EC3 m\u1EA5t \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887027
    m_Localized: "\u0110\xE3 \u0111\u1EBFn g\u1EA7n ph\u1EA3n \u1EE9ng c\u1EE7a \u0111\xE1
      t\xEDn hi\u1EC7u trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887028
    m_Localized: "C\xF3 v\u1EBB c\xF3 th\u1EC3 x\xE1c \u0111\u1ECBnh \u0111i\u1EC3m
      ph\u1EA3n \u1EE9ng h\u1ED9i t\u1EE5 \u1EDF tuy\u1EBFn ph\xF2ng th\u1EE7 cu\u1ED1i
      c\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887029
    m_Localized: "Tuy\u1EBFn ph\xF2ng th\u1EE7 cu\u1ED1i c\xF9ng c\u1EE7a Atra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887030
    m_Localized: "T\u1EA5t c\u1EA3 c\xE1c r\xE3nh h\u1EE3p l\u1EA1i th\xE0nh m\u1ED9t
      b\xEAn d\u01B0\u1EDBi tuy\u1EBFn ph\xF2ng th\u1EE7 cu\u1ED1i c\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887031
    m_Localized: "Ph\u1EA3n \u1EE9ng \u0111i qua \u0111\u1ED3ng b\u1EB1ng, ngo\u1EA1i
      vi v\xE0 c\u1ED5ng \u0111ang h\u1ED9i t\u1EE5 b\xEAn d\u01B0\u1EDBi tuy\u1EBFn
      ph\xF2ng th\u1EE7 n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887032
    m_Localized: "D\u1EA5u ch\xE2n c\u0169ng ph\u1EE9c t\u1EA1p nh\u1EA5t tr\u01B0\u1EDBc
      tuy\u1EBFn ph\xF2ng th\u1EE7 cu\u1ED1i c\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887033
    m_Localized: "Qu\xE1i v\u1EADt b\u1ECB d\u1ED3n \u0111\u1EBFn t\u1EEB nh\u1EEFng
      n\u01A1i kh\xE1c nhau, nh\u01B0ng cu\u1ED1i c\xF9ng \u0111\u1EC1u h\u1ED9i
      t\u1EE5 tr\xEAn c\xF9ng m\u1ED9t tuy\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887034
    m_Localized: "V\u1EADy \u0111\xE2y th\u1EADt s\u1EF1 l\xE0 ng\u01B0\u1EE1ng c\u1EEDa
      cu\u1ED1i c\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887035
    m_Localized: "T\xF4i th\xEDch t\u1EEB 'cu\u1ED1i c\xF9ng', nh\u01B0ng ph\u1EA7n
      cu\u1ED1i th\u01B0\u1EDDng l\xE0 ph\u1EA7n kh\xF3 nh\u1EA5t..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887036
    m_Localized: "Qu\u1EA3ng tr\u01B0\u1EDDng trung t\xE2m \u1EDF ph\xEDa sau tuy\u1EBFn
      ph\xF2ng th\u1EE7 n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887037
    m_Localized: "\u0110\xE1 t\xEDn hi\u1EC7u trung t\xE2m c\u1EE7a m\u1EA1ng l\u01B0\u1EDBi
      ph\xF2ng th\u1EE7 kinh \u0111\xF4 c\u0169ng \u1EDF b\xEAn d\u01B0\u1EDBi \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887038
    m_Localized: "N\u1EBFu \u0111\xE1 t\xEDn hi\u1EC7u trung t\xE2m b\u1EA5t \u1ED5n
      th\xEC \u1EA3nh h\u01B0\u1EDFng s\u1EBD lan \u0111\u1EBFn c\xE1c khu v\u1EF1c
      xung quanh sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887039
    m_Localized: "\u1EEA. B\xE2y gi\u1EDD ph\u1EA3i hi\u1EC3u nh\u01B0 v\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887040
    m_Localized: "Cies, Zeppel, Lumer, Verdin, Milen v\xE0 Norua \u0111\u1EC1u l\xE0
      c\xE1c c\xF4ng tr\xECnh thu\u1ED9c m\u1EA1ng l\u01B0\u1EDBi b\xEAn ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887041
    m_Localized: "Ph\u1EA3n \u1EE9ng t\u1EEB \u0111\xE1 t\xEDn hi\u1EC7u trung t\xE2m
      ch\u1EA3y ng\u01B0\u1EE3c khi\u1EBFn thi\u1EBFt b\u1ECB \u1EDF t\u1EEBng khu
      v\u1EF1c dao \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887042
    m_Localized: "V\u1EADy t\u1EEB \u0111\u1EA7u qu\xE1i v\u1EADt kh\xF4ng nh\u1EAFm
      v\xE0o kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887043
    m_Localized: "\u0110\xFAng. Con \u0111\u01B0\u1EDDng qu\xE1i v\u1EADt b\u1ECB
      d\u1ED3n \u0111\u1EBFn l\u1EA1i h\u1ED9i t\u1EE5 v\u1EC1 ph\xEDa kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887044
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng c\u1EE7a qu\xE1i v\u1EADt tr\u01B0\u1EDBc
      tuy\u1EBFn ph\xF2ng th\u1EE7 cu\u1ED1i c\xF9ng kh\xF4ng \u1ED5n \u0111\u1ECBnh."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887045
    m_Localized: "Ch\xFAng kh\xF4ng ph\u1ED1i h\u1EE3p \u0111\u1EC3 t\u1EA5n c\xF4ng.
      C\xF3 v\u1EBB c\u01A1 th\u1EC3 b\u1ECB gi\u1EADt m\u1ED7i khi ph\u1EA3n \u1EE9ng
      t\u0103ng l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887046
    m_Localized: "V\u1EADy c\xF2n nguy hi\u1EC3m h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887047
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng kh\xF4ng th\u1EC3 \u0111o\xE1n tr\u01B0\u1EDBc
      s\u1EBD khi\u1EBFn nhi\u1EC1u ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887048
    m_Localized: "T\xECnh tr\u1EA1ng tuy\u1EBFn ph\xF2ng th\u1EE7 th\u1EBF n\xE0o?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887049
    m_Localized: "T\u01B0\u1EDDng c\xF3 th\u1EC3 tr\u1EE5, nh\u01B0ng kh\xF4ng l\xE2u
      \u0111\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887050
    m_Localized: "N\u1EBFu b\u1ECB \u0111\u1EA9y v\xE0o qu\u1EA3ng tr\u01B0\u1EDDng
      trung t\xE2m th\xEC s\u1EF1 h\u1ED7n lo\u1EA1n s\u1EBD l\u1EADp t\u1EE9c ch\u1EA1m
      \u0111\u1EBFn b\u1ED9 ph\u1EADn \u0111i\u1EC1u khi\u1EC3n m\u1EA1ng l\u01B0\u1EDBi
      ph\xF2ng th\u1EE7."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887051
    m_Localized: "V\u1EADy ph\u1EA3i tr\u1EE5 \u1EDF tuy\u1EBFn ph\xF2ng th\u1EE7
      cu\u1ED1i c\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887052
    m_Localized: "Nh\u1EEFng ng\u01B0\u1EDDi ph\xEDa sau v\xE0 m\u1ECDi n\u01A1i
      ch\xFAng ta \u0111\xE3 \u0111i qua \u0111\u1EC1u n\u1ED1i v\u1EDBi nhau."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887053
    m_Localized: "Khu v\u1EF1c b\xEAn d\u01B0\u1EDBi b\u1EE9c t\u01B0\u1EDDng b\xEAn
      ph\u1EA3i rung tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887054
    m_Localized: "Nh\xF3m l\u1EDBn s\u1EBD \u0111\u1EBFn khu v\u1EF1c b\xEAn d\u01B0\u1EDBi
      b\u1EE9c t\u01B0\u1EDDng b\xEAn ph\u1EA3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887055
    m_Localized: "M\u1ED7i khi ph\u1EA3n \u1EE9ng c\u1EE7a \u0111\xE1 t\xEDn hi\u1EC7u
      trung t\xE2m l\u1EDBn l\xEAn, r\xE3nh b\xEAn ph\u1EA3i l\u1EA1i s\xE1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887056
    m_Localized: "N\u1EBFu kh\xF4ng gi\u1EEF khu v\u1EF1c b\xEAn d\u01B0\u1EDBi b\u1EE9c
      t\u01B0\u1EDDng b\xEAn ph\u1EA3i th\xEC ph\u1EA3n \u1EE9ng c\xF3 th\u1EC3 \u0111i
      v\xE0o ph\xEDa trong tuy\u1EBFn ph\xF2ng th\u1EE7."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887057
    m_Localized: "H\xE3y ch\u1EB7n b\xEAn d\u01B0\u1EDBi b\u1EE9c t\u01B0\u1EDDng
      b\xEAn ph\u1EA3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887058
    m_Localized: "H\xE3y b\u1EA3o v\u1EC7 r\xE3nh d\u1EABn \u0111\u1EBFn qu\u1EA3ng
      tr\u01B0\u1EDDng trung t\xE2m v\xE0 ch\u1EB7n nh\xF3m qu\xE1i v\u1EADt tr\u01B0\u1EDBc
      tuy\u1EBFn ph\xF2ng th\u1EE7."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887059
    m_Localized: "Tuy\u1EBFn ph\xF2ng th\u1EE7 n\xE0y s\u1EBD l\xE0 c\u01A1 h\u1ED9i
      chu\u1EA9n b\u1ECB cu\u1ED1i c\xF9ng c\u1EE7a ch\xFAng ta."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887060
    m_Localized: "N\u1EBFu c\u1ED1 qu\xE1 b\xE2y gi\u1EDD th\xEC s\u1EBD kh\xF4ng
      c\xF2n g\xEC cho tr\u1EADn cu\u1ED1i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887061
    m_Localized: "T\xF4i s\u1EBD ch\u1EB7n ch\xFAng m\xE0 kh\xF4ng c\u1ED1 qu\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887062
    m_Localized: "Nh\u01B0ng tuy\u1EC7t \u0111\u1ED1i t\xF4i s\u1EBD kh\xF4ng \u0111\u1EC3
      ch\xFAng \u0111i qua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887063
    m_Localized: "Nh\xF3m \u0111i ra tr\u01B0\u1EDBc \u0111ang \u0111\u1EBFn khu
      v\u1EF1c b\xEAn d\u01B0\u1EDBi b\u1EE9c t\u01B0\u1EDDng b\xEAn ph\u1EA3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887064
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn h\u01A1n \u0111ang b\u1ECB
      k\xE9o v\u1EC1 ph\xEDa ph\u1EA3n \u1EE9ng \u1EDF qu\u1EA3ng tr\u01B0\u1EDDng
      trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887065
    m_Localized: "Ph\u1EA3n \u1EE9ng b\xEAn d\u01B0\u1EDBi tuy\u1EBFn ph\xF2ng th\u1EE7
      cu\u1ED1i c\xF9ng g\u1EA7n ch\u1EA1m \u0111\u1EBFn \u0111\xE1 t\xEDn hi\u1EC7u
      trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887066
    m_Localized: "Sau tr\u1EADn n\xE0y ph\u1EA3i l\u1EADp t\u1EE9c s\u1EEDa ch\u1EEFa."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887067
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n \u1EDF tuy\u1EBFn ph\xF2ng
      th\u1EE7 cu\u1ED1i c\xF9ng c\u1EE7a Atra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887068
    m_Localized: "H\xE3y gi\xE0nh th\u1EDDi gian cho l\u1EA7n chu\u1EA9n b\u1ECB
      cu\u1ED1i c\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887069
    m_Localized: "Tuy\u1EBFn ph\xF2ng th\u1EE7 \u0111\xE3 tr\u1EE5."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887070
    m_Localized: "Nh\xF3m l\u1EDBn \u0111\xE3 l\xF9i v\u1EC1 ph\xEDa qu\u1EA3ng tr\u01B0\u1EDDng
      trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887071
    m_Localized: "N\xF3 kh\xF4ng b\u1ECF ch\u1EA1y, m\xE0 c\xF3 v\u1EBB b\u1ECB k\xE9o
      tr\u1EDF l\u1EA1i v\u1EC1 ph\xEDa ph\u1EA3n \u1EE9ng m\u1EA1nh h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887072
    m_Localized: "Gi\u1EDD th\xEC ch\u1EAFc ch\u1EAFn r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887073
    m_Localized: "\u0110\xE1 t\xEDn hi\u1EC7u trung t\xE2m \u0111\xE3 \u0111\u1EA9y
      ph\u1EA3n \u1EE9ng ra ngo\xE0i qua m\u1EA1ng l\u01B0\u1EDBi ph\xF2ng th\u1EE7."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887074
    m_Localized: "Kh\xF4ng ph\u1EA3i thi\u1EBFt b\u1ECB b\xEAn ngo\xE0i h\u1ECFng
      tr\u01B0\u1EDBc. Ch\xFAng kh\xF4ng ch\u1ECBu n\u1ED5i ph\u1EA3n \u1EE9ng b\u1ECB
      \u0111\u1EA9y ra t\u1EEB trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887075
    m_Localized: "V\u1EADy n\u1EBFu \u1ED5n \u0111\u1ECBnh \u0111\xE1 t\xEDn hi\u1EC7u
      trung t\xE2m th\xEC ph\u1EA3n \u1EE9ng \u1EDF c\xE1c khu v\u1EF1c xung quanh
      c\u0169ng c\xF3 th\u1EC3 gi\u1EA3m theo."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887076
    m_Localized: "\u1EEA. Nh\u01B0ng n\u1EBFu c\u1ED1 c\u1EAFt th\xEC n\xF3 c\xF3
      th\u1EC3 b\xF9ng l\xEAn d\u1EEF d\u1ED9i h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887077
    m_Localized: "V\u1EADy cu\u1ED1i c\xF9ng v\u1EABn l\xE0 v\u1EEBa c\u1EA7m c\u1EF1
      v\u1EEBa \u0111i\u1EC1u ch\u1EC9nh..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887078
    m_Localized: "May l\xE0 ch\xFAng ta \u0111\xE3 \u0111\u1EC3 d\xE0nh s\u1EE9c."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887079
    m_Localized: "Tuy\u1EBFn ph\xF2ng th\u1EE7 cu\u1ED1i c\xF9ng v\u1EABn \u0111ang
      tr\u1EE5."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887080
    m_Localized: "Ch\xFAng t\xF4i s\u1EBD t\u1EA1o th\u1EDDi gian s\u1EEDa ch\u1EEFa
      tr\u01B0\u1EDBc khi c\xE1c v\u1ECB v\xE0o qu\u1EA3ng tr\u01B0\u1EDDng trung
      t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887081
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y s\u1EEDa t\u01B0\u1EDDng tr\u01B0\u1EDBc
      tr\u1EADn chi\u1EBFn cu\u1ED1i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887082
    m_Localized: "C\u0169ng ph\u1EA3i ho\xE0n t\u1EA5t \u0111i\u1EC1u ch\u1EC9nh
      \u0111\xE1 t\xEDn hi\u1EC7u c\u1EE7a b\u1ED1n anh h\xF9ng \u1EDF tuy\u1EBFn
      ph\xF2ng th\u1EE7 cu\u1ED1i c\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887083
    m_Localized: "\u0110\xE2y l\xE0 l\u1EA7n chu\u1EA9n b\u1ECB cu\u1ED1i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887084
    m_Localized: "T\xF4i th\u1EADt s\u1EF1 mong l\u1EA7n n\xE0y \u0111\xFAng l\xE0
      l\u1EA7n cu\u1ED1i!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887085
    m_Localized: "Serah, t\xF4i ch\u1EC9 ghi nh\u1EADn l\xE0 c\u1EADu \u0111\xE3
      n\xF3i v\u1EADy th\xF4i..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887086
    m_Localized: "Ti\u1EBFng v\u1ECDng b\xEAn d\u01B0\u1EDBi qu\u1EA3ng tr\u01B0\u1EDDng
      trung t\xE2m c\u1EE9 ti\u1EBFp t\u1EE5c vang."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887087
    m_Localized: "T\xF4i v\u1EABn ch\u01B0a \u0111\u1EC3 m\u1EA5t h\u01B0\u1EDBng
      \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887088
    m_Localized: "Ph\xEDa trong tuy\u1EBFn ph\xF2ng th\u1EE7 cu\u1ED1i c\xF9ng c\u1EE7a
      Atra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887089
    m_Localized: "Ch\xFAng t\xF4i \u0111\xE3 gia c\u1ED1 t\u1EA1m th\u1EDDi tuy\u1EBFn
      ph\xF2ng th\u1EE7 cu\u1ED1i c\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887090
    m_Localized: "D\xF9 kh\xF4ng th\u1EC3 tr\u1EE5 l\xE2u, n\xF3 v\u1EABn c\xF3 th\u1EC3
      c\xE2u gi\u1EDD cho \u0111\u1EBFn khi c\xE1c v\u1ECB v\xE0o qu\u1EA3ng tr\u01B0\u1EDDng
      trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887091
    m_Localized: "Ph\u1EA3n \u1EE9ng c\u1EE7a \u0111\xE1 t\xEDn hi\u1EC7u trung t\xE2m
      v\u1EABn \u0111ang t\u0103ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887092
    m_Localized: "N\u1EBFu kh\xF4ng \u0111i\u1EC1u ch\u1EC9nh b\xE2y gi\u1EDD th\xEC
      \u0111\xE1 t\xEDn hi\u1EC7u c\xF3 th\u1EC3 b\xF9ng l\xEAn trong qu\u1EA3ng
      tr\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887093
    m_Localized: "H\xE3y ho\xE0n t\u1EA5t l\u1EA7n \u0111i\u1EC1u ch\u1EC9nh c\u01B0\u1EDDng
      h\xF3a cu\u1ED1i b\xEAn trong tuy\u1EBFn ph\xF2ng th\u1EE7 cu\u1ED1i c\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887094
    m_Localized: "Nh\u1EEFng g\xEC ch\xFAng ta t\xEDch l\u0169y \u0111\u1EBFn \u0111\xE2y
      \u0111\u1EC1u \u0111\u01B0\u1EE3c gi\u1EEF l\u1EA1i \u0111\xFAng kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887095
    m_Localized: "\u1EEA. C\xE1c c\u01B0\u1EDDng h\xF3a v\xE0 \u0111i\u1EC1u ch\u1EC9nh
      \u0111\xE1 t\xEDn hi\u1EC7u \u0111\xE3 ch\u1ECDn cho \u0111\u1EBFn gi\u1EDD
      s\u1EBD c\xF2n trong tr\u1EADn cu\u1ED1i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887096
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng b\xEAn trong qu\u1EA3ng tr\u01B0\u1EDDng
      trung t\xE2m v\u1EABn \u0111ang l\u1EDBn l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887097
    m_Localized: "Nh\u01B0ng h\u01B0\u1EDBng \u0111i \u0111\xE3 r\xF5. L\u1EA7n n\xE0y
      t\xF4i s\u1EBD kh\xF4ng \u0111\u1EC3 m\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887098
    m_Localized: "T\xF4i c\xF3 th\u1EC3 chia ngu\u1ED3n l\u1EF1c ch\u1EEFa tr\u1ECB
      \u0111\u1EBFn t\u1EADn cu\u1ED1i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887099
    m_Localized: "Vi\u1EC7c kh\xF4ng d\xF9ng h\u1EBFt ngay t\u1EEB \u0111\u1EA7u
      gi\u1EDD \u0111\xE3 gi\xFAp \xEDch..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887100
    m_Localized: "V\u1EADy t\xF4i s\u1EBD lo ph\xEDa tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887101
    m_Localized: "C\xF3 nh\u1EEFng ng\u01B0\u1EDDi \u0111ang ch\u1EDD b\xEAn trong
      tuy\u1EBFn ph\xF2ng th\u1EE7, n\xEAn l\u1EA7n n\xE0y t\xF4i c\u0169ng c\xF3
      th\u1EC3 tr\u1EE5 \u0111\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887102
    m_Localized: "T\xF4i s\u1EBD kh\xF4ng b\u1ECF l\u1EE1 kho\u1EA3nh kh\u1EAFc chuy\u1EC3n
      \u0111\u1ED9ng t\xE1ch ra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887103
    m_Localized: "N\u1EBFu th\u1EA5y \u0111i\u1EC1u g\xEC l\u1EA1, d\xF9 ch\u01B0a
      ch\u1EAFc ch\u1EAFn t\xF4i c\u0169ng s\u1EBD b\xE1o ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887104
    m_Localized: "T\xF4i s\u1EBD h\u1EA1 ph\u1EA3n \u1EE9ng c\u1EE7a \u0111\xE1 t\xEDn
      hi\u1EC7u trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887105
    m_Localized: "Kh\xF4ng \u0111\u01B0\u1EE3c c\u1EAFt n\xF3, m\xE0 ph\u1EA3i \u0111i\u1EC1u
      ch\u1EC9nh \u0111\u1EC3 m\u1EA1ng l\u01B0\u1EDBi ph\xF2ng th\u1EE7 l\u1EA1i
      ch\u1EA3y theo \u0111\xFAng h\u01B0\u1EDBng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887106
    m_Localized: "T\xF4i s\u1EBD theo d\xF5i ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng
      \u1EDF ph\xEDa sau."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887107
    m_Localized: "Ch\u1EEFa tr\u1ECB c\u0169ng c\xF3 th\u1EE9 t\u1EF1. Ph\u1EA3i
      ch\u1EEBa s\u1EE9c \u0111\u1EC3 d\xF9ng \u0111\u1EBFn t\u1EADn cu\u1ED1i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887108
    m_Localized: "T\u1ED1t. Vai tr\xF2 \u0111\xE3 \u0111\u01B0\u1EE3c quy\u1EBFt
      \u0111\u1ECBnh."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887109
    m_Localized: "H\xE3y tin nhau v\xE0 l\xE0m ph\u1EA7n vi\u1EC7c c\u1EE7a m\xECnh."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887110
    m_Localized: "T\xF4i s\u1EBD c\u0103n ch\u1EC9nh t\xEDn hi\u1EC7u trung t\xE2m
      v\xE0 canh th\u1EDDi \u0111i\u1EC3m \u0111\u1EC3 m\u1ECDi ng\u01B0\u1EDDi di
      chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887111
    m_Localized: "\u0110\u1ED9i ph\xF2ng th\u1EE7 b\xEAn trong qu\u1EA3ng tr\u01B0\u1EDDng
      trung t\xE2m s\u1EBD lui l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887112
    m_Localized: "Ch\xFAng t\xF4i s\u1EBD \u0111\u1EC3 tr\u1ED1ng kh\xF4ng gian cho
      c\xE1c v\u1ECB H\u1ED9 V\u1EC7 di chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887113
    m_Localized: "\u0110\u1EEBng tr\u1EF1c ti\u1EBFp ch\u1EA1m v\xE0o b\u1ED9 ph\u1EADn
      \u0111i\u1EC1u khi\u1EC3n d\u01B0\u1EDBi qu\u1EA3ng tr\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887114
    m_Localized: "N\u1EBFu ph\u1EA3n \u1EE9ng b\xF9ng l\xEAn th\xEC c\u1EA3 ph\u1EA7n
      gia c\u1ED1 t\u01B0\u1EDDng c\u0169ng c\xF3 th\u1EC3 rung chuy\u1EC3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887115
    m_Localized: "\u0110\xE3 r\xF5. T\xF4i s\u1EBD cho binh l\xEDnh t\u1EADp trung
      gi\u1EEF tuy\u1EBFn ph\xF2ng th\u1EE7."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887116
    m_Localized: "C\xE1nh c\u1ED5ng v\xE0o qu\u1EA3ng tr\u01B0\u1EDDng trung t\xE2m
      \u0111ang m\u1EDF."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887117
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn \u0111ang \u0111i v\xF2ng b\xEAn
      trong c\xE1nh c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887118
    m_Localized: "\u0110\u01B0\u1EE3c. L\u1EA7n n\xE0y h\xE3y ch\u1EB7n \u0111\u1EBFn
      t\u1EADn cu\u1ED1i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887119
    m_Localized: "T\u1EEB \"t\u1EADn cu\u1ED1i\" nghe n\u1EB7ng n\u1EC1 qu\xE1..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887120
    m_Localized: "D\xF9 v\u1EADy, ch\xFAng ta \u0111\xE3 \u0111i \u0111\u1EBFn \u0111\xE2y
      r\u1ED3i th\xEC ph\u1EA3i \u0111i \u0111\u1EBFn c\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887121
    m_Localized: "T\xF4i c\u0169ng mang theo ghi ch\xE9p c\u1EE7a \u0111\xE1 t\xEDn
      hi\u1EC7u trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887122
    m_Localized: "Ch\xFAng ta s\u1EBD c\u1EA7n t\u1EA5t c\u1EA3 ghi ch\xE9p v\u1EC1
      nh\u1EEFng khu v\u1EF1c \u0111\xE3 ki\u1EC3m tra \u1EDF qu\u1EA3ng tr\u01B0\u1EDDng
      trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887123
    m_Localized: "H\xE3y ti\u1EBFn v\xE0o qu\u1EA3ng tr\u01B0\u1EDDng trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887124
    m_Localized: "\u1ED4n \u0111\u1ECBnh m\u1EA1ng l\u01B0\u1EDBi ph\xF2ng th\u1EE7
      v\xE0 ch\u1EB7n chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn cu\u1ED1i c\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887125
    m_Localized: "Qu\u1EA3ng tr\u01B0\u1EDDng trung t\xE2m Atra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887126
    m_Localized: "Kia l\xE0 \u0111\xE1 t\xEDn hi\u1EC7u trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887127
    m_Localized: "Ph\u1EA3n \u1EE9ng c\u1EE7a m\u1EA1ng l\u01B0\u1EDBi ph\xF2ng th\u1EE7
      kinh \u0111\xF4 b\u1EAFt \u0111\u1EA7u t\u1EEB \u0111\xE1 t\xEDn hi\u1EC7u
      trung t\xE2m r\u1ED3i l\u1EA1i quay v\u1EC1 \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887128
    m_Localized: "C\xE1c r\xE3nh d\u01B0\u1EDBi s\xE0n d\u1EABn v\u1EC1 m\u1ECDi
      h\u01B0\u1EDBng ch\xFAng ta \u0111\xE3 \u0111i qua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887129
    m_Localized: "D\u1EA5u ch\u1EC9 v\u1EC1 ph\xEDa Cies, Zeppel, Lumer, Verdin,
      Milen v\xE0 Norua \u0111\u1EC1u c\xF2n \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887130
    m_Localized: "T\u1EA5t c\u1EA3 con \u0111\u01B0\u1EDDng ch\xFAng ta \u0111\xE3
      \u0111i qua \u0111\u1EC1u d\u1EABn \u0111\u1EBFn \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887131
    m_Localized: "Kh\xF4ng ng\u1EDD nghe n\xF3i c\xF3 nhi\u1EC1u \u0111\u01B0\u1EDDng
      l\u1EA1i m\u1EC7t m\u1ECFi \u0111\u1EBFn th\u1EBF n\xE0y..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887132
    m_Localized: "T\xECnh tr\u1EA1ng c\u1EE7a \u0111\xE1 t\xEDn hi\u1EC7u trung t\xE2m
      th\u1EBF n\xE0o?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887133
    m_Localized: "C\xE1n c\xE2n \u0111\xE3 s\u1EE5p \u0111\u1ED5."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887134
    m_Localized: "M\u1EA1ng l\u01B0\u1EDBi ph\xF2ng th\u1EE7 v\u1ED1n \u0111\u01B0\u1EE3c
      thi\u1EBFt k\u1EBF \u0111\u1EC3 \u0111\u1EA9y nguy hi\u1EC3m b\xEAn ngo\xE0i
      ra, nh\u01B0ng gi\u1EDD l\u1EA1i \u0111ang \u0111\u1EA9y ph\u1EA3n \u1EE9ng
      b\xEAn trong ra ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887135
    m_Localized: "V\xEC th\u1EBF qu\xE1i v\u1EADt \u0111\xE3 b\u1ECB d\u1ED3n ra
      \u1EDF t\u1EEBng khu v\u1EF1c."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887136
    m_Localized: "Ch\xFAng kh\xF4ng t\u1EADp trung \u0111\u1EC3 t\u1EA5n c\xF4ng.
      M\u1ED7i khi m\u1EA1ng l\u01B0\u1EDBi ph\xF2ng th\u1EE7 dao \u0111\u1ED9ng,
      ch\xFAng l\u1EA1i b\u1ECB \u0111\u1EA9y kh\u1ECFi \u0111\u01B0\u1EDDng \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887137
    m_Localized: "\u0110\xF3 c\u0169ng l\xE0 \u0111i\u1EC1u ch\xFAng ta th\u1EA5y
      \u1EDF Cies l\xFAc \u0111\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887138
    m_Localized: "Con qu\xE1i v\u1EADt l\u1EDBn c\u0169ng kh\xF4ng nh\u1EAFm v\xE0o
      ch\xFAng ta. Ph\u1EA3n \u1EE9ng m\u1EA1ng l\u01B0\u1EDBi ph\xF2ng th\u1EE7
      b\u1EA5t \u1ED5n \u0111\xE3 \u0111\u1EA9y n\xF3 xu\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887139
    m_Localized: "\u1EDE Zeppel, ph\u1EA3n \u1EE9ng c\u1EE7a m\u1EA1ng l\u01B0\u1EDBi
      ph\xF2ng th\u1EE7 lan theo nh\u1EEFng con \u0111\u01B0\u1EDDng v\xE0 d\xF2ng
      n\u01B0\u1EDBc ng\u01B0\u1EDDi d\xE2n s\u1EED d\u1EE5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887140
    m_Localized: "Thi\u1EBFt b\u1ECB \u0111\xE3 suy y\u1EBFu trong r\u1EEBng Lumer
      l\xE0 th\u1EE9 \u0111\u1EA7u ti\xEAn ch\u1ECBu \xE1p l\u1EF1c \u0111\xF3 r\u1ED3i
      dao \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887141
    m_Localized: "\u1EDE m\u1ECF Verdin, ph\u1EA3n \u1EE9ng \u0111i theo c\xE1c l\u1ED1i
      \u0111i d\u01B0\u1EDBi l\xF2ng \u0111\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887142
    m_Localized: "\u1EDE Milen, ph\u1EA3n \u1EE9ng c\u0169ng ti\u1EBFp t\u1EE5c theo
      c\xE1c c\xF4ng tr\xECnh b\xEAn d\u01B0\u1EDBi h\u1ED3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887143
    m_Localized: "Di t\xEDch Norua l\xE0 thi\u1EBFt b\u1ECB chuy\u1EC3n ti\u1EBFp
      t\u1EADp h\u1EE3p t\u1EA5t c\u1EA3 ph\u1EA3n \u1EE9ng \u0111\xF3 r\u1ED3i chuy\u1EC3n
      ng\u01B0\u1EE3c v\u1EC1 ph\xEDa kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887144
    m_Localized: "T\xF3m l\u1EA1i th\xEC c\xE0ng th\u1EA5y nghi\xEAm tr\u1ECDng h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887145
    m_Localized: "D\xF9 v\u1EADy, gi\u1EDD ch\xFAng ta bi\u1EBFt ph\u1EA3i nh\xECn
      v\xE0o \u0111\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887146
    m_Localized: "Ch\u1EC9 c\u1EA7n d\u1EEBng \u0111\xE1 t\xEDn hi\u1EC7u trung t\xE2m
      l\xE0 \u0111\u01B0\u1EE3c sao?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887147
    m_Localized: "Kh\xF4ng \u0111\u01B0\u1EE3c d\u1EEBng n\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887148
    m_Localized: "N\u1EBFu c\u1EAFt ho\xE0n to\xE0n m\u1EA1ng l\u01B0\u1EDBi ph\xF2ng
      th\u1EE7 th\xEC c\xE1c c\xF4ng tr\xECnh b\xEAn ngo\xE0i c\xF3 th\u1EC3 kh\xF4ng
      tr\u1EE5 \u0111\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887149
    m_Localized: "Vi\u1EC7c c\u1EA7n l\xE0m kh\xF4ng ph\u1EA3i c\u1EAFt m\u1EA1ng
      l\u01B0\u1EDBi, m\xE0 l\xE0 h\u1EA1 d\xF2ng ch\u1EA3y ng\u01B0\u1EE3c v\xE0
      \u0111\u01B0a n\xF3 tr\u1EDF v\u1EC1 h\u01B0\u1EDBng ban \u0111\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887150
    m_Localized: "Nh\u1EEFng g\xEC ch\xFAng ta ch\u1EB7n t\u1EEB tr\u01B0\u1EDBc
      \u0111\u1EBFn gi\u1EDD c\u0169ng kh\xF4ng ph\u1EA3i c\u1EAFt \u0111\u1EE9t
      ho\xE0n to\xE0n con \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887151
    m_Localized: "Ch\xFAng ta ch\u1EEBa \u0111\u01B0\u1EDDng cho ng\u01B0\u1EDDi
      \u0111i qua v\xE0 ch\u1EC9 ch\u1EB7n nh\u1EEFng nh\xF3m nguy hi\u1EC3m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887152
    m_Localized: "Ch\u1EEFa tr\u1ECB c\u0169ng v\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887153
    m_Localized: "Kh\xF4ng d\xF9ng t\u1EA5t c\u1EA3 c\xF9ng m\u1ED9t l\xFAc, m\xE0
      chia th\u1EE9 t\u1EF1 \u0111\u1EC3 m\u1ECDi ng\u01B0\u1EDDi c\xF3 th\u1EC3
      c\u1EA7m c\u1EF1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887154
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn \u0111ang \u0111i v\xF2ng ph\xEDa
      sau \u0111\xE1 t\xEDn hi\u1EC7u trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887155
    m_Localized: "Qu\xE1i v\u1EADt kh\xF4ng t\u1EA5n c\xF4ng \u0111\xE1 t\xEDn hi\u1EC7u.
      N\xF3 kh\xF4ng th\u1EC3 tho\xE1t kh\u1ECFi khu v\u1EF1c quanh \u0111\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887156
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn \u0111\xF3 \u0111ang l\xE0m
      ph\u1EA3n \u1EE9ng c\xE0ng b\u1EA5t \u1ED5n h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887157
    m_Localized: "Ph\u1EA3i ch\u1EB7n n\xF3 tr\u01B0\u1EDBc th\xEC m\u1EDBi \u0111i\u1EC1u
      ch\u1EC9nh \u0111\u01B0\u1EE3c."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887158
    m_Localized: "Serah, lo ph\xEDa tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887159
    m_Localized: "Noah, b\xE1o ngay kho\u1EA3nh kh\u1EAFc chuy\u1EC3n \u0111\u1ED9ng
      l\u1EDBn t\xE1ch ra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887160
    m_Localized: "Alice, chu\u1EA9n b\u1ECB \u0111i\u1EC1u ch\u1EC9nh \u0111\xE1
      t\xEDn hi\u1EC7u trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887161
    m_Localized: "Spayne, gi\u1EEF ph\xEDa sau v\xE0 ph\u1EE5 tr\xE1ch th\u1EE9 t\u1EF1
      ch\u1EEFa tr\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887162
    m_Localized: "\u1EEA. T\xF4i s\u1EBD tr\u1EE5 tr\u01B0\u1EDBc \u0111\xE1 t\xEDn
      hi\u1EC7u trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887163
    m_Localized: "C\xF3 nh\u1EEFng ng\u01B0\u1EDDi \u0111ang tin ch\xFAng ta v\xE0
      ch\u1EDD b\xEAn trong tuy\u1EBFn ph\xF2ng th\u1EE7."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887164
    m_Localized: "N\u1EBFu chuy\u1EC3n \u0111\u1ED9ng t\xE1ch ra t\xF4i s\u1EBD b\xE1o
      ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887165
    m_Localized: "L\u1EA7n n\xE0y t\xF4i s\u1EBD kh\xF4ng b\xE1o mu\u1ED9n \u0111i\u1EC1u
      m\xECnh nh\xECn th\u1EA5y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887166
    m_Localized: "T\xF4i s\u1EBD lo \u0111\xE1 t\xEDn hi\u1EC7u trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887167
    m_Localized: "Theo ghi ch\xE9p, t\xEDn hi\u1EC7u c\u1EE7a c\u1EA3 b\u1ED1n anh
      h\xF9ng ph\u1EA3i \u0111\u1ED3ng th\u1EDDi kh\u1EDBp nhau."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887168
    m_Localized: "T\xF4i c\u0169ng \u0111\xE3 quy\u1EBFt \u0111\u1ECBnh th\u1EE9
      t\u1EF1 ch\u1EEFa tr\u1ECB cu\u1ED1i c\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887169
    m_Localized: "N\u1EBFu b\u1ECB th\u01B0\u01A1ng th\xEC \u0111\u1EEBng gi\u1EA5u.
      L\u1EA7n n\xE0y nh\u1EA5t \u0111\u1ECBnh ph\u1EA3i n\xF3i ngay."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887170
    m_Localized: "Nh\xF3m \u0111i ra tr\u01B0\u1EDBc \u0111ang ti\u1EBFn \u0111\u1EBFn
      \u0111\xE1 t\xEDn hi\u1EC7u trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887171
    m_Localized: "Qu\xE1i v\u1EADt l\u1EDBn c\u0169ng \u0111ang ti\u1EBFn \u0111\u1EBFn
      t\u1EEB ph\xEDa sau \u0111\xE1 t\xEDn hi\u1EC7u trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887172
    m_Localized: "\u0110\u01B0\u1EE3c. H\xE3y ch\u1EB7n \u1EDF qu\u1EA3ng tr\u01B0\u1EDDng
      trung t\xE2m Atra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887173
    m_Localized: "B\u1EA3o v\u1EC7 \u0111\xE1 t\xEDn hi\u1EC7u trung t\xE2m v\xE0
      h\u1EA1 d\xF2ng ch\u1EA3y ng\u01B0\u1EE3c c\u1EE7a m\u1EA1ng l\u01B0\u1EDBi
      ph\xF2ng th\u1EE7."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887174
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng l\u1EDBn \u0111\xE3 d\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887175
    m_Localized: "Qu\xE1i v\u1EADt c\u0169ng kh\xF4ng c\xF2n d\u1ED3n v\xE0o m\u1ED9t
      ch\u1ED7."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887176
    m_Localized: "Chuy\u1EC3n \u0111\u1ED9ng \u0111\xE3 t\u1EA3n ra, nh\u01B0ng kh\xF4ng
      c\xF2n dao \u0111\u1ED9ng nh\u01B0 l\xFAc n\xE3y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887177
    m_Localized: "Ph\u1EA3n \u1EE9ng c\u1EE7a \u0111\xE1 t\xEDn hi\u1EC7u trung t\xE2m
      \u0111\xE3 y\u1EBFu \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887178
    m_Localized: "D\xF2ng ch\u1EA3y ng\u01B0\u1EE3c \u0111\xE3 d\u1EEBng, v\xE0 \xE1p
      l\u1EF1c ch\u1EA3y ra m\u1EA1ng l\u01B0\u1EDBi b\xEAn ngo\xE0i c\u0169ng gi\u1EA3m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887179
    m_Localized: "C\xE1c khu v\u1EF1c xung quanh c\xF3 th\u1EC3 \u1ED5n \u0111\u1ECBnh
      kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887180
    m_Localized: "Ch\xFAng s\u1EBD ch\u01B0a l\u1EADp t\u1EE9c tr\u1EDF l\u1EA1i
      ho\xE0n to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887181
    m_Localized: "Nh\u01B0ng ph\u1EA3n \u1EE9ng r\xF2 v\u1EC1 ph\xEDa Cies, Zeppel,
      Lumer, Verdin, Milen v\xE0 Norua s\u1EBD kh\xF4ng l\u1EDBn th\xEAm."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887182
    m_Localized: "Cu\u1ED1i c\xF9ng m\u1ECDi chuy\u1EC7n c\u0169ng \u0111ang theo
      h\u01B0\u1EDBng b\u1EDBt vi\u1EC7c h\u01A1n..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887183
    m_Localized: "Kh\xF4ng, v\u1EABn c\xF2n r\u1EA5t nhi\u1EC1u vi\u1EC7c ph\u1EA3i
      thu x\u1EBFp."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887184
    m_Localized: "D\xF9 v\u1EADy, ch\xFAng ta \u0111\xE3 b\u1EA3o v\u1EC7 \u0111\u01B0\u1EE3c
      h\u1ECD."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887185
    m_Localized: "Cies, Zeppel, khu r\u1EEBng, m\u1ECF, h\u1ED3, cao nguy\xEAn, v\xE0
      c\u1EA3 n\u01A1i n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887186
    m_Localized: "Ban \u0111\u1EA7u ch\xFAng ta \u0111\xE3 ngh\u0129 t\u1EA5t c\u1EA3
      c\xE1c n\u01A1i \u0111\u1EC1u \u0111ang b\u1ECB t\u1EA5n c\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887187
    m_Localized: "Nh\u01B0ng sau khi quan s\xE1t su\u1ED1t th\u1EDDi gian qua, ch\xFAng
      ta nh\u1EADn ra \u0111\xF3 l\xE0 nh\u1EEFng con \u0111\u01B0\u1EDDng qu\xE1i
      v\u1EADt \u0111\xE3 b\u1ECB d\u1ED3n qua."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887188
    m_Localized: "M\u1EA1ng l\u01B0\u1EDBi ph\xF2ng th\u1EE7 c\xF3 l\u1EBD \u0111\u01B0\u1EE3c
      t\u1EA1o ra \u0111\u1EC3 b\u1EA3o v\u1EC7 con ng\u01B0\u1EDDi."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887189
    m_Localized: "Do b\u1ECB b\u1ECF m\u1EB7c qu\xE1 l\xE2u, n\xF3 m\u1EA5t c\xE2n
      b\u1EB1ng, v\xE0 s\u1EE9c m\u1EA1nh v\u1ED1n \u0111\u1EC3 b\u1EA3o v\u1EC7
      \u0111\xE3 bi\u1EBFn th\xE0nh s\u1EE9c m\u1EA1nh \u0111\u1EA9y m\u1ECDi th\u1EE9
      ra ngo\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887190
    m_Localized: "Gi\u1EDD \u0111\xE3 bi\u1EBFt nguy\xEAn nh\xE2n th\xEC c\xF3 th\u1EC3
      kh\xF4i ph\u1EE5c n\xF3 r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887191
    m_Localized: "H\xE3y g\u1EEDi ghi ch\xE9p \u0111\u1EBFn t\u1EEBng khu v\u1EF1c
      v\xE0 b\u1EAFt \u0111\u1EA7u ki\u1EC3m tra m\u1EA1ng l\u01B0\u1EDBi c\xF4ng
      tr\xECnh."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887192
    m_Localized: "Qu\u1EA3ng tr\u01B0\u1EDDng trung t\xE2m v\xE0 tuy\u1EBFn ph\xF2ng
      th\u1EE7 \u1EDF c\u1ED5ng kinh \u0111\xF4 \u0111ang \u1ED5n \u0111\u1ECBnh."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887193
    m_Localized: "Ch\xFAng t\xF4i c\u0169ng v\u1EEBa g\u1EEDi t\xEDn hi\u1EC7u \u1ED5n
      \u0111\u1ECBnh \u0111\u1EBFn c\xE1c n\u01A1i tr\xFA \u1EA9n \u1EDF ngo\u1EA1i
      vi."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535733887194
    m_Localized: "V\u1EADy t\xF4i s\u1EBD ki\u1EC3m tra l\u1EA1i ng\u01B0\u1EDDi
      b\u1ECB th\u01B0\u01A1ng tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275584
    m_Localized: "Gi\u1EDD t\xF4i c\xF3 th\u1EC3 ph\xE2n bi\u1EC7t \u0111\xFAng gi\u1EEFa
      vi\u1EC7c ch\u1EEFa tr\u1ECB kh\u1EA9n c\u1EA5p v\xE0 vi\u1EC7c c\xF3 th\u1EC3
      \u0111\u1EC3 sau."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275585
    m_Localized: "T\xF4i c\u0169ng s\u1EBD ki\u1EC3m tra l\u1EA1i d\u1EA5u v\u1EBFt
      \u1EDF ngo\u1EA1i vi."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275586
    m_Localized: "Ph\u1EA3i x\xE1c nh\u1EADn chuy\u1EC3n \u0111\u1ED9ng quay v\u1EC1
      \u0111ang \u0111i theo h\u01B0\u1EDBng an to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275587
    m_Localized: "T\xF4i s\u1EBD xem ph\xEDa tr\u01B0\u1EDBc c\u1ED5ng kinh \u0111\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275588
    m_Localized: "N\u1EBFu c\xF2n nh\xF3m n\xE0o th\xEC l\u1EA7n n\xE0y t\xF4i c\u0169ng
      s\u1EBD ch\u1EB7n t\u1EEB ph\xEDa tr\u01B0\u1EDBc!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275589
    m_Localized: "Serah, t\u1EEB gi\u1EDD h\xE3y di chuy\u1EC3n theo t\xEDn hi\u1EC7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275590
    m_Localized: "Hi\u1EC3u r\u1ED3i. L\u1EA7n n\xE0y t\xF4i s\u1EBD ch\u1EDD r\u1ED3i
      ch\u1EB7n th\u1EADt ng\u1EA7u!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275591
    m_Localized: "C\xE2u \u0111\xF3 v\u1EABn khi\u1EBFn t\xF4i h\u01A1i lo... nh\u01B0ng
      l\u1EA7n n\xE0y t\xF4i s\u1EBD tin c\u1EADu."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275592
    m_Localized: "M\u1ECDi ng\u01B0\u1EDDi \u0111\xE3 v\u1EA5t v\u1EA3 r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275593
    m_Localized: "Nh\u1EDD m\u1ECDi ng\u01B0\u1EDDi ho\xE0n th\xE0nh ph\u1EA7n vi\u1EC7c
      c\u1EE7a m\xECnh \u0111\u1EBFn cu\u1ED1i m\xE0 ch\xFAng ta \u0111\xE3 b\u1EA3o
      v\u1EC7 \u0111\u01B0\u1EE3c \u0111\xE1 t\xEDn hi\u1EC7u trung t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275594
    m_Localized: "V\u1EADy l\xE0 gi\u1EDD th\u1EADt s\u1EF1 k\u1EBFt th\xFAc r\u1ED3i
      \u0111\xFAng kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275595
    m_Localized: "M\u1ED1i nguy l\u1EDBn nh\u1EA5t \u0111\xE3 k\u1EBFt th\xFAc."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275596
    m_Localized: "Nh\u01B0ng sau khi k\u1EBFt th\xFAc v\u1EABn c\xF2n nhi\u1EC1u
      vi\u1EC7c ph\u1EA3i ki\u1EC3m tra."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275597
    m_Localized: "\u0110\u01B0\u1EE3c. V\u1EADy h\xE3y ngh\u1EC9 sau khi gi\u1EA3m
      b\u1EDBt s\u1ED1 vi\u1EC7c c\xF2n ph\u1EA3i ki\u1EC3m tra..."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275598
    m_Localized: "\xC2m thanh c\u1EE7a \u0111\xE1 t\xEDn hi\u1EC7u trung t\xE2m \u0111\xE3
      \u1ED5n \u0111\u1ECBnh."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275599
    m_Localized: "Gi\u1EDD n\xF3 kh\xF4ng c\xF2n \u0111\xE1ng s\u1EE3 nh\u01B0 l\xFAc
      t\xF4i nghe l\u1EA7n \u0111\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275600
    m_Localized: "V\u1EADy th\xEC quay v\u1EC1 th\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275601
    m_Localized: "H\xE3y \u0111i n\xF3i v\u1EDBi nh\u1EEFng ng\u01B0\u1EDDi \u0111\xE3
      giao l\u01B0ng cho ch\xFAng ta b\u1EA3o v\u1EC7 r\u1EB1ng ch\xFAng ta \u0111\xE3
      gi\u1EEF \u0111\u01B0\u1EE3c h\u1ECD an to\xE0n!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535742275602
    m_Localized: "\u0110\xFAng v\u1EADy. H\xE3y thu x\u1EBFp t\xECnh h\xECnh \u1EDF
      Atra r\u1ED3i g\u1EEDi t\xEDn hi\u1EC7u \u1ED5n \u0111\u1ECBnh \u0111\u1EBFn
      t\u1EEBng khu v\u1EF1c."
    m_Metadata:
      m_Items: []
  - m_Id: 9940110521229312
    m_Localized: "L\xEAn c\u1EA5p!"
    m_Metadata:
      m_Items: []
  - m_Id: 9940110550589440
    m_Localized: "Ch\u1ECDn m\u1ED9t hi\u1EC7u \u1EE9ng c\u01B0\u1EDDng h\xF3a.<br>Hi\u1EC7u
      \u1EE9ng n\xE0y ch\u1EC9 \xE1p d\u1EE5ng cho node hi\u1EC7n t\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 9940110550589441
    m_Localized: "Qua m\xE0n!"
    m_Metadata:
      m_Items: []
  - m_Id: 9940110550589442
    m_Localized: "Ch\u1ECDn m\u1ED9t hi\u1EC7u \u1EE9ng c\u01B0\u1EDDng h\xF3a.<br>Hi\u1EC7u
      \u1EE9ng n\xE0y \xE1p d\u1EE5ng <color=red>v\u0129nh vi\u1EC5n</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 12273840598376448
    m_Localized: "Xem l\u1EA1i c\u1ED1t truy\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 12273840598376449
    m_Localized: "H\u1ED3 s\u01A1 nh\xE2n v\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 12273840598376450
    m_Localized: "Tu\u1ED5i: 21<br>Thu\u1ED9c: H\u1ED9 V\u1EC7<br>Vai tr\xF2: Ki\u1EBFm
      s\u0129 ti\u1EC1n tuy\u1EBFn<br><br>T\u1EEBng l\xE0 t\xE2n binh \u1EDF m\u1ED9t
      \u0111\u1ED3n bi\xEAn gi\u1EDBi. C\xF4 luy\u1EC7n ki\u1EBFm \u0111\u1EC3 tr\xE1nh
      phi\xEAn tr\u1EF1c b\u1EBFp, nh\u01B0ng t\xE0i n\u0103ng ti\u1EC1n tuy\u1EBFn
      v\xE0 \u0111\u1ED9 c\u1ED9ng h\u01B0\u1EDFng v\u1EDBi \u0111\xE1 t\xEDn hi\u1EC7u
      \u0111\xE3 gi\xFAp c\xF4 gia nh\u1EADp H\u1ED9 V\u1EC7.<br><br>T\u1EF1 tin,
      h\xE0nh \u0111\u1ED9ng nhanh v\xE0 c\xF3 ph\u1EA7n v\u1EE5ng v\u1EC1 nh\u01B0ng
      \u0111\xE1ng tin c\u1EADy. C\xF4 lu\xF4n \u0111\u1EE9ng \u1EDF tuy\u1EBFn \u0111\u1EA7u
      \u0111\u1EC3 \u0111\u1ED3ng \u0111\u1ED9i an t\xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 12273840598376451
    m_Localized: "Tu\u1ED5i: 27<br>Thu\u1ED9c: H\u1ED9 V\u1EC7<br>Vai tr\xF2: Cung
      th\u1EE7 h\u1EADu tuy\u1EBFn<br><br>T\u1EEBng l\xE0 ng\u01B0\u1EDDi d\u1EABn
      \u0111\u01B0\u1EDDng \u1EDF v\xF9ng r\u1EEBng n\xFAi bi\xEAn gi\u1EDBi. Kh\u1EA3
      n\u0103ng ph\xE1t hi\u1EC7n d\u1EA5u v\u1EBFt v\xE0 nguy hi\u1EC3m gi\xFAp
      c\xF4 gia nh\u1EADp H\u1ED9 V\u1EC7.<br><br>Tai n\u1EA1n trong r\u1EEBng khi\u1EBFn
      c\xF4 d\u1EC5 gi\u1EADt m\xECnh, nh\u01B0ng c\xF4 lu\xF4n b\xE1o nguy hi\u1EC3m
      v\xE0 ch\u0103m s\xF3c \u0111\u1ED3ng \u0111\u1ED9i nh\u01B0 m\u1ED9t ng\u01B0\u1EDDi
      ch\u1ECB \u1EA5m \xE1p."
    m_Metadata:
      m_Items: []
  - m_Id: 12273840598376452
    m_Localized: "Tu\u1ED5i: 23<br>Thu\u1ED9c: H\u1ED9 V\u1EC7<br>Vai tr\xF2: Ph\xE1p
      s\u01B0 t\u1EA7m xa<br><br>M\u1ED9t ph\xE1p s\u01B0 th\u1EF1c chi\u1EBFn xu\u1EA5t
      th\xE2n t\u1EEB h\u1ECDc vi\u1EC7n ph\xE9p thu\u1EADt. C\xF4 ch\u1ECDn phong
      c\xE1ch t\u01B0\u01A1i s\xE1ng, l\u1ED9ng l\u1EABy \u0111\u1EC3 m\u1ECDi ng\u01B0\u1EDDi
      c\u1EA3m th\u1EA5y d\u1EC5 g\u1EA7n v\u1EDBi ph\xE1p s\u01B0 h\u01A1n.<br><br>Tr\xE1i
      v\u1EDBi v\u1EBB ngo\xE0i, c\xF4 l\xE0 ng\u01B0\u1EDDi s\u1EAFp x\u1EBFp l\xFD
      tr\xED v\xE0 tr\xE1ch nhi\u1EC7m nh\u1EA5t \u0111\u1ED9i, lu\xF4n gi\u1EA3i
      th\xEDch t\xECnh h\xECnh ph\u1EE9c t\u1EA1p th\xE0nh h\xE0nh \u0111\u1ED9ng
      r\xF5 r\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 12273840598376453
    m_Localized: "Tu\u1ED5i: 25<br>Thu\u1ED9c: H\u1ED9 V\u1EC7<br>Vai tr\xF2: H\u1ED7
      tr\u1EE3 h\u1EADu tuy\u1EBFn<br><br>T\u1EEBng l\xE0 nh\xE2n vi\xEAn tr\u1ECB
      li\u1EC7u d\xE3 chi\u1EBFn c\u1EE7a qu\xE2n \u0111\u1ED9i ho\xE0ng gia. Sau
      l\u1EA7n d\xF9ng t\xE0i nguy\xEAn qu\xE1 s\u1EDBm, c\xF4 h\u1ECDc c\xE1ch d\xE0nh
      ch\xFAng cho l\xFAc nguy c\u1EA5p.<br><br>Tr\xF4ng bu\u1ED3n ng\u1EE7 v\xE0
      ng\u1EA1i vi\u1EC7c, nh\u01B0ng c\xF4 t\xEDnh th\u1EDDi \u0111i\u1EC3m v\xE0
      chi ph\xED ch\xEDnh x\xE1c \u0111\u1EC3 gi\u1EA3m t\u1ED5n th\u1EA5t cho \u0111\u1ED9i."
    m_Metadata:
      m_Items: []
  - m_Id: 12276361995837440
    m_Localized: "Ch\u01B0a c\xF3 m\xE0n ch\u01A1i n\xE0o \u0111\u01B0\u1EE3c ho\xE0n
      th\xE0nh."
    m_Metadata:
      m_Items: []
  - m_Id: 10143141099560960
    m_Localized: "Th\u1EAFng tr\u1EADn!"
    m_Metadata:
      m_Items: []
  - m_Id: 10143141137309696
    m_Localized: "Thua tr\u1EADn!"
    m_Metadata:
      m_Items: []
  - m_Id: 9940110550589443
    m_Localized: "K\u1EBFt qu\u1EA3 m\xE0n ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 10143141137309697
    m_Localized: "T\u1ED5ng th\u1EDDi gian ch\u01A1i: {0:D2}:{1:D2}"
    m_Metadata:
      m_Items: []
  - m_Id: 10143141137309698
    m_Localized: "T\u1ED5ng s\u1ED1 Sort: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10143141137309699
    m_Localized: "Combo t\u1ED1i \u0111a: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 9940110550589444
    m_Localized: "\u0110\u1EBFn m\xE0n h\xECnh ch\u1ECDn node"
    m_Metadata:
      m_Items: []
  - m_Id: 9940110550589445
    m_Localized: "Node ti\u1EBFp theo"
    m_Metadata:
      m_Items: []
  - m_Id: 9940110550589446
    m_Localized: "R\xFAt lui"
    m_Metadata:
      m_Items: []
  - m_Id: 9940110550589447
    m_Localized: "Ch\u01A1i l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535750664192
    m_Localized: "Ch\xFA \xFD!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535750664193
    m_Localized: "<color=red>\u0110\u1EB7t l\u1EA1i</color> ti\u1EBFn tr\xECnh c\xE2u
      chuy\u1EC7n.<br><br>Ti\u1EBFp t\u1EE5c s\u1EBD \u0111\u01B0a b\u1EA1n v\u1EC1
      m\xE0n h\xECnh t\u1EA3i<br>v\xE0 <color=red>\u0111\u1EB7t l\u1EA1i to\xE0n
      b\u1ED9 ti\u1EBFn tr\xECnh hi\u1EC7n t\u1EA1i</color>.<br><br>Ti\u1EBFp t\u1EE5c?"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535750664194
    m_Localized: "C\u1EA3nh b\xE1o!"
    m_Metadata:
      m_Items: []
  - m_Id: 11184535750664195
    m_Localized: "R\xFAt lui s\u1EBD \u0111\u1EB7t l\u1EA1i m\xE0n ch\u01A1i hi\u1EC7n
      t\u1EA1i.<br><br>R\xFAt lui?"
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742272
    m_Localized: "H\u01B0\u1EDBng d\u1EABn 3-Sort"
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742273
    m_Localized: "L\xEAn c\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742274
    m_Localized: "H\u01B0\u1EDBng d\u1EABn k\u1EF9 n\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742275
    m_Localized: "Nh\u1EADn di v\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742276
    m_Localized: "B\u1EAFt \u0111\u1EA7u tr\u1EADn chi\u1EBFn"
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742277
    m_Localized: "\u0110\xE3 s\u1EAFp x\u1EBFp xong"
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742278
    m_Localized: "H\u01B0\u1EDBng d\u1EABn \u0111i\u1EC1u khi\u1EC3n"
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742279
    m_Localized: Combo
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742280
    m_Localized: "Chu\u1EA9n b\u1ECB Wave 1. H\xE3y s\u1EAFp x\u1EBFp c\xE1c kh\u1ED1i
      c\u01B0\u1EDDng h\xF3a trong th\u1EDDi gian gi\u1EDBi h\u1EA1n \u0111\u1EC3
      c\u01B0\u1EDDng h\xF3a c\xE1c anh h\xF9ng tr\u01B0\u1EDBc tr\u1EADn chi\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742281
    m_Localized: "K\xE9o kh\u1ED1i t\u1EA5n c\xF4ng \u0111\u1EB7t tr\xEAn \u0111\u01B0\u1EDDng
      ray v\xE0o \xF4 c\u1EE7a Serah."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742282
    m_Localized: "Khi 3 kh\u1ED1i c\u01B0\u1EDDng h\xF3a \u0111\u01B0\u1EE3c \u0111\u1EB7t
      li\xEAn ti\u1EBFp tr\xEAn \u0111\u01B0\u1EDDng ray, Combo s\u1EBD k\xEDch ho\u1EA1t."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742283
    m_Localized: "\u0110\u1EB7t kh\u1ED1i t\u1EA5n c\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742284
    m_Localized: "\u0110\u1EB7t 3 kh\u1ED1i gi\u1ED1ng nhau l\xEAn nh\xE2n v\u1EADt
      \u0111\u1EC3 t\u0103ng ch\u1EC9 s\u1ED1 t\u01B0\u01A1ng \u1EE9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742285
    m_Localized: "\u0110\xE3 chu\u1EA9n b\u1ECB xong. H\xE3y ti\u1EBFp t\u1EE5c s\u1EAFp
      x\u1EBFp ho\u1EB7c nh\u1EA5n BATTLE START."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742286
    m_Localized: "Ch\xFAng b\u1EAFt \u0111\u1EA7u tr\xE0n ra r\u1ED3i! T\xF4i s\u1EBD
      ch\u1EB7n ph\xEDa tr\u01B0\u1EDBc!"
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742287
    m_Localized: "N\u1EBFu k\u1EBB \u0111\u1ECBch d\u1ED3n v\xE0o m\u1ED9t ch\u1ED7,
      t\xF4i s\u1EBD x\u1EED l\xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742288
    m_Localized: "Khi l\xEAn c\u1EA5p, b\u1EA1n c\xF3 th\u1EC3 nh\u1EADn m\u1ED9t
      trong c\xE1c th\u1EBB t\u0103ng c\u01B0\u1EDDng ch\u1EC9 s\u1ED1."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742289
    m_Localized: "[Gi\xE1c quan s\u1EAFc b\xE9n] Nh\u1EADn T\u1EA5n c\xF4ng +8"
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742290
    m_Localized: "Xin l\u1ED7i v\xEC \u0111\xE3 \u0111\u1EBFn tham gia mu\u1ED9n."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742291
    m_Localized: "T\xF4i \u0111\xE3 \u0111i nhanh nh\u1EA5t c\xF3 th\u1EC3 r\u1ED3i
      m\xE0..."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742292
    m_Localized: "Noah, Spayne \u0111\xE3 tham gia!"
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742293
    m_Localized: "Ch\u1EC9 huy, con l\u1EDBn \u0111ang \u0111\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742294
    m_Localized: "Nh\xF3m n\xE0y \u0111ang di chuy\u1EC3n xoay quanh n\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742295
    m_Localized: "V\u1EADy ch\u1EC9 c\u1EA7n ch\u1EB7n con l\u1EDBn \u0111\xF3 l\xE0
      \u0111\u01B0\u1EE3c. T\xF4i s\u1EBD h\u1EA1 n\xF3!"
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742296
    m_Localized: "Thanh tuy\u1EC7t k\u1EF9 c\u1EE7a Serah \u0111\xE3 \u0111\u1EA7y.
      H\xE3y ch\u1EA1m v\xE0o ch\xE2n dung \u0111\u1EC3 s\u1EED d\u1EE5ng tuy\u1EC7t
      k\u1EF9."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742297
    m_Localized: "M\u1ECDi ng\u01B0\u1EDDi kh\xF4ng b\u1ECB th\u01B0\u01A1ng \u1EDF
      \u0111\xE2u ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742298
    m_Localized: "T\xF4i kh\xF4ng sao. \u0110\xF2n t\u1EA5n c\xF4ng c\u0169ng c\xF3
      hi\u1EC7u qu\u1EA3 m\xE0!"
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742299
    m_Localized: "L\xE0m t\u1ED1t l\u1EAFm khi \u0111\xE3 ch\u1EB7n ch\xFAng tr\u01B0\u1EDBc
      khi b\u1ECB \u0111\u1EA9y \u0111\u1EBFn t\u1EADn c\u1ED5ng."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792802742300
    m_Localized: "K\xECa, t\xF4i th\u1EA5y \xE1nh s\xE1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792806936576
    m_Localized: "\u0110\xFAng th\u1EADt. C\xF3 th\u1EE9 g\xEC \u0111\xF3 \u0111ang
      ph\xE1t s\xE1ng!"
    m_Metadata:
      m_Items: []
  - m_Id: 12265792806936577
    m_Localized: "Alice, c\u1EADu ki\u1EC3m tra gi\xFAp \u0111\u01B0\u1EE3c kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 12265792806936578
    m_Localized: "\u1EEA. T\xF4i \u0111\xE3 ki\u1EC3m tra, nh\u01B0ng c\xF3 v\u1EBB
      kh\xF4ng c\xF3 v\u1EA5n \u0111\u1EC1 g\xEC."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792806936579
    m_Localized: "\u0110\xFAng nh\u01B0 t\xF4i ngh\u0129. Ph\u1EA3n \u1EE9ng v\u1EEBa
      ki\u1EC3m tra l\xE0 m\u1ED9t di v\u1EADt."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792806936580
    m_Localized: "V\u1EADy ph\u1EA3i ch\u1ECDn th\u1EADt c\u1EA9n th\u1EADn r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792806936581
    m_Localized: "Khi th\u1EAFng tr\u1EADn, b\u1EA1n c\xF3 th\u1EC3 ch\u1ECDn 1 di
      v\u1EADt c\xF3 th\u1EC3 duy tr\xEC \u0111\u1EBFn cu\u1ED1i."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792806936582
    m_Localized: "V\u1EADy ch\u1ECDn th\u1EE9 li\xEAn quan \u0111\u1EBFn Serah, gi\xFAp
      c\xF4 \u1EA5y tr\u1EE5 \u1EDF ph\xEDa tr\u01B0\u1EDBc l\xE2u h\u01A1n, s\u1EBD
      t\u1ED1t h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792806936583
    m_Localized: "T\u1EA7m nh\xECn tr\xEAn \u0111\u01B0\u1EDDng r\u1EEBng h\u1EB9p.
      N\u1EBFu Serah gi\u1EEF ph\xEDa tr\u01B0\u1EDBc, m\u1ECDi ng\u01B0\u1EDDi s\u1EBD
      d\u1EC5 di chuy\u1EC3n h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 12265792806936584
    m_Localized: "\u0110\xE3 ch\u1ECDn. Hi\u1EC7u \u1EE9ng n\xE0y c\u0169ng s\u1EBD
      \u0111\u01B0\u1EE3c gi\u1EEF trong tr\u1EADn chi\u1EBFn ti\u1EBFp theo."
    m_Metadata:
      m_Items: []
  - m_Id: 12986810110402560
    m_Localized: "Hi\u1EC7u \u1EE9ng di v\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 12986810143956992
    m_Localized: "Hi\u1EC7u \u1EE9ng c\u01B0\u1EDDng h\xF3a"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

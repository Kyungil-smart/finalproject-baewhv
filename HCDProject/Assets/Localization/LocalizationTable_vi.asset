    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087300
    m_Localized: "M\xE0n b\u1EA3o tr\xEC"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087301
    m_Localized: "{0} \u0111\xE3 nh\u1EB7t \u0111\u01B0\u1EE3c th\u1EE9 g\xEC \u0111\xF3!"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087302
    m_Localized: "Qu\xE0 c\u1EE7a {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 8695236044087303
    m_Localized: "Ch\u1EC9 c\xF3 th\u1EC3 ch\u1ECDn 1."

  - m_Id: 51780677632
    m_Localized: "\uB808\uBCA8 \uB9AC\uC6CC\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160517
    m_Localized: "\uC561\uD2F0\uBE0C \uC2A4\uD0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160513
    m_Localized: "\uC624\uBE0C\uC81D\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160464
    m_Localized: " \uBAAC\uC2A4\uD130 \uC2A4\uD0AC \uAD00\uB828"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160463
    m_Localized: "\uC9C0\uD718\uAD00\uC758 \uAE43\uBC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160462
    m_Localized: "\uC131\uBCBD \uAC15\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160461
    m_Localized: "\uC131\uBCBD \uC218\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160460
    m_Localized: "\uC804\uC220 \uAD50\uBCF8 (\uD790\uB7EC)"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160459
    m_Localized: "\uBCF4\uD638\uB9C9 \uB9C8\uBC95"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160458
    m_Localized: "\uCE58\uC720 \uC99D\uD3ED\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160457
    m_Localized: "\uC804\uC220 \uAD50\uBCF8 (\uB9C8\uBC95\uC0AC)"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160456
    m_Localized: "\uC9C0\uC9C4 \uB9C8\uBC95"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160455
    m_Localized: "\uD655\uC7A5 \uB9C8\uBC95"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160454
    m_Localized: "\uC804\uC220 \uAD50\uBCF8 (\uAD81\uC218)"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160453
    m_Localized: "\uD654\uC0B4\uBE44"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160452
    m_Localized: "\uB9C8\uBC95 \uD65C"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160451
    m_Localized: "\uC804\uC220 \uAD50\uBCF8 (\uC804\uC0AC)"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160450
    m_Localized: "\uD790\uB9C1 \uD329\uD130"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160449
    m_Localized: "\uACE0\uB300 \uAC11\uC637"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160448
    m_Localized: "\uC2A4\uD30C\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160447
    m_Localized: "\uC5D8\uB9AC\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160446
    m_Localized: "\uB178\uC544"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160445
    m_Localized: "\uC138\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160396
    m_Localized: "\uBAAC\uC2A4\uD130 \uC774\uB984"
    m_Metadata:
      m_Items: []
  - m_Id: 863262176796672
    m_Localized: "\uC9C0\uD718\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 863262227128320
    m_Localized: "\uB098\uB808\uC774\uC158"
    m_Metadata:
      m_Items: []
  - m_Id: 863262227128321
    m_Localized: "\uC694\uC0C8 \uBCD1\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 863262227128322
    m_Localized: "\uB370\uBBF8\uC548"
    m_Metadata:
      m_Items: []
  - m_Id: 863262227128323
    m_Localized: "\uC2DC\uC2A4\uD15C"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322624
    m_Localized: "(\uCCAB \uBC30\uCE58\uC9C0\uB294 \uC0DD\uAC01\uBCF4\uB2E4 \uC870\uC6A9\uD588\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322625
    m_Localized: "\uC5EC\uAE30\uAC00 \uC2DC\uC5D0\uC2A4 \uBC29\uC5B4 \uC694\uC0C8\uC57C?
      \uBAAC\uC2A4\uD130\uAC00 \uAC70\uC758 \uC548 \uB098\uC628\uB2E4\uB354\uB2C8,
      \uC9C4\uC9DC\uB85C \uC870\uC6A9\uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322626
    m_Localized: "\uC9C0\uD718\uAD00\uB2D8\uACFC \uC218\uD638\uB300 \uC5EC\uB7EC\uBD84\uC774\uC2ED\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322627
    m_Localized: "\uC2DC\uC5D0\uC2A4 \uBC29\uC5B4 \uC694\uC0C8\uC5D0 \uC624\uC2E0
      \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322628
    m_Localized: "\uD658\uC601\uD574 \uC918\uC11C \uACE0\uB9C8\uC6CC. \uC624\uC790\uB9C8\uC790
      \uC77C \uC774\uC57C\uAE30\uB97C \uD574\uC11C \uBBF8\uC548\uD55C\uB370, \uC548\uB0B4\uB97C
      \uBD80\uD0C1\uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322629
    m_Localized: "\uC774\uCABD\uC774 \uC138\uB77C, \uADF8\uB9AC\uACE0 \uC774\uCABD\uC774
      \uB178\uC544\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322630
    m_Localized: "\uBC18\uAC00\uC6CC. \uC804\uC5F4\uC744 \uB9E1\uACE0 \uC788\uB294
      \uC138\uB77C\uC57C. \uAD00\uBB38 \uCABD \uD655\uC778\uC740 \uB0B4\uAC00 \uBA3C\uC800
      \uBCFC\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322631
    m_Localized: "\uB178\uC544\uC57C. \uBA40\uB9AC\uC11C \uBCF4\uC774\uB294 \uC6C0\uC9C1\uC784\uC740
      \uB0B4\uAC00 \uBA3C\uC800 \uD655\uC778\uD574 \uB458\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322632
    m_Localized: "\uADF8\uB9AC\uACE0 \uC774\uCABD\uC774 \uC5D8\uB9AC\uC2A4, \uC2A4\uD30C\uC778\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322633
    m_Localized: "\uC5D8\uB9AC\uC2A4\uC57C. \uC2E0\uD638\uC11D \uD655\uC778\uACFC
      \uB9C8\uBC95 \uC9C0\uC6D0\uC744 \uB9E1\uACE0 \uC788\uC5B4. \uBCF4\uAE30\uBCF4\uB2E4
      \uAF3C\uAF3C\uD55C \uD3B8\uC774\uB2C8\uAE4C \uAC71\uC815\uD558\uC9C0 \uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322634
    m_Localized: "\uC2A4\uD30C\uC778\uC774\uC57C. \uD68C\uBCF5\uC744 \uB9E1\uACE0
      \uC788\uC5B4. \uC544\uD504\uBA74 \uBC14\uB85C \uB9D0\uD574\uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322635
    m_Localized: "\uC800\uB294 \uC2DC\uC5D0\uC2A4 \uC694\uC0C8 \uC218\uBE44\uB300\uC7A5\uC778
      \uB370\uBBF8\uC548\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322636
    m_Localized: "\uC55E\uC73C\uB85C \uC798 \uBD80\uD0C1\uD574, \uB370\uBBF8\uC548.
      \uB3C4\uCC29 \uC804\uC5D0 \uD655\uC778\uD560 \uC5C5\uBB34\uB294 \uC804\uB2EC\uBC1B\uC558\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322637
    m_Localized: "\uC138\uB77C\uB294 \uAD00\uBB38 \uAC80\uBB38\uC18C\uB97C \uD655\uC778\uD574
      \uC918. \uB178\uC544\uB294 \uB9DD\uB8E8\uC5D0\uC11C \uC232\uAE38\uC744 \uBD10\uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322638
    m_Localized: "\uC5D8\uB9AC\uC2A4\uB294 \uC2E0\uD638\uC11D\uC744 \uD655\uC778\uD574
      \uC8FC\uACE0, \uC2A4\uD30C\uC778\uC740 \uBB3C\uC790 \uBCF4\uAD00\uC18C\uB97C
      \uBD10\uC904\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322639
    m_Localized: "\uB370\uBBF8\uC548, \uB124 \uC0AC\uB78C\uC5D0\uAC8C \uC548\uB0B4\uD560
      \uC778\uC6D0\uC744 \uBD99\uC5EC\uC904 \uC218 \uC788\uC744\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322640
    m_Localized: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uBC14\uB85C \uC548\uB0B4 \uBCD1\uB825\uC744
      \uBC30\uCE58\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322641
    m_Localized: "\uC88B\uC544! \uAD00\uBB38 \uAC80\uBB38\uC18C\uB294 \uB0B4\uAC00
      \uBCFC\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322642
    m_Localized: "\uB9DD\uB8E8 \uCABD\uC744 \uBA3C\uC800 \uD655\uC778\uD558\uACE0
      \uC62C\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322643
    m_Localized: "\uC2E0\uD638\uC11D\uC744 \uD655\uC778\uD558\uACE0 \uB098\uC11C,
      \uC138\uB77C \uCABD\uC744 \uB3C4\uC640\uC904\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322644
    m_Localized: "\uAD00\uBB38 \uC548\uCABD \uBB3C\uC790 \uBCF4\uAD00\uC18C\uB77C\uBA74...
      \uC5EC\uAE30\uC11C \uC81C\uC77C \uBA40\uC9C0 \uC54A\uC544?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322645
    m_Localized: "\uBA40\uC5B4\uB3C4 \uC9C0\uAE08 \uBD10\uB450\uBA74 \uB098\uC911\uC5D0
      \uD5E4\uB9E4\uC9C0\uB294 \uC54A\uC744 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322646
    m_Localized: "\uC138\uB77C, \uD639\uC2DC \uB098\uB791 \uC5ED\uD560 \uBC14\uAFC0\uB798...?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322647
    m_Localized: "\uBBF8\uC548. \uAC80\uBB38\uC18C\uB294 \uB0B4\uAC00 \uBCF4\uB294
      \uAC8C \uC88B\uC744 \uAC83 \uAC19\uC544. \uC55E\uC5D0\uC11C \uB9C9\uB294 \uAC74
      \uB0B4 \uC77C\uC774\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322648
    m_Localized: "\uB108\uBB34 \uB9DE\uB294 \uB9D0\uC774\uB77C \uB354 \uC2AC\uD504\uB124..."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322649
    m_Localized: "(\uAC01\uC790 \uC704\uCE58\uB97C \uD655\uC778\uD558\uB824\uB358
      \uC21C\uAC04, \uC694\uC0C8 \uC548\uCABD\uC5D0\uC11C \uACBD\uBCF4 \uC885\uC774
      \uD06C\uAC8C \uC6B8\uB838\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322650
    m_Localized: "\uBCF4\uACE0\uB4DC\uB9BD\uB2C8\uB2E4! \uBAAC\uC2A4\uD130 \uACBD\uBCF4\uC785\uB2C8\uB2E4!
      \uC232 \uBC29\uD5A5\uC5D0\uC11C \uB2E4\uC218\uC758 \uBAAC\uC2A4\uD130\uB97C
      \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4! \uAD00\uBB38 \uCABD\uC73C\uB85C \uC811\uADFC
      \uC911\uC785\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322651
    m_Localized: "\uC138\uB77C... \uC870\uC6A9\uD558\uB2E4\uBA74\uC11C?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322652
    m_Localized: "\uADF8\uB7AC\uC5C8\uC9C0!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322653
    m_Localized: "\uC77C\uB2E8 \uB2E4\uC2DC \uC870\uC6A9\uD558\uAC8C \uB9CC\uB4E4
      \uBC29\uBC95\uBD80\uD130 \uC0DD\uAC01\uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322654
    m_Localized: "\uB178\uC544\uB294 \uB9DD\uB8E8\uC5D0\uC11C \uC232\uAE38\uC744
      \uACC4\uC18D \uAC10\uC2DC\uD574 \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322655
    m_Localized: "\uC2A4\uD30C\uC778\uC740 \uBB3C\uC790 \uBCF4\uAD00\uC18C\uC5D0\uC11C
      \uC751\uAE09 \uCC98\uCE58 \uBB3C\uD488\uC744 \uCC59\uACA8\uC640 \uC918. \uB458
      \uB2E4 \uC900\uBE44\uB418\uB294 \uB300\uB85C \uAD00\uBB38\uC73C\uB85C \uD569\uB958\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322656
    m_Localized: "\uC751, \uD655\uC778\uD558\uACE0 \uBC14\uB85C \uAC08\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322657
    m_Localized: "\uC73D... \uD798\uB4E4\uAC8C \uC81C\uC77C \uBA3C \uACF3\uAE4C\uC9C0
      \uC654\uB294\uB370 \uBC14\uB85C \uB3CC\uC544\uAC00\uC57C \uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322658
    m_Localized: "\uC138\uB77C\uC640 \uC5D8\uB9AC\uC2A4 \uB450 \uC0AC\uB78C\uC740
      \uAD00\uBB38 \uAC80\uBB38\uC18C\uC5D0\uC11C \uBAAC\uC2A4\uD130\uB97C \uBA3C\uC800
      \uB9C9\uC544\uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322659
    m_Localized: "\uC88B\uC544! \uC5EC\uAE30\uB294 \uB0B4\uAC00 \uBC84\uD2F8\uAC8C.
      \uAD00\uBB38\uAE4C\uC9C0\uB294 \uC808\uB300 \uBABB \uC9C0\uB098\uAC00\uAC8C
      \uB9C9\uC744 \uAC70\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322660
    m_Localized: "\uC138\uB77C\uAC00 \uC55E\uC744 \uB9E1\uC544\uC918. \uB098\uB294
      \uC801\uC774 \uBAB0\uB9AC\uB294 \uCABD\uC744 \uBCFC\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322661
    m_Localized: "\uC54C\uACA0\uC5B4. \uC2E0\uD638\uAC00 \uC624\uBA74 \uBC14\uB85C
      \uB098\uAC08\uAC8C!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322662
    m_Localized: "\uBAAC\uC2A4\uD130 \uBB34\uB9AC\uAC00 \uAD00\uBB38 \uC55E\uAE4C\uC9C0
      \uC811\uADFC\uD588\uC2B5\uB2C8\uB2E4! \uC9C0\uD718\uAD00\uB2D8, \uC2E0\uD638\uC11D
      \uC900\uBE44\uB97C \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322663
    m_Localized: "\uC138\uB77C\uC640 \uC5D8\uB9AC\uC2A4\uD55C\uD14C \uBA3C\uC800
      \uC2E0\uD638\uB97C \uBCF4\uB0BC\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322664
    m_Localized: "\uC2E0\uD638 \uC5F0\uACB0 \uD655\uC778. \uC138\uB77C, \uC900\uBE44\uB410\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322665
    m_Localized: "\uC88B\uC544, \uAC04\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322666
    m_Localized: "[\uD29C\uD1A0\uB9AC\uC5BC \uD31D\uC5C5: \uC2E0\uD638\uC11D \uD0C0\uC774\uBC0D
      \uC561\uC158 \uBC0F 3-Sort \uCF64\uBCF4 \uACF5\uACA9 \uD559\uC2B5]"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322667
    m_Localized: "\uACF5\uACA9 \uC2E0\uD638\uC11D\uC744 \uC138\uB77C \uC2AC\uB86F\uC73C\uB85C
      \uB4DC\uB798\uADF8\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322668
    m_Localized: "\uAC19\uC740 \uC2E0\uD638\uC11D 3\uAC1C\uB97C \uC815\uB82C\uD574
      \uCF64\uBCF4\uB97C \uC644\uC131\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322669
    m_Localized: "\uC3DF\uC544\uC838 \uB098\uC624\uAE30 \uC2DC\uC791\uD588\uC5B4!
      \uC55E\uCABD\uC740 \uB0B4\uAC00 \uB9C9\uC744\uAC8C!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322670
    m_Localized: "\uC801\uB4E4\uC774 \uD55C\uACF3\uC5D0 \uBAB0\uB9AC\uBA74 \uB0B4\uAC00
      \uCC98\uB9AC\uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322671
    m_Localized: "\uB450 \uBC88\uC9F8 \uBB34\uB9AC\uAC00 \uBCF4\uC5EC. \uC774\uC81C
      \uB098\uB3C4 \uD569\uB958\uD560\uAC8C. \uBA40\uB9AC\uC11C \uB2E4\uAC00\uC624\uB294
      \uC801\uC740 \uB0B4\uAC00 \uBCFC\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322672
    m_Localized: "\uBB3C\uC790 \uCABD \uC7A0\uAE08\uC740 \uD655\uC778\uD588\uC5B4.
      \uBD95\uB300\uB3C4 \uCC59\uACBC\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322673
    m_Localized: "\uADF8\uB798\uB3C4 \uBC14\uB85C \uC640\uC918\uC11C \uB2E4\uD589\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322674
    m_Localized: "\uB2A6\uC73C\uBA74 \uB354 \uBC14\uBE60\uC9C0\uB2C8\uAE4C..."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322675
    m_Localized: "\uC88B\uC544! \uC774\uC81C \uB2E4 \uBAA8\uC600\uB124!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322676
    m_Localized: "\uC774\uB7EC\uBA74 \uB2E4\uCCD0\uB3C4 \uBC14\uB85C \uBCFC \uC218\uB294
      \uC788\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322677
    m_Localized: "[\uD29C\uD1A0\uB9AC\uC5BC \uD31D\uC5C5: \uC801 \uCC98\uCE58 \uACBD\uD5D8\uCE58
      \uD68D\uB4DD \uBC0F \uB808\uBCA8\uC5C5 \uBCF4\uC0C1 \uC120\uD0DD]"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322678
    m_Localized: "\uB808\uBCA8\uC5C5 \uBCF4\uC0C1 \uCE74\uB4DC \uC911 \uD558\uB098\uB97C
      \uC120\uD0DD\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322679
    m_Localized: "\uB300\uD615 \uBAAC\uC2A4\uD130/\uBCF4\uC2A4 \uB4F1\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322680
    m_Localized: "\uD070 \uB140\uC11D\uC774 \uBCF4\uC5EC. \uC774\uBC88 \uBB34\uB9AC\uB294
      \uC800 \uB140\uC11D\uC744 \uC911\uC2EC\uC73C\uB85C \uC6C0\uC9C1\uC774\uACE0
      \uC788\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322681
    m_Localized: "\uADF8\uB7FC \uC800 \uD070 \uB140\uC11D\uBD80\uD130 \uB9C9\uC73C\uBA74
      \uB418\uACA0\uB124. \uB0B4\uAC00 \uC55E\uC5D0 \uC124\uAC8C!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322682
    m_Localized: "\uC138\uB77C, \uC7A0\uAE50\uB9CC! \uC800 \uB369\uCE58\uB294 \uC77C\uBC18
      \uACF5\uACA9\uB9CC\uC73C\uB85C\uB294 \uC2DC\uAC04\uC774 \uC624\uB798 \uAC78\uB9B4
      \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322683
    m_Localized: "\uC9C0\uD718\uAD00, \uC138\uB77C\uC5D0\uAC8C \uC2A4\uD0AC \uC2E0\uD638\uB97C
      \uBCF4\uB0B4\uC918!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322684
    m_Localized: "\uC77C\uBC18 \uC2E0\uD638\uAC00 \uC544\uB2C8\uB77C, \uAC8C\uC774\uC9C0\uB97C
      \uC804\uBD80 \uC18C\uBAA8\uD558\uB294 \uD544\uC0B4\uAE30 \uC2E0\uD638\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322685
    m_Localized: "[\uD29C\uD1A0\uB9AC\uC5BC \uD31D\uC5C5: \uAC8C\uC774\uC9C0 \uC18C\uBAA8\uB97C
      \uD1B5\uD55C \uD544\uC0B4\uAE30(\uAD81\uADF9\uAE30) \uBC1C\uB3D9]"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322686
    m_Localized: "\uD544\uC0B4\uAE30 \uAC8C\uC774\uC9C0\uB97C \uC0AC\uC6A9\uD574
      \uC138\uB77C\uC758 \uD544\uC0B4\uAE30\uB97C \uBC1C\uB3D9\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322687
    m_Localized: "\uC2E0\uD638 \uD655\uC778! \uD06C\uAC8C \uD55C \uBC29 \uBA39\uC77C\uAC8C!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322688
    m_Localized: "(\uAD00\uBB38 \uC55E\uC758 \uBAAC\uC2A4\uD130 \uBB34\uB9AC\uB97C
      \uC804\uBD80 \uBB3C\uB9AC\uCCE4\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322689
    m_Localized: "\uB2E4\uCE5C \uB370\uB294 \uC5C6\uC5B4? \uBB34\uB9AC\uD558\uC9C0
      \uB9D0\uACE0 \uBC14\uB85C \uB9D0\uD574\uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322690
    m_Localized: "\uC5C6\uC5B4! \uB2E4\uCE5C \uB370\uB294 \uC5C6\uC5B4! \uAD00\uBB38
      \uC55E \uB3CC\uBC14\uB2E5\uC740... \uC74C, \uAD1C\uCC2E\uACA0\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322691
    m_Localized: "\uAD1C\uCC2E\uACA0\uC9C0\uB85C \uB05D\uB0BC \uC774\uC57C\uAE30\uB294
      \uC544\uB2CC\uB370, \uBB50 \uADF8\uB798\uB3C4 \uBAAC\uC2A4\uD130\uB294 \uAD00\uBB38\uC5D0
      \uB2FF\uAE30 \uC804\uC5D0 \uB04A\uC5B4\uB0C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322692
    m_Localized: "\uB3CC\uBC14\uB2E5\uC740 \uB0B4\uAC00 \uD655\uC778\uD574 \uB458\uAC8C.
      \uB098\uC911\uC5D0 \uC218\uB9AC \uC77C\uC774 \uCEE4\uC9C0\uBA74 \uB354 \uADC0\uCC2E\uC544\uC9C0\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322693
    m_Localized: "\uADF8\uB7F0\uB370 \uC880 \uC774\uC0C1\uD574. \uC544\uAE4C \uADF8
      \uBAAC\uC2A4\uD130 \uBB34\uB9AC, \uC804\uBD80 \uC232\uAE38\uC5D0\uC11C \uB0B4\uB824\uC654\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 863262231322694
    m_Localized: "\uB9DD\uB8E8\uC5D0\uC11C \uBD24\uC744 \uB54C, \uC232\uAE38 \uC548\uCABD
      \uC6C0\uC9C1\uC784\uC774 \uC544\uC9C1 \uB0A8\uC544 \uC788\uC5C8\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711232
    m_Localized: "\uADF8\uB7FC \uC232\uAE38 \uCABD\uC744 \uB2E4\uC2DC \uD655\uC778\uD574\uC57C\uACA0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711233
    m_Localized: "\uC2DC\uC5D0\uC2A4\uAC00 \uC6D0\uB798 \uC774\uB807\uAC8C \uBAAC\uC2A4\uD130\uAC00
      \uBAB0\uB824\uB4DC\uB294 \uACF3\uC740 \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711234
    m_Localized: "\uC870\uC6A9\uD55C \uADFC\uBB34\uC9C0\uB77C\uB354\uB2C8, \uADF8
      \uC18C\uBB38\uC774 \uC644\uC804\uD788 \uD2C0\uB838\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711235
    m_Localized: "\uADF8 \uC18C\uBB38\uC744 \uC81C\uC77C \uBA3C\uC800 \uB9D0\uD55C
      \uC0AC\uB78C\uC774 \uC138\uB77C\uC600\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711236
    m_Localized: "\uADF8\uB7FC \uB0B4\uAC00 \uC9C1\uC811 \uD655\uC778\uD574\uC11C
      \uC815\uC815\uD558\uBA74 \uB418\uACA0\uB124!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711237
    m_Localized: "\uC7A0\uAE50\uB9CC, \uAD00\uBB38 \uC55E\uC5D0 \uBB54\uAC00 \uBCF4\uC5EC."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711238
    m_Localized: "\uBAAC\uC2A4\uD130\uB4E4\uC774 \uC9C0\uB098\uAC04 \uC790\uB9AC\uC5D0
      \uBE5B\uB098\uB294 \uAC8C \uB0A8\uC544 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711239
    m_Localized: "\uC9C4\uC9DC\uB124. \uBB54\uAC00 \uBE5B\uB098\uACE0 \uC788\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711240
    m_Localized: "\uAD1C\uD788 \uAC74\uB4DC\uB838\uB2E4\uAC00 \uC77C\uC774 \uB298\uC5B4\uB098\uBA74
      \uC2EB\uC73C\uB2C8\uAE4C..."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711241
    m_Localized: "\uC5D8\uB9AC\uC2A4, \uD655\uC778 \uBD80\uD0C1\uD574\uB3C4 \uB3FC?"
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711242
    m_Localized: "\uC751. \uD655\uC778\uD574 \uBD24\uB294\uB370 \uBB38\uC81C\uB294
      \uC5C6\uC5B4 \uBCF4\uC5EC."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711243
    m_Localized: "\uC2E0\uD638\uC11D \uBC18\uC751\uC774\uB791 \uBE44\uC2B7\uD55C\uB370,
      \uC870\uAE08 \uB2EC\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711244
    m_Localized: "\uC774\uAC74 \uC720\uBB3C\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711245
    m_Localized: "[\uD29C\uD1A0\uB9AC\uC5BC \uD31D\uC5C5: \uC720\uBB3C \uBCF4\uC0C1
      \uC120\uD0DD]"
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711246
    m_Localized: "\uC720\uBB3C \uD6A8\uACFC\uB294 \uB2E4\uC74C \uC2A4\uD14C\uC774\uC9C0\uC5D0\uB3C4
      \uC720\uC9C0\uB429\uB2C8\uB2E4. 3\uAC1C \uC911 1\uAC1C\uB97C \uC120\uD0DD\uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711247
    m_Localized: "\uADF8\uB7FC \uC2E0\uC911\uD558\uAC8C \uACE8\uB77C\uC57C\uACA0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711248
    m_Localized: "\uADF8\uB7FC \uC55E\uC5D0\uC11C \uB354 \uC624\uB798 \uBC84\uD2F8
      \uC218 \uC788\uB294 \uC138\uB77C\uC640 \uAD00\uB828\uB41C \uAC8C \uC88B\uACA0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711249
    m_Localized: "\uC232\uAE38\uC740 \uC2DC\uC57C\uAC00 \uC881\uC544. \uC138\uB77C\uAC00
      \uC55E\uC744 \uBC84\uD168\uC8FC\uBA74 \uBAA8\uB450 \uC6C0\uC9C1\uC774\uAE30
      \uD3B8\uD560 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711250
    m_Localized: "\uACE0\uB300 \uAC11\uC637\uC744 \uD68D\uB4DD\uD588\uC2B5\uB2C8\uB2E4.
      \uC774\uD6C4 \uC2A4\uD14C\uC774\uC9C0\uC5D0\uB3C4 \uD6A8\uACFC\uAC00 \uC720\uC9C0\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711251
    m_Localized: "\uC120\uD0DD\uB410\uC5B4. \uC774 \uD6A8\uACFC\uB294 \uB2E4\uC74C
      \uC804\uD22C\uC5D0\uB3C4 \uB0A8\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711252
    m_Localized: "\uC232\uAE38\uBD80\uD130 \uD655\uC778\uD574 \uBCF4\uC790. \uB178\uC544,
      \uBAAC\uC2A4\uD130\uAC00 \uC9C0\uB098\uAC04 \uD754\uC801\uC744 \uB530\uB77C\uAC00
      \uC918."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711253
    m_Localized: "\uC751. \uC9C0\uB098\uAC04 \uD754\uC801\uC740 \uC544\uC9C1 \uB0A8\uC544
      \uC788\uC5B4. \uB530\uB77C\uAC00 \uBCFC\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711254
    m_Localized: "\uB098\uB294 \uC2E0\uD638\uC11D \uC0C1\uD0DC\uB97C \uB2E4\uC2DC
      \uBCFC\uAC8C. \uB2E4\uC74C \uBB34\uB9AC\uAC00 \uC624\uAE30 \uC804\uC5D0 \uB9DE\uCDB0\uB46C\uC57C
      \uD558\uB2C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711255
    m_Localized: "\uC88B\uC544! \uC6D0\uC778\uC744 \uCC3E\uACE0, \uC870\uC6A9\uD55C
      \uADFC\uBB34\uC9C0\uB3C4 \uB418\uCC3E\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711256
    m_Localized: "\uADF8\uB7FC \uC9C0\uAE08 \uC6C0\uC9C1\uC774\uC790. \uBA40\uB9AC\uAE4C\uC9C4
      \uC548 \uAC00\uB3C4 \uB418\uACA0\uC9C0..."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711257
    m_Localized: "\uC548 \uAC00\uB3C4 \uB41C\uB2E4\uACE0 \uD574\uC918..."
    m_Metadata:
      m_Items: []
  - m_Id: 863262239711258
    m_Localized: "(\uAD00\uBB38 \uC55E\uC758 \uC18C\uB780\uC740 \uB05D\uB0AC\uC9C0\uB9CC,
      \uC232 \uCABD\uC758 \uC6C0\uC9C1\uC784\uC740 \uC544\uC9C1 \uBA48\uCD94\uC9C0
      \uC54A\uC740 \uAC83 \uAC19\uC558\uB2E4.)"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

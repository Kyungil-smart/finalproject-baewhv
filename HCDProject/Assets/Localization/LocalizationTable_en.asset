  m_TableData:
  - m_Id: 51780677632
    m_Localized: Sharp Senses
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160516
    m_Localized: Heart
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160515
    m_Localized: Attack Speed
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160514
    m_Localized: Shield
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160513
    m_Localized: Attack
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160463
    m_Localized: Commander's Banner
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160462
    m_Localized: Wall Reinforcement
    m_Metadata:

    m_Localized: "\u0E17\u0E31\u0E49\u0E07\u0E17\u0E32\u0E07\u0E1B\u0E48\u0E32\u0E2B\u0E19\u0E49\u0E32\u0E1B\u0E23\u0E30\u0E15\u0E39\u0E14\u0E48\u0E32\u0E19

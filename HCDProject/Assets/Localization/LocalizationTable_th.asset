    m_Localized: "\u0E40\u0E0B\u0E23\u0E32\u0E2B\u0E4C \u0E41\u0E04\u0E48\u0E2D\u0E22\u0E48\u0E32\u0E19\u0E33\u0E2B\u0E19\u0E49\u0E32\u0E44\u0E1B\u0E44\u0E01\u0E25\u0E40\u0E01\u0E34\u0E19\u0E44\u0E1B"

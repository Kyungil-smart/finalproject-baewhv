    m_Localized: "\u0E41\u0E15\u0E48\u0E01\u0E47\u0E22\u0E31\u0E07\u0E15\u0E49\u0E2D\u0E07\u0E15\u0E23\u0E27\u0E08\u0E2A\u0E20\u0E32\u0E1E\u0E01\u0E33\u0E41\u0E1E\u0E07\u0E1B\u0E49\u0E2D\u0E07\u0E01\u0E31\u0E19"

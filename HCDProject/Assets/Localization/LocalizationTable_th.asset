    m_Localized: "\u0E40\u0E1B\u0E47\u0E19\u0E40\u0E1E\u0E23\u0E32\u0E30\u0E40\u0E1B\u0E47\u0E19\u0E08\u0E2D\u0E21\u0E40\u0E27\u0E17

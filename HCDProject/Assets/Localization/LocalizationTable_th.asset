    m_Localized: "\u0E07\u0E31\u0E49\u0E19\u0E43\u0E0A\u0E49\u0E2A\u0E35\u0E17\u0E35\u0E48\u0E2A\u0E30\u0E14\u0E38\u0E14\u0E15\u0E32\u0E19\u0E31\u0E48\u0E19\u0E21\u0E32\u0E01\u0E33\u0E2B\u0E19\u0E14\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E2B\u0E21\u0E32\u0E22\u0E02\u0E2D\u0E07\u0E1E\u0E23\u0E38\u0E48\u0E07\u0E19\u0E35\u0E49\u0E01\u0E31\u0E19"

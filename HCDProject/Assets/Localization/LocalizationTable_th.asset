    m_Localized: "\u0E04\u0E25\u0E49\u0E32\u0E22\u0E1B\u0E31\u0E0D\u0E2B\u0E32\u0E17\u0E32\u0E07\u0E19\u0E49\u0E33\u0E17\u0E35\u0E48\u0E40\u0E2B\u0E47\u0E19\u0E43\u0E19\u0E40\u0E08\u0E40\u0E1E\u0E34\u0E25"

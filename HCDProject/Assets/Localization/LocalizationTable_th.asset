    m_Localized: "\u0E16\u0E49\u0E32\u0E1A\u0E23\u0E23\u0E22\u0E32\u0E01\u0E32\u0E28\u0E17\u0E33\u0E43\u0E2B\u0E49\u0E04\u0E19\u0E40\u0E02\u0E49\u0E32\u0E43\u0E01\u0E25\u0E49\u0E22\u0E32\u0E01

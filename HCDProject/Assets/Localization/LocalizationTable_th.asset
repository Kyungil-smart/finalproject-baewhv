    m_Localized: "\u0E17\u0E34\u0E28\u0E17\u0E32\u0E07\u0E2D\u0E1E\u0E22\u0E1E\u0E01\u0E47\u0E15\u0E49\u0E2D\u0E07\u0E40\u0E1B\u0E25\u0E35\u0E48\u0E22\u0E19\u0E44\u0E1B\u0E15\u0E32\u0E21\u0E27\u0E48\u0E32\u0E17\u0E32\u0E07\u0E19\u0E49\u0E33\u0E2A\u0E32\u0E22\u0E44\u0E2B\u0E19\u0E40\u0E23\u0E34\u0E48\u0E21\u0E1B\u0E31\u0E48\u0E19\u0E1B\u0E48\u0E27\u0E19\u0E01\u0E48\u0E2D\u0E19"

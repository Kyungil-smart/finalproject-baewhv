    m_Localized: "\u0E09\u0E31\u0E19\u0E14\u0E39\u0E1A\u0E31\u0E19\u0E17\u0E36\u0E01\u0E01\u0E32\u0E23\u0E15\u0E48\u0E2D\u0E2A\u0E39\u0E49\u0E04\u0E23\u0E31\u0E49\u0E07\u0E41\u0E23\u0E01\u0E41\u0E25\u0E49\u0E27"

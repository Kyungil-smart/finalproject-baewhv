    m_Localized: "\u0E09\u0E31\u0E19\u0E08\u0E30\u0E14\u0E39\u0E23\u0E2D\u0E22\u0E40\u0E17\u0E49\u0E32\u0E21\u0E2D\u0E19\u0E2A\u0E40\u0E15\u0E2D\u0E23\u0E4C\u0E2D\u0E35\u0E01\u0E04\u0E23\u0E31\u0E49\u0E07"

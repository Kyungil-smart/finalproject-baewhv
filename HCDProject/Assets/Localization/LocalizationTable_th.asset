    m_Localized: "\u0E44\u0E21\u0E48\u0E2D\u0E22\u0E32\u0E01\u0E2D\u0E22\u0E39\u0E48\u0E19\u0E32\u0E19\u0E43\u0E19\u0E17\u0E35\u0E48\u0E41\u0E1A\u0E1A\u0E19\u0E35\u0E49\u0E40\u0E25\u0E22"

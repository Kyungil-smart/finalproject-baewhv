    m_Localized: "\u0E21\u0E32\u0E23\u0E31\u0E01\u0E29\u0E32\u0E40\u0E2A\u0E49\u0E19\u0E17\u0E32\u0E07\u0E2D\u0E1E\u0E22\u0E1E\u0E1E\u0E37\u0E49\u0E19\u0E17\u0E35\u0E48\u0E23\u0E2D\u0E1A\u0E19\u0E2D\u0E01\u0E01\u0E31\u0E19"

    m_Metadata:
      m_Items: []
  - m_Id: 2040774160389
    m_Localized: Penguatan Tubuh
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160390
    m_Localized: Tubuh Ringan
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160391
    m_Localized: Kekuatan Terkonsentrasi
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160392
    m_Localized: Overload
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160393
    m_Localized: Napas Angin
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160394
    m_Localized: Wujud Buas
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160395
    m_Localized: Semangat Tembok Besi
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160396
    m_Localized: Nama Monster
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160464
    m_Localized: Info Skill Monster
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160513
    m_Localized: Serangan
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160514
    m_Localized: Pertahanan
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160515
    m_Localized: Kecepatan Serangan
    m_Metadata:
      m_Items: []
  - m_Id: 2040774160516

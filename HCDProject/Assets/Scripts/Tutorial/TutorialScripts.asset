  m_Script: {fileID: 11500000, guid: bbbbd5ea305fb5a489f6d3413ad981fa, type: 3}
  m_Name: TutorialScripts
  m_EditorClassIdentifier: Assembly-CSharp::TutorialScripts
  textList:
  - title: "3-Sort \uC548\uB0B4"
    desc: "Wave 1 \uC900\uBE44. \uC2E0\uD638\uC11D\uC744 \uBC30\uCE58\uD574 \uC804\uD22C
      \uC804 \uC601\uC6C5\uC744 \uAC15\uD654\uD574\uC8FC\uC138\uC694."
  - title: "\uC870\uC791 \uC548\uB0B4"
    desc: "\uACF5\uACA9 \uC2E0\uD638\uC11D\uC744 \uC138\uB77C \uC2AC\uB86F\uC73C\uB85C
      \uB4DC\uB798\uADF8\uD574\uC8FC\uC138\uC694."
  - title: "\uC804\uD22C \uC2DC\uC791"
    desc: "\uC900\uBE44\uAC00 \uB05D\uB0AC\uC2B5\uB2C8\uB2E4. BATTLE START\uB97C
      \uB20C\uB7EC \uC804\uD22C\uB97C \uC2DC\uC791\uD574\uC8FC\uC138\uC694."
  - title: "\uC138\uB77C"
    desc: "\uC3DF\uC544\uC838 \uB098\uC624\uAE30 \uC2DC\uC791\uD588\uC5B4! \uC55E\uCABD\uC740
      \uB0B4\uAC00 \uB9C9\uC744\uAC8C!"
  - title: "\uC5D8\uB9AC\uC2A4"
    desc: "\uC801\uB4E4\uC774 \uD55C\uACF3\uC5D0 \uBAB0\uB9AC\uBA74 \uB0B4\uAC00
      \uCC98\uB9AC\uD560\uAC8C. "
  - title: "\uB178\uC544"
    desc: "\uD569\uB958\uAC00 \uB2A6\uC5B4\uC11C \uBBF8\uC548\uD574! \uC774\uC81C\uBD80\uD130\uB294
      \uB098\uB3C4 \uD568\uAED8\uD560\uAC8C."
  - title: "\uC2A4\uD30C\uC778"
    desc: "\uCD5C\uB300\uD55C \uBE68\uB9AC \uAC78\uC5B4\uC654\uB2E4\uACE0..."
  - title: "\uB178\uC544"
    desc: "\uC9C0\uD718\uAD00, \uD070 \uB140\uC11D\uC774 \uC624\uACE0 \uC788\uC5B4."
  - title: "\uB178\uC544"
    desc: "\uC774\uBC88 \uBB34\uB9AC\uB294 \uC800 \uB140\uC11D\uC744 \uC911\uC2EC\uC73C\uB85C
      \uC6C0\uC9C1\uC774\uACE0 \uC788\uC5B4."
  - title: "\uC138\uB77C"
    desc: "\uADF8\uB7FC \uC800 \uCEE4\uB2E4\uB780 \uB140\uC11D\uC744 \uB9C9\uC73C\uBA74
      \uB418\uACA0\uB124. \uB0B4\uAC00 \uC4F0\uB7EC\uB728\uB9B4\uAC8C!"
  - title: "\uC2A4\uD0AC \uC548\uB0B4"
    desc: "\uC138\uB77C\uC758 \uD544\uC0B4\uAE30 \uAC8C\uC774\uC9C0\uAC00 \uAC00\uB4DD
      \uCC3C\uC2B5\uB2C8\uB2E4. \uCD08\uC0C1\uD654\uB97C \uD130\uCE58\uD574 \uD544\uC0B4\uAE30\uB97C
      \uC0AC\uC6A9\uD574\uC8FC\uC138\uC694."
  - title: "\uC2A4\uD0AC \uC548\uB0B4"
    desc: "\uC138\uB77C\uC758 \uD544\uC0B4\uAE30 \uAC8C\uC774\uC9C0\uAC00 \uAC00\uB4DD
      \uCC3C\uC2B5\uB2C8\uB2E4. \uCD08\uC0C1\uD654\uB97C \uD130\uCE58\uD574 \uD544\uC0B4\uAE30\uB97C
      \uC0AC\uC6A9\uD574\uC8FC\uC138\uC694."
  - title: "\uB178\uC544"
    desc: "\uB2E4\uB4E4 \uB2E4\uCE5C \uB370\uB294 \uC5C6\uC5B4?"
  - title: "\uC138\uB77C"
    desc: "\uB09C \uAD1C\uCC2E\uC544. \uACF5\uACA9\uB3C4 \uC81C\uB300\uB85C \uBA39\uD614\uACE0!"
  - title: "\uC5D8\uB9AC\uC2A4"
    desc: "\uC131\uBB38\uAE4C\uC9C0 \uBC00\uB824\uB098\uAE30 \uC804\uC5D0 \uB04A\uC5B4\uB0B8
      \uAC74 \uC798\uD588\uC5B4."
  - title: "\uB178\uC544"
    desc: "\uC800\uAE30, \uBE5B\uC774 \uBCF4\uC5EC."
  - title: "\uC138\uB77C"
    desc: "\uC9C4\uC9DC\uB124. \uBB54\uAC00 \uBE5B\uB098\uACE0 \uC788\uC5B4!"
  - title: "\uC9C0\uD718\uAD00"
    desc: "\uC5D8\uB9AC\uC2A4, \uD655\uC778 \uBD80\uD0C1\uD574\uB3C4 \uB3FC?"
  - title: "\uC5D8\uB9AC\uC2A4"
    desc: "\uC751. \uD655\uC778\uD574 \uBD24\uB294\uB370 \uBB38\uC81C\uB294 \uC5C6\uC5B4
      \uBCF4\uC5EC."
  - title: "\uC5D8\uB9AC\uC2A4"
    desc: "\uC5ED\uC2DC. \uC544\uAE4C \uD655\uC778\uD55C \uBC18\uC751\uC740 \uC720\uBB3C\uC774\uC5C8\uC5B4."
  - title: "\uC2A4\uD30C\uC778"
    desc: "\uADF8\uB7FC \uC2E0\uC911\uD558\uAC8C \uACE8\uB77C\uC57C\uACA0\uB124."
  - title: "\uC9C0\uD718\uAD00"
    desc: "\uADF8\uB7FC \uC55E\uC5D0\uC11C \uB354 \uC624\uB798 \uBC84\uD2F8 \uC218
      \uC788\uB294 \uC138\uB77C\uC640 \uAD00\uB828\uB41C \uAC8C \uC88B\uACA0\uB124."
  - title: "\uB178\uC544"
    desc: "\uC232\uAE38\uC740 \uC2DC\uC57C\uAC00 \uC881\uC544. \uC138\uB77C\uAC00
      \uC55E\uC744 \uBC84\uD168\uC8FC\uBA74 \uBAA8\uB450 \uC6C0\uC9C1\uC774\uAE30
      \uD3B8\uD560 \uAC70\uC57C."
  - title: "\uC5D8\uB9AC\uC2A4"
    desc: "\uC120\uD0DD\uB410\uC5B4. \uC774 \uD6A8\uACFC\uB294 \uB2E4\uC74C \uC804\uD22C\uC5D0\uB3C4
      \uB0A8\uC544."
